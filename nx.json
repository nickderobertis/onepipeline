{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "defaultBase": "main",
  "cacheDirectory": ".nx/cache",
  "namedInputs": {
    "sharedGlobals": [
      "{workspaceRoot}/nx.json",
      "{workspaceRoot}/package.json",
      "{workspaceRoot}/package-lock.json",
      "{workspaceRoot}/justfile"
    ],
    "default": [
      "{projectRoot}/**/*",
      "sharedGlobals"
    ],
    "wholeWorkspace": [
      "{workspaceRoot}/**/*"
    ],
    "crateSource": [
      "{workspaceRoot}/src/**/*",
      "{workspaceRoot}/tests/**/*",
      "{workspaceRoot}/docs/contract.md",
      "{workspaceRoot}/release-targets.toml",
      "{workspaceRoot}/Cargo.toml",
      "{workspaceRoot}/Cargo.lock",
      "{workspaceRoot}/rust-toolchain.toml",
      "{workspaceRoot}/clippy.toml",
      "{workspaceRoot}/rustfmt.toml",
      "{workspaceRoot}/docs/contract-divergences.md",
      "{workspaceRoot}/personas/**/*",
      "{workspaceRoot}/graphs/**/*",
      "{workspaceRoot}/examples/**/*",
      "sharedGlobals"
    ]
  },
  "targetDefaults": {
    "bootstrap": {
      "cache": false
    },
    "build": {
      "cache": true,
      "inputs": [
        "default"
      ]
    },
    "format": {
      "cache": false
    },
    "format-check": {
      "cache": true,
      "inputs": [
        "default"
      ]
    },
    "lint": {
      "cache": true,
      "inputs": [
        "default"
      ]
    },
    "test": {
      "cache": true,
      "inputs": [
        "default"
      ]
    },
    "doc": {
      "cache": true,
      "inputs": [
        "default"
      ]
    },
    "lint-llm-diff": {
      "cache": true,
      "inputs": [
        "wholeWorkspace",
        {
          "env": "LLMLINT_DIFF_BASE_SHA"
        },
        {
          "runtime": "bash scripts/llmlint-fingerprint.sh"
        }
      ]
    },
    "check": {
      "cache": false,
      "dependsOn": [
        "format-check",
        "lint",
        "test"
      ]
    }
  }
}
