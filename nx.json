{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "defaultBase": "main",
  "cacheDirectory": ".nx/cache",
  "namedInputs": {
    "sharedGlobals": [
      "{workspaceRoot}/nx.json",
      {
        "runtime": "node scripts/nx-version-free-inputs.mjs --ecosystem npm"
      },
      "{workspaceRoot}/justfile",
      "{workspaceRoot}/scripts/nx-version-free-inputs.mjs",
      "{workspaceRoot}/.github/nx-version-files",
      {
        "runtime": "node scripts/nx-version-free-inputs.mjs --ecosystem files"
      }
    ],
    "default": [
      "{projectRoot}/**/*",
      "sharedGlobals",
      "!{projectRoot}/CHANGELOG.md",
      "!{projectRoot}/**/CHANGELOG.md"
    ],
    "wholeWorkspace": [
      "{workspaceRoot}/**/*"
    ],
    "rustBuild": [
      "{workspaceRoot}/src/**/*",
      "{workspaceRoot}/crates/**/*",
      "{workspaceRoot}/schemas/**/*",
      {
        "runtime": "node scripts/nx-version-free-inputs.mjs --ecosystem cargo"
      },
      "{workspaceRoot}/rust-toolchain.toml",
      "{workspaceRoot}/.cargo/config.toml",
      "{workspaceRoot}/.config/nextest.toml",
      "sharedGlobals",
      "{workspaceRoot}/scripts/ensure-test-archive.sh"
    ],
    "crateSource": [
      "rustBuild",
      "{workspaceRoot}/tests/**/*",
      "{workspaceRoot}/clippy.toml",
      "{workspaceRoot}/rustfmt.toml",
      "{workspaceRoot}/docs/contract.md",
      "{workspaceRoot}/docs/contract-divergences.md",
      "{workspaceRoot}/README.md",
      "{workspaceRoot}/.github/workflows/visual-docs.yml"
    ],
    "crateTestSource": [
      "rustBuild",
      "{workspaceRoot}/clippy.toml",
      "{workspaceRoot}/rustfmt.toml",
      "{workspaceRoot}/README.md",
      "{workspaceRoot}/.editorconfig",
      "{workspaceRoot}/.gitattributes",
      "{workspaceRoot}/.gitignore",
      "{workspaceRoot}/tests/*.rs",
      "{workspaceRoot}/tests/golden/**/*",
      "{workspaceRoot}/tests/recorded/**/*",
      "{workspaceRoot}/tests/e2e/adoption.rs",
      "{workspaceRoot}/tests/e2e/host_view.rs",
      "{workspaceRoot}/tests/e2e/loopcost.rs",
      "{workspaceRoot}/tests/smoke/repo.rs",
      "{workspaceRoot}/docs/**/*",
      "{workspaceRoot}/examples/**/*",
      "{workspaceRoot}/graphs/**/*",
      "{workspaceRoot}/personas/**/*",
      "{workspaceRoot}/scripts/**/*",
      "{workspaceRoot}/release/release.py",
      "{workspaceRoot}/screenshots/**/*",
      "{workspaceRoot}/.github/**/*",
      "{workspaceRoot}/AGENTS.md",
      "{workspaceRoot}/CODEOWNERS",
      "{workspaceRoot}/biome.jsonc",
      "{workspaceRoot}/budgets.yaml",
      "{workspaceRoot}/deny.toml",
      "{workspaceRoot}/gh-secrets.json",
      "{workspaceRoot}/llmlint.yml",
      "{workspaceRoot}/oneharness.toml",
      "{workspaceRoot}/project.json",
      {
        "runtime": "node scripts/nx-version-free-inputs.mjs --ecosystem python"
      },
      "{workspaceRoot}/release-plz.toml",
      "{workspaceRoot}/release-targets.toml",
      "{workspaceRoot}/screencomp.toml"
    ],
    "e2eSource": [
      "rustBuild",
      "{workspaceRoot}/tests/e2e/**/*",
      "{workspaceRoot}/tests/golden/**/*",
      "{workspaceRoot}/tests/recorded/**/*",
      "{workspaceRoot}/docs/**/*",
      "{workspaceRoot}/examples/**/*",
      "{workspaceRoot}/graphs/**/*",
      "{workspaceRoot}/personas/**/*",
      "{workspaceRoot}/scripts/stacked-spikes-budget.mjs",
      "{workspaceRoot}/scripts/record-channel-answers.sh",
      "{workspaceRoot}/oneharness.toml",
      "{workspaceRoot}/clippy.toml",
      "{workspaceRoot}/rustfmt.toml"
    ],
    "contractSource": [
      "rustBuild",
      "{workspaceRoot}/tests/contract.rs",
      "{workspaceRoot}/tests/contract/**/*",
      "{workspaceRoot}/tests/golden/**/*",
      "{workspaceRoot}/tests/recorded/**/*",
      "{workspaceRoot}/tests/e2e/channel.rs",
      "{workspaceRoot}/docs/**/*",
      "{workspaceRoot}/README.md",
      "{workspaceRoot}/examples/**/*",
      "{workspaceRoot}/graphs/**/*",
      "{workspaceRoot}/personas/**/*",
      "{workspaceRoot}/scripts/check-node.sh",
      "{workspaceRoot}/scripts/review-envelope.sh",
      "{workspaceRoot}/scripts/smoke-published.sh",
      "{workspaceRoot}/clippy.toml",
      "{workspaceRoot}/rustfmt.toml"
    ],
    "noteJourneySource": [
      "rustBuild",
      "{workspaceRoot}/tests/note/**/*",
      "{workspaceRoot}/tests/e2e/harness.rs",
      "{workspaceRoot}/personas/**/*",
      "{workspaceRoot}/graphs/**/*",
      "{workspaceRoot}/clippy.toml",
      "{workspaceRoot}/rustfmt.toml"
    ],
    "smokeSource": [
      "rustBuild",
      "{workspaceRoot}/tests/smoke/**/*",
      "{workspaceRoot}/tests/e2e/harness.rs",
      "{workspaceRoot}/personas/**/*",
      "{workspaceRoot}/graphs/**/*",
      "{workspaceRoot}/scripts/release-probe.sh",
      "{workspaceRoot}/clippy.toml",
      "{workspaceRoot}/rustfmt.toml"
    ],
    "poolWorkloadSource": [
      "rustBuild",
      "{workspaceRoot}/tests/pool_workload/**/*",
      "{workspaceRoot}/tests/e2e/harness.rs",
      "{workspaceRoot}/personas/**/*",
      "{workspaceRoot}/graphs/**/*",
      "{workspaceRoot}/clippy.toml",
      "{workspaceRoot}/rustfmt.toml"
    ],
    "releaseCompatSource": [
      "rustBuild",
      "{workspaceRoot}/tests/release_channel/**/*",
      "{workspaceRoot}/tests/e2e/harness.rs",
      "{workspaceRoot}/tests/e2e/recorded_support.rs",
      "{workspaceRoot}/tests/recorded/**/*",
      "{workspaceRoot}/personas/**/*",
      "{workspaceRoot}/graphs/**/*",
      "{workspaceRoot}/clippy.toml",
      "{workspaceRoot}/rustfmt.toml"
    ],
    "visualDocsSource": [
      "{workspaceRoot}/src/**/*",
      "{workspaceRoot}/crates/**/*",
      "{workspaceRoot}/examples/**/*",
      "{workspaceRoot}/graphs/**/*",
      "{workspaceRoot}/tests/recorded/run-root/**/*",
      "{workspaceRoot}/screenshots/**/*",
      "{workspaceRoot}/screencomp.toml",
      "{workspaceRoot}/.github/workflows/visual-docs.yml",
      "{workspaceRoot}/Cargo.toml",
      "{workspaceRoot}/Cargo.lock",
      "{workspaceRoot}/rust-toolchain.toml",
      "{workspaceRoot}/.cargo/config.toml",
      "{workspaceRoot}/.config/nextest.toml",
      "sharedGlobals"
    ],
    "codexServerSource": [
      "{workspaceRoot}/tests/codex_server/**/*",
      {
        "runtime": "node scripts/nx-version-free-inputs.mjs --ecosystem cargo"
      },
      "{workspaceRoot}/crates/testfakes/src/lib.rs",
      "{workspaceRoot}/crates/testfakes/src/codex_app_server.rs",
      "{workspaceRoot}/crates/testfakes/src/bin/fake-codex.rs",
      "{workspaceRoot}/rust-toolchain.toml",
      "{workspaceRoot}/.cargo/config.toml",
      "{workspaceRoot}/.config/nextest.toml",
      "{workspaceRoot}/rustfmt.toml",
      "{workspaceRoot}/clippy.toml",
      "sharedGlobals"
    ],
    "pooledSlotSource": [
      "rustBuild",
      "{workspaceRoot}/tests/pooled_slot/**/*",
      "{workspaceRoot}/tests/e2e/harness.rs",
      "{workspaceRoot}/tests/e2e/hook.*",
      "{workspaceRoot}/tests/e2e/probe.*",
      "{workspaceRoot}/graphs/**/*",
      "{workspaceRoot}/personas/**/*",
      "{workspaceRoot}/oneharness.toml",
      "{workspaceRoot}/justfile",
      "{workspaceRoot}/clippy.toml",
      "{workspaceRoot}/rustfmt.toml",
      "{workspaceRoot}/tests/e2e/pool_support.rs",
      "{workspaceRoot}/tests/e2e/pool_hand_back.rs"
    ],
    "cargoSelection": [
      "{workspaceRoot}/Cargo.toml",
      "{workspaceRoot}/Cargo.lock",
      "{workspaceRoot}/**/Cargo.toml"
    ],
    "npmSelection": [
      "{workspaceRoot}/package.json",
      "{workspaceRoot}/package-lock.json",
      "{workspaceRoot}/**/package.json",
      "{workspaceRoot}/**/package-lock.json"
    ],
    "pythonSelection": [
      "{workspaceRoot}/pyproject.toml"
    ]
  },
  "targetDefaults": {
    "bootstrap": {
      "cache": false,
      "inputs": [
        "default",
        "^default",
        {
          "runtime": "node -p process.platform"
        }
      ]
    },
    "build": {
      "cache": true,
      "inputs": [
        "default",
        {
          "runtime": "node -p process.platform"
        }
      ],
      "outputs": []
    },
    "format": {
      "cache": false,
      "inputs": [
        "default",
        "^default",
        {
          "runtime": "node -p process.platform"
        }
      ]
    },
    "format-check": {
      "cache": true,
      "inputs": [
        "default",
        {
          "runtime": "node -p process.platform"
        }
      ],
      "outputs": []
    },
    "lint": {
      "cache": true,
      "inputs": [
        "default",
        {
          "runtime": "node -p process.platform"
        }
      ],
      "outputs": []
    },
    "coverage-clean": {
      "cache": false,
      "inputs": [
        "default",
        "^default",
        {
          "runtime": "node -p process.platform"
        }
      ]
    },
    "test-archive": {
      "cache": false,
      "inputs": [
        "default",
        "^default",
        {
          "runtime": "node -p process.platform"
        }
      ]
    },
    "test-quick-archive": {
      "cache": false,
      "inputs": [
        "default",
        "^default",
        {
          "runtime": "node -p process.platform"
        }
      ]
    },
    "test-rest": {
      "cache": true,
      "inputs": [
        "default",
        {
          "runtime": "node -p process.platform"
        }
      ],
      "outputs": []
    },
    "test": {
      "cache": true,
      "inputs": [
        "default",
        {
          "runtime": "node -p process.platform"
        }
      ],
      "outputs": []
    },
    "test-quick": {
      "cache": true,
      "inputs": [
        "default",
        {
          "env": "ONEPIPELINE_TEST_PARTITION"
        },
        {
          "runtime": "node -p process.platform"
        }
      ],
      "outputs": []
    },
    "doc": {
      "cache": true,
      "inputs": [
        "default",
        {
          "runtime": "node -p process.platform"
        }
      ],
      "outputs": []
    },
    "msrv": {
      "cache": false,
      "inputs": [
        "default",
        "^default",
        {
          "runtime": "node -p process.platform"
        }
      ]
    },
    "deps-check": {
      "cache": false,
      "inputs": [
        "default",
        "^default",
        {
          "runtime": "node -p process.platform"
        }
      ]
    },
    "smoke": {
      "cache": false,
      "inputs": [
        "default",
        "^default",
        {
          "runtime": "node -p process.platform"
        }
      ]
    },
    "release-compat": {
      "cache": false,
      "inputs": [
        "default",
        "^default",
        {
          "runtime": "node -p process.platform"
        }
      ]
    },
    "release-journeys": {
      "cache": false,
      "inputs": [
        "default",
        "^default",
        {
          "runtime": "node -p process.platform"
        }
      ]
    },
    "workload": {
      "cache": false,
      "inputs": [
        "default",
        "^default",
        {
          "runtime": "node -p process.platform"
        }
      ]
    },
    "lint-llm-diff": {
      "cache": true,
      "inputs": [
        "wholeWorkspace",
        {
          "env": "LLMLINT_DIFF_BASE_SHA"
        },
        {
          "runtime": "llmlint fingerprint"
        },
        {
          "runtime": "node -p process.platform"
        }
      ],
      "outputs": []
    },
    "check": {
      "cache": false,
      "dependsOn": [
        "format-check",
        "lint",
        "test"
      ],
      "inputs": [
        "default",
        "^default",
        {
          "runtime": "node -p process.platform"
        }
      ]
    },
    "screenshots": {
      "cache": true,
      "inputs": [
        "visualDocsSource",
        {
          "runtime": "node -p process.platform"
        }
      ],
      "outputs": []
    },
    "screenshots-bless": {
      "cache": false,
      "inputs": [
        "default",
        "^default",
        {
          "runtime": "node -p process.platform"
        }
      ]
    },
    "budgets": {
      "cache": false,
      "inputs": [
        "default",
        "^default",
        {
          "runtime": "node -p process.platform"
        }
      ]
    },
    "budgets-host": {
      "cache": false,
      "inputs": [
        "default",
        "^default",
        {
          "runtime": "node -p process.platform"
        }
      ]
    }
  },
  "plugins": [
    "./scripts/nx-remote-cache.mjs"
  ]
}
