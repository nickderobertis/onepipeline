         .collect()
 }
+
+
+/// Prototype (spike-onepipeline-test-cost): whether [`World::run`] answers in this
+/// process. Each nextest test is a process of its own, so one test's switch is
+/// never another's.
+static IN_PROCESS: std::sync::atomic::AtomicBool = std::sync::atomic::AtomicBool::new(false);
+
+/// Run a journey with every [`World::run`] it makes answered in this process.
+pub fn in_process(journey: fn()) {
+    IN_PROCESS.store(true, std::sync::atomic::Ordering::SeqCst);
+    journey();
+}
+
+#[cfg(unix)]
+fn exit_status(code: i32) -> std::process::ExitStatus {
+    std::os::unix::process::ExitStatusExt::from_raw((code & 0xff) << 8)
+}
+
+#[cfg(windows)]
+fn exit_status(code: i32) -> std::process::ExitStatus {
+    std::os::windows::process::ExitStatusExt::from_raw(code as u32)
+}
+
+/// What `run` wrote to this process's stdout and stderr, taken through files.
+fn captured(root: &Path, run: impl FnOnce() -> i32) -> (i32, Vec<u8>, Vec<u8>) {
+    use std::io::Write;
+    static TAKEN: std::sync::atomic::AtomicUsize = std::sync::atomic::AtomicUsize::new(0);
+    let n = TAKEN.fetch_add(1, std::sync::atomic::Ordering::SeqCst);
+    let out_path = root.join(format!("in-process-{n}.stdout"));
+    let err_path = root.join(format!("in-process-{n}.stderr"));
+    let out = std::fs::File::create(&out_path).expect("a stdout file");
+    let err = std::fs::File::create(&err_path).expect("a stderr file");
+    let _ = std::io::stdout().flush();
+    let _ = std::io::stderr().flush();
+    let restore = redirect(&out, &err);
+    let code = run();
+    let _ = std::io::stdout().flush();
+    let _ = std::io::stderr().flush();
+    restore();
+    drop((out, err));
+    (
+        code,
+        std::fs::read(&out_path).unwrap_or_default(),
+        std::fs::read(&err_path).unwrap_or_default(),
+    )
+}
+
+#[cfg(unix)]
+fn redirect(out: &std::fs::File, err: &std::fs::File) -> impl FnOnce() {
+    use std::os::fd::AsRawFd;
+    // SAFETY: plain descriptor duplication on descriptors this process owns.
+    let (saved_out, saved_err) = unsafe { (libc::dup(1), libc::dup(2)) };
+    unsafe {
+        libc::dup2(out.as_raw_fd(), 1);
+        libc::dup2(err.as_raw_fd(), 2);
+    }
+    move || unsafe {
+        libc::dup2(saved_out, 1);
+        libc::dup2(saved_err, 2);
+        libc::close(saved_out);
+        libc::close(saved_err);
+    }
+}
+
+#[cfg(windows)]
+fn redirect(out: &std::fs::File, err: &std::fs::File) -> impl FnOnce() {
+    use std::os::windows::io::AsRawHandle;
+    use windows_sys::Win32::System::Console::{GetStdHandle, SetStdHandle, STD_ERROR_HANDLE, STD_OUTPUT_HANDLE};
+    // SAFETY: the handles stay open until the restore below runs.
+    let (saved_out, saved_err) = unsafe { (GetStdHandle(STD_OUTPUT_HANDLE), GetStdHandle(STD_ERROR_HANDLE)) };
+    unsafe {
+        SetStdHandle(STD_OUTPUT_HANDLE, out.as_raw_handle() as _);
+        SetStdHandle(STD_ERROR_HANDLE, err.as_raw_handle() as _);
+    }
+    move || unsafe {
+        SetStdHandle(STD_OUTPUT_HANDLE, saved_out);
+        SetStdHandle(STD_ERROR_HANDLE, saved_err);
+    }
+}
