+//! Prototype (spike-onepipeline-test-cost): the pyramid sample's in-process
+//! replacements. Each test here runs one `lifecycle` or `views` journey's own body
+//! with [`crate::harness::in_process`] on, so every engine command the journey
+//! itself runs through `World::run` is answered by `onepipeline::run` in this
+//! test process rather than by the compiled binary; everything the engine spawns
+//! (git, the host and agent doubles) is unchanged.
+
+macro_rules! in_process {
+    ($($module:ident :: $name:ident => $replacement:ident),* $(,)?) => {
+        $(
+            #[test]
+            fn $replacement() {
+                crate::harness::in_process(crate::$module::$name);
+            }
+        )*
+    };
+}
+
