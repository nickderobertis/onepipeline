+//! Prototype (spike-onepipeline-test-cost): the pyramid sample's in-process
+//! replacements. Each test here runs one `lifecycle` or `views` journey's own body
+//! with [`crate::harness::in_process`] on, so every engine command the journey
+//! itself runs through `World::run` is answered by `onepipeline::run` in this
+//! test process rather than by the compiled binary; everything the engine spawns
+//! (git, the host and agent doubles) is unchanged.
+
+macro_rules! in_process {
+    ($($module:ident :: $name:ident => $replacement:ident),* $(,)?) => {
+        $(
+            #[test]
+            fn $replacement() {
+                crate::harness::in_process(crate::$module::$name);
+            }
+        )*
+    };
+}
+
+in_process! {
+    lifecycle::the_pr_author_dispatch_drafts_the_body_the_change_request_opens_with => lifecycle_the_pr_author_dispatch_drafts_the_body_the_change_request_opens_with,
+    lifecycle::a_node_that_states_its_own_body_publishes_it_and_spends_no_dispatch => lifecycle_a_node_that_states_its_own_body_publishes_it_and_spends_no_dispatch,
+    lifecycle::a_drafting_dispatch_that_ends_badly_leaves_the_publication_untouched => lifecycle_a_drafting_dispatch_that_ends_badly_leaves_the_publication_untouched,
+    lifecycle::a_drafted_body_is_read_only_from_the_copy_this_run_retained => lifecycle_a_drafted_body_is_read_only_from_the_copy_this_run_retained,
+    lifecycle::an_earlier_plan_still_publishes_under_the_subject_the_sibling_derives => lifecycle_an_earlier_plan_still_publishes_under_the_subject_the_sibling_derives,
+    lifecycle::a_drafting_graph_the_launch_directory_cannot_produce_is_refused_before_a_run_starts => lifecycle_a_drafting_graph_the_launch_directory_cannot_produce_is_refused_before_a_run_starts,
+    lifecycle::an_unresolvable_repository_is_refused_before_a_run_starts => lifecycle_an_unresolvable_repository_is_refused_before_a_run_starts,
+    lifecycle::a_title_the_sibling_will_not_commit_under_is_refused_before_any_dispatch => lifecycle_a_title_the_sibling_will_not_commit_under_is_refused_before_any_dispatch,
+    lifecycle::a_publication_onevcs_refuses_outright_settles_the_residual_and_is_not_retried => lifecycle_a_publication_onevcs_refuses_outright_settles_the_residual_and_is_not_retried,
+    lifecycle::a_push_the_merge_path_refuses_for_a_missing_host_prerequisite_settles_once_naming_the_fix => lifecycle_a_push_the_merge_path_refuses_for_a_missing_host_prerequisite_settles_once_naming_the_fix,
+    lifecycle::a_failure_no_attempt_could_answer_still_skips_its_dependents => lifecycle_a_failure_no_attempt_could_answer_still_skips_its_dependents,
+    lifecycle::a_published_node_reports_where_a_human_reads_the_change_it_opened => lifecycle_a_published_node_reports_where_a_human_reads_the_change_it_opened,
