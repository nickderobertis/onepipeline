{
  "name": "onepipeline-npm",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "npm/onepipeline-cli",
  "tags": ["scope:packaging", "lang:js"],
  "implicitDependencies": ["onepipeline"],
  "targets": {
    "bootstrap": {
      "command": "uv tool install maturin==1.14.1"
    },
    "build": {
      "command": "node scripts/npm-build.mjs launcher --out dist/npm",
      "inputs": [
        "{projectRoot}/**/*",
        "{workspaceRoot}/scripts/npm-build.mjs",
        "{workspaceRoot}/Cargo.toml",
        "sharedGlobals"
      ],
      "outputs": ["{workspaceRoot}/dist/npm"]
    },
    "format": {
      "command": "node node_modules/@biomejs/biome/bin/biome format --write npm scripts"
    },
    "format-check": {
      "command": "node node_modules/@biomejs/biome/bin/biome format npm scripts"
    },
    "lint": {
      "command": "node node_modules/@biomejs/biome/bin/biome lint npm scripts"
    },
    "test": {
      "command": "node --test npm/test/*.test.mjs",
      "//": "The crate's debug build (`just _crate-build`) runs first, as its own task: the publish journey packs that build and workspace-nx drives the same recipe, and a suite that compiled it itself held the tree's lock past the publish journey's 900-second setup.",
      "dependsOn": [
        {
          "projects": ["onepipeline"],
          "target": "build"
        }
      ],
      "inputs": [
        "{workspaceRoot}/justfile",
        "{projectRoot}/**/*",
        "{workspaceRoot}/scripts/npm-build.mjs",
        "{workspaceRoot}/scripts/publish-npm.sh",
        "{workspaceRoot}/scripts/release-outcome.mjs",
        "{workspaceRoot}/scripts/nx.sh",
        "{workspaceRoot}/scripts/stacked-spikes-budget.mjs",
        "{workspaceRoot}/scripts/test-profile-report.mjs",
        "{workspaceRoot}/scripts/crate-split-replay.mjs",
        "{workspaceRoot}/scripts/crate-split/**/*",
        "{workspaceRoot}/.github/workflows/ci.yml",
        "{workspaceRoot}/.github/workflows/visual-docs.yml",
        "{workspaceRoot}/scripts/ci-job.sh",
        "{workspaceRoot}/scripts/install-proof.sh",
        "{workspaceRoot}/scripts/nx-remote-cache.mjs",
        "{workspaceRoot}/nx.json",
        "{workspaceRoot}/tests/golden/test-profile-record-v2.json",
        "{workspaceRoot}/tests/e2e/*.rs",
        "{workspaceRoot}/budgets.yaml",
        {
          "runtime": "node scripts/nx-version-free-inputs.mjs --ecosystem npm"
        },
        "{workspaceRoot}/scripts/nx-affected.sh",
        "{workspaceRoot}/scripts/setup-llmlint.sh",
        "{workspaceRoot}/scripts/release-probe.sh",
        "{workspaceRoot}/release-targets.toml",
        "{workspaceRoot}/**/project.json",
        "{workspaceRoot}/.github/workflows/release.yml",
        "{workspaceRoot}/src/**/*",
        {
          "runtime": "node scripts/nx-version-free-inputs.mjs --ecosystem cargo"
        },
        "{workspaceRoot}/crates/**/*",
        "{workspaceRoot}/schemas/**/*",
        "{workspaceRoot}/rust-toolchain.toml",
        "{workspaceRoot}/.cargo/config.toml",
        "{workspaceRoot}/.config/nextest.toml",
        {
          "runtime": "node scripts/nx-version-free-inputs.mjs --ecosystem python"
        },
        "sharedGlobals",
        "{workspaceRoot}/scripts/build-staged-release.py",
        "{workspaceRoot}/release/release.py",
        {
          "runtime": "node -p process.platform"
        },
        {
          "runtime": "node scripts/nx-version-free-inputs.mjs --ecosystem cargo --keep-version"
        }
      ]
    },
    "test-launcher": {
      "command": "just npm-launcher",
      "//": "The launcher's process-tree journeys alone, for the Windows and macOS test jobs, where `test` never runs and the launcher takes paths Linux cannot reach (`just npm-launcher` says why). Linux runs them inside `test`.",
      "cache": false,
      "inputs": [
        "default",
        "^default",
        {
          "runtime": "node -p process.platform"
        }
      ]
    },
    "check": {
      "executor": "nx:noop",
      "dependsOn": ["format-check", "lint", "test"]
    },
    "input-selection": {
      "executor": "nx:noop",
      "cache": false,
      "//": "Selection-only manifest edges: Nx affected ignores runtime inputs. Hashing stays in the version-free runtime inputs of the tasks that run.",
      "inputs": ["justfileSelection", "cargoSelection", "npmSelection", "pythonSelection"]
    }
  }
}
