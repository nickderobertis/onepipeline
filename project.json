{
  "name": "onepipeline",
  "$schema": "node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "src",
  "tags": [
    "scope:cli",
    "lang:rust"
  ],
  "targets": {
    "bootstrap": {
      "command": "just _crate-bootstrap"
    },
    "build": {
      "command": "just _crate-build",
      "inputs": [
        "crateSource"
      ]
    },
    "format": {
      "command": "just _crate-format"
    },
    "format-check": {
      "command": "just _crate-fmt-check",
      "inputs": [
        "crateSource"
      ]
    },
    "lint": {
      "command": "just _crate-lint",
      "inputs": [
        "crateSource"
      ]
    },
    "coverage-clean": {
      "command": "just _crate-coverage-clean"
    },
    "test-archive": {
      "command": "just _crate-test-archive",
      "dependsOn": [
        "coverage-clean"
      ]
    },
    "test-rest": {
      "command": "just _crate-test-rest",
      "inputs": [
        "crateTestSource"
      ],
      "dependsOn": [
        "test-archive"
      ],
      "outputs": [
        "{workspaceRoot}/target/llvm-cov-target/onepipeline-rest-*.profraw"
      ]
    },
    "test": {
      "command": "just _crate-coverage",
      "inputs": [
        "crateTestSource",
        "e2eSource",
        "contractSource",
        "noteJourneySource"
      ],
      "dependsOn": [
        "test-rest",
        {
          "projects": [
            "onepipeline-e2e",
            "onepipeline-contract",
            "onepipeline-note-journeys"
          ],
          "target": "test"
        }
      ]
    },
    "test-quick-archive": {
      "command": "just _crate-test-quick-archive"
    },
    "test-quick": {
      "command": "just _crate-test-quick",
      "inputs": [
        "crateTestSource"
      ],
      "dependsOn": [
        "test-quick-archive"
      ],
      "parallelism": false
    },
    "doc": {
      "command": "just _crate-doc",
      "inputs": [
        "crateSource"
      ]
    },
    "lint-llm-diff": {
      "command": "bash scripts/llmlint-judge.sh",
      "options": {
        "cwd": "."
      },
      "outputs": [
        "{workspaceRoot}/.lint-llm-diff/verdict"
      ]
    },
    "check": {
      "executor": "nx:noop",
      "dependsOn": [
        "format-check",
        "lint",
        "test",
        "doc",
        "budgets"
      ]
    },
    "budgets": {
      "command": "just budgets",
      "dependsOn": [
        {
          "projects": [
            "onepipeline-e2e"
          ],
          "target": "test"
        }
      ],
      "inputs": [
        "e2eSource",
        "{workspaceRoot}/budgets.yaml",
        "{workspaceRoot}/scripts/stacked-spikes-budget.mjs",
        "{workspaceRoot}/package-lock.json",
        "{workspaceRoot}/scripts/linear-writeback-budget.sh"
      ]
    },
    "msrv": {
      "command": "just _crate-msrv",
      "inputs": [
        "crateSource"
      ]
    },
    "deps-check": {
      "command": "just _crate-deps-check",
      "inputs": [
        "rustBuild",
        "{workspaceRoot}/deny.toml"
      ]
    }
  },
  "//": "llmlint: ignore[expensive_tests_stay_behind_their_own_edge] project selection stays per tier — a change only one tier reads selects that tier and this crate, never a sibling tier (npm/test/workspace-nx.test.mjs drives it). This edge is what makes ci.yml's `changes` answer `true` for a tier-only change, so `cross`, `msrv`, `deny`, `install` and `wheel` still run on it; and the one 95% floor merges every tier's profiles, so `test` here depends on each tier's `test`, which replays from the cache wherever its inputs did not change.",
  "implicitDependencies": [
    "onepipeline-note-journeys",
    "onepipeline-e2e",
    "onepipeline-contract",
    "onepipeline-smoke",
    "onepipeline-release-compat"
  ]
}
