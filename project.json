{
  "name": "onepipeline",
  "$schema": "node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "src",
  "tags": [
    "scope:cli",
    "lang:rust"
  ],
  "targets": {
    "bootstrap": {
      "command": "just _crate-bootstrap",
      "inputs": [
        "default",
        "^default",
        {
          "runtime": "node -p process.platform"
        }
      ]
    },
    "build": {
      "command": "just _crate-build",
      "inputs": [
        {
          "runtime": "node scripts/nx-recipe-input.mjs _crate-build"
        },
        "crateSource",
        {
          "runtime": "node -p process.platform"
        }
      ]
    },
    "format": {
      "command": "just _crate-format",
      "inputs": [
        "default",
        "^default",
        {
          "runtime": "node -p process.platform"
        }
      ]
    },
    "format-check": {
      "command": "just _crate-fmt-check",
      "inputs": [
        {
          "runtime": "node scripts/nx-recipe-input.mjs _crate-fmt-check"
        },
        "crateSource",
        {
          "runtime": "node -p process.platform"
        }
      ]
    },
    "lint": {
      "command": "just _crate-lint",
      "inputs": [
        {
          "runtime": "node scripts/nx-recipe-input.mjs _crate-lint"
        },
        "crateSource",
        {
          "runtime": "node -p process.platform"
        }
      ]
    },
    "coverage-clean": {
      "command": "just _crate-coverage-clean",
      "inputs": [
        "default",
        "^default",
        {
          "runtime": "node -p process.platform"
        }
      ]
    },
    "test-archive": {
      "command": "just _crate-test-archive",
      "dependsOn": [
        "coverage-clean"
      ],
      "inputs": [
        "default",
        "^default",
        {
          "runtime": "node -p process.platform"
        }
      ]
    },
    "test-rest": {
      "command": "just _crate-test-rest",
      "inputs": [
        "crateCoverageSource",
        "coverageTierKey",
        {
          "runtime": "node scripts/nx-recipe-input.mjs _crate-test-rest _ensure-onetaskgraph --variable rest-tier --variable onetaskgraph-version"
        },
        {
          "runtime": "node -p process.platform"
        }
      ],
      "dependsOn": [
        "coverage-clean"
      ],
      "outputs": [
        "{workspaceRoot}/target/coverage-units/onepipeline-rest.lcov"
      ]
    },
    "test": {
      "command": "just _crate-coverage",
      "inputs": [
        "crateTestSource",
        "e2eSource",
        "contractSource",
        "noteJourneySource",
        "codexServerSource",
        "pooledSlotSource",
        {
          "runtime": "node -p process.platform"
        }
      ],
      "//": "llmlint: ignore-block[expensive_tests_stay_behind_their_own_edge] the one 95% floor merges every instrumented tier's LCOV report, including the separate version-reading tests', so this aggregate depends on each tier's test. Each tier is a cached coverage unit that replays its report while its inputs are unchanged; this aggregate stays uncached, so the merge always reads the current set, and archives build only when a tier runs.",
      "dependsOn": [
        "test-rest",
        {
          "projects": [
            "onepipeline-e2e",
            "onepipeline-contract",
            "onepipeline-note-journeys",
            "onepipeline-codex-server",
            "onepipeline-pooled-slot",
            "onepipeline-narrow-write"
          ],
          "target": "test"
        },
        {
          "projects": [
            "onepipeline-version-contract",
            "onepipeline-version-e2e",
            "onepipeline-version-package"
          ],
          "target": "test"
        }
      ],
      "//end": "llmlint: ignore-end[expensive_tests_stay_behind_their_own_edge]",
      "cache": false
    },
    "test-quick-archive": {
      "command": "just _crate-test-quick-archive",
      "inputs": [
        "default",
        "^default",
        {
          "runtime": "node -p process.platform"
        }
      ]
    },
    "test-quick": {
      "command": "just _crate-test-quick",
      "inputs": [
        {
          "runtime": "node scripts/nx-recipe-input.mjs _crate-test-quick --variable onetaskgraph-version"
        },
        "crateTestSource",
        {
          "env": "ONEPIPELINE_TEST_PARTITION"
        },
        {
          "runtime": "node -p process.platform"
        }
      ],
      "dependsOn": [],
      "parallelism": false
    },
    "doc": {
      "command": "just _crate-doc",
      "inputs": [
        {
          "runtime": "node scripts/nx-recipe-input.mjs _crate-doc"
        },
        "crateSource",
        {
          "runtime": "node -p process.platform"
        }
      ]
    },
    "check": {
      "executor": "nx:noop",
      "dependsOn": [
        "format-check",
        "lint",
        "test",
        "doc",
        "budgets"
      ],
      "inputs": [
        "default",
        "^default",
        {
          "runtime": "node -p process.platform"
        }
      ]
    },
    "budgets": {
      "command": "just budgets",
      "//": "llmlint: ignore-block[expensive_tests_stay_behind_their_own_edge] the stacked-spikes budget reads the record the e2e tier writes, so it runs after that tier, as it ran after `test-rest` when that target held the e2e binary. The edge is narrower than before the split; the uncached coverage tier produces fresh records for the reader.",
      "dependsOn": [
        {
          "projects": [
            "onepipeline-e2e"
          ],
          "target": "test"
        }
      ],
      "//end": "llmlint: ignore-end[expensive_tests_stay_behind_their_own_edge]",
      "inputs": [
        "e2eSource",
        "{workspaceRoot}/budgets.yaml",
        "{workspaceRoot}/scripts/stacked-spikes-budget.mjs",
        "{workspaceRoot}/scripts/review-round-quota-budget.*",
        "{workspaceRoot}/scripts/check-visibility-quota-budget.*",
        {
          "runtime": "node scripts/nx-version-free-inputs.mjs --ecosystem npm"
        },
        "{workspaceRoot}/scripts/store-operations-budget.mjs",
        "{workspaceRoot}/scripts/settlement-latency-budget.sh",
        {
          "dependentTasksOutputFiles": "target/budget-records/**/*",
          "transitive": false
        },
        {
          "runtime": "node -p process.platform"
        }
      ]
    },
    "msrv": {
      "command": "just _crate-msrv",
      "inputs": [
        "crateSource",
        {
          "runtime": "node -p process.platform"
        }
      ]
    },
    "deps-check": {
      "command": "just _crate-deps-check",
      "inputs": [
        "rustBuild",
        "{workspaceRoot}/deny.toml",
        {
          "runtime": "node -p process.platform"
        }
      ]
    },
    "install-smoke": {
      "command": "bash scripts/install-proof.sh path",
      "//": "llmlint: ignore-block[expensive_tests_stay_behind_their_own_edge, external_service_suite_stays_out_of_the_affected_tier] the end-user install proofs, kept on the crate because test-linux runs this one whenever the crate is affected: the host-view-time budget times the binary it installs. That is the edge ci.yml's old `install` job had, and narrowing it would leave that budget unmeasured. test-windows and test-macos run it only when onepipeline-install-smoke-selection (install/smoke/project.json) is affected (scripts/ci-job.sh), since a source change that breaks it there fails release.yml's per-platform release build and test-install before that platform publishes anything. `cargo install --path . --locked` of this revision, into the job's one target directory; uncached, because what it proves is that the install works on the host it runs on, and so a narrowed selection can never replay an earlier pass.",
      "cache": false,
      "inputs": [
        "default",
        "^default",
        {
          "runtime": "node -p process.platform"
        }
      ]
    },
    "install-documented": {
      "command": "bash scripts/install-proof.sh documented",
      "//": "README.md's `cargo install --git` one-liner, which installs the remote's default branch: network, and uncached because no input of this tree names that revision. A pull request's test jobs run it only when onepipeline-install-documented-selection (install/documented/project.json) is affected, as nothing else in the pull request reaches what it builds; the push-to-main `timed` job runs it on every push that affects the crate, on Linux, and never during a timing, as every `timed` target is `parallelism: false`. It builds in a CARGO_TARGET_DIR of its own outside target/, so it rewrites none of the release units, nor the target/release/onepipeline, that the job's other builds share (onepipeline#1814), and needs no order against install-smoke.",
      "cache": false,
      "//end": "llmlint: ignore-end[expensive_tests_stay_behind_their_own_edge, external_service_suite_stays_out_of_the_affected_tier]",
      "inputs": [
        "default",
        "^default",
        {
          "runtime": "node -p process.platform"
        }
      ]
    },
    "input-selection": {
      "executor": "nx:noop",
      "cache": false,
      "//": "Selection-only manifest edges: Nx affected ignores runtime inputs. Hashing stays in the version-free runtime inputs of the tasks that run.",
      "inputs": [
        "justfileSelection",
        "cargoSelection",
        "npmSelection",
        "pythonSelection"
      ]
    }
  },
  "//": "llmlint: ignore[expensive_tests_stay_behind_their_own_edge] project selection stays per tier \u2014 a change only one tier reads selects that tier and this crate, never a sibling tier (npm/test/workspace-nx.test.mjs drives it). This edge is what makes ci.yml's `changes` answer `true` for a tier-only change, so `cross`, `msrv`, `deny` and `install` still run on it.",
  "implicitDependencies": [
    "onepipeline-note-journeys",
    "onepipeline-e2e",
    "onepipeline-contract",
    "onepipeline-real-smoke",
    "onepipeline-release-compat",
    "onepipeline-stop-verdict",
    "onepipeline-pooled-slot",
    "onepipeline-narrow-write"
  ],
  "namedInputs": {
    "default": [
      "{projectRoot}/**/*",
      "!{projectRoot}/CHANGELOG.md",
      {
        "runtime": "node scripts/nx-version-free-inputs.mjs --ecosystem cargo"
      },
      "sharedGlobals",
      "!{projectRoot}/Cargo.toml",
      "!{projectRoot}/Cargo.lock"
    ]
  }
}
