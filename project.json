{
  "name": "onepipeline",
  "$schema": "node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "src",
  "tags": [
    "scope:cli",
    "lang:rust"
  ],
  "targets": {
    "bootstrap": {
      "command": "just _crate-bootstrap"
    },
    "build": {
      "command": "just _crate-build",
      "inputs": [
        "crateSource"
      ]
    },
    "format": {
      "command": "just _crate-format"
    },
    "format-check": {
      "command": "just _crate-fmt-check",
      "inputs": [
        "crateSource"
      ]
    },
    "lint": {
      "command": "just _crate-lint",
      "inputs": [
        "crateSource"
      ]
    },
    "coverage-clean": {
      "command": "just _crate-coverage-clean"
    },
    "test-rest": {
      "command": "just _crate-test-rest",
      "inputs": [
        "crateSource"
      ],
      "dependsOn": [
        "coverage-clean"
      ],
      "outputs": [
        "{workspaceRoot}/target/budget-records/stacked-spikes-stage.json"
      ]
    },
    "test": {
      "command": "just _crate-coverage",
      "inputs": [
        "crateSource"
      ],
      "dependsOn": [
        "test-rest",
        {
          "projects": [
            "onepipeline-note-journeys"
          ],
          "target": "test"
        }
      ]
    },
    "doc": {
      "command": "just _crate-doc",
      "inputs": [
        "crateSource"
      ]
    },
    "lint-llm-diff": {
      "command": "bash scripts/llmlint-judge.sh",
      "options": {
        "cwd": "."
      },
      "outputs": [
        "{workspaceRoot}/.lint-llm-diff/verdict"
      ]
    },
    "check": {
      "executor": "nx:noop",
      "dependsOn": [
        "format-check",
        "lint",
        "test",
        "doc",
        "budgets"
      ]
    },
    "budgets": {
      "command": "just budgets",
      "dependsOn": [
        "test-rest"
      ],
      "inputs": [
        "crateSource",
        "{workspaceRoot}/budgets.yaml",
        "{workspaceRoot}/scripts/stacked-spikes-budget.mjs",
        "{workspaceRoot}/scripts/linear-writeback-budget.sh"
      ]
    }
  },
  "implicitDependencies": [
    "onepipeline-note-journeys"
  ]
}
