{
  "name": "onepipeline",
  "$schema": "node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "src",
  "tags": [
    "scope:cli",
    "lang:rust"
  ],
  "targets": {
    "bootstrap": {
      "command": "just _crate-bootstrap"
    },
    "build": {
      "command": "just _crate-build",
      "inputs": [
        "crateSource"
      ]
    },
    "format": {
      "command": "just _crate-format"
    },
    "format-check": {
      "command": "just _crate-fmt-check",
      "inputs": [
        "crateSource"
      ]
    },
    "lint": {
      "command": "just _crate-lint",
      "inputs": [
        "crateSource"
      ]
    },
    "coverage-clean": {
      "command": "just _crate-coverage-clean"
    },
    "test-archive": {
      "command": "just _crate-test-archive",
      "dependsOn": [
        "coverage-clean"
      ]
    },
    "test-rest": {
      "command": "just _crate-test-rest",
      "inputs": [
        "crateTestSource"
      ],
      "dependsOn": [
        "test-archive"
      ],
      "outputs": [
        "{workspaceRoot}/target/llvm-cov-target/onepipeline-rest-*.profraw"
      ]
    },
    "test": {
      "command": "just _crate-coverage",
      "inputs": [
        "crateTestSource",
        "e2eSource",
        "contractSource",
        "noteJourneySource"
      ],
      "//": "llmlint: ignore-block[expensive_tests_stay_behind_their_own_edge] the one 95% floor merges every tier's profiles, so this report depends on each tier's `test`. An unchanged tier replays only where the Nx cache is warm: a CI runner starts cold, so there a tier-only change re-runs every tier under this aggregate. That cost is accepted for now because selection stays per tier; restoring the Nx cache in CI is recorded as a follow-up.",
      "dependsOn": [
        "test-rest",
        {
          "projects": [
            "onepipeline-e2e",
            "onepipeline-contract",
            "onepipeline-note-journeys"
          ],
          "target": "test"
        }
      ],
      "//end": "llmlint: ignore-end[expensive_tests_stay_behind_their_own_edge]"
    },
    "test-quick-archive": {
      "command": "just _crate-test-quick-archive"
    },
    "test-quick": {
      "command": "just _crate-test-quick",
      "inputs": [
        "crateTestSource"
      ],
      "dependsOn": [
        "test-quick-archive"
      ],
      "parallelism": false
    },
    "doc": {
      "command": "just _crate-doc",
      "inputs": [
        "crateSource"
      ]
    },
    "lint-llm-diff": {
      "command": "bash scripts/llmlint-judge.sh",
      "options": {
        "cwd": "."
      },
      "outputs": [
        "{workspaceRoot}/.lint-llm-diff/verdict"
      ]
    },
    "check": {
      "executor": "nx:noop",
      "dependsOn": [
        "format-check",
        "lint",
        "test",
        "doc",
        "budgets"
      ]
    },
    "budgets": {
      "command": "just budgets",
      "//": "llmlint: ignore-block[expensive_tests_stay_behind_their_own_edge] the stacked-spikes budget reads the record the e2e tier writes, so it runs after that tier, as it ran after `test-rest` when that target held the e2e binary. The edge is narrower than before the split, and the same warm-cache replay and cold-CI cost apply as for `test` above. The stop-verdict budgets read the records `onepipeline-stop-verdict:test` writes, so they follow that producing tier the same way; Nx restores its records, invocation manifest and producing binary together, and the reader refuses any that disagree.",
      "dependsOn": [
        {
          "projects": [
            "onepipeline-e2e",
            "onepipeline-stop-verdict"
          ],
          "target": "test"
        }
      ],
      "//end": "llmlint: ignore-end[expensive_tests_stay_behind_their_own_edge]",
      "inputs": [
        "e2eSource",
        "{workspaceRoot}/budgets.yaml",
        "{workspaceRoot}/scripts/stacked-spikes-budget.mjs",
        "{workspaceRoot}/package-lock.json",
        "{workspaceRoot}/scripts/linear-writeback-budget.sh",
        "{workspaceRoot}/scripts/stop-guard-unpublished-*",
        "{workspaceRoot}/tests/stop_verdict/**/*",
        "{workspaceRoot}/tests/golden/**/*",
        "{workspaceRoot}/tests/recorded/registry/**/*",
        "{workspaceRoot}/tests/recorded/run-root/onemessagebus-repair-2/**/*",
        {
          "dependentTasksOutputFiles": "target/budget-records/**/*",
          "transitive": false
        }
      ]
    },
    "msrv": {
      "command": "just _crate-msrv",
      "inputs": [
        "crateSource"
      ]
    },
    "deps-check": {
      "command": "just _crate-deps-check",
      "inputs": [
        "rustBuild",
        "{workspaceRoot}/deny.toml"
      ]
    }
  },
  "//": "llmlint: ignore[expensive_tests_stay_behind_their_own_edge] project selection stays per tier — a change only one tier reads selects that tier and this crate, never a sibling tier (npm/test/workspace-nx.test.mjs drives it). This edge is what makes ci.yml's `changes` answer `true` for a tier-only change, so `cross`, `msrv`, `deny`, `install` and `wheel` still run on it.",
  "implicitDependencies": [
    "onepipeline-note-journeys",
    "onepipeline-e2e",
    "onepipeline-contract",
    "onepipeline-smoke",
    "onepipeline-release-compat",
    "onepipeline-stop-verdict"
  ]
}
