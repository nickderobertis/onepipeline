{
  "name": "onepipeline-modularization",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "scripts/modularization",
  "tags": [
    "scope:research",
    "lang:js"
  ],
  "targets": {
    "bootstrap": {
      "executor": "nx:noop"
    },
    "build": {
      "executor": "nx:noop"
    },
    "format": {
      "command": "node node_modules/@biomejs/biome/bin/biome format --write scripts/modularization"
    },
    "test": {
      "command": "node scripts/modularization/pinned.mjs",
      "inputs": [
        "default",
        "{workspaceRoot}/scripts/crate-split-replay.mjs",
        "{workspaceRoot}/scripts/crate-split/**/*",
        "{workspaceRoot}/docs/modularization-design.md",
        "{workspaceRoot}/docs/modularization-target-layout.md",
        "{workspaceRoot}/docs/modularization-command-replay.md",
        "{workspaceRoot}/docs/modularization-test-split.md"
      ]
    },
    "lint": {
      "command": "node node_modules/@biomejs/biome/bin/biome lint scripts/modularization",
      "inputs": [
        "default",
        "{workspaceRoot}/biome.json"
      ]
    },
    "format-check": {
      "command": "node node_modules/@biomejs/biome/bin/biome format scripts/modularization",
      "inputs": [
        "default",
        "{workspaceRoot}/biome.json"
      ]
    },
    "check": {
      "executor": "nx:noop",
      "dependsOn": [
        "format-check",
        "lint",
        "test"
      ]
    }
  }
}
