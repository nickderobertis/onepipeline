{
  "//": "Today's shape, as nx.json's rustBuild and e2eSource state it: one crate, and the whole e2e binary as one suite.",
  "shared": [
    "Cargo.toml",
    "Cargo.lock",
    "rust-toolchain.toml",
    ".cargo/config.toml",
    ".config/nextest.toml",
    "nx.json",
    "package.json",
    "package-lock.json",
    "justfile"
  ],
  "sources": [
    "src/**",
    "crates/**",
    "schemas/**"
  ],
  "fallback": "onepipeline",
  "crates": {
    "onepipeline": {
      "paths": [
        "src/**",
        "crates/**",
        "schemas/**"
      ],
      "deps": []
    }
  },
  "suites": {
    "e2e": {
      "paths": [
        "tests/e2e/**",
        "tests/golden/**",
        "tests/recorded/**",
        "docs/**",
        "examples/**",
        "graphs/**",
        "personas/**",
        "scripts/stacked-spikes-budget.mjs",
        "scripts/record-channel-answers.sh",
        "oneharness.toml",
        "clippy.toml",
        "rustfmt.toml"
      ],
      "crates": [
        "onepipeline"
      ],
      "modules": [
        "adoption",
        "agents",
        "amend",
        "ask",
        "boundary",
        "branch_template",
        "bus_config",
        "cancellation",
        "change_telemetry",
        "channel",
        "checkpoint",
        "compatibility",
        "concurrency",
        "continuation",
        "criteria",
        "criteria_rule",
        "crossdag",
        "delivers",
        "destination",
        "dispatch",
        "dispatch_env_hook",
        "draft_lifecycle",
        "driver",
        "driver_exit",
        "envelope_reviewer",
        "filter",
        "flow",
        "harness",
        "holds",
        "host_view",
        "journal",
        "landing",
        "layout_document",
        "lifecycle",
        "linear_loopback",
        "linear_writeback",
        "listing",
        "live_edit",
        "loopcost",
        "maintenance",
        "malformed_envelopes",
        "manager_landings",
        "multi_source",
        "node_validator",
        "older_launch_record",
        "out_of_band",
        "plan",
        "plan_check",
        "profiling",
        "publication_boundary",
        "publish_preserve",
        "readjust",
        "real_vcs",
        "recorded_channel",
        "retirement",
        "review",
        "rework",
        "run_end_hooks",
        "run_ending",
        "scratch",
        "session",
        "session_reuse",
        "shipped",
        "shutdown",
        "stacked_drafts",
        "stop_guard",
        "store",
        "summary",
        "surface",
        "templates",
        "turns",
        "unpublished",
        "unreadable_sessions",
        "unwatched",
        "views",
        "wake_budget",
        "watch",
        "writeback_budget",
        "writeback_cost",
        "writeback_projections"
      ]
    }
  }
}
