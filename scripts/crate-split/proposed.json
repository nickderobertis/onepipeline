  "//": "The proposed split. Crates: onepipeline-sys is the five src modules outside the one dependency cycle the other 68 form; onepipeline-core is that cycle; onepipeline is the binary; onepipeline-testfakes is the doubles. Every e2e suite drives the compiled binary, so it exercises the binary crate and through it every crate. The e2e binary splits into the suites below, each with the module files its binary compiles \u2014 its own and those they reach through `crate::<module>::` \u2014 and the runtime files they read; the harness and what it reads are every suite's.",
  "shared": [
    "Cargo.toml",
    "Cargo.lock",
    "rust-toolchain.toml",
    ".cargo/config.toml",
    ".config/nextest.toml",
    "nx.json",
    "package.json",
    "package-lock.json",
    "justfile"
  ],
  "sources": [
    "src/**",
    "crates/**",
    "schemas/**"
  ],
  "fallback": "onepipeline-core",
  "crates": {
    "onepipeline-sys": {
      "paths": [
        "src/sys.rs",
        "src/error.rs",
        "src/refusal.rs",
        "src/rendercost.rs",
        "src/hostphases.rs"
      ],
      "deps": []
    },
    "onepipeline-core": {
      "paths": [
        "src/**",
        "schemas/**"
      ],
      "deps": [
        "onepipeline-sys"
      ]
    },
    "onepipeline": {
      "paths": [
        "src/main.rs"
      ],
      "deps": [
        "onepipeline-core",
        "onepipeline-testfakes"
      ]
    },
    "onepipeline-testfakes": {
      "paths": [
        "crates/testfakes/**"
      ],
      "deps": []
    }
  },
