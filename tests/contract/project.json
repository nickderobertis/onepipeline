{
  "name": "onepipeline-contract",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "tests/contract",
  "tags": [
    "scope:tests",
    "lang:rust"
  ],
  "targets": {
    "bootstrap": {
      "executor": "nx:noop"
    },
    "build": {
      "command": "just _tier-build contract",
      "inputs": [
        {
          "runtime": "node scripts/nx-recipe-input.mjs _tier-build"
        },
        "contractSource",
        {
          "runtime": "node -p process.platform"
        }
      ]
    },
    "format": {
      "command": "just _tier-format tests/contract.rs"
    },
    "format-check": {
      "command": "just _tier-fmt-check tests/contract.rs",
      "inputs": [
        {
          "runtime": "node scripts/nx-recipe-input.mjs _tier-fmt-check"
        },
        "contractSource",
        {
          "runtime": "node -p process.platform"
        }
      ]
    },
    "lint": {
      "command": "just _tier-lint contract",
      "inputs": [
        {
          "runtime": "node scripts/nx-recipe-input.mjs _tier-lint"
        },
        "contractSource",
        {
          "runtime": "node -p process.platform"
        }
      ]
    },
    "test": {
      "command": "just _contract-test",
      "inputs": [
        "contractSource",
        {
          "runtime": "node -p process.platform"
        }
      ],
      "dependsOn": [
        {
          "projects": [
            "onepipeline"
          ],
          "target": "coverage-clean"
        }
      ],
      "outputs": [
        "{workspaceRoot}/target/llvm-cov-target/onepipeline-contract-*.profraw"
      ],
      "cache": false
    },
    "test-quick": {
      "command": "just _contract-test-quick",
      "inputs": [
        {
          "runtime": "node scripts/nx-recipe-input.mjs _contract-test-quick --variable onetaskgraph-version"
        },
        "contractSource",
        {
          "env": "ONEPIPELINE_TEST_PARTITION"
        },
        {
          "runtime": "node -p process.platform"
        }
      ],
      "dependsOn": [],
      "parallelism": false
    },
    "check": {
      "executor": "nx:noop",
      "dependsOn": [
        "format-check",
        "lint",
        "test"
      ]
    },
    "input-selection": {
      "executor": "nx:noop",
      "cache": false,
      "//": "Selection-only manifest edges: Nx affected ignores runtime inputs. Hashing stays in the version-free runtime inputs of the tasks that run.",
      "inputs": [
        "justfileSelection",
        "cargoSelection",
        "npmSelection"
      ]
    }
  }
}
