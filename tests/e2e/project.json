{
  "name": "onepipeline-e2e",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "tests/e2e",
  "tags": [
    "scope:tests",
    "lang:rust"
  ],
  "targets": {
    "bootstrap": {
      "executor": "nx:noop"
    },
    "build": {
      "command": "just _tier-build e2e",
      "inputs": [
        {
          "runtime": "node scripts/nx-recipe-input.mjs _tier-build"
        },
        "e2eSource",
        {
          "runtime": "node -p process.platform"
        }
      ]
    },
    "format": {
      "command": "just _tier-format tests/e2e/main.rs"
    },
    "format-check": {
      "command": "just _tier-fmt-check tests/e2e/main.rs",
      "inputs": [
        {
          "runtime": "node scripts/nx-recipe-input.mjs _tier-fmt-check"
        },
        "e2eSource",
        {
          "runtime": "node -p process.platform"
        }
      ]
    },
    "lint": {
      "command": "just _tier-lint e2e",
      "inputs": [
        {
          "runtime": "node scripts/nx-recipe-input.mjs _tier-lint"
        },
        "e2eSource",
        {
          "runtime": "node -p process.platform"
        }
      ]
    },
    "test": {
      "command": "just _e2e-test",
      "inputs": [
        "e2eSource",
        {
          "runtime": "node -p process.platform"
        }
      ],
      "dependsOn": [
        {
          "projects": [
            "onepipeline"
          ],
          "target": "coverage-clean"
        }
      ],
      "outputs": [
        "{workspaceRoot}/target/llvm-cov-target/onepipeline-e2e-*.profraw",
        "{workspaceRoot}/target/budget-records/stacked-spikes-stage.json",
        "{workspaceRoot}/target/budget-records/host-view-debug.json",
        "{workspaceRoot}/target/budget-records/review-round-quota.json",
        "{workspaceRoot}/target/budget-records/check-visibility-quota.json",
        "{workspaceRoot}/target/budget-records/store-operations/*.json",
        "{workspaceRoot}/target/test-profile/e2e/*.json"
      ],
      "parallelism": false,
      "cache": false
    },
    "test-quick": {
      "command": "just _e2e-test-quick",
      "inputs": [
        {
          "runtime": "node scripts/nx-recipe-input.mjs _e2e-test-quick --variable onetaskgraph-version"
        },
        "e2eSource",
        {
          "env": "ONEPIPELINE_TEST_PARTITION"
        },
        {
          "runtime": "node -p process.platform"
        }
      ],
      "dependsOn": [],
      "outputs": [
        "{workspaceRoot}/target/test-profile/e2e/*.json"
      ],
      "parallelism": false
    },
    "check": {
      "executor": "nx:noop",
      "dependsOn": [
        "format-check",
        "lint",
        "test"
      ]
    },
    "input-selection": {
      "executor": "nx:noop",
      "cache": false,
      "//": "Selection-only manifest edges: Nx affected ignores runtime inputs. Hashing stays in the version-free runtime inputs of the tasks that run.",
      "inputs": [
        "justfileSelection",
        "cargoSelection",
        "npmSelection"
      ]
    }
  }
}
