{
  "name": "onepipeline-release-compat",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "tests/release_channel",
  "tags": [
    "scope:tests",
    "lang:rust",
    "tier:live"
  ],
  "targets": {
    "bootstrap": {
      "executor": "nx:noop"
    },
    "build": {
      "command": "just _tier-build release_channel",
      "inputs": [
        {
          "runtime": "node scripts/nx-recipe-input.mjs _tier-build"
        },
        "releaseCompatSource",
        {
          "runtime": "node -p process.platform"
        }
      ]
    },
    "format": {
      "command": "just _tier-format tests/release_channel/main.rs"
    },
    "format-check": {
      "command": "just _tier-fmt-check tests/release_channel/main.rs",
      "inputs": [
        {
          "runtime": "node scripts/nx-recipe-input.mjs _tier-fmt-check"
        },
        "releaseCompatSource",
        {
          "runtime": "node -p process.platform"
        }
      ]
    },
    "lint": {
      "command": "just _tier-lint release_channel",
      "inputs": [
        {
          "runtime": "node scripts/nx-recipe-input.mjs _tier-lint"
        },
        "releaseCompatSource",
        {
          "runtime": "node -p process.platform"
        }
      ]
    },
    "release-compat": {
      "command": "just _release-compat-run",
      "//": "After the crate's debug build, which compiles this binary under the same flags, so the journeys find it built rather than compiling it beside the job's other builds; and alone, as its own job ran it: beside test-linux's instrumented tiers its three journeys ran past nextest's 360-second bound (run 41259782580) and pass in seconds re-run alone.",
      "parallelism": false,
      "dependsOn": [
        {
          "projects": [
            "onepipeline"
          ],
          "target": "build"
        }
      ],
      "inputs": [
        "releaseCompatSource",
        {
          "runtime": "node -p process.platform"
        }
      ],
      "cache": false
    },
    "check": {
      "executor": "nx:noop",
      "dependsOn": [
        "format-check",
        "lint"
      ]
    },
    "input-selection": {
      "executor": "nx:noop",
      "cache": false,
      "//": "Selection-only manifest edges: Nx affected ignores runtime inputs. Hashing stays in the version-free runtime inputs of the tasks that run.",
      "inputs": [
        "justfileSelection",
        "cargoSelection",
        "npmSelection"
      ]
    }
  }
}
