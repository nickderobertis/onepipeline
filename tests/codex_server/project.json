{
  "name": "onepipeline-codex-server",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "tests/codex_server",
  "tags": [
    "scope:tests",
    "lang:rust"
  ],
  "targets": {
    "bootstrap": {
      "executor": "nx:noop"
    },
    "build": {
      "command": "just _tier-build codex_server",
      "inputs": [
        "codexServerSource",
        {
          "runtime": "node -p process.platform"
        }
      ]
    },
    "format": {
      "command": "just _tier-format tests/codex_server/main.rs"
    },
    "format-check": {
      "command": "just _tier-fmt-check tests/codex_server/main.rs",
      "inputs": [
        "codexServerSource",
        {
          "runtime": "node -p process.platform"
        }
      ]
    },
    "lint": {
      "command": "just _tier-lint codex_server",
      "inputs": [
        "codexServerSource",
        {
          "runtime": "node -p process.platform"
        }
      ]
    },
    "test": {
      "command": "just _codex-server-test",
      "inputs": [
        "codexServerSource",
        {
          "runtime": "node -p process.platform"
        }
      ],
      "dependsOn": [
        {
          "projects": [
            "onepipeline"
          ],
          "target": "coverage-clean"
        }
      ],
      "outputs": [
        "{workspaceRoot}/target/llvm-cov-target/onepipeline-codex_server-*.profraw"
      ],
      "parallelism": false,
      "cache": false
    },
    "test-quick": {
      "command": "just _codex-server-test-quick",
      "inputs": [
        "codexServerSource",
        {
          "env": "ONEPIPELINE_TEST_PARTITION"
        },
        {
          "runtime": "node -p process.platform"
        }
      ],
      "dependsOn": [],
      "parallelism": false
    },
    "check": {
      "executor": "nx:noop",
      "dependsOn": [
        "format-check",
        "lint",
        "test"
      ]
    },
    "input-selection": {
      "executor": "nx:noop",
      "cache": false,
      "//": "Selection-only manifest edges: Nx affected ignores runtime inputs. Hashing stays in the version-free runtime inputs of the tasks that run.",
      "inputs": [
        "cargoSelection",
        "npmSelection"
      ]
    }
  }
}
