{
  "name": "onepipeline-real-smoke",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "tests/smoke",
  "tags": [
    "scope:tests",
    "lang:rust",
    "tier:live"
  ],
  "targets": {
    "bootstrap": {
      "executor": "nx:noop"
    },
    "build": {
      "command": "just _tier-build smoke",
      "inputs": [
        {
          "runtime": "node scripts/nx-recipe-input.mjs _tier-build"
        },
        "smokeSource",
        {
          "runtime": "node -p process.platform"
        }
      ]
    },
    "format": {
      "command": "just _tier-format tests/smoke/main.rs"
    },
    "format-check": {
      "command": "just _tier-fmt-check tests/smoke/main.rs",
      "inputs": [
        {
          "runtime": "node scripts/nx-recipe-input.mjs _tier-fmt-check"
        },
        "smokeSource",
        {
          "runtime": "node -p process.platform"
        }
      ]
    },
    "lint": {
      "command": "just _tier-lint smoke",
      "inputs": [
        {
          "runtime": "node scripts/nx-recipe-input.mjs _tier-lint"
        },
        "smokeSource",
        {
          "runtime": "node -p process.platform"
        }
      ]
    },
    "smoke": {
      "command": "just _smoke-run",
      "//": "Alone, as the `smoke` job ran it: the journey drives the real GitHub API under nextest's 360-second bound, and beside the instrumented tiers on one runner it ran past that bound.",
      "parallelism": false,
      "inputs": [
        "smokeSource",
        {
          "runtime": "node -p process.platform"
        }
      ],
      "cache": false
    },
    "check": {
      "executor": "nx:noop",
      "dependsOn": [
        "format-check",
        "lint"
      ]
    },
    "input-selection": {
      "executor": "nx:noop",
      "cache": false,
      "//": "Selection-only manifest edges: Nx affected ignores runtime inputs. Hashing stays in the version-free runtime inputs of the tasks that run.",
      "inputs": [
        "justfileSelection",
        "cargoSelection",
        "npmSelection"
      ]
    }
  }
}
