{
  "name": "onepipeline-stop-verdict",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "tests/stop_verdict",
  "tags": [
    "scope:tests",
    "lang:rust",
    "tier:budget"
  ],
  "targets": {
    "bootstrap": {
      "executor": "nx:noop"
    },
    "build": {
      "command": "just _tier-build stop_verdict",
      "inputs": [
        {
          "runtime": "node scripts/nx-recipe-input.mjs _tier-build"
        },
        "rustBuild",
        "{workspaceRoot}/tests/stop_verdict/**/*",
        "{workspaceRoot}/tests/golden/**/*",
        "{workspaceRoot}/tests/recorded/registry/**/*",
        "{workspaceRoot}/clippy.toml",
        "{workspaceRoot}/rustfmt.toml",
        {
          "runtime": "node -p process.platform"
        }
      ]
    },
    "format": {
      "command": "just _tier-format tests/stop_verdict/main.rs"
    },
    "format-check": {
      "command": "just _tier-fmt-check tests/stop_verdict/main.rs",
      "inputs": [
        {
          "runtime": "node scripts/nx-recipe-input.mjs _tier-fmt-check"
        },
        "rustBuild",
        "{workspaceRoot}/tests/stop_verdict/**/*",
        "{workspaceRoot}/tests/golden/**/*",
        "{workspaceRoot}/tests/recorded/registry/**/*",
        "{workspaceRoot}/clippy.toml",
        "{workspaceRoot}/rustfmt.toml",
        {
          "runtime": "node -p process.platform"
        }
      ]
    },
    "lint": {
      "command": "just _tier-lint stop_verdict",
      "inputs": [
        {
          "runtime": "node scripts/nx-recipe-input.mjs _tier-lint"
        },
        "rustBuild",
        "{workspaceRoot}/tests/stop_verdict/**/*",
        "{workspaceRoot}/tests/golden/**/*",
        "{workspaceRoot}/tests/recorded/registry/**/*",
        "{workspaceRoot}/clippy.toml",
        "{workspaceRoot}/rustfmt.toml",
        {
          "runtime": "node -p process.platform"
        }
      ]
    },
    "test-build": {
      "command": "just _stop-verdict-build",
      "//": "The release binary `test` times, built ahead of it and beside the rest of the gate: `test` admits nothing beside it because it times that binary, and compiling it needs no such quiet. Keyed on exactly the uncached `test`'s producing inputs. A matching producer result replays; the timed journey checks and builds its executable through its own recipe before recording it. The debug test binaries `test` runs come from `onepipeline:build`, the other edge `test` declares.",
      "cache": true,
      "inputs": [
        {
          "runtime": "node scripts/nx-recipe-input.mjs _stop-verdict-build"
        },
        "rustBuild",
        "{workspaceRoot}/tests/stop_verdict/**/*",
        "{workspaceRoot}/tests/golden/**/*",
        "{workspaceRoot}/tests/recorded/registry/**/*",
        "{workspaceRoot}/tests/recorded/run-root/onemessagebus-repair-2/**/*",
        "{workspaceRoot}/scripts/stop-guard-unpublished-*",
        "{workspaceRoot}/clippy.toml",
        "{workspaceRoot}/rustfmt.toml",
        {
          "runtime": "node -p process.platform"
        },
        {
          "runtime": "node scripts/nx-version-free-inputs.mjs --ecosystem cargo --keep-version"
        }
      ],
      "outputs": []
    },
    "test": {
      "command": "just stop-verdict-journeys",
      "//": "llmlint: ignore-block[expensive_tests_stay_behind_their_own_edge] this tier times the release binary, so its inputs are what that binary is built from and nothing narrower: the budget reader refuses a record whose build fingerprint (scripts/stop-guard-unpublished-build-inputs.json, the same set) differs from the tree, and the cached producer uses this same input set. A module left out of both would let a changed binary be judged by an old one's timings. The timed tier itself stays uncached because its record requires the producing executable.",
      "inputs": [
        "rustBuild",
        "{workspaceRoot}/tests/stop_verdict/**/*",
        "{workspaceRoot}/tests/golden/**/*",
        "{workspaceRoot}/tests/recorded/registry/**/*",
        "{workspaceRoot}/tests/recorded/run-root/onemessagebus-repair-2/**/*",
        "{workspaceRoot}/scripts/stop-guard-unpublished-*",
        "{workspaceRoot}/clippy.toml",
        "{workspaceRoot}/rustfmt.toml",
        {
          "runtime": "node -p process.platform"
        },
        {
          "runtime": "node scripts/nx-version-free-inputs.mjs --ecosystem cargo --keep-version"
        }
      ],
      "//end": "llmlint: ignore-end[expensive_tests_stay_behind_their_own_edge]",
      "outputs": [
        "{workspaceRoot}/target/budget-records/stop-guard-unpublished.json",
        "{workspaceRoot}/target/budget-records/stop-guard-unpublished-invocation.json",
        "{workspaceRoot}/target/budget-records/stop-guard-unpublished-onepipeline"
      ],
      "dependsOn": [
        "test-build",
        {
          "projects": [
            "onepipeline"
          ],
          "target": "build"
        }
      ],
      "parallelism": false,
      "cache": false
    },
    "check": {
      "executor": "nx:noop",
      "dependsOn": [
        "format-check",
        "lint",
        "test"
      ]
    },
    "input-selection": {
      "executor": "nx:noop",
      "cache": false,
      "//": "Selection-only manifest edges: Nx affected ignores runtime inputs. Hashing stays in the version-free runtime inputs of the tasks that run.",
      "inputs": [
        "justfileSelection",
        "cargoSelection",
        "npmSelection"
      ]
    }
  }
}
