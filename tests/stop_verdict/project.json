{
  "name": "onepipeline-stop-verdict",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "tests/stop_verdict",
  "tags": [
    "scope:tests",
    "lang:rust",
    "tier:budget"
  ],
  "targets": {
    "bootstrap": {
      "executor": "nx:noop"
    },
    "build": {
      "command": "just _tier-build stop_verdict",
      "inputs": [
        {
          "runtime": "node scripts/nx-recipe-input.mjs _tier-build"
        },
        "rustBuild",
        "{workspaceRoot}/tests/stop_verdict/**/*",
        "{workspaceRoot}/tests/golden/**/*",
        "{workspaceRoot}/tests/recorded/registry/**/*",
        "{workspaceRoot}/clippy.toml",
        "{workspaceRoot}/rustfmt.toml",
        {
          "runtime": "node -p process.platform"
        }
      ]
    },
    "format": {
      "command": "just _tier-format tests/stop_verdict/main.rs"
    },
    "format-check": {
      "command": "just _tier-fmt-check tests/stop_verdict/main.rs",
      "inputs": [
        {
          "runtime": "node scripts/nx-recipe-input.mjs _tier-fmt-check"
        },
        "rustBuild",
        "{workspaceRoot}/tests/stop_verdict/**/*",
        "{workspaceRoot}/tests/golden/**/*",
        "{workspaceRoot}/tests/recorded/registry/**/*",
        "{workspaceRoot}/clippy.toml",
        "{workspaceRoot}/rustfmt.toml",
        {
          "runtime": "node -p process.platform"
        }
      ]
    },
    "lint": {
      "command": "just _tier-lint stop_verdict",
      "inputs": [
        {
          "runtime": "node scripts/nx-recipe-input.mjs _tier-lint"
        },
        "rustBuild",
        "{workspaceRoot}/tests/stop_verdict/**/*",
        "{workspaceRoot}/tests/golden/**/*",
        "{workspaceRoot}/tests/recorded/registry/**/*",
        "{workspaceRoot}/clippy.toml",
        "{workspaceRoot}/rustfmt.toml",
        {
          "runtime": "node -p process.platform"
        }
      ]
    },
    "test": {
      "command": "just _stop-verdict-counts",
      "//": "llmlint: ignore-block[expensive_tests_stay_behind_their_own_edge] this tier counts what the binary does on every call the stop hook makes, so its inputs are everything that binary is built from and nothing narrower: a module left out would let a change that moves a count replay an old pass. It times nothing, builds no release binary and runs beside the gate; its debug test binary is the tree `onepipeline:build` builds under the same flags.",
      "inputs": [
        {
          "runtime": "node scripts/nx-recipe-input.mjs _stop-verdict-counts"
        },
        "rustBuild",
        "{workspaceRoot}/justfile",
        "{workspaceRoot}/tests/stop_verdict/**/*",
        "{workspaceRoot}/tests/golden/**/*",
        "{workspaceRoot}/tests/recorded/registry/**/*",
        "{workspaceRoot}/tests/recorded/run-root/onemessagebus-repair-2/**/*",
        "{workspaceRoot}/scripts/stop-guard-unpublished-*",
        "{workspaceRoot}/clippy.toml",
        "{workspaceRoot}/rustfmt.toml",
        {
          "runtime": "node -p process.platform"
        },
        {
          "runtime": "node scripts/nx-version-free-inputs.mjs --ecosystem cargo --keep-version"
        }
      ],
      "//end": "llmlint: ignore-end[expensive_tests_stay_behind_their_own_edge]",
      "dependsOn": [
        {
          "projects": [
            "onepipeline"
          ],
          "target": "build"
        }
      ]
    },
    "timed": {
      "command": "just _stop-verdict-timed",
      "//": "The timing budgets' journey, which only `scripts/ci-job.sh timed` selects, on a push to main: it builds and times the release binary, writes `target/budget-records/stop-guard-unpublished*`, and checks the stop-verdict timing budgets from that record. Uncached, because its record requires the producing executable, and alone, because it times.",
      "cache": false,
      "parallelism": false
    },
    "check": {
      "executor": "nx:noop",
      "dependsOn": [
        "format-check",
        "lint",
        "test"
      ]
    },
    "input-selection": {
      "executor": "nx:noop",
      "cache": false,
      "//": "Selection-only manifest edges: Nx affected ignores runtime inputs. Hashing stays in the version-free runtime inputs of the tasks that run.",
      "inputs": [
        "justfileSelection",
        "cargoSelection",
        "npmSelection"
      ]
    }
  }
}
