{
  "name": "human-items-e2e",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "tests/human_items",
  "tags": [
    "scope:tests",
    "lang:rust",
    "tier:budget"
  ],
  "targets": {
    "bootstrap": {
      "executor": "nx:noop"
    },
    "build": {
      "command": "just _tier-build human_items_workload",
      "inputs": [
        {
          "runtime": "node scripts/nx-recipe-input.mjs _tier-build"
        },
        "rustBuild",
        "{workspaceRoot}/tests/human_items/**/*",
        "{workspaceRoot}/tests/e2e/harness.rs",
        "{workspaceRoot}/clippy.toml",
        "{workspaceRoot}/rustfmt.toml",
        {
          "runtime": "node -p process.platform"
        }
      ]
    },
    "format": {
      "command": "just _tier-format tests/human_items/main.rs"
    },
    "format-check": {
      "command": "just _tier-fmt-check tests/human_items/main.rs",
      "inputs": [
        {
          "runtime": "node scripts/nx-recipe-input.mjs _tier-fmt-check"
        },
        "rustBuild",
        "{workspaceRoot}/tests/human_items/**/*",
        "{workspaceRoot}/rustfmt.toml",
        {
          "runtime": "node -p process.platform"
        }
      ]
    },
    "lint": {
      "command": "just _tier-lint human_items_workload",
      "inputs": [
        {
          "runtime": "node scripts/nx-recipe-input.mjs _tier-lint"
        },
        "rustBuild",
        "{workspaceRoot}/tests/human_items/**/*",
        "{workspaceRoot}/tests/e2e/harness.rs",
        "{workspaceRoot}/clippy.toml",
        "{workspaceRoot}/rustfmt.toml",
        {
          "runtime": "node -p process.platform"
        }
      ]
    },
    "check": {
      "executor": "nx:noop",
      "dependsOn": [
        "format-check",
        "lint",
        "test"
      ]
    },
    "test": {
      "command": "just human-items-budget",
      "dependsOn": [
        "build"
      ],
      "inputs": [
        "rustBuild",
        "{workspaceRoot}/tests/human_items/**/*",
        "{workspaceRoot}/tests/e2e/harness.rs",
        "{workspaceRoot}/clippy.toml",
        "{workspaceRoot}/rustfmt.toml",
        {
          "runtime": "node -p process.platform"
        }
      ],
      "parallelism": false,
      "cache": false,
      "outputs": [
        "{workspaceRoot}/target/budget-records/human-items.json"
      ]
    },
    "input-selection": {
      "executor": "nx:noop",
      "cache": false,
      "//": "Selection-only manifest edges: Nx affected ignores runtime inputs. Hashing stays in the version-free runtime inputs of the tasks that run.",
      "inputs": [
        "justfileSelection",
        "cargoSelection",
        "npmSelection"
      ]
    }
  }
}
