{
  "name": "onepipeline-coverage-cache",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "tests/coverage_cache",
  "tags": ["scope:tests", "lang:js"],
  "targets": {
    "bootstrap": {
      "executor": "nx:noop"
    },
    "build": {
      "executor": "nx:noop"
    },
    "format": {
      "command": "node node_modules/@biomejs/biome/bin/biome format --write tests/coverage_cache"
    },
    "format-check": {
      "command": "node node_modules/@biomejs/biome/bin/biome format tests/coverage_cache"
    },
    "lint": {
      "command": "node node_modules/@biomejs/biome/bin/biome lint tests/coverage_cache"
    },
    "test": {
      "command": "node --test --test-concurrency=2 tests/coverage_cache/*.test.mjs",
      "//": "Real Nx over a scratch copy of this graph, a small crate in place of the Rust code: what replays, what merges and what refuses. Linux only, as `onepipeline:test` is. Keyed on what those journeys read.",
      "inputs": [
        "{projectRoot}/**/*",
        "{workspaceRoot}/nx.json",
        "{workspaceRoot}/**/project.json",
        "{workspaceRoot}/justfile",
        "{workspaceRoot}/scripts/coverage-unit.sh",
        "{workspaceRoot}/scripts/coverage-merge.mjs",
        "{workspaceRoot}/scripts/coverage-tiers.mjs",
        "{workspaceRoot}/scripts/nx.sh",
        "{workspaceRoot}/scripts/nx-recipe-input.mjs",
        "{workspaceRoot}/scripts/nx-version-free-inputs.mjs",
        "{workspaceRoot}/scripts/ensure-test-archive.sh",
        "{workspaceRoot}/.config/nextest.toml",
        "{workspaceRoot}/.cargo/config.toml",
        "{workspaceRoot}/rust-toolchain.toml",
        "sharedGlobals",
        {
          "runtime": "node -p process.platform"
        }
      ]
    },
    "check": {
      "executor": "nx:noop",
      "dependsOn": ["format-check", "lint", "test"]
    },
    "input-selection": {
      "executor": "nx:noop",
      "cache": false,
      "//": "Selection-only manifest edges: Nx affected ignores runtime inputs. Hashing stays in the version-free runtime inputs of the tasks that run.",
      "inputs": ["justfileSelection", "npmSelection"]
    }
  }
}
