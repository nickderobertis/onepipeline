{
  "schema_version": 3,
  "filters": {
    "agentgraph": {
      "exclude": [
        {
          "kind": "turn-activity"
        }
      ]
    },
    "vcs": {
      "include": [
        {
          "kind": "gate-*"
        },
        {
          "kind": "session-closed"
        }
      ]
    },
    "profiles": {
      "monitor": {},
      "planner": {
        "include": [
          {
            "source": "pipeline"
          }
        ]
      }
    }
  },
  "pr_author_graph": "./graphs/pr-author.yaml",
  "node_validator": "./scripts/check-node.sh"
}
