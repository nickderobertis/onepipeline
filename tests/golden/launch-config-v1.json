{
  "schema_version": 1,
  "filters": {
    "agentgraph": {
      "exclude": [
        {
          "kind": "turn-activity"
        }
      ]
    },
    "vcs": {
      "include": [
        {
          "kind": "gate-*"
        },
        {
          "kind": "session-closed"
        }
      ]
    },
    "profiles": {
      "detailed": {},
      "planner": {
        "include": [
          {
            "source": "pipeline"
          }
        ]
      }
    }
  }
}
