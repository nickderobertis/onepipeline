{
  "name": "github-workflows",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "tags": ["scope:tooling", "lang:js"],
  "targets": {
    "bootstrap": {
      "command": "bash .github/bootstrap.sh",
      "cache": false
    },
    "test": {
      "command": "node --test .github/tests/*.test.mjs",
      "cache": false,
      "inputs": [
        "{projectRoot}/**/*",
        "{workspaceRoot}/screencomp.toml",
        "{workspaceRoot}/scripts/build-staged-release.py",
        "{workspaceRoot}/release/release.py",
        "{workspaceRoot}/scripts/npm-build.mjs",
        "{workspaceRoot}/release-targets.toml",
        "{workspaceRoot}/justfile",
        "{workspaceRoot}/budgets.yaml",
        {
          "runtime": "node scripts/nx-version-free-inputs.mjs --ecosystem npm"
        },
        "{workspaceRoot}/scripts/actions-budget-figures.sh",
        "{workspaceRoot}/scripts/gate-time.sh",
        "{workspaceRoot}/scripts/gate-time-budget.mjs",
        {
          "runtime": "node scripts/nx-version-free-inputs.mjs --ecosystem cargo"
        },
        "{workspaceRoot}/tests/ci_workflows.rs",
        "sharedGlobals",
        {
          "runtime": "node -p process.platform"
        }
      ],
      "outputs": ["{projectRoot}/.telemetry/macos-policy.json"]
    },
    "test-ci-shape": {
      "command": "node --test .github/ci-shape/*.test.mjs",
      "//": "Hash and test-selection journeys read the entire workspace: the runtime digest binds a replay to it, version edits excluded. The named files decide which changes select this proof, because Nx's affected selection reads a file input as a project touch, and so a workspace-wide glob here would select it for every change.",
      "cache": true,
      "inputs": [
        "{projectRoot}/**/*",
        "{workspaceRoot}/screencomp.toml",
        "{workspaceRoot}/scripts/nx-remote-cache.mjs",
        "{workspaceRoot}/scripts/nx-version-free-inputs.mjs",
        "{workspaceRoot}/scripts/actions-budget-figures.sh",
        "{workspaceRoot}/budgets.yaml",
        "sharedGlobals",
        {
          "runtime": "node -p process.platform"
        },
        {
          "runtime": "node .github/workspace-proof-input.mjs"
        },
        "{workspaceRoot}/nx.json",
        "{workspaceRoot}/**/project.json",
        "{workspaceRoot}/justfile",
        "{workspaceRoot}/rust-toolchain.toml",
        "{workspaceRoot}/scripts/ensure-test-archive.sh",
        {
          "runtime": "node scripts/nx-version-free-inputs.mjs --ecosystem cargo"
        },
        {
          "runtime": "node scripts/nx-version-free-inputs.mjs --ecosystem npm"
        },
        {
          "runtime": "node scripts/nx-version-free-inputs.mjs --ecosystem python"
        },
        "{workspaceRoot}/tests/contract.rs",
        "{workspaceRoot}/tests/e2e/surface.rs",
        "{workspaceRoot}/tests/package_bundle.rs"
      ],
      "outputs": []
    },
    "lint": {
      "command": "node node_modules/@biomejs/biome/bin/biome lint .github",
      "inputs": [
        "default",
        "{workspaceRoot}/biome.jsonc",
        {
          "runtime": "node -p process.platform"
        }
      ]
    },
    "syntax-check": {
      "command": "bash -c 'for file in .github/*.mjs .github/tests/*.mjs .github/ci-shape/*.mjs; do node --check \"$file\" || exit; done'"
    },
    "budgets": {
      "command": "bash .github/check-budgets.sh",
      "dependsOn": ["test"],
      "cache": false
    },
    "check": {
      "executor": "nx:noop",
      "dependsOn": ["format-check", "lint", "syntax-check", "budgets", "test-ci-shape"]
    },
    "format-check": {
      "command": "node node_modules/@biomejs/biome/bin/biome format .github",
      "inputs": [
        "default",
        "{workspaceRoot}/biome.jsonc",
        {
          "runtime": "node -p process.platform"
        }
      ]
    },
    "format": {
      "command": "node node_modules/@biomejs/biome/bin/biome format --write .github"
    },
    "build": {
      "executor": "nx:noop",
      "dependsOn": ["syntax-check"]
    },
    "input-selection": {
      "executor": "nx:noop",
      "cache": false,
      "//": "Selection-only manifest edges: Nx affected ignores runtime inputs. Hashing stays in the version-free runtime inputs of the tasks that run.",
      "inputs": ["cargoSelection", "npmSelection", "pythonSelection"]
    }
  }
}
