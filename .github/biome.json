{
  "$schema": "../node_modules/@biomejs/biome/configuration_schema.json",
  "root": false,
  "files": {
    "includes": [
      "*.mjs",
      "tests/*.mjs",
      "tests/support/*.mjs",
      "package.json",
      "project.json"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "rules": {
      "recommended": true
    }
  },
  "assist": {
    "enabled": false
  },
  "extends": [
    "../biome.json"
  ]
}
