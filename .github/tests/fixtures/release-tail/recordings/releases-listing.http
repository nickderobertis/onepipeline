pi.github.com/users/github-actions%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/github-actions%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/github-actions%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/github-actions%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/github-actions%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/github-actions%5Bbot%5D/repos","events_url":"https://api.github.com/users/github-actions%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/github-actions%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"content_type":"application/octet-stream","state":"uploaded","size":615,"digest":"sha256:3a21b0ef564ad88e71ecb8ee07f34b3e0e71203c8c34f02843a9cee20b687415","download_count":2,"created_at":"2026-10-28T06:09:52Z","updated_at":"2026-10-28T06:09:52Z","browser_download_url":"https://github.com/nickderobertis/onepipeline/releases/download/v0.95.4/release-outcome.json"}],"tarball_url":"https://api.github.com/repos/nickderobertis/onepipeline/tarball/v0.95.4","zipball_url":"https://api.github.com/repos/nickderobertis/onepipeline/zipball/v0.95.4","body":"### Fixed\n\n- *(npm)* make the npm-installed onepipeline command become the engine process instead of running it as a child ([#1240](https://github.com/nickderobertis/onepipeline/pull/1240))\n\n<!-- linked-engines -->\n### Linked engines\n\nThe sibling engines this release actually links, resolved from its own `Cargo.lock`:\n\n| Engine | Linked | Requirement | Newest the requirement permits |\n| --- | --- | --- | --- |\n| `oneagentgraph` | 0.9.0 | `0.9.0` | 0.9.0 |\n| `onevcs` | 0.57.0 | `0.57.0` | 0.57.0 |\n| `onevcs-testing` | 0.19.22 | `0.19.22` | 0.19.22 |\n| `onejudge` | 0.22.0 | `0.22.0` | 0.22.0 |\n| `oneharness-core` | 0.29.1 | `0.29.1` | 0.29.1 |\n| `onetaskgraph-core` | 0.12.7 | `=0.12.7` | 0.12.7 |\n| `onetaskgraph-plugin-api` | 0.12.7 | `=0.12.7` | 0.12.7 |\n| `onetaskgraph-local-md` | 0.12.7 | `=0.12.7` | 0.12.7 |\n| `onemessagebus` | 0.9.4 | `0.9.3` | 0.9.4 |\n| `onebudgetspec-core` | 0.1.5 | `=0.1.5` | 0.1.5 |\n\nEvery linked engine is the newest its own requirement permits.\n"},{"url":"https://api.github.com/repos/nickderobertis/onepipeline/releases/425626879","assets_url":"https://api.github.com/repos/nickderobertis/onepipeline/releases/425626879/assets","upload_url":"https://uploads.github.com/repos/nickderobertis/onepipeline/releases/425626879/assets{?name,label}","html_url":"https://github.com/nickderobertis/onepipeline/releases/tag/v0.95.3","id":425626879,"author":{"login":"nickderobertis","id":19440155,"node_id":"MDQ6VXNlcjE5NDQwMTU1","avatar_url":"https://avatars.githubusercontent.com/u/19440155?v=4","gravatar_id":"","url":"https://api.github.com/users/nickderobertis","html_url":"https://github.com/nickderobertis","followers_url":"https://api.github.com/users/nickderobertis/followers","following_url":"https://api.github.com/users/nickderobertis/following{/other_user}","gists_url":"https://api.github.com/users/nickderobertis/gists{/gist_id}","starred_url":"https://api.github.com/users/nickderobertis/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nickderobertis/subscriptions","organizations_url":"https://api.github.com/users/nickderobertis/orgs","repos_url":"https://api.github.com/users/nickderobertis/repos","events_url":"https://api.github.com/users/nickderobertis/events{/privacy}","received_events_url":"https://api.github.com/users/nickderobertis/received_events","type":"User","user_view_type":"public","site_admin":false},"node_id":"RE_kwDOTx8aUc4ZXoz_","tag_name":"v0.95.3","target_commitish":"main","name":"v0.95.3","draft":false,"immutable":false,"prerelease":false,"created_at":"2026-10-27T15:17:05Z","updated_at":"2026-10-27T15:56:46Z","published_at":"2026-10-27T15:17:07Z","assets":[{"url":"https://api.github.com/repos/nickderob