com/apps/github-actions","followers_url":"https://api.github.com/users/github-actions%5Bbot%5D/followers","following_url":"https://api.github.com/users/github-actions%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/github-actions%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/github-actions%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/github-actions%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/github-actions%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/github-actions%5Bbot%5D/repos","events_url":"https://api.github.com/users/github-actions%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/github-actions%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"content_type":"application/octet-stream","state":"uploaded","size":616,"digest":"sha256:0bc7a8d85a28b32c8d2b5f261d4f89180b412c50f14a83fd6865864d15b20d78","download_count":1,"created_at":"2026-10-22T12:16:10Z","updated_at":"2026-10-22T12:16:11Z","browser_download_url":"https://github.com/nickderobertis/onepipeline/releases/download/v0.84.0/release-outcome.json"}],"tarball_url":"https://api.github.com/repos/nickderobertis/onepipeline/tarball/v0.84.0","zipball_url":"https://api.github.com/repos/nickderobertis/onepipeline/zipball/v0.84.0","body":"### Added\n\n- [**breaking**] record run labels and the project each run belongs to, and let them be set later ([#1100](https://github.com/nickderobertis/onepipeline/pull/1100))\n\n<!-- linked-engines -->\n### Linked engines\n\nThe sibling engines this release actually links, resolved from its own `Cargo.lock`:\n\n| Engine | Linked | Requirement | Newest the requirement permits |\n| --- | --- | --- | --- |\n| `oneagentgraph` | **0.7.0** | `0.7.0` | **0.7.1** — this release is behind it |\n| `onevcs` | **0.56.3** | `0.56.3` | **0.56.5** — this release is behind it |\n| `onevcs-testing` | **0.19.13** | `0.19.13` | **0.19.15** — this release is behind it |\n| `onejudge` | 0.20.0 | `0.20.0` | 0.20.0 |\n| `oneharness-core` | **0.28.7** | `0.28.5` | **0.28.8** — this release is behind it |\n| `onetaskgraph-core` | 0.9.2 | `=0.9.2` | 0.9.2 |\n| `onetaskgraph-plugin-api` | 0.9.2 | `=0.9.2` | 0.9.2 |\n| `onetaskgraph-local-md` | 0.9.2 | `=0.9.2` | 0.9.2 |\n| `onemessagebus` | 0.9.3 | `0.9.3` | 0.9.3 |\n| `onebudgetspec-core` | 0.1.5 | `=0.1.5` | 0.1.5 |\n\n> [!WARNING]\n> This release links an engine **older than its own requirement permits**, so reading\n> `Cargo.toml` overstates what this build contains:\n>\n> - `oneagentgraph` links 0.7.0; the requirement already permitted 0.7.1.\n> - `onevcs` links 0.56.3; the requirement already permitted 0.56.5.\n> - `onevcs-testing` links 0.19.13; the requirement already permitted 0.19.15.\n> - `oneharness-core` links 0.28.7; the requirement already permitted 0.28.8.\n"},{"url":"https://api.github.com/repos/nickderobertis/onepipeline/releases/420279135","assets_url":"https://api.github.com/repos/nickderobertis/onepipeline/releases/420279135/assets","upload_url":"https://uploads.github.com/repos/nickderobertis/onepipeline/releases/420279135/assets{?name,label}","html_url":"https://github.com/nickderobertis/onepipeline/releases/tag/v0.83.0","id":420279135,"author":{"login":"nickderobertis","id":19440155,"node_id":"MDQ6VXNlcjE5NDQwMTU1","avatar_url":"https://avatars.githubusercontent.com/u/19440155?v=4","gravatar_id":"","url":"https://api.github.com/users/nickderobertis","html_url":"https://github.com/nickderobertis","followers_url":"https://api.github.com/users/nickderobertis/followers","following_url":"https://api.github.com/users/nickderobertis/following{/other_user}","gists_url":"https://api.github.com/users/nickderobertis/gists{/gist_id}","starred_url":"https://api.github.com/users/nickderobertis/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nickderobertis/subscriptions","organizations_url