//avatars.githubusercontent.com/in/15368?v=4","gravatar_id":"","url":"https://api.github.com/users/github-actions%5Bbot%5D","html_url":"https://github.com/apps/github-actions","followers_url":"https://api.github.com/users/github-actions%5Bbot%5D/followers","following_url":"https://api.github.com/users/github-actions%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/github-actions%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/github-actions%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/github-actions%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/github-actions%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/github-actions%5Bbot%5D/repos","events_url":"https://api.github.com/users/github-actions%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/github-actions%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"content_type":"application/octet-stream","state":"uploaded","size":615,"digest":"sha256:50f955d51d8817726bfa83a40ee0f828b0df692ce7873644c933f8a8a9018d10","download_count":1,"created_at":"2026-10-27T15:56:46Z","updated_at":"2026-10-27T15:56:46Z","browser_download_url":"https://github.com/nickderobertis/onepipeline/releases/download/v0.95.3/release-outcome.json"}],"tarball_url":"https://api.github.com/repos/nickderobertis/onepipeline/tarball/v0.95.3","zipball_url":"https://api.github.com/repos/nickderobertis/onepipeline/zipball/v0.95.3","body":"### Fixed\n\n- *(tests)* make the settled-from-evidence adoption journey deterministic on Windows ([#1234](https://github.com/nickderobertis/onepipeline/pull/1234))\n\n### Performance\n\n- *(deps)* link the store that batches private-source copies ([#1236](https://github.com/nickderobertis/onepipeline/pull/1236))\n- *(driver)* hold the combined driver's cost flat across journal sizes ([#1230](https://github.com/nickderobertis/onepipeline/pull/1230))\n\n<!-- linked-engines -->\n### Linked engines\n\nThe sibling engines this release actually links, resolved from its own `Cargo.lock`:\n\n| Engine | Linked | Requirement | Newest the requirement permits |\n| --- | --- | --- | --- |\n| `oneagentgraph` | 0.9.0 | `0.9.0` | 0.9.0 |\n| `onevcs` | 0.57.0 | `0.57.0` | 0.57.0 |\n| `onevcs-testing` | 0.19.22 | `0.19.22` | 0.19.22 |\n| `onejudge` | 0.22.0 | `0.22.0` | 0.22.0 |\n| `oneharness-core` | 0.29.1 | `0.29.1` | 0.29.1 |\n| `onetaskgraph-core` | 0.12.7 | `=0.12.7` | 0.12.7 |\n| `onetaskgraph-plugin-api` | 0.12.7 | `=0.12.7` | 0.12.7 |\n| `onetaskgraph-local-md` | 0.12.7 | `=0.12.7` | 0.12.7 |\n| `onemessagebus` | 0.9.4 | `0.9.3` | 0.9.4 |\n| `onebudgetspec-core` | 0.1.5 | `=0.1.5` | 0.1.5 |\n\nEvery linked engine is the newest its own requirement permits.\n"},{"url":"https://api.github.com/repos/nickderobertis/onepipeline/releases/425136423","assets_url":"https://api.github.com/repos/nickderobertis/onepipeline/releases/425136423/assets","upload_url":"https://uploads.github.com/repos/nickderobertis/onepipeline/releases/425136423/assets{?name,label}","html_url":"https://github.com/nickderobertis/onepipeline/releases/tag/v0.95.2","id":425136423,"author":{"login":"nickderobertis","id":19440155,"node_id":"MDQ6VXNlcjE5NDQwMTU1","avatar_url":"https://avatars.githubusercontent.com/u/19440155?v=4","gravatar_id":"","url":"https://api.github.com/users/nickderobertis","html_url":"https://github.com/nickderobertis","followers_url":"https://api.github.com/users/nickderobertis/followers","following_url":"https://api.github.com/users/nickderobertis/following{/other_user}","gists_url":"https://api.github.com/users/nickderobertis/gists{/gist_id}","starred_url":"https://api.github.com/users/nickderobertis/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nickderobertis/subscriptions","organizations_url":"https://api.github.com/users/nickderobertis/orgs","repos_url":"https://api.github.com/users/nickderobe