8.0 |\n| `onetaskgraph-plugin-api` | 0.8.0 | `=0.8.0` | 0.8.0 |\n| `onetaskgraph-local-md` | 0.8.0 | `=0.8.0` | 0.8.0 |\n| `onemessagebus` | **0.9.2** | `0.9.1` | **0.9.3** — this release is behind it |\n| `onebudgetspec-core` | 0.1.5 | `=0.1.5` | 0.1.5 |\n\n> [!WARNING]\n> This release links an engine **older than its own requirement permits**, so reading\n> `Cargo.toml` overstates what this build contains:\n>\n> - `oneharness-core` links 0.28.5; the requirement already permitted 0.28.6.\n> - `onemessagebus` links 0.9.2; the requirement already permitted 0.9.3.\n"},{"url":"https://api.github.com/repos/nickderobertis/onepipeline/releases/417878780","assets_url":"https://api.github.com/repos/nickderobertis/onepipeline/releases/417878780/assets","upload_url":"https://uploads.github.com/repos/nickderobertis/onepipeline/releases/417878780/assets{?name,label}","html_url":"https://github.com/nickderobertis/onepipeline/releases/tag/v0.79.0","id":417878780,"author":{"login":"nickderobertis","id":19440155,"node_id":"MDQ6VXNlcjE5NDQwMTU1","avatar_url":"https://avatars.githubusercontent.com/u/19440155?v=4","gravatar_id":"","url":"https://api.github.com/users/nickderobertis","html_url":"https://github.com/nickderobertis","followers_url":"https://api.github.com/users/nickderobertis/followers","following_url":"https://api.github.com/users/nickderobertis/following{/other_user}","gists_url":"https://api.github.com/users/nickderobertis/gists{/gist_id}","starred_url":"https://api.github.com/users/nickderobertis/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nickderobertis/subscriptions","organizations_url":"https://api.github.com/users/nickderobertis/orgs","repos_url":"https://api.github.com/users/nickderobertis/repos","events_url":"https://api.github.com/users/nickderobertis/events{/privacy}","received_events_url":"https://api.github.com/users/nickderobertis/received_events","type":"User","user_view_type":"public","site_admin":false},"node_id":"RE_kwDOTx8a