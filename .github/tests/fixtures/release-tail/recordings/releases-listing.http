m/users/github-actions%5Bbot%5D/repos","events_url":"https://api.github.com/users/github-actions%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/github-actions%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"content_type":"application/octet-stream","state":"uploaded","size":616,"digest":"sha256:8000e6e66d46895733486a053eb94a0773895936943fd457d679afc28e58c5f3","download_count":1,"created_at":"2026-10-20T21:42:18Z","updated_at":"2026-10-20T21:42:18Z","browser_download_url":"https://github.com/nickderobertis/onepipeline/releases/download/v0.80.2/release-outcome.json"}],"tarball_url":"https://api.github.com/repos/nickderobertis/onepipeline/tarball/v0.80.2","zipball_url":"https://api.github.com/repos/nickderobertis/onepipeline/zipball/v0.80.2","body":"### Added\n\n- withdraw a live manager note while its delivery is awaited ([#1054](https://github.com/nickderobertis/onepipeline/pull/1054))\n\n### Fixed\n\n- *(tests)* steady the writeback-cost journey and ask a follow its session only when the answer can matter ([#1065](https://github.com/nickderobertis/onepipeline/pull/1065))\n- *(release)* finish a re-run whose earlier attempt already published, and wait longer for npm ([#1067](https://github.com/nickderobertis/onepipeline/pull/1067))\n\n<!-- linked-engines -->\n### Linked engines\n\nThe sibling engines this release actually links, resolved from its own `Cargo.lock`:\n\n| Engine | Linked | Requirement | Newest the requirement permits |\n| --- | --- | --- | --- |\n| `oneagentgraph` | 0.7.0 | `0.7.0` | 0.7.0 |\n| `onevcs` | 0.56.3 | `0.56.3` | 0.56.3 |\n| `onevcs-testing` | 0.19.13 | `0.19.13` | 0.19.13 |\n| `onejudge` | 0.20.0 | `0.20.0` | 0.20.0 |\n| `oneharness-core` | **0.28.6** | `0.28.5` | **0.28.7** — this release is behind it |\n| `onetaskgraph-core` | 0.9.0 | `=0.9.0` | 0.9.0 |\n| `onetaskgraph-plugin-api` | 0.9.0 | `=0.9.0` | 0.9.0 |\n| `onetaskgraph-local-md` | 0.9.0 | `=0.9.0` | 0.9.0 |\n| `onemessagebus` | 0.9.3 | `0.9.3` | 0.9.3 |\n| `onebudgetspec-core` | 0.1.5 | `=0.1.5` | 0.1.5 |\n\n> [!WARNING]\n> This release links an engine **older than its own requirement permits**, so reading\n> `Cargo.toml` overstates what this build contains:\n>\n> - `oneharness-core` links 0.28.6; the requirement already permitted 0.28.7.\n"},{"url":"https://api.github.com/repos/nickderobertis/onepipeline/releases/418588296","assets_url":"https://api.github.com/repos/nickderobertis/onepipeline/releases/418588296/assets","upload_url":"https://uploads.github.com/repos/nickderobertis/onepipeline/releases/418588296/assets{?name,label}","html_url":"https://github.com/nickderobertis/onepipeline/releases/tag/v0.80.1","id":418588296,"author":{"login":"nickderobertis","id":19440155,"node_id":"MDQ6VXNlcjE5NDQwMTU1","avatar_url":"https://avatars.githubusercontent.com/u/19440155?v=4","gravatar_id":"","url":"https://api.github.com/users/nickderobertis","html_url":"https://github.com/nickderobertis","followers_url":"https://api.github.com/users/nickderobertis/followers","following_url":"https://api.github.com/users/nickderobertis/following{/other_user}","gists_url":"https://api.github.com/users/nickderobertis/gists{/gist_id}","starred_url":"https://api.github.com/users/nickderobertis/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nickderobertis/subscriptions","organizations_url":"https://api.github.com/users/nickderobertis/orgs","repos_url":"https://api.github.com/users/nickderobertis/repos","events_url":"https://api.github.com/users/nickderobertis/events{/privacy}","received_events_url":"https://api.github.com/users/nickderobertis/received_events","type":"User","user_view_type":"public","site_admin":false},"node_id":"RE_kwDOTx8aUc4Y8yaI","tag_name":"v0.80.1","target_commitish":"main","name":"v0.80.1","draft":false,"immutable":false,"prerelease":false,"created_at":"2026-10-20T15:55:37Z","updated_at":"2026-10-20T16:34:05Z","published_at":"2026-10-20T15:55:38Z","