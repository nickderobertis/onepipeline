/received_events","type":"Bot","user_view_type":"public","site_admin":false},"content_type":"application/octet-stream","state":"uploaded","size":22953022,"digest":"sha256:2d5a715c480f01dfc64a3c21bfd369ee0d64b643dc449b089c51629e5beca4b0","download_count":23,"created_at":"2026-10-23T07:33:47Z","updated_at":"2026-10-23T07:33:49Z","browser_download_url":"https://github.com/nickderobertis/onepipeline/releases/download/v0.86.0/onepipeline-v0.86.0-x86_64-unknown-linux-gnu.tar.gz"},{"url":"https://api.github.com/repos/nickderobertis/onepipeline/releases/assets/668399022","id":668399022,"node_id":"RA_kwDOTx8aUc4n1vWu","name":"release-outcome.json","label":"","uploader":{"login":"github-actions[bot]","id":41898282,"node_id":"MDM6Qm90NDE4OTgyODI=","avatar_url":"https://avatars.githubusercontent.com/in/15368?v=4","gravatar_id":"","url":"https://api.github.com/users/github-actions%5Bbot%5D","html_url":"https://github.com/apps/github-actions","followers_url":"https://api.github.com/users/github-actions%5Bbot%5D/followers","following_url":"https://api.github.com/users/github-actions%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/github-actions%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/github-actions%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/github-actions%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/github-actions%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/github-actions%5Bbot%5D/repos","events_url":"https://api.github.com/users/github-actions%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/github-actions%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"content_type":"application/octet-stream","state":"uploaded","size":616,"digest":"sha256:b04294481c129b87a0f8dc2e6b355dee64da0820a1710fb6547ecd6d0ac67aed","download_count":1,"created_at":"2026-10-23T07:54:48Z","updated_at":"2026-10-23T07:54:48Z","browser_download_url":"https://github.com/nickderobertis/onepipeline/releases/download/v0.86.0/release-outcome.json"}],"tarball_url":"https://api.github.com/repos/nickderobertis/onepipeline/tarball/v0.86.0","zipball_url":"https://api.github.com/repos/nickderobertis/onepipeline/zipball/v0.86.0","body":"### Performance\n\n- *(deps)* [**breaking**] link the plan store whose approval takes one request per call ([#1115](https://github.com/nickderobertis/onepipeline/pull/1115))\n\n<!-- linked-engines -->\n### Linked engines\n\nThe sibling engines this release actually links, resolved from its own `Cargo.lock`:\n\n| Engine | Linked | Requirement | Newest the requirement permits |\n| --- | --- | --- | --- |\n| `oneagentgraph` | 0.7.1 | `0.7.1` | 0.7.1 |\n| `onevcs` | **0.56.5** | `0.56.3` | **0.56.6** — this release is behind it |\n| `onevcs-testing` | **0.19.15** | `0.19.13` | **0.19.16** — this release is behind it |\n| `onejudge` | 0.20.0 | `0.20.0` | 0.20.0 |\n| `oneharness-core` | 0.28.8 | `0.28.8` | 0.28.8 |\n| `onetaskgraph-core` | 0.11.0 | `=0.11.0` | 0.11.0 |\n| `onetaskgraph-plugin-api` | 0.11.0 | `=0.11.0` | 0.11.0 |\n| `onetaskgraph-local-md` | 0.11.0 | `=0.11.0` | 0.11.0 |\n| `onemessagebus` | 0.9.3 | `0.9.3` | 0.9.3 |\n| `onebudgetspec-core` | 0.1.5 | `=0.1.5` | 0.1.5 |\n\n> [!WARNING]\n> This release links an engine **older than its own requirement permits**, so reading\n> `Cargo.toml` overstates what this build contains:\n>\n> - `onevcs` links 0.56.5; the requirement already permitted 0.56.6.\n> - `onevcs-testing` links 0.19.15; the requirement already permitted 0.19.16.\n"},{"url":"https://api.github.com/repos/nickderobertis/onepipeline/releases/421415663","assets_url":"https://api.github.com/repos/nickderobertis/onepipeline/releases/421415663/assets","upload_url":"https://uploads.github.com/repos/nickderobertis/onepipeline/releases/421415663/assets{?name,label}","html_url":"https://github.com/nickderobertis/onepipeline/releases/tag/v0.85