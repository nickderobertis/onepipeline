 0.17.1 | `0.17.1` | 0.17.1 |\n| `oneharness-core` | 0.24.0 | `0.24.0` | 0.24.0 |\n| `onetaskgraph-core` | 0.2.54 | `=0.2.54` | 0.2.54 |\n\nEvery linked engine is the newest its own requirement permits.\n"},{"url":"https://api.github.com/repos/nickderobertis/onepipeline/releases/401007903","assets_url":"https://api.github.com/repos/nickderobertis/onepipeline/releases/401007903/assets","upload_url":"https://uploads.github.com/repos/nickderobertis/onepipeline/releases/401007903/assets{?name,label}","html_url":"https://github.com/nickderobertis/onepipeline/releases/tag/v0.57.1","id":401007903,"author":{"login":"nickderobertis","id":19440155,"node_id":"MDQ6VXNlcjE5NDQwMTU1","avatar_url":"https://avatars.githubusercontent.com/u/19440155?v=4","gravatar_id":"","url":"https://api.github.com/users/nickderobertis","html_url":"https://github.com/nickderobertis","followers_url":"https://api.github.com/users/nickderobertis/followers","following_url":"https://api.github.com/users/nickderobertis/following{/other_user}","gists_url":"https://api.github.com/users/nickderobertis/gists{/gist_id}","starred_url":"https://api.github.com/users/nickderobertis/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nickderobertis/subscriptions","organizations_url":"https://api.github.com/users/nickderobertis/orgs","repos_url":"https://api.github.com/users/nickderobertis/repos","events_url":"https://api.github.com/users/nickderobertis/events{/privacy}","received_events_url":"https://api.github.com/users/nickderobertis/received_events","type":"User","user_view_type":"public","site_admin":false},"node_id":"RE_kwDOTx8aUc4X5uUf","tag_name":"v0.57.1","target_commitish":"main","name":"v0.57.1","draft":false,"immutable":false,"prerelease":false,"created_at":"2026-10-01T13:42:46Z","updated_at":"2026-10-01T15:38:24Z","published_at":"2026-10-01T13:42:48Z","assets":[{"url":"https://api.github.com/repos/nickderobertis/onepipeline/releases/assets/603471017","id":603471017,"node_id":"RA_k