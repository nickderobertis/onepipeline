.tar.gz"},{"url":"https://api.github.com/repos/nickderobertis/onepipeline/releases/assets/687886693","id":687886693,"node_id":"RA_kwDOTx8aUc4pAFFl","name":"release-outcome.json","label":"","uploader":{"login":"github-actions[bot]","id":41898282,"node_id":"MDM6Qm90NDE4OTgyODI=","avatar_url":"https://avatars.githubusercontent.com/in/15368?v=4","gravatar_id":"","url":"https://api.github.com/users/github-actions%5Bbot%5D","html_url":"https://github.com/apps/github-actions","followers_url":"https://api.github.com/users/github-actions%5Bbot%5D/followers","following_url":"https://api.github.com/users/github-actions%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/github-actions%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/github-actions%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/github-actions%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/github-actions%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/github-actions%5Bbot%5D/repos","events_url":"https://api.github.com/users/github-actions%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/github-actions%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"content_type":"application/octet-stream","state":"uploaded","size":615,"digest":"sha256:13c7082ae9ef864aac80ae7a60c6578a0bf9dcb0b70336b5f782b887561f9a32","download_count":1,"created_at":"2026-10-29T08:33:07Z","updated_at":"2026-10-29T08:33:08Z","browser_download_url":"https://github.com/nickderobertis/onepipeline/releases/download/v0.95.5/release-outcome.json"}],"tarball_url":"https://api.github.com/repos/nickderobertis/onepipeline/tarball/v0.95.5","zipball_url":"https://api.github.com/repos/nickderobertis/onepipeline/zipball/v0.95.5","body":"### Added\n\n- *(deps)* link the plan store that routes by organization and classification together ([#1262](https://github.com/nickderobertis/onepipeline/pull/1262))\n\n### Fixed\n\n- *(test)* make the pooled-slot hand-back journey reliable on a loaded runner ([#1279](https://github.com/nickderobertis/onepipeline/pull/1279))\n- *(tests)* make the activity-rule liveness test wait for the spawned tree to exit ([#1268](https://github.com/nickderobertis/onepipeline/pull/1268))\n- *(tests)* make the live-judge note journey wait for the worker's presentation record ([#1273](https://github.com/nickderobertis/onepipeline/pull/1273))\n- *(npm)* run the npm launcher journeys on Windows ([#1259](https://github.com/nickderobertis/onepipeline/pull/1259))\n- *(deps)* link the plan store that keeps a private Linear home's public projections ([#1256](https://github.com/nickderobertis/onepipeline/pull/1256))\n\n<!-- linked-engines -->\n### Linked engines\n\nThe sibling engines this release actually links, resolved from its own `Cargo.lock`:\n\n| Engine | Linked | Requirement | Newest the requirement permits |\n| --- | --- | --- | --- |\n| `oneagentgraph` | **0.9.0** | `0.9.0` | **0.9.1** — this release is behind it |\n| `onevcs` | **0.57.0** | `0.57.0` | **0.57.1** — this release is behind it |\n| `onevcs-testing` | **0.19.22** | `0.19.22` | **0.19.23** — this release is behind it |\n| `onejudge` | 0.22.0 | `0.22.0` | 0.22.0 |\n| `oneharness-core` | 0.29.1 | `0.29.1` | 0.29.1 |\n| `onetaskgraph-core` | 0.12.9 | `=0.12.9` | 0.12.9 |\n| `onetaskgraph-plugin-api` | 0.12.9 | `=0.12.9` | 0.12.9 |\n| `onetaskgraph-local-md` | 0.12.9 | `=0.12.9` | 0.12.9 |\n| `onemessagebus` | 0.9.4 | `0.9.3` | 0.9.4 |\n| `onebudgetspec-core` | 0.1.5 | `=0.1.5` | 0.1.5 |\n\n> [!WARNING]\n> This release links an engine **older than its own requirement permits**, so reading\n> `Cargo.toml` overstates what this build contains:\n>\n> - `oneagentgraph` links 0.9.0; the requirement already permitted 0.9.1.\n> - `onevcs` links 0.57.0; the requirement already permitted 0.57.1.\n> - `onevcs-testing` links 0.19.22; the requirement already permitted 0.19.23.\n"},{"url":"https://api.github.com/repos/nickderobertis/onepipeline/releases/426297673","assets_url":"https://api.github.com/repos/nickderobertis/onepipeline/releases/426297673/assets","upload_url":"https://uploads.github.com/repos/nickderobertis/onepipeline/releases/426297673/assets{?name,label}","html_url":"https://github.com/nickderobertis/onepipeline/releases/tag/v0.95.4","id":426297673,"author":{"login":"nickderobertis","id":19440155,"node_id":"MDQ6VXNlcjE5NDQwMTU1","avatar_url":"https://avatars.githubusercontent.com/u/19440155?v=4","gravatar_id":"","url":"https://api.github.com/users/nickderobertis","html_url":"https://github.com/nickderobertis","followers_url":"https://api.github.com/users/nickderobertis/followers","following_url":"https://api.github.com/users/nickderobertis/following{/other_user}","gists_url":"https://api.github.com/users/nickderobertis/gists{/gist_id}","starred_url":"https://api.github.com/users/nickderobertis/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nickderobertis/subscriptions","organizations_url":"https://api.github.com/users/nickderobertis/orgs","repos_url":"https://api.github.com/users/nickderobertis/repos","events_url":"https://api.github.com/users/nickderobertis/events{/privacy}","received_events_url":"https://api.github.com/users/nickderobertis/received_events","type":"User","user_view_type":"public","site_admin":false},"node_id":"RE_kwDOTx8aUc4ZaMlJ","tag_name":"v0.95.4","target_commitish":"main","name":"v0.95.4","draft":false,"immutable":false,"prerelease":false,"created_at":"2026-10-28T05:35:32Z","updated_at":"2026-10-28T06:09:52Z","published_at":"2026-10-28T05:35:33Z","assets":[{"url":"https://api.github.com/repos/nickderobertis/onepipeline/releases/assets/683985606","id":683985606,"node_id":"RA_kwDOTx8aUc4oxMrG","name":"onepipeline-v0.95.4-aarch64-apple-darwin.sha256","label":"","uploader":{"login":"github-actions[bot]","id":41898282,"node_id":"MDM6Qm90NDE4OTgyODI=","avatar_url":"https://avatars.