k`:\n\n| Engine | Linked | Requirement | Newest the requirement permits |\n| --- | --- | --- | --- |\n| `oneagentgraph` | 0.5.2 | `0.5.2` | 0.5.2 |\n| `onevcs` | 0.34.1 | `0.34.1` | 0.34.1 |\n| `onevcs-testing` | 0.8.5 | `0.8.5` | 0.8.5 |\n| `onejudge` | 0.14.0 | `0.14.0` | 0.14.0 |\n| `oneharness-core` | 0.18.0 | `0.18.0` | 0.18.0 |\n| `onetaskgraph-core` | 0.2.49 | `=0.2.49` | 0.2.49 |\n\nEvery linked engine is the newest its own requirement permits.\n"},{"url":"https://api.github.com/repos/nickderobertis/onepipeline/releases/397966774","assets_url":"https://api.github.com/repos/nickderobertis/onepipeline/releases/397966774/assets","upload_url":"https://uploads.github.com/repos/nickderobertis/onepipeline/releases/397966774/assets{?name,label}","html_url":"https://github.com/nickderobertis/onepipeline/releases/tag/v0.52.0","id":397966774,"author":{"login":"nickderobertis","id":19440155,"node_id":"MDQ6VXNlcjE5NDQwMTU1","avatar_url":"https://avatars.githubusercontent.com/u/19440155?v=4","gravatar_id":"","url":"https://api.github.com/users/nickderobertis","html_url":"https://github.com/nickderobertis","followers_url":"https://api.github.com/users/nickderobertis/followers","following_url":"https://api.github.com/users/nickderobertis/following{/other_user}","gists_url":"https://api.github.com/users/nickderobertis/gists{/gist_id}","starred_url":"https://api.github.com/users/nickderobertis/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nickderobertis/subscriptions","organizations_url":"https://api.github.com/users/nickderobertis/orgs","repos_url":"https://api.github.com/users/nickderobertis/repos","events_url":"https://api.github.com/users/nickderobertis/events{/privacy}","received_events_url":"https://api.github.com/users/nickderobertis/received_events","type":"User","user_view_type":"public","site_admin":false},"node_id":"RE_kwDOTx8aUc4XuH22","tag_name":"v0.52.0","target_commitish":"main","name":"v0.52.0","draft":false,"immutable":false,"prere