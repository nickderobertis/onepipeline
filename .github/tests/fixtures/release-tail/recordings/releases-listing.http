repo}","subscriptions_url":"https://api.github.com/users/github-actions%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/github-actions%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/github-actions%5Bbot%5D/repos","events_url":"https://api.github.com/users/github-actions%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/github-actions%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"content_type":"application/octet-stream","state":"uploaded","size":615,"digest":"sha256:d6e0e014a937bd0495511c0f1597c8bfa454ec1bb228b03a75a5190377d97e4e","download_count":1,"created_at":"2026-10-26T21:38:09Z","updated_at":"2026-10-26T21:38:09Z","browser_download_url":"https://github.com/nickderobertis/onepipeline/releases/download/v0.94.0/release-outcome.json"}],"tarball_url":"https://api.github.com/repos/nickderobertis/onepipeline/tarball/v0.94.0","zipball_url":"https://api.github.com/repos/nickderobertis/onepipeline/zipball/v0.94.0","body":"### Added\n\n- *(release)* [**breaking**] hold a fast local-direct node's landing until the release it adopted early ([#1214](https://github.com/nickderobertis/onepipeline/pull/1214))\n\n<!-- linked-engines -->\n### Linked engines\n\nThe sibling engines this release actually links, resolved from its own `Cargo.lock`:\n\n| Engine | Linked | Requirement | Newest the requirement permits |\n| --- | --- | --- | --- |\n| `oneagentgraph` | 0.9.0 | `0.9.0` | 0.9.0 |\n| `onevcs` | 0.57.0 | `0.57.0` | 0.57.0 |\n| `onevcs-testing` | 0.19.22 | `0.19.22` | 0.19.22 |\n| `onejudge` | 0.22.0 | `0.22.0` | 0.22.0 |\n| `oneharness-core` | 0.29.1 | `0.29.1` | 0.29.1 |\n| `onetaskgraph-core` | 0.12.5 | `=0.12.5` | 0.12.5 |\n| `onetaskgraph-plugin-api` | 0.12.5 | `=0.12.5` | 0.12.5 |\n| `onetaskgraph-local-md` | 0.12.5 | `=0.12.5` | 0.12.5 |\n| `onemessagebus` | **0.9.3** | `0.9.3` | **0.9.4** — this release is behind it |\n| `onebudgetspec-core` | 0.1.5 | `=0.1.5` | 0.1.5 |\n\n> [!WARNING]\n> This release links an engine **older than its own requirement permits**, so reading\n> `Cargo.toml` overstates what this build contains:\n>\n> - `onemessagebus` links 0.9.3; the requirement already permitted 0.9.4.\n"},{"url":"https://api.github.com/repos/nickderobertis/onepipeline/releases/423906220","assets_url":"https://api.github.com/repos/nickderobertis/onepipeline/releases/423906220/assets","upload_url":"https://uploads.github.com/repos/nickderobertis/onepipeline/releases/423906220/assets{?name,label}","html_url":"https://github.com/nickderobertis/onepipeline/releases/tag/v0.93.1","id":423906220,"author":{"login":"nickderobertis","id":19440155,"node_id":"MDQ6VXNlcjE5NDQwMTU1","avatar_url":"https://avatars.githubusercontent.com/u/19440155?v=4","gravatar_id":"","url":"https://api.github.com/users/nickderobertis","html_url":"https://github.com/nickderobertis","followers_url":"https://api.github.com/users/nickderobertis/followers","following_url":"https://api.github.com/users/nickderobertis/following{/other_user}","gists_url":"https://api.github.com/users/nickderobertis/gists{/gist_id}","starred_url":"https://api.github.com/users/nickderobertis/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nickderobertis/subscriptions","organizations_url":"https://api.github.com/users/nickderobertis/orgs","repos_url":"https://api.github.com/users/nickderobertis/repos","events_url":"https://api.github.com/users/nickderobertis/events{/privacy}","received_events_url":"https://api.github.com/users/nickderobertis/received_events","type":"User","user_view_type":"public","site_admin":false},"node_id":"RE_kwDOTx8aUc4ZREus","tag_name":"v0.93.1","target_commitish":"main","name":"v0.93.1","draft":false,"immutable":false,"prerelease":false,"created_at":"2026-10-26T06:06:45Z","updated_at":"2026-10-26T14:44:32Z","published_at":"2026-10-26T06:06:46Z","assets":[{"url":"https://api.github.com/repos/nickderobertis/onepipeline/releases/assets/677225