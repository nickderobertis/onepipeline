api.github.com/users/github-actions%5Bbot%5D/repos","events_url":"https://api.github.com/users/github-actions%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/github-actions%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"content_type":"application/json","state":"uploaded","size":616,"digest":"sha256:c261b9b79360e01549bd9cdcca2657d44b597060b6f134afdf83cfb0c62f7712","download_count":1,"created_at":"2026-10-17T21:02:19Z","updated_at":"2026-10-17T21:02:19Z","browser_download_url":"https://github.com/nickderobertis/onepipeline/releases/download/v0.75.0/release-outcome.json"}],"tarball_url":"https://api.github.com/repos/nickderobertis/onepipeline/tarball/v0.75.0","zipball_url":"https://api.github.com/repos/nickderobertis/onepipeline/zipball/v0.75.0","body":"### Added\n\n- *(deps)* [**breaking**] read YAML with serde-saphyr and link the onetaskgraph and sibling releases that do ([#923](https://github.com/nickderobertis/onepipeline/pull/923))\n\n### Fixed\n\n- *(scratch)* name an added node's scratch directory the same way on Windows ([#977](https://github.com/nickderobertis/onepipeline/pull/977))\n- *(e2e)* close the multi-source stop race and the readjust placement flake ([#951](https://github.com/nickderobertis/onepipeline/pull/951))\n\n### Performance\n\n- *(driver)* read the driver claim on an interval and make an adopting driver wait for the one it displaces ([#965](https://github.com/nickderobertis/onepipeline/pull/965))\n\n<!-- linked-engines -->\n### Linked engines\n\nThe sibling engines this release actually links, resolved from its own `Cargo.lock`:\n\n| Engine | Linked | Requirement | Newest the requirement permits |\n| --- | --- | --- | --- |\n| `oneagentgraph` | 0.5.13 | `0.5.13` | 0.5.13 |\n| `onevcs` | 0.52.0 | `0.52.0` | 0.52.0 |\n| `onevcs-testing` | 0.19.4 | `0.19.4` | 0.19.4 |\n| `onejudge` | 0.19.5 | `0.19.5` | 0.19.5 |\n| `oneharness-core` | 0.28.2 | `0.28.2` | 0.28.2 |\n| `onetaskgraph-core` | 0.7.1 | `=0.7.1` | 0.7.1 |\n| `onetaskgraph-plugin-api` | 0.7.1 | `=0.7.1` | 0.7.1 |\n| `onetaskgraph-local-md` | 0.7.1 | `=0.7.1` | 0.7.1 |\n| `onemessagebus` | 0.9.1 | `0.9.1` | 0.9.1 |\n| `onebudgetspec-core` | 0.1.5 | `=0.1.5` | 0.1.5 |\n\nEvery linked engine is the newest its own requirement permits.\n"},{"url":"https://api.github.com/repos/nickderobertis/onepipeline/releases/414813711","assets_url":"https://api.github.com/repos/nickderobertis/onepipeline/releases/414813711/assets","upload_url":"https://uploads.github.com/repos/nickderobertis/onepipeline/releases/414813711/assets{?name,label}","html_url":"https://github.com/nickderobertis/onepipeline/releases/tag/v0.74.1","id":414813711,"author":{"login":"nickderobertis","id":19440155,"node_id":"MDQ6VXNlcjE5NDQwMTU1","avatar_url":"https://avatars.githubusercontent.com/u/19440155?v=4","gravatar_id":"","url":"https://api.github.com/users/nickderobertis","html_url":"https://github.com/nickderobertis","followers_url":"https://api.github.com/users/nickderobertis/followers","following_url":"https://api.github.com/users/nickderobertis/following{/other_user}","gists_url":"https://api.github.com/users/nickderobertis/gists{/gist_id}","starred_url":"https://api.github.com/users/nickderobertis/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nickderobertis/subscriptions","organizations_url":"https://api.github.com/users/nickderobertis/orgs","repos_url":"https://api.github.com/users/nickderobertis/repos","events_url":"https://api.github.com/users/nickderobertis/events{/privacy}","received_events_url":"https://api.github.com/users/nickderobertis/received_events","type":"User","user_view_type":"public","site_admin":false},"node_id":"RE_kwDOTx8aUc4YuY4P","tag_name":"v0.74.1","target_commitish":"main","name":"v0.74.1","draft":false,"immutable":false,"prerelease":false,"created_at":"2026-10-16T10:14:00Z","updated_at":"2026-10-16T12:30:16Z","published_at":"2026-10-16T10:14:02Z","assets":[{"url"