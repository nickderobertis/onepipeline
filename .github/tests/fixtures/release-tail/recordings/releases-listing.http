/github-actions%5Bbot%5D/repos","events_url":"https://api.github.com/users/github-actions%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/github-actions%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"content_type":"application/x-gtar","state":"uploaded","size":19725744,"digest":"sha256:fc7b67b09de5a3b19be310940ecc909d2b8bb12f5b51d3383996282b677c9167","download_count":1,"created_at":"2026-10-13T12:47:32Z","updated_at":"2026-10-13T12:47:34Z","browser_download_url":"https://github.com/nickderobertis/onepipeline/releases/download/v0.70.1/onepipeline-v0.70.1-x86_64-unknown-linux-gnu.tar.gz"},{"url":"https://api.github.com/repos/nickderobertis/onepipeline/releases/assets/637977683","id":637977683,"node_id":"RA_kwDOTx8aUc4mBsRT","name":"release-outcome.json","label":"","uploader":{"login":"github-actions[bot]","id":41898282,"node_id":"MDM6Qm90NDE4OTgyODI=","avatar_url":"https://avatars.githubusercontent.com/in/15368?v=4","gravatar_id":"","url":"https://api.github.com/users/github-actions%5Bbot%5D","html_url":"https://github.com/apps/github-actions","followers_url":"https://api.github.com/users/github-actions%5Bbot%5D/followers","following_url":"https://api.github.com/users/github-actions%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/github-actions%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/github-actions%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/github-actions%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/github-actions%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/github-actions%5Bbot%5D/repos","events_url":"https://api.github.com/users/github-actions%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/github-actions%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"content_type":"application/json","state":"uploaded","size":620,"digest":"sha256:b7d8056f207597ee5a9f20ad1381df149aec0189a3c0b401297c109925b925e2","download_count":1,"created_at":"2026-10-13T19:06:18Z","updated_at":"2026-10-13T19:06:18Z","browser_download_url":"https://github.com/nickderobertis/onepipeline/releases/download/v0.70.1/release-outcome.json"}],"tarball_url":"https://api.github.com/repos/nickderobertis/onepipeline/tarball/v0.70.1","zipball_url":"https://api.github.com/repos/nickderobertis/onepipeline/zipball/v0.70.1","body":"### Fixed\n\n- *(deps)* link the onevcs that retires a branch only on its own repository's merged change request ([#886](https://github.com/nickderobertis/onepipeline/pull/886))\n\n<!-- linked-engines -->\n### Linked engines\n\nThe sibling engines this release actually links, resolved from its own `Cargo.lock`:\n\n| Engine | Linked | Requirement | Newest the requirement permits |\n| --- | --- | --- | --- |\n| `oneagentgraph` | **0.5.6** | `0.5.6` | **0.5.7** — this release is behind it |\n| `onevcs` | 0.49.0 | `0.49.0` | 0.49.0 |\n| `onevcs-testing` | 0.18.0 | `0.18.0` | 0.18.0 |\n| `onejudge` | 0.19.0 | `0.19.0` | 0.19.0 |\n| `oneharness-core` | 0.24.2 | `0.24.1` | 0.24.2 |\n| `onetaskgraph-core` | 0.6.0 | `=0.6.0` | 0.6.0 |\n\n> [!NOTE]\n> A newer release of an engine below exists that this build's own requirements\n> **hold back**: it requires a sibling engine outside the window `Cargo.toml` states,\n> so no `cargo update` takes it without a second copy of that sibling, and only a\n> requirement move lifts it:\n>\n> - `onejudge` links 0.19.0, the newest its requirement permits that this manifest admits; 0.19.1 is held back by `oneharness-core = \"0.24.1\"` (0.19.1 requires oneharness-core ^0.26.0).\n\n> [!WARNING]\n> This release links an engine **older than its own requirement permits**, so reading\n> `Cargo.toml` overstates what this build contains:\n>\n> - `oneagentgraph` links 0.5.6; the requirement already permitted 0.5.7 (0.5.8 is held back by `oneharness-core = \"0.24.1\"`: 0.5.8 requires oneharness-core ^0.26.0).\n"},{"url":"https://api.github.com/repos/nickderobertis/onepipeline/releases/411487957","assets_url":"https://api.github.com/repos/nickderobertis/onepipeline/releases/411487957/assets","upload_url":"https://uploads.github.com/repos/nickderobertis/onepipeline/releases/411487957/assets{?name,label}","html_url":"https://github.com/nickderobertis/onepipeline/releases/tag/v0.70.0","id":411487957,"author":{"login":"nickderobertis","id":19440155,"node_id":"MDQ6VXNlcjE5NDQwMTU1","avatar_url":"https://avatars.githubusercontent.com/u/19440155?v=4","gravatar_id":"","url":"https://api.github.com/users/nickderobertis","html_url":"https://github.com/nickderobertis","followers_url":"https://api.github.com/users/nickderobertis/followers","following_url":"https://api.github.com/users/nickderobertis/following{/other_user}","gists_url":"https://api.github.com/users/nickderobertis/gists{/gist_id}","starred_url":"https://api.github.com/users/nickderobertis/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nickderobertis/subscriptions","organizations_url":"https://api.github.com/users/nickderobertis/orgs","repos_url":"https://api.github.com/users/nickderobertis/repos","events_url":"https://api.github.com/users/nickderobertis/events{/privacy}","received_events_url":"https://api.github.com/users/nickderobertis/received_events","type":"User","user_view_type":"public","site_admin":false},"node_id":"RE_kwDOTx8aUc4Yhs7V","tag_name":"v0.70.0","target_commitish":"main","name":"v0.70.0","draft":false,"immutable":false,"prerelease":false,"created_at":"2026-10-13T09:09:10Z","updated_at":"2026-10-13T17:07:01Z","published_at":"2026-10-13T09:09:15Z","assets":[{"url":"https://api.github.com/repos/nickderobertis/onepipeline/releases/assets/637080844","id":637080844,"node_id":"RA_kwDOTx8aUc4l-RUM","name":"onepipeline-v0.70.0-aarch64-apple-darwin.sha256","label":"","uploader":{"login":"github-actions[bot]","id":41898282,"node_id":"MD