":"https://github.com/apps/github-actions","followers_url":"https://api.github.com/users/github-actions%5Bbot%5D/followers","following_url":"https://api.github.com/users/github-actions%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/github-actions%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/github-actions%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/github-actions%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/github-actions%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/github-actions%5Bbot%5D/repos","events_url":"https://api.github.com/users/github-actions%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/github-actions%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"content_type":"application/octet-stream","state":"uploaded","size":616,"digest":"sha256:0c4144b72a961143924204d7c505691bcc437dbfd44fe86b44aeaaedd53e7b2e","download_count":1,"created_at":"2026-10-25T01:01:05Z","updated_at":"2026-10-25T01:01:06Z","browser_download_url":"https://github.com/nickderobertis/onepipeline/releases/download/v0.89.3/release-outcome.json"}],"tarball_url":"https://api.github.com/repos/nickderobertis/onepipeline/tarball/v0.89.3","zipball_url":"https://api.github.com/repos/nickderobertis/onepipeline/zipball/v0.89.3","body":"### Fixed\n\n- *(driver)* stop reading the project claim on a timer and never end work over a failed read ([#1116](https://github.com/nickderobertis/onepipeline/pull/1116))\n\n<!-- linked-engines -->\n### Linked engines\n\nThe sibling engines this release actually links, resolved from its own `Cargo.lock`:\n\n| Engine | Linked | Requirement | Newest the requirement permits |\n| --- | --- | --- | --- |\n| `oneagentgraph` | 0.8.0 | `0.8.0` | 0.8.0 |\n| `onevcs` | **0.56.10** | `0.56.9` | **0.56.11** — this release is behind it |\n| `onevcs-testing` | **0.19.20** | `0.19.19` | **0.19.21** — this release is behind it |\n| `onejudge` | 0.21.0 | `0.21.0` | 0.21.0 |\n| `oneharness-core` | 0.29.1 | `0.29.1` | 0.29.1 |\n| `onetaskgraph-core` | 0.11.1 | `=0.11.1` | 0.11.1 |\n| `onetaskgraph-plugin-api` | 0.11.1 | `=0.11.1` | 0.11.1 |\n| `onetaskgraph-local-md` | 0.11.1 | `=0.11.1` | 0.11.1 |\n| `onemessagebus` | 0.9.3 | `0.9.3` | 0.9.3 |\n| `onebudgetspec-core` | 0.1.5 | `=0.1.5` | 0.1.5 |\n\n> [!WARNING]\n> This release links an engine **older than its own requirement permits**, so reading\n> `Cargo.toml` overstates what this build contains:\n>\n> - `onevcs` links 0.56.10; the requirement already permitted 0.56.11.\n> - `onevcs-testing` links 0.19.20; the requirement already permitted 0.19.21.\n"},{"url":"https://api.github.com/repos/nickderobertis/onepipeline/releases/422935170","assets_url":"https://api.github.com/repos/nickderobertis/onepipeline/releases/422935170/assets","upload_url":"https://uploads.github.com/repos/nickderobertis/onepipeline/releases/422935170/assets{?name,label}","html_url":"https://github.com/nickderobertis/onepipeline/releases/tag/v0.89.2","id":422935170,"author":{"login":"nickderobertis","id":19440155,"node_id":"MDQ6VXNlcjE5NDQwMTU1","avatar_url":"https://avatars.githubusercontent.com/u/19440155?v=4","gravatar_id":"","url":"https://api.github.com/users/nickderobertis","html_url":"https://github.com/nickderobertis","followers_url":"https://api.github.com/users/nickderobertis/followers","following_url":"https://api.github.com/users/nickderobertis/following{/other_user}","gists_url":"https://api.github.com/users/nickderobertis/gists{/gist_id}","starred_url":"https://api.github.com/users/nickderobertis/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nickderobertis/subscriptions","organizations_url":"https://api.github.com/users/nickderobertis/orgs","repos_url":"https://api.github.com/users/nickderobertis/repos","events_url":"https://api.github.com/users/nickderobertis/events{/privacy}","receiv