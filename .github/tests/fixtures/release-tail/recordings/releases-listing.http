:23453991,"digest":"sha256:c6a87a0f0d5915cf72b1998e7d52a1b7d1b7172c62176718d5d3eb6fa3b15425","download_count":17,"created_at":"2026-10-25T09:46:27Z","updated_at":"2026-10-25T09:46:29Z","browser_download_url":"https://github.com/nickderobertis/onepipeline/releases/download/v0.91.0/onepipeline-v0.91.0-x86_64-unknown-linux-gnu.tar.gz"},{"url":"https://api.github.com/repos/nickderobertis/onepipeline/releases/assets/674705316","id":674705316,"node_id":"RA_kwDOTx8aUc4oNy-k","name":"release-outcome.json","label":"","uploader":{"login":"github-actions[bot]","id":41898282,"node_id":"MDM6Qm90NDE4OTgyODI=","avatar_url":"https://avatars.githubusercontent.com/in/15368?v=4","gravatar_id":"","url":"https://api.github.com/users/github-actions%5Bbot%5D","html_url":"https://github.com/apps/github-actions","followers_url":"https://api.github.com/users/github-actions%5Bbot%5D/followers","following_url":"https://api.github.com/users/github-actions%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/github-actions%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/github-actions%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/github-actions%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/github-actions%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/github-actions%5Bbot%5D/repos","events_url":"https://api.github.com/users/github-actions%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/github-actions%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"content_type":"application/octet-stream","state":"uploaded","size":616,"digest":"sha256:4982ffcde206e4ec48217adfe86c225547680c8800317a4656b2f10a43d55606","download_count":1,"created_at":"2026-10-25T10:08:44Z","updated_at":"2026-10-25T10:08:45Z","browser_download_url":"https://github.com/nickderobertis/onepipeline/releases/download/v0.91.0/release-outcome.json"}],"tarball_url":"https://api.github.com/repos/nickderobertis/onepipeline/tarball/v0.91.0","zipball_url":"https://api.github.com/repos/nickderobertis/onepipeline/zipball/v0.91.0","body":"### Added\n\n- [**breaking**] execute private coordination plans with task-owned visibility ([#1152](https://github.com/nickderobertis/onepipeline/pull/1152))\n\n### Fixed\n\n- free the run's event store before the Windows stop-guard journey replaces it ([#1160](https://github.com/nickderobertis/onepipeline/pull/1160))\n\n<!-- linked-engines -->\n### Linked engines\n\nThe sibling engines this release actually links, resolved from its own `Cargo.lock`:\n\n| Engine | Linked | Requirement | Newest the requirement permits |\n| --- | --- | --- | --- |\n| `oneagentgraph` | 0.8.0 | `0.8.0` | 0.8.0 |\n| `onevcs` | 0.56.11 | `0.56.11` | 0.56.11 |\n| `onevcs-testing` | 0.19.21 | `0.19.21` | 0.19.21 |\n| `onejudge` | 0.21.0 | `0.21.0` | 0.21.0 |\n| `oneharness-core` | 0.29.1 | `0.29.1` | 0.29.1 |\n| `onetaskgraph-core` | 0.12.1 | `=0.12.1` | 0.12.1 |\n| `onetaskgraph-plugin-api` | 0.12.1 | `=0.12.1` | 0.12.1 |\n| `onetaskgraph-local-md` | 0.12.1 | `=0.12.1` | 0.12.1 |\n| `onemessagebus` | **0.9.3** | `0.9.3` | **0.9.4** — this release is behind it |\n| `onebudgetspec-core` | 0.1.5 | `=0.1.5` | 0.1.5 |\n\n> [!WARNING]\n> This release links an engine **older than its own requirement permits**, so reading\n> `Cargo.toml` overstates what this build contains:\n>\n> - `onemessagebus` links 0.9.3; the requirement already permitted 0.9.4.\n"},{"url":"https://api.github.com/repos/nickderobertis/onepipeline/releases/423126857","assets_url":"https://api.github.com/repos/nickderobertis/onepipeline/releases/423126857/assets","upload_url":"https://uploads.github.com/repos/nickderobertis/onepipeline/releases/423126857/assets{?name,label}","html_url":"https://github.com/nickderobertis/onepipeline/releases/tag/v0.90.0","id":423126857,"author":{"login":"nickderobertis","id":19440155,"node_id":"MDQ6VXNlcjE5NDQwMTU1","ava