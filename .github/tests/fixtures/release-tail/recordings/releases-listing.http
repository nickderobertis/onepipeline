received_events_url":"https://api.github.com/users/github-actions%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"content_type":"application/octet-stream","state":"uploaded","size":616,"digest":"sha256:aedea31750c5e48357e51a2a93c1b13076c40b927e2cd0e89504450baf525ff4","download_count":1,"created_at":"2026-10-22T15:35:37Z","updated_at":"2026-10-22T15:35:38Z","browser_download_url":"https://github.com/nickderobertis/onepipeline/releases/download/v0.84.1/release-outcome.json"}],"tarball_url":"https://api.github.com/repos/nickderobertis/onepipeline/tarball/v0.84.1","zipball_url":"https://api.github.com/repos/nickderobertis/onepipeline/zipball/v0.84.1","body":"### Fixed\n\n- *(deps)* link the oneharness core that stops a pooled server after its last lease ([#1107](https://github.com/nickderobertis/onepipeline/pull/1107))\n- *(launch)* leave a board plan's withdrawn tasks out of the executable graph ([#1101](https://github.com/nickderobertis/onepipeline/pull/1101))\n\n<!-- linked-engines -->\n### Linked engines\n\nThe sibling engines this release actually links, resolved from its own `Cargo.lock`:\n\n| Engine | Linked | Requirement | Newest the requirement permits |\n| --- | --- | --- | --- |\n| `oneagentgraph` | 0.7.1 | `0.7.1` | 0.7.1 |\n| `onevcs` | **0.56.3** | `0.56.3` | **0.56.5** — this release is behind it |\n| `onevcs-testing` | **0.19.13** | `0.19.13` | **0.19.15** — this release is behind it |\n| `onejudge` | 0.20.0 | `0.20.0` | 0.20.0 |\n| `oneharness-core` | 0.28.8 | `0.28.8` | 0.28.8 |\n| `onetaskgraph-core` | 0.9.2 | `=0.9.2` | 0.9.2 |\n| `onetaskgraph-plugin-api` | 0.9.2 | `=0.9.2` | 0.9.2 |\n| `onetaskgraph-local-md` | 0.9.2 | `=0.9.2` | 0.9.2 |\n| `onemessagebus` | 0.9.3 | `0.9.3` | 0.9.3 |\n| `onebudgetspec-core` | 0.1.5 | `=0.1.5` | 0.1.5 |\n\n> [!WARNING]\n> This release links an engine **older than its own requirement permits**, so reading\n> `Cargo.toml` overstates what this build contains:\n>\n> - `onevcs` links 0.56.3; the requirement already permitted 0.56.5.\n> - `onevcs-testing` links 0.19.13; the requirement already permitted 0.19.15.\n"},{"url":"https://api.github.com/repos/nickderobertis/onepipeline/releases/420390774","assets_url":"https://api.github.com/repos/nickderobertis/onepipeline/releases/420390774/assets","upload_url":"https://uploads.github.com/repos/nickderobertis/onepipeline/releases/420390774/assets{?name,label}","html_url":"https://github.com/nickderobertis/onepipeline/releases/tag/v0.84.0","id":420390774,"author":{"login":"nickderobertis","id":19440155,"node_id":"MDQ6VXNlcjE5NDQwMTU1","avatar_url":"https://avatars.githubusercontent.com/u/19440155?v=4","gravatar_id":"","url":"https://api.github.com/users/nickderobertis","html_url":"https://github.com/nickderobertis","followers_url":"https://api.github.com/users/nickderobertis/followers","following_url":"https://api.github.com/users/nickderobertis/following{/other_user}","gists_url":"https://api.github.com/users/nickderobertis/gists{/gist_id}","starred_url":"https://api.github.com/users/nickderobertis/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nickderobertis/subscriptions","organizations_url":"https://api.github.com/users/nickderobertis/orgs","repos_url":"https://api.github.com/users/nickderobertis/repos","events_url":"https://api.github.com/users/nickderobertis/events{/privacy}","received_events_url":"https://api.github.com/users/nickderobertis/received_events","type":"User","user_view_type":"public","site_admin":false},"node_id":"RE_kwDOTx8aUc4ZDqd2","tag_name":"v0.84.0","target_commitish":"main","name":"v0.84.0","draft":false,"immutable":false,"prerelease":false,"created_at":"2026-10-22T06:50:24Z","updated_at":"2026-10-22T12:16:11Z","published_at":"2026-10-22T06:50:26Z","assets":[{"url":"https://api.github.com/repos/nickderobertis/onepipeline/releases/assets/665041125","id":665041125,"node_id":"RA_kwDOTx8aUc4no7jl","name":"onepipeline-v0.84.0-aarch64-apple-darwin.sha256