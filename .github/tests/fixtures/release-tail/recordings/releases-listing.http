5D/subscriptions","organizations_url":"https://api.github.com/users/github-actions%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/github-actions%5Bbot%5D/repos","events_url":"https://api.github.com/users/github-actions%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/github-actions%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"content_type":"application/json","state":"uploaded","size":620,"digest":"sha256:9b3c8c0614ea6368762ac9682f07372399396c449212612183d1bbc5c623afe8","download_count":1,"created_at":"2026-10-13T03:36:06Z","updated_at":"2026-10-13T03:36:07Z","browser_download_url":"https://github.com/nickderobertis/onepipeline/releases/download/v0.69.0/release-outcome.json"}],"tarball_url":"https://api.github.com/repos/nickderobertis/onepipeline/tarball/v0.69.0","zipball_url":"https://api.github.com/repos/nickderobertis/onepipeline/zipball/v0.69.0","body":"### Added\n\n- *(start)* [**breaking**] continue a project from its store's settlements and claim it for one driver ([#862](https://github.com/nickderobertis/onepipeline/pull/862))\n- *(host)* [**breaking**] answer from live runs alone, and print the reading as JSON ([#861](https://github.com/nickderobertis/onepipeline/pull/861))\n\n### Performance\n\n- *(build)* drop dev and test debuginfo; ignore RUSTSEC-2024-0449 until the YAML crate is replaced ([#878](https://github.com/nickderobertis/onepipeline/pull/878))\n\n<!-- linked-engines -->\n### Linked engines\n\nThe sibling engines this release actually links, resolved from its own `Cargo.lock`:\n\n| Engine | Linked | Requirement | Newest the requirement permits |\n| --- | --- | --- | --- |\n| `oneagentgraph` | 0.5.6 | `0.5.6` | 0.5.6 |\n| `onevcs` | **0.48.0** | `0.48.0` | **0.48.1** — this release is behind it |\n| `onevcs-testing` | 0.16.0 | `0.16.0` | 0.16.0 |\n| `onejudge` | 0.19.0 | `0.19.0` | 0.19.0 |\n| `oneharness-core` | 0.24.2 | `0.24.1` | 0.24.2 |\n| `onetaskgraph-core` | 0.4.0 | `=0.4.0` | 0.4.0 |\n\n> [!WARNING]\n> This release links an engine **older than its own requirement permits**, so reading\n> `Cargo.toml` overstates what this build contains:\n>\n> - `onevcs` links 0.48.0; the requirement already permitted 0.48.1.\n"},{"url":"https://api.github.com/repos/nickderobertis/onepipeline/releases/410422720","assets_url":"https://api.github.com/repos/nickderobertis/onepipeline/releases/410422720/assets","upload_url":"https://uploads.github.com/repos/nickderobertis/onepipeline/releases/410422720/assets{?name,label}","html_url":"https://github.com/nickderobertis/onepipeline/releases/tag/v0.68.1","id":410422720,"author":{"login":"nickderobertis","id":19440155,"node_id":"MDQ6VXNlcjE5NDQwMTU1","avatar_url":"https://avatars.githubusercontent.com/u/19440155?v=4","gravatar_id":"","url":"https://api.github.com/users/nickderobertis","html_url":"https://github.com/nickderobertis","followers_url":"https://api.github.com/users/nickderobertis/followers","following_url":"https://api.github.com/users/nickderobertis/following{/other_user}","gists_url":"https://api.github.com/users/nickderobertis/gists{/gist_id}","starred_url":"https://api.github.com/users/nickderobertis/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nickderobertis/subscriptions","organizations_url":"https://api.github.com/users/nickderobertis/orgs","repos_url":"https://api.github.com/users/nickderobertis/repos","events_url":"https://api.github.com/users/nickderobertis/events{/privacy}","received_events_url":"https://api.github.com/users/nickderobertis/received_events","type":"User","user_view_type":"public","site_admin":false},"node_id":"RE_kwDOTx8aUc4Ydo3A","tag_name":"v0.68.1","target_commitish":"main","name":"v0.68.1","draft":false,"immutable":false,"prerelease":false,"created_at":"2026-10-12T09:20:23Z","updated_at":"2026-10-12T14:41:23Z","published_at":"2026-10-12T09:20:24Z","assets":[{"url":"https://api.github.com/repos/nickderobertis/onepipeline/relea