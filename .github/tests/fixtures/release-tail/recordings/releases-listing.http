9.1 | `0.29.1` | 0.29.1 |\n| `onetaskgraph-core` | 0.12.14 | `=0.12.14` | 0.12.14 |\n| `onetaskgraph-plugin-api` | 0.12.14 | `=0.12.14` | 0.12.14 |\n| `onetaskgraph-local-md` | 0.12.14 | `=0.12.14` | 0.12.14 |\n| `onemessagebus` | 0.9.4 | `0.9.3` | 0.9.4 |\n| `onebudgetspec-core` | 0.1.5 | `=0.1.5` | 0.1.5 |\n\nEvery linked engine is the newest its own requirement permits.\n"},{"url":"https://api.github.com/repos/nickderobertis/onepipeline/releases/430252934","assets_url":"https://api.github.com/repos/nickderobertis/onepipeline/releases/430252934/assets","upload_url":"https://uploads.github.com/repos/nickderobertis/onepipeline/releases/430252934/assets{?name,label}","html_url":"https://github.com/nickderobertis/onepipeline/releases/tag/v0.97.2","id":430252934,"author":{"login":"nickderobertis","id":19440155,"node_id":"MDQ6VXNlcjE5NDQwMTU1","avatar_url":"https://avatars.githubusercontent.com/u/19440155?v=4","gravatar_id":"","url":"https://api.github.com/users/nickderobertis","html_url":"https://github.com/nickderobertis","followers_url":"https://api.github.com/users/nickderobertis/followers","following_url":"https://api.github.com/users/nickderobertis/following{/other_user}","gists_url":"https://api.github.com/users/nickderobertis/gists{/gist_id}","starred_url":"https://api.github.com/users/nickderobertis/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nickderobertis/subscriptions","organizations_url":"https://api.github.com/users/nickderobertis/orgs","repos_url":"https://api.github.com/users/nickderobertis/repos","events_url":"https://api.github.com/users/nickderobertis/events{/privacy}","received_events_url":"https://api.github.com/users/nickderobertis/received_events","type":"User","user_view_type":"public","site_admin":false},"node_id":"RE_kwDOTx8aUc4ZpSOG","tag_name":"v0.97.2","target_commitish":"main","name":"v0.97.2","draft":false,"immutable":false,"prerelease":false,"created_at":"2026-10-31T23:40:51Z","updated_at":"2026-11-01T00:27:0