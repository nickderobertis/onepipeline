com/users/github-actions%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/github-actions%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/github-actions%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/github-actions%5Bbot%5D/repos","events_url":"https://api.github.com/users/github-actions%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/github-actions%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"content_type":"application/json","state":"uploaded","size":616,"digest":"sha256:c96d579ace9e0af3cb34d8cf3ab945525414fb439f6b6bc5f636ca31b3ada430","download_count":2,"created_at":"2026-10-11T18:29:41Z","updated_at":"2026-10-11T18:29:41Z","browser_download_url":"https://github.com/nickderobertis/onepipeline/releases/download/v0.66.0/release-outcome.json"}],"tarball_url":"https://api.github.com/repos/nickderobertis/onepipeline/tarball/v0.66.0","zipball_url":"https://api.github.com/repos/nickderobertis/onepipeline/zipball/v0.66.0","body":"### Added\n\n- *(flow)* hold a session for a launch flow that starts runs over time ([#849](https://github.com/nickderobertis/onepipeline/pull/849))\n\n<!-- linked-engines -->\n### Linked engines\n\nThe sibling engines this release actually links, resolved from its own `Cargo.lock`:\n\n| Engine | Linked | Requirement | Newest the requirement permits |\n| --- | --- | --- | --- |\n| `oneagentgraph` | 0.5.6 | `0.5.6` | 0.5.6 |\n| `onevcs` | 0.43.1 | `0.43.1` | 0.43.1 |\n| `onevcs-testing` | 0.13.4 | `0.13.4` | 0.13.4 |\n| `onejudge` | 0.19.0 | `0.19.0` | 0.19.0 |\n| `oneharness-core` | 0.24.2 | `0.24.1` | 0.24.2 |\n| `onetaskgraph-core` | 0.4.0 | `=0.4.0` | 0.4.0 |\n\n> [!NOTE]\n> A newer release of an engine below exists that this build's own requirements\n> **hold back**: it requires a sibling engine outside the window `Cargo.toml` states,\n> so no `cargo update` takes it without a second copy of that sibling, and only a\n> requirement move lifts it:\n>\n> - `onevcs-testing` links 0.13.4, the newest its requirement permits that this manifest admits; 0.13.7 is held back by `onevcs = \"0.43.1\"` (0.13.7 requires onevcs =0.45.0).\n\nEvery linked engine is the newest its own requirement permits among the releases this manifest admits.\n"},{"url":"https://api.github.com/repos/nickderobertis/onepipeline/releases/409512012","assets_url":"https://api.github.com/repos/nickderobertis/onepipeline/releases/409512012/assets","upload_url":"https://uploads.github.com/repos/nickderobertis/onepipeline/releases/409512012/assets{?name,label}","html_url":"https://github.com/nickderobertis/onepipeline/releases/tag/v0.65.0","id":409512012,"author":{"login":"nickderobertis","id":19440155,"node_id":"MDQ6VXNlcjE5NDQwMTU1","avatar_url":"https://avatars.githubusercontent.com/u/19440155?v=4","gravatar_id":"","url":"https://api.github.com/users/nickderobertis","html_url":"https://github.com/nickderobertis","followers_url":"https://api.github.com/users/nickderobertis/followers","following_url":"https://api.github.com/users/nickderobertis/following{/other_user}","gists_url":"https://api.github.com/users/nickderobertis/gists{/gist_id}","starred_url":"https://api.github.com/users/nickderobertis/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nickderobertis/subscriptions","organizations_url":"https://api.github.com/users/nickderobertis/orgs","repos_url":"https://api.github.com/users/nickderobertis/repos","events_url":"https://api.github.com/users/nickderobertis/events{/privacy}","received_events_url":"https://api.github.com/users/nickderobertis/received_events","type":"User","user_view_type":"public","site_admin":false},"node_id":"RE_kwDOTx8aUc4YaKhM","tag_name":"v0.65.0","target_commitish":"main","name":"v0.65.0","draft":false,"immutable":false,"prerelease":false,"created_at":"2026-10-11T07:45:29Z","updated_at":"2026-10-11T10:57:05Z","published_at":"2026-10-11T07:45:30Z","asse