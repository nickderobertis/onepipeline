s%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/github-actions%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"content_type":"application/octet-stream","state":"uploaded","size":616,"digest":"sha256:f41f3ba2b60cfb87bc547bc62bcbf1313ebd85674952c49406007b054282040b","download_count":1,"created_at":"2026-10-24T15:12:11Z","updated_at":"2026-10-24T15:12:12Z","browser_download_url":"https://github.com/nickderobertis/onepipeline/releases/download/v0.89.1/release-outcome.json"}],"tarball_url":"https://api.github.com/repos/nickderobertis/onepipeline/tarball/v0.89.1","zipball_url":"https://api.github.com/repos/nickderobertis/onepipeline/zipball/v0.89.1","body":"### Performance\n\n- *(review)* start far fewer git processes in a busy review round ([#1133](https://github.com/nickderobertis/onepipeline/pull/1133))\n\n<!-- linked-engines -->\n### Linked engines\n\nThe sibling engines this release actually links, resolved from its own `Cargo.lock`:\n\n| Engine | Linked | Requirement | Newest the requirement permits |\n| --- | --- | --- | --- |\n| `oneagentgraph` | 0.8.0 | `0.8.0` | 0.8.0 |\n| `onevcs` | **0.56.9** | `0.56.9` | **0.56.10** — this release is behind it |\n| `onevcs-testing` | **0.19.19** | `0.19.19` | **0.19.20** — this release is behind it |\n| `onejudge` | 0.21.0 | `0.21.0` | 0.21.0 |\n| `oneharness-core` | 0.29.1 | `0.29.1` | 0.29.1 |\n| `onetaskgraph-core` | 0.11.1 | `=0.11.1` | 0.11.1 |\n| `onetaskgraph-plugin-api` | 0.11.1 | `=0.11.1` | 0.11.1 |\n| `onetaskgraph-local-md` | 0.11.1 | `=0.11.1` | 0.11.1 |\n| `onemessagebus` | 0.9.3 | `0.9.3` | 0.9.3 |\n| `onebudgetspec-core` | 0.1.5 | `=0.1.5` | 0.1.5 |\n\n> [!WARNING]\n> This release links an engine **older than its own requirement permits**, so reading\n> `Cargo.toml` overstates what this build contains:\n>\n> - `onevcs` links 0.56.9; the requirement already permitted 0.56.10.\n> - `onevcs-testing` links 0.19.19; the requirement already permitted 0.19.20.\n"},{"url":"https://api.github.com/repos/nickderobertis/onepipeline/releases/422690907","assets_url":"https://api.github.com/repos/nickderobertis/onepipeline/releases/422690907/assets","upload_url":"https://uploads.github.com/repos/nickderobertis/onepipeline/releases/422690907/assets{?name,label}","html_url":"https://github.com/nickderobertis/onepipeline/releases/tag/v0.89.0","id":422690907,"author":{"login":"nickderobertis","id":19440155,"node_id":"MDQ6VXNlcjE5NDQwMTU1","avatar_url":"https://avatars.githubusercontent.com/u/19440155?v=4","gravatar_id":"","url":"https://api.github.com/users/nickderobertis","html_url":"https://github.com/nickderobertis","followers_url":"https://api.github.com/users/nickderobertis/followers","following_url":"https://api.github.com/users/nickderobertis/following{/other_user}","gists_url":"https://api.github.com/users/nickderobertis/gists{/gist_id}","starred_url":"https://api.github.com/users/nickderobertis/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nickderobertis/subscriptions","organizations_url":"https://api.github.com/users/nickderobertis/orgs","repos_url":"https://api.github.com/users/nickderobertis/repos","events_url":"https://api.github.com/users/nickderobertis/events{/privacy}","received_events_url":"https://api.github.com/users/nickderobertis/received_events","type":"User","user_view_type":"public","site_admin":false},"node_id":"RE_kwDOTx8aUc4ZMcBb","tag_name":"v0.89.0","target_commitish":"main","name":"v0.89.0","draft":false,"immutable":false,"prerelease":false,"created_at":"2026-10-24T11:29:26Z","updated_at":"2026-10-24T12:06:08Z","published_at":"2026-10-24T11:29:28Z","assets":[{"url":"https://api.github.com/repos/nickderobertis/onepipeline/releases/assets/672123781","id":672123781,"node_id":"RA_kwDOTx8aUc4oD8uF","name":"onepipeline-v0.89.0-aarch64-apple-darwin.sha256","label":"","uploader":{"login":"github-actions[bot]","id":41898282,"node_id":"MDM6Qm90NDE4OTgyODI=","avatar_url":"h