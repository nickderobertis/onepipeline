api.github.com/users/github-actions%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"content_type":"application/octet-stream","state":"uploaded","size":22785226,"digest":"sha256:0bebf126423fd960eb196404a968eda07a914a67a170bbff88019a2800d7e0ab","download_count":12,"created_at":"2026-10-21T08:01:50Z","updated_at":"2026-10-21T08:01:51Z","browser_download_url":"https://github.com/nickderobertis/onepipeline/releases/download/v0.81.0/onepipeline-v0.81.0-x86_64-unknown-linux-gnu.tar.gz"},{"url":"https://api.github.com/repos/nickderobertis/onepipeline/releases/assets/661874698","id":661874698,"node_id":"RA_kwDOTx8aUc4nc2gK","name":"release-outcome.json","label":"","uploader":{"login":"github-actions[bot]","id":41898282,"node_id":"MDM6Qm90NDE4OTgyODI=","avatar_url":"https://avatars.githubusercontent.com/in/15368?v=4","gravatar_id":"","url":"https://api.github.com/users/github-actions%5Bbot%5D","html_url":"https://github.com/apps/github-actions","followers_url":"https://api.github.com/users/github-actions%5Bbot%5D/followers","following_url":"https://api.github.com/users/github-actions%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/github-actions%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/github-actions%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/github-actions%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/github-actions%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/github-actions%5Bbot%5D/repos","events_url":"https://api.github.com/users/github-actions%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/github-actions%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"content_type":"application/octet-stream","state":"uploaded","size":616,"digest":"sha256:e735427286653fd6b122463972f1c0d3972b0575113b3d8d860a08c7edc07b9b","download_count":1,"created_at":"2026-10-21T08:39:42Z","updated_at":"2026-10-21T08:39:43Z","browser_download_url":"https://github.com/nickderobertis/onepipeline/releases/download/v0.81.0/release-outcome.json"}],"tarball_url":"https://api.github.com/repos/nickderobertis/onepipeline/tarball/v0.81.0","zipball_url":"https://api.github.com/repos/nickderobertis/onepipeline/zipball/v0.81.0","body":"### Performance\n\n- *(deps)* [**breaking**] link the plan store that copies without walking the board ([#1070](https://github.com/nickderobertis/onepipeline/pull/1070))\n\n<!-- linked-engines -->\n### Linked engines\n\nThe sibling engines this release actually links, resolved from its own `Cargo.lock`:\n\n| Engine | Linked | Requirement | Newest the requirement permits |\n| --- | --- | --- | --- |\n| `oneagentgraph` | 0.7.0 | `0.7.0` | 0.7.0 |\n| `onevcs` | 0.56.3 | `0.56.3` | 0.56.3 |\n| `onevcs-testing` | 0.19.13 | `0.19.13` | 0.19.13 |\n| `onejudge` | 0.20.0 | `0.20.0` | 0.20.0 |\n| `oneharness-core` | **0.28.6** | `0.28.5` | **0.28.7** — this release is behind it |\n| `onetaskgraph-core` | 0.9.2 | `=0.9.2` | 0.9.2 |\n| `onetaskgraph-plugin-api` | 0.9.2 | `=0.9.2` | 0.9.2 |\n| `onetaskgraph-local-md` | 0.9.2 | `=0.9.2` | 0.9.2 |\n| `onemessagebus` | 0.9.3 | `0.9.3` | 0.9.3 |\n| `onebudgetspec-core` | 0.1.5 | `=0.1.5` | 0.1.5 |\n\n> [!WARNING]\n> This release links an engine **older than its own requirement permits**, so reading\n> `Cargo.toml` overstates what this build contains:\n>\n> - `oneharness-core` links 0.28.6; the requirement already permitted 0.28.7.\n"},{"url":"https://api.github.com/repos/nickderobertis/onepipeline/releases/418875705","assets_url":"https://api.github.com/repos/nickderobertis/onepipeline/releases/418875705/assets","upload_url":"https://uploads.github.com/repos/nickderobertis/onepipeline/releases/418875705/assets{?name,label}","html_url":"https://github.com/nickderobertis/onepipeline/releases/tag/v0.80.2","id":418875705,"author":{"login":"nickderobertis","id":19440155,"node_id