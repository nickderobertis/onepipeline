ub.com/users/github-actions%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/github-actions%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/github-actions%5Bbot%5D/repos","events_url":"https://api.github.com/users/github-actions%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/github-actions%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"content_type":"application/json","state":"uploaded","size":616,"digest":"sha256:c7582279ec1e41d480ba4a5853a91f2507fccc87d13620d46d0bacc26b702bb1","download_count":1,"created_at":"2026-10-16T00:22:24Z","updated_at":"2026-10-16T00:22:24Z","browser_download_url":"https://github.com/nickderobertis/onepipeline/releases/download/v0.73.0/release-outcome.json"}],"tarball_url":"https://api.github.com/repos/nickderobertis/onepipeline/tarball/v0.73.0","zipball_url":"https://api.github.com/repos/nickderobertis/onepipeline/zipball/v0.73.0","body":"### Added\n\n- *(deps)* [**breaking**] link the versioned project and document cache ([#942](https://github.com/nickderobertis/onepipeline/pull/942))\n\n<!-- linked-engines -->\n### Linked engines\n\nThe sibling engines this release actually links, resolved from its own `Cargo.lock`:\n\n| Engine | Linked | Requirement | Newest the requirement permits |\n| --- | --- | --- | --- |\n| `oneagentgraph` | 0.5.7 | `0.5.6` | 0.5.7 |\n| `onevcs` | **0.51.2** | `0.51.2` | **0.51.3** — this release is behind it |\n| `onevcs-testing` | **0.19.2** | `0.19.2` | **0.19.3** — this release is behind it |\n| `onejudge` | 0.19.0 | `0.19.0` | 0.19.0 |\n| `oneharness-core` | 0.24.2 | `0.24.1` | 0.24.2 |\n| `onetaskgraph-core` | 0.7.0 | `=0.7.0` | 0.7.0 |\n\n> [!NOTE]\n> A newer release of an engine below exists that this build's own requirements\n> **hold back**: it requires a sibling engine outside the window `Cargo.toml` states,\n> so no `cargo update` takes it without a second copy of that sibling, and only a\n> requirement move lifts it:\n>\n> - `oneagentgraph` links 0.5.7, the newest its requirement permits that this manifest admits; 0.5.12 is held back by `oneharness-core = \"0.24.1\"` (0.5.12 requires oneharness-core ^0.26.0).\n> - `onejudge` links 0.19.0, the newest its requirement permits that this manifest admits; 0.19.3 is held back by `oneharness-core = \"0.24.1\"` (0.19.3 requires oneharness-core ^0.26.0).\n\n> [!WARNING]\n> This release links an engine **older than its own requirement permits**, so reading\n> `Cargo.toml` overstates what this build contains:\n>\n> - `onevcs` links 0.51.2; the requirement already permitted 0.51.3.\n> - `onevcs-testing` links 0.19.2; the requirement already permitted 0.19.3.\n"},{"url":"https://api.github.com/repos/nickderobertis/onepipeline/releases/413247801","assets_url":"https://api.github.com/repos/nickderobertis/onepipeline/releases/413247801/assets","upload_url":"https://uploads.github.com/repos/nickderobertis/onepipeline/releases/413247801/assets{?name,label}","html_url":"https://github.com/nickderobertis/onepipeline/releases/tag/v0.72.0","id":413247801,"author":{"login":"nickderobertis","id":19440155,"node_id":"MDQ6VXNlcjE5NDQwMTU1","avatar_url":"https://avatars.githubusercontent.com/u/19440155?v=4","gravatar_id":"","url":"https://api.github.com/users/nickderobertis","html_url":"https://github.com/nickderobertis","followers_url":"https://api.github.com/users/nickderobertis/followers","following_url":"https://api.github.com/users/nickderobertis/following{/other_user}","gists_url":"https://api.github.com/users/nickderobertis/gists{/gist_id}","starred_url":"https://api.github.com/users/nickderobertis/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nickderobertis/subscriptions","organizations_url":"https://api.github.com/users/nickderobertis/orgs","repos_url":"https://api.github.com/users/nickderobertis/repos","events_url":"https://api.github.com/users/nickderobertis/events{/privacy}","received_events_url":