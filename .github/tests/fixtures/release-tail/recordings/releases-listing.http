ravatar_id":"","url":"https://api.github.com/users/github-actions%5Bbot%5D","html_url":"https://github.com/apps/github-actions","followers_url":"https://api.github.com/users/github-actions%5Bbot%5D/followers","following_url":"https://api.github.com/users/github-actions%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/github-actions%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/github-actions%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/github-actions%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/github-actions%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/github-actions%5Bbot%5D/repos","events_url":"https://api.github.com/users/github-actions%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/github-actions%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"content_type":"application/json","state":"uploaded","size":616,"digest":"sha256:34fed19a053247481ad57bee79cc0dcbeabfa6455596811ed9baa251171dbaaf","download_count":2,"created_at":"2026-10-08T23:48:08Z","updated_at":"2026-10-08T23:48:08Z","browser_download_url":"https://github.com/nickderobertis/onepipeline/releases/download/v0.63.3/release-outcome.json"}],"tarball_url":"https://api.github.com/repos/nickderobertis/onepipeline/tarball/v0.63.3","zipball_url":"https://api.github.com/repos/nickderobertis/onepipeline/zipball/v0.63.3","body":"### Fixed\n\n- *(tests)* make five intermittently failing tests deterministic ([#810](https://github.com/nickderobertis/onepipeline/pull/810))\n\n<!-- linked-engines -->\n### Linked engines\n\nThe sibling engines this release actually links, resolved from its own `Cargo.lock`:\n\n| Engine | Linked | Requirement | Newest the requirement permits |\n| --- | --- | --- | --- |\n| `oneagentgraph` | 0.5.5 | `0.5.5` | 0.5.5 |\n| `onevcs` | **0.42.1** | `0.42.0` | **0.42.2** — this release is behind it |\n| `onevcs-testing` | **0.13.1** | `0.13.0` | **0.13.2** — this release is behind it |\n| `onejudge` | 0.17.2 | `0.17.1` | 0.17.2 |\n| `oneharness-core` | 0.24.2 | `0.24.1` | 0.24.2 |\n| `onetaskgraph-core` | 0.3.9 | `=0.3.9` | 0.3.9 |\n\n> [!WARNING]\n> This release links an engine **older than its own requirement permits**, so reading\n> `Cargo.toml` overstates what this build contains:\n>\n> - `onevcs` links 0.42.1; the requirement already permitted 0.42.2.\n> - `onevcs-testing` links 0.13.1; the requirement already permitted 0.13.2.\n"},{"url":"https://api.github.com/repos/nickderobertis/onepipeline/releases/406936507","assets_url":"https://api.github.com/repos/nickderobertis/onepipeline/releases/406936507/assets","upload_url":"https://uploads.github.com/repos/nickderobertis/onepipeline/releases/406936507/assets{?name,label}","html_url":"https://github.com/nickderobertis/onepipeline/releases/tag/v0.63.2","id":406936507,"author":{"login":"nickderobertis","id":19440155,"node_id":"MDQ6VXNlcjE5NDQwMTU1","avatar_url":"https://avatars.githubusercontent.com/u/19440155?v=4","gravatar_id":"","url":"https://api.github.com/users/nickderobertis","html_url":"https://github.com/nickderobertis","followers_url":"https://api.github.com/users/nickderobertis/followers","following_url":"https://api.github.com/users/nickderobertis/following{/other_user}","gists_url":"https://api.github.com/users/nickderobertis/gists{/gist_id}","starred_url":"https://api.github.com/users/nickderobertis/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nickderobertis/subscriptions","organizations_url":"https://api.github.com/users/nickderobertis/orgs","repos_url":"https://api.github.com/users/nickderobertis/repos","events_url":"https://api.github.com/users/nickderobertis/events{/privacy}","received_events_url":"https://api.github.com/users/nickderobertis/received_events","type":"User","user_view_type":"public","site_admin":false},"node_id":"RE_kwDOTx8aUc4YQVu7","tag_name":"v0.6