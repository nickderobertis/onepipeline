ub.com/nickderobertis/onepipeline/pull/653))\n\n### Fixed\n\n- *(reply)* give a correlated ruling to its question, settled or live ([#667](https://github.com/nickderobertis/onepipeline/pull/667))\n\n<!-- linked-engines -->\n### Linked engines\n\nThe sibling engines this release actually links, resolved from its own `Cargo.lock`:\n\n| Engine | Linked | Requirement | Newest the requirement permits |\n| --- | --- | --- | --- |\n| `oneagentgraph` | 0.5.5 | `0.5.5` | 0.5.5 |\n| `onevcs` | 0.37.0 | `0.37.0` | 0.37.0 |\n| `onevcs-testing` | 0.10.0 | `0.10.0` | 0.10.0 |\n| `onejudge` | 0.17.1 | `0.17.1` | 0.17.1 |\n| `oneharness-core` | 0.24.0 | `0.24.0` | 0.24.0 |\n| `onetaskgraph-core` | 0.2.54 | `=0.2.54` | 0.2.54 |\n\nEvery linked engine is the newest its own requirement permits.\n"},{"url":"https://api.github.com/repos/nickderobertis/onepipeline/releases/401346461","assets_url":"https://api.github.com/repos/nickderobertis/onepipeline/releases/401346461/assets","upload_url":"https://uploads.github.com/repos/nickderobertis/onepipeline/releases/401346461/assets{?name,label}","html_url":"https://github.com/nickderobertis/onepipeline/releases/tag/v0.57.2","id":401346461,"author":{"login":"nickderobertis","id":19440155,"node_id":"MDQ6VXNlcjE5NDQwMTU1","avatar_url":"https://avatars.githubusercontent.com/u/19440155?v=4","gravatar_id":"","url":"https://api.github.com/users/nickderobertis","html_url":"https://github.com/nickderobertis","followers_url":"https://api.github.com/users/nickderobertis/followers","following_url":"https://api.github.com/users/nickderobertis/following{/other_user}","gists_url":"https://api.github.com/users/nickderobertis/gists{/gist_id}","starred_url":"https://api.github.com/users/nickderobertis/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nickderobertis/subscriptions","organizations_url":"https://api.github.com/users/nickderobertis/orgs","repos_url":"https://api.github.com/users/nickderobertis/repos","events_url":"https://ap