ertis/onepipeline/releases/download/v0.78.0/onepipeline-v0.78.0-x86_64-unknown-linux-gnu.tar.gz"},{"url":"https://api.github.com/repos/nickderobertis/onepipeline/releases/assets/655913639","id":655913639,"node_id":"RA_kwDOTx8aUc4nGHKn","name":"release-outcome.json","label":"","uploader":{"login":"github-actions[bot]","id":41898282,"node_id":"MDM6Qm90NDE4OTgyODI=","avatar_url":"https://avatars.githubusercontent.com/in/15368?v=4","gravatar_id":"","url":"https://api.github.com/users/github-actions%5Bbot%5D","html_url":"https://github.com/apps/github-actions","followers_url":"https://api.github.com/users/github-actions%5Bbot%5D/followers","following_url":"https://api.github.com/users/github-actions%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/github-actions%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/github-actions%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/github-actions%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/github-actions%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/github-actions%5Bbot%5D/repos","events_url":"https://api.github.com/users/github-actions%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/github-actions%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"content_type":"application/octet-stream","state":"uploaded","size":616,"digest":"sha256:43d4e1e8bc2cbd098812cc067c33da5dd55983cc16117fe9af0f5f93eba4a56b","download_count":1,"created_at":"2026-10-19T10:10:15Z","updated_at":"2026-10-19T10:10:16Z","browser_download_url":"https://github.com/nickderobertis/onepipeline/releases/download/v0.78.0/release-outcome.json"}],"tarball_url":"https://api.github.com/repos/nickderobertis/onepipeline/tarball/v0.78.0","zipball_url":"https://api.github.com/repos/nickderobertis/onepipeline/zipball/v0.78.0","body":"### Fixed\n\n- hold live notes per receiver and never hold findings behind them ([#1026](https://github.com/nickderobertis/onepipeline/pull/1026))\n- *(deps)* adopt the plan store that tolerates a source no layer defines ([#1030](https://github.com/nickderobertis/onepipeline/pull/1030))\n\n<!-- linked-engines -->\n### Linked engines\n\nThe sibling engines this release actually links, resolved from its own `Cargo.lock`:\n\n| Engine | Linked | Requirement | Newest the requirement permits |\n| --- | --- | --- | --- |\n| `oneagentgraph` | 0.5.14 | `0.5.13` | 0.5.14 |\n| `onevcs` | 0.52.1 | `0.52.0` | 0.52.1 |\n| `onevcs-testing` | 0.19.5 | `0.19.4` | 0.19.5 |\n| `onejudge` | 0.19.5 | `0.19.5` | 0.19.5 |\n| `oneharness-core` | **0.28.2** | `0.28.2` | **0.28.4** — this release is behind it |\n| `onetaskgraph-core` | 0.7.3 | `=0.7.3` | 0.7.3 |\n| `onetaskgraph-plugin-api` | 0.7.3 | `=0.7.3` | 0.7.3 |\n| `onetaskgraph-local-md` | 0.7.3 | `=0.7.3` | 0.7.3 |\n| `onemessagebus` | **0.9.1** | `0.9.1` | **0.9.2** — this release is behind it |\n| `onebudgetspec-core` | 0.1.5 | `=0.1.5` | 0.1.5 |\n\n> [!NOTE]\n> A newer release of an engine below exists that this build's own requirements\n> **hold back**: it requires a sibling engine outside the window `Cargo.toml` states,\n> so no `cargo update` takes it without a second copy of that sibling, and only a\n> requirement move lifts it:\n>\n> - `onevcs-testing` links 0.19.5, the newest its requirement permits that this manifest admits; 0.19.12 is held back by `onevcs = \"0.52.0\"` (0.19.12 requires onevcs =0.56.2).\n\n> [!WARNING]\n> This release links an engine **older than its own requirement permits**, so reading\n> `Cargo.toml` overstates what this build contains:\n>\n> - `oneharness-core` links 0.28.2; the requirement already permitted 0.28.4.\n> - `onemessagebus` links 0.9.1; the requirement already permitted 0.9.2.\n"},{"url":"https://api.github.com/repos/nickderobertis/onepipeline/releases/416834908","assets_url":"https://api.github.com/repos/nickderobertis/onepipeline/releases/41683