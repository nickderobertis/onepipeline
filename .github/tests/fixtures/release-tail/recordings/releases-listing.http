ub-actions%5Bbot%5D/repos","events_url":"https://api.github.com/users/github-actions%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/github-actions%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"content_type":"application/json","state":"uploaded","size":616,"digest":"sha256:072958959c8772556e6a704e06102db4f1aabcee135615d455a5ec015166fbbb","download_count":1,"created_at":"2026-09-30T07:42:37Z","updated_at":"2026-09-30T07:42:37Z","browser_download_url":"https://github.com/nickderobertis/onepipeline/releases/download/v0.53.3/release-outcome.json"}],"tarball_url":"https://api.github.com/repos/nickderobertis/onepipeline/tarball/v0.53.3","zipball_url":"https://api.github.com/repos/nickderobertis/onepipeline/zipball/v0.53.3","body":"### Fixed\n\n- *(deps)* link the onetaskgraph release that searches boards natively and follows copy links ([#598](https://github.com/nickderobertis/onepipeline/pull/598))\n\n<!-- linked-engines -->\n### Linked engines\n\nThe sibling engines this release actually links, resolved from its own `Cargo.lock`:\n\n| Engine | Linked | Requirement | Newest the requirement permits |\n| --- | --- | --- | --- |\n| `oneagentgraph` | 0.5.3 | `0.5.2` | 0.5.3 |\n| `onevcs` | 0.34.1 | `0.34.1` | 0.34.1 |\n| `onevcs-testing` | 0.8.5 | `0.8.5` | 0.8.5 |\n| `onejudge` | 0.14.0 | `0.14.0` | 0.14.0 |\n| `oneharness-core` | 0.18.0 | `0.18.0` | 0.18.0 |\n| `onetaskgraph-core` | 0.2.52 | `=0.2.52` | 0.2.52 |\n\n> [!NOTE]\n> A newer release of an engine below exists that this build's own requirements\n> **hold back**: it requires a sibling engine outside the window `Cargo.toml` states,\n> so no `cargo update` takes it without a second copy of that sibling, and only a\n> requirement move lifts it:\n>\n> - `onevcs-testing` links 0.8.5, the newest its requirement permits that this manifest admits; 0.8.6 is held back by `onevcs = \"0.34.1\"` (0.8.6 requires onevcs ^0.35.0).\n\nEvery linked engine is the newest its own requirement permits among the releases this manifest admits.\n"},{"url":"https://api.github.com/repos/nickderobertis/onepipeline/releases/399658786","assets_url":"https://api.github.com/repos/nickderobertis/onepipeline/releases/399658786/assets","upload_url":"https://uploads.github.com/repos/nickderobertis/onepipeline/releases/399658786/assets{?name,label}","html_url":"https://github.com/nickderobertis/onepipeline/releases/tag/v0.53.2","id":399658786,"author":{"login":"nickderobertis","id":19440155,"node_id":"MDQ6VXNlcjE5NDQwMTU1","avatar_url":"https://avatars.githubusercontent.com/u/19440155?v=4","gravatar_id":"","url":"https://api.github.com/users/nickderobertis","html_url":"https://github.com/nickderobertis","followers_url":"https://api.github.com/users/nickderobertis/followers","following_url":"https://api.github.com/users/nickderobertis/following{/other_user}","gists_url":"https://api.github.com/users/nickderobertis/gists{/gist_id}","starred_url":"https://api.github.com/users/nickderobertis/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nickderobertis/subscriptions","organizations_url":"https://api.github.com/users/nickderobertis/orgs","repos_url":"https://api.github.com/users/nickderobertis/repos","events_url":"https://api.github.com/users/nickderobertis/events{/privacy}","received_events_url":"https://api.github.com/users/nickderobertis/received_events","type":"User","user_view_type":"public","site_admin":false},"node_id":"RE_kwDOTx8aUc4X0k8i","tag_name":"v0.53.2","target_commitish":"main","name":"v0.53.2","draft":false,"immutable":false,"prerelease":false,"created_at":"2026-09-30T02:02:12Z","updated_at":"2026-09-30T03:51:35Z","published_at":"2026-09-30T02:02:13Z","assets":[{"url":"https://api.github.com/repos/nickderobertis/onepipeline/releases/assets/599890039","id":599890039,"node_id":"RA_kwDOTx8aUc4jwZh3","name":"onepipeline-v0.53.2-aarch64-apple-darwin.sha256","label":"","uploader":{"login":"github-actions[bot]",