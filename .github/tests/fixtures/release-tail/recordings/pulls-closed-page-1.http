ertis/onepipeline/pull/1130))\n- *(journal)* let another process append to a run's journal on Windows while a driver holds it ([#1129](https://github.com/nickderobertis/onepipeline/pull/1129))\n</blockquote>\n\n\n</p></details>\n\n---\nThis PR was generated with [release-plz](https://github.com/release-plz/release-plz/).","created_at":"2026-10-24T01:31:21Z","updated_at":"2026-10-24T07:31:51Z","closed_at":"2026-10-24T07:31:50Z","merged_at":"2026-10-24T07:31:50Z","merge_commit_sha":"dd9697799684b64e7a50cbc0f78cf35e1fdda818","assignees":[],"requested_reviewers":[],"requested_teams":[],"labels":[],"milestone":null,"draft":false,"commits_url":"https://api.github.com/repos/nickderobertis/onepipeline/pulls/1131/commits","review_comments_url":"https://api.github.com/repos/nickderobertis/onepipeline/pulls/1131/comments","review_comment_url":"https://api.github.com/repos/nickderobertis/onepipeline/pulls/comments{/number}","comments_url":"https://api.github.com/repos/nickderobertis/onepipeline/issues/1131/comments","statuses_url":"https://api.github.com/repos/nickderobertis/onepipeline/statuses/b47ced766adaa5d1a0bfe432c2f1ce7cfffc7fd2","head":{"label":"nickderobertis:release-plz-2026-10-24T01-31-18Z","ref":"release-plz-2026-10-24T01-31-18Z","sha":"b47ced766adaa5d1a0bfe432c2f1ce7cfffc7fd2","user":{"login":"nickderobertis","id":19440155,"node_id":"MDQ6VXNlcjE5NDQwMTU1","avatar_url":"https://avatars.githubusercontent.com/u/19440155?v=4","gravatar_id":"","url":"https://api.github.com/users/nickderobertis","html_url":"https://github.com/nickderobertis","followers_url":"https://api.github.com/users/nickderobertis/followers","following_url":"https://api.github.com/users/nickderobertis/following{/other_user}","gists_url":"https://api.github.com/users/nickderobertis/gists{/gist_id}","starred_url":"https://api.github.com/users/nickderobertis/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nickderobertis/subscriptions","organizations_url":"https://api.github.com