.com/users/nickderobertis/gists{/gist_id}","starred_url":"https://api.github.com/users/nickderobertis/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nickderobertis/subscriptions","organizations_url":"https://api.github.com/users/nickderobertis/orgs","repos_url":"https://api.github.com/users/nickderobertis/repos","events_url":"https://api.github.com/users/nickderobertis/events{/privacy}","received_events_url":"https://api.github.com/users/nickderobertis/received_events","type":"User","user_view_type":"public","site_admin":false},"merge_method":"squash","commit_title":null,"commit_message":null},"assignee":null,"active_lock_reason":null},{"url":"https://api.github.com/repos/nickderobertis/onepipeline/pulls/1121","id":4981000554,"node_id":"PR_kwDOTx8aUc8AAAABKOQJag","html_url":"https://github.com/nickderobertis/onepipeline/pull/1121","diff_url":"https://github.com/nickderobertis/onepipeline/pull/1121.diff","patch_url":"https://github.com/nickderobertis/onepipeline/pull/1121.patch","issue_url":"https://api.github.com/repos/nickderobertis/onepipeline/issues/1121","number":1121,"state":"closed","locked":false,"title":"fix(tests): keep two of onepipeline's continuation tests reliable on Windows","user":{"login":"nickderobertis","id":19440155,"node_id":"MDQ6VXNlcjE5NDQwMTU1","avatar_url":"https://avatars.githubusercontent.com/u/19440155?v=4","gravatar_id":"","url":"https://api.github.com/users/nickderobertis","html_url":"https://github.com/nickderobertis","followers_url":"https://api.github.com/users/nickderobertis/followers","following_url":"https://api.github.com/users/nickderobertis/following{/other_user}","gists_url":"https://api.github.com/users/nickderobertis/gists{/gist_id}","starred_url":"https://api.github.com/users/nickderobertis/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nickderobertis/subscriptions","organizations_url":"https://api.github.com/users/nickderobertis/orgs","repos_url":"https://api.github.com/users/nickderobertis/repos","events_url":"https://api.github.com/users/nickderobertis/events{/privacy}","received_events_url":"https://api.github.com/users/nickderobertis/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"## What\n\nBound subprocess waits in the adoption-after-takeover journey, with failures naming the stalled command and its output. Add a deterministic journey that orders shutdown before an admitted dispatch starts, then verifies takeover completes after its required wait and the run finishes. Bound rendezvous connections and handshakes too.\n\n## Why\n\nFlaky Windows continuation tests have cost hours of CI reruns while restoring a long multi-repository run. These journeys make the shutdown/admission ordering reproducible and stalled steps diagnosable without increasing runner timeouts or weakening existing assertions.\n\n## Additional info\n\nChanges are confined to tests and their harness. The claim-deadline unit test is out of scope because the claim change that introduced it was withdrawn and it is absent from this branch’s base.","created_at":"2026-10-23T09:56:09Z","updated_at":"2026-10-23T12:20:23Z","closed_at":"2026-10-23T12:20:20Z","merged_at":"2026-10-23T12:20:20Z","merge_commit_sha":"5af95f010eae03f6cbe2a4b43a2128fe9e1129d9","assignees":[],"requested_reviewers":[],"requested_teams":[],"labels":[],"milestone":null,"draft":false,"commits_url":"https://api.github.com/repos/nickderobertis/onepipeline/pulls/1121/commits","review_comments_url":"https://api.github.com/repos/nickderobertis/onepipeline/pulls/1121/comments","review_comment_url":"https://api.github.com/repos/nickderobertis/onepipeline/pulls/comments{/number}","comments_url":"https://api.github.com/repos/nickderobertis/onepipeline/issues/1121/comments","statuses_url":"https://api.github.com/repos/nickderobertis/onepipeline/statuses/9f646b7b3b03ca4773979e778210bf3b42b59621","head":{"label":"nickderobertis:nick/Keep-a-long-run-s-driver-responsive-howe