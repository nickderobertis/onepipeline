f57d7b6f3f33332241a8045971"}},"author_association":"OWNER","auto_merge":null,"assignee":null,"active_lock_reason":null},{"url":"https://api.github.com/repos/nickderobertis/onepipeline/pulls/1129","id":4990330893,"node_id":"PR_kwDOTx8aUc8AAAABKXJoDQ","html_url":"https://github.com/nickderobertis/onepipeline/pull/1129","diff_url":"https://github.com/nickderobertis/onepipeline/pull/1129.diff","patch_url":"https://github.com/nickderobertis/onepipeline/pull/1129.patch","issue_url":"https://api.github.com/repos/nickderobertis/onepipeline/issues/1129","number":1129,"state":"closed","locked":false,"title":"fix(journal): let another process append to a run's journal on Windows while a driver holds it","user":{"login":"nickderobertis","id":19440155,"node_id":"MDQ6VXNlcjE5NDQwMTU1","avatar_url":"https://avatars.githubusercontent.com/u/19440155?v=4","gravatar_id":"","url":"https://api.github.com/users/nickderobertis","html_url":"https://github.com/nickderobertis","followers_url":"https://api.github.com/users/nickderobertis/followers","following_url":"https://api.github.com/users/nickderobertis/following{/other_user}","gists_url":"https://api.github.com/users/nickderobertis/gists{/gist_id}","starred_url":"https://api.github.com/users/nickderobertis/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nickderobertis/subscriptions","organizations_url":"https://api.github.com/users/nickderobertis/orgs","repos_url":"https://api.github.com/users/nickderobertis/repos","events_url":"https://api.github.com/users/nickderobertis/events{/privacy}","received_events_url":"https://api.github.com/users/nickderobertis/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"## What\n\nAllow other processes to append to a journal held by a Windows driver while keeping onepipeline’s own appenders serialized. Write records at the current end of the file so intervening appends survive, with an end-to-end regression covering concurrent writers and scratch retention.\n\n## Why\n\nWindows previously refused external appends with a sharing violation for as long as a driver, `surface`, or `reply` held the journal, causing the unreadable-journal scratch-retention test to fail on main’s Windows shard. This brings Windows sharing behavior into line with Unix.","created_at":"2026-10-23T23:04:10Z","updated_at":"2026-10-24T01:28:14Z","closed_at":"2026-10-24T01:28:11Z","merged_at":"2026-10-24T01:28:11Z","merge_commit_sha":"64abf6f1c4b1cc06364221af9a3b7a02b6196871","assignees":[],"requested_reviewers":[],"requested_teams":[],"labels":[],"milestone":null,"draft":false,"commits_url":"https://api.github.com/repos/nickderobertis/onepipeline/pulls/1129/commits","review_comments_url":"https://api.github.com/repos/nickderobertis/onepipeline/pulls/1129/comments","review_comment_url":"https://api.github.com/repos/nickderobertis/onepipeline/pulls/comments{/number}","comments_url":"https://api.github.com/repos/nickderobertis/onepipeline/issues/1129/comments","statuses_url":"https://api.github.com/repos/nickderobertis/onepipeline/statuses/0091f640dfafa33d9b470ac1b3d7be6780dd9765","head":{"label":"nickderobertis:nick/Keep-a-long-run-s-driver-responsive-however-large-its-journal-grows-and-stop-it-cancelling-its-own-work/op-ci-win-journal-share","ref":"nick/Keep-a-long-run-s-driver-responsive-however-large-its-journal-grows-and-stop-it-cancelling-its-own-work/op-ci-win-journal-share","sha":"0091f640dfafa33d9b470ac1b3d7be6780dd9765","user":{"login":"nickderobertis","id":19440155,"node_id":"MDQ6VXNlcjE5NDQwMTU1","avatar_url":"https://avatars.githubusercontent.com/u/19440155?v=4","gravatar_id":"","url":"https://api.github.com/users/nickderobertis","html_url":"https://github.com/nickderobertis","followers_url":"https://api.github.com/users/nickderobertis/followers","following_url":"https://api.github.com/users/nickderobertis/following{/other_user}","gists_url":"https://api.github.com/users/nickderobertis/gists{/gist_id}","starred_url":"https: