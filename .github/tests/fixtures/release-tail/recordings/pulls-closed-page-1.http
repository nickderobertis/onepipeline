ps://api.github.com/licenses/mit","node_id":"MDc6TGljZW5zZTEz"},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"has_pull_requests":true,"pull_request_creation_policy":"all","topics":[],"visibility":"public","forks":2,"open_issues":252,"watchers":1,"default_branch":"main"}},"_links":{"self":{"href":"https://api.github.com/repos/nickderobertis/onepipeline/pulls/1135"},"html":{"href":"https://github.com/nickderobertis/onepipeline/pull/1135"},"issue":{"href":"https://api.github.com/repos/nickderobertis/onepipeline/issues/1135"},"comments":{"href":"https://api.github.com/repos/nickderobertis/onepipeline/issues/1135/comments"},"review_comments":{"href":"https://api.github.com/repos/nickderobertis/onepipeline/pulls/1135/comments"},"review_comment":{"href":"https://api.github.com/repos/nickderobertis/onepipeline/pulls/comments{/number}"},"commits":{"href":"https://api.github.com/repos/nickderobertis/onepipeline/pulls/1135/commits"},"statuses":{"href":"https://api.github.com/repos/nickderobertis/onepipeline/statuses/a62385c6fb6793971cea3e0dd10a6cb9bdf9112e"}},"author_association":"OWNER","auto_merge":{"enabled_by":{"login":"nickderobertis","id":19440155,"node_id":"MDQ6VXNlcjE5NDQwMTU1","avatar_url":"https://avatars.githubusercontent.com/u/19440155?v=4","gravatar_id":"","url":"https://api.github.com/users/nickderobertis","html_url":"https://github.com/nickderobertis","followers_url":"https://api.github.com/users/nickderobertis/followers","following_url":"https://api.github.com/users/nickderobertis/following{/other_user}","gists_url":"https://api.github.com/users/nickderobertis/gists{/gist_id}","starred_url":"https://api.github.com/users/nickderobertis/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nickderobertis/subscriptions","organizations_url":"https://api.github.com/users/nickderobertis/orgs","repos_url":"https://api.github.com/users/nickderobertis/repos","events_url":"https://api.github.com/users/nickderobertis/events{/privacy}","received_events_url":"https://api.github.com/users/nickderobertis/received_events","type":"User","user_view_type":"public","site_admin":false},"merge_method":"squash","commit_title":null,"commit_message":null},"assignee":null,"active_lock_reason":null},{"url":"https://api.github.com/repos/nickderobertis/onepipeline/pulls/1134","id":4993351618,"node_id":"PR_kwDOTx8aUc8AAAABKaB_wg","html_url":"https://github.com/nickderobertis/onepipeline/pull/1134","diff_url":"https://github.com/nickderobertis/onepipeline/pull/1134.diff","patch_url":"https://github.com/nickderobertis/onepipeline/pull/1134.patch","issue_url":"https://api.github.com/repos/nickderobertis/onepipeline/issues/1134","number":1134,"state":"closed","locked":false,"title":"fix(watch): never return a cursor past a record the watch did not emit","user":{"login":"nickderobertis","id":19440155,"node_id":"MDQ6VXNlcjE5NDQwMTU1","avatar_url":"https://avatars.githubusercontent.com/u/19440155?v=4","gravatar_id":"","url":"https://api.github.com/users/nickderobertis","html_url":"https://github.com/nickderobertis","followers_url":"https://api.github.com/users/nickderobertis/followers","following_url":"https://api.github.com/users/nickderobertis/following{/other_user}","gists_url":"https://api.github.com/users/nickderobertis/gists{/gist_id}","starred_url":"https://api.github.com/users/nickderobertis/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nickderobertis/subscriptions","organizations_url":"https://api.github.com/users/nickderobertis/orgs","repos_url":"https://api.github.com/users/nickderobertis/repos","events_url":"https://api.github.com/users/nickderobertis/events{/privacy}","received_events_url":"https://api.github.com/users/nickderobertis/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"## What\n\nFix the torn-record watch test’s startup race by waiting for its driver to exit before appending a partial record. Previously, the driver could append a complete `driver-exited` record after `result.json` appeared; the watch correctly advanced past that profile-hidden record, triggering a false failure.\n\nAdd controlled interleavings through the real watch CLI to verify that a record completed during a read is either emitted or retained for the next watch, without loss or duplication.\n\n## Why\n\nFix flaky tests rather than tolerate unrelated required Windows checks failing. This failure blocked work such as #1128’s stop fix, needed to stop Codex launches consuming network and quota on dispatch hosts (nickderobertis/oneharness#1442), while obscuring whether supervisors could actually lose journal events.","created_at":"2026-10-24T07:04:20Z","updated_at":"2026-10-24T09:31:45Z","closed_at":"2026-10-24T09:31:43Z","merged_at":"2026-10-24T09:31:43Z","merge_commit_sha":"4b40f8c130897b4a6b1ce017ca10566a9ba41793","assignees":[],"requested_reviewers":[],"requested_teams":[],"labels":[],"milestone":null,"draft":false,"commits_url":"https://api.github.com/repos/nickderobertis/onepipeline/pulls/1134/commits","review_comments_url":"https://api.github.com/repos/nickderobertis/onepipeline/pulls/1134/comments","review_comment_url":"https://api.github.com/repos/nickderobertis/onepipeline/pulls/comments{/number}","comments_url":"https://api.github.com/repos/nickderobertis/onepipeline/issues/1134/comments","statuses_url":"https://api.github.com/repos/nickderobertis/onepipeline/statuses/53051c43ca24d0d6a05103aef5c8e01b5570805e","head":{"label":"nickderobertis:nick/Share-one-Codex-app-server-across-dispatches-and-budget-network-data-per-launch/onepipeline-watch-torn-record-flake","ref":"nick/Share-one-Codex-app-server-across-dispatches-and-budget-network-data-per-launch/onepipeline-watch-torn-record-flake","sha":"53051c43ca24d0d6a05103aef5c8e01b5570805e","user":{"login":"nickderobertis","id":19440155,"node_id":"MDQ6VXNlcjE5NDQwMTU1","avatar_url":"https://avatars.githubusercontent.com/u/19440155?v=4","gravatar_id":"","url":