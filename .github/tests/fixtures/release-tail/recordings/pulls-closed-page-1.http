ne/labels{/name}","releases_url":"https://api.github.com/repos/nickderobertis/onepipeline/releases{/id}","deployments_url":"https://api.github.com/repos/nickderobertis/onepipeline/deployments","created_at":"2026-08-08T05:18:50Z","updated_at":"2026-11-01T09:13:42Z","pushed_at":"2026-11-01T09:36:05Z","git_url":"git://github.com/nickderobertis/onepipeline.git","ssh_url":"git@github.com:nickderobertis/onepipeline.git","clone_url":"https://github.com/nickderobertis/onepipeline.git","svn_url":"https://github.com/nickderobertis/onepipeline","homepage":null,"size":24249,"stargazers_count":1,"watchers_count":1,"language":"Rust","has_issues":true,"has_projects":true,"has_downloads":false,"has_wiki":true,"has_pages":true,"has_discussions":false,"forks_count":2,"mirror_url":null,"archived":false,"disabled":false,"open_issues_count":252,"license":{"key":"mit","name":"MIT License","spdx_id":"MIT","url":"https://api.github.com/licenses/mit","node_id":"MDc6TGljZW5zZTEz"},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"has_pull_requests":true,"pull_request_creation_policy":"all","topics":[],"visibility":"public","forks":2,"open_issues":252,"watchers":1,"default_branch":"main"}},"_links":{"self":{"href":"https://api.github.com/repos/nickderobertis/onepipeline/pulls/1212"},"html":{"href":"https://github.com/nickderobertis/onepipeline/pull/1212"},"issue":{"href":"https://api.github.com/repos/nickderobertis/onepipeline/issues/1212"},"comments":{"href":"https://api.github.com/repos/nickderobertis/onepipeline/issues/1212/comments"},"review_comments":{"href":"https://api.github.com/repos/nickderobertis/onepipeline/pulls/1212/comments"},"review_comment":{"href":"https://api.github.com/repos/nickderobertis/onepipeline/pulls/comments{/number}"},"commits":{"href":"https://api.github.com/repos/nickderobertis/onepipeline/pulls/1212/commits"},"statuses":{"href":"https://api.github.com/repos/nickderobertis/onepipeline/statuses/05e9449fb0eb8efda76ed09aaf7b751dffbc8ba6"}},"author_association":"OWNER","auto_merge":{"enabled_by":{"login":"nickderobertis","id":19440155,"node_id":"MDQ6VXNlcjE5NDQwMTU1","avatar_url":"https://avatars.githubusercontent.com/u/19440155?v=4","gravatar_id":"","url":"https://api.github.com/users/nickderobertis","html_url":"https://github.com/nickderobertis","followers_url":"https://api.github.com/users/nickderobertis/followers","following_url":"https://api.github.com/users/nickderobertis/following{/other_user}","gists_url":"https://api.github.com/users/nickderobertis/gists{/gist_id}","starred_url":"https://api.github.com/users/nickderobertis/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nickderobertis/subscriptions","organizations_url":"https://api.github.com/users/nickderobertis/orgs","repos_url":"https://api.github.com/users/nickderobertis/repos","events_url":"https://api.github.com/users/nickderobertis/events{/privacy}","received_events_url":"https://api.github.com/users/nickderobertis/received_events","type":"User","user_view_type":"public","site_admin":false},"merge_method":"squash","commit_title":null,"commit_message":null},"assignee":null,"active_lock_reason":null},{"url":"https://api.github.com/repos/nickderobertis/onepipeline/pulls/1200","id":5004846947,"node_id":"PR_kwDOTx8aUc8AAAABKk_nYw","html_url":"https://github.com/nickderobertis/onepipeline/pull/1200","diff_url":"https://github.com/nickderobertis/onepipeline/pull/1200.diff","patch_url":"https://github.com/nickderobertis/onepipeline/pull/1200.patch","issue_url":"https://api.github.com/repos/nickderobertis/onepipeline/issues/1200","number":1200,"state":"closed","locked":false,"title":"perf(driver): keep a driver's cost flat however large its journal grows, with liveness out of it","user":{"login":"nickderobertis","id":19440155,"node_id":"MDQ6VXNlcjE5NDQwMTU1","avatar_url":"https://avatars.githubusercontent.com/u/19440155?v=4","gravatar_id":"","url":"https://api.github.com/users/nickderobertis","html_url":"https://github.com/nickderobertis","followers_url":"https://api.github.com/users/nickderobertis/followers","following_url":"https://api.github.com/users/nickderobertis/following{/other_user}","gists_url":"https://api.github.com/users/nickderobertis/gists{/gist_id}","starred_url":"https://api.github.com/users/nickderobertis/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nickderobertis/subscriptions","organizations_url":"https://api.github.com/users/nickderobertis/orgs","repos_url":"https://api.github.com/users/nickderobertis/repos","events_url":"https://api.github.com/users/nickderobertis/events{/privacy}","received_events_url":"https://api.github.com/users/nickderobertis/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"## What\n\nKeep recurring driver, `status`, `watch` and `reply` journal reads on the checkpoint and newly appended records, including late events with earlier timestamps. Relay worker events and dispatch heartbeats during reconciliation, answer eligible unrelated `settle` envelopes before the pass ends, and replace journalled heartbeats with current member liveness.\n\n## Why\n\nLong multi-repository runs lost responsive supervision as their journals grew: one three-day run's driver fell 30–60+ minutes behind, consumed 90% of a core while idle and held 1.1 GB. Heartbeats accounted for over a third of its journal. Removing repeated history reads and heartbeat accumulation keeps useful work visible as a run ages.\n\n## Additional info\n\nCompatibility and behavior changes are recorded in `docs/contract-divergences.md`, entries 142–143:\n\n- Existing `events.jsonl` bytes and record formats are preserved. Checkpoints now use schema **15**; missing, unreadable or incompatible checkpoints rebuild through a streaming journal read. Main had already assigned schema 14 to a different shape. The checkpoint seal validates its document rather than re-reading covered journal bytes. `results`, `monitor` and `transcript` retain their whole-journal reads.\n- Dispatch heartbeats update atomic `liveness.json`, with entries removed when their dispatch settles. Readers use the later heartbeat from the journal and that file. Observer heartbeats are neither journalled nor retained: **a run with no dispatch in flight and a live observer can now read `PARKED` where it previously read `ACTIVE`.** Observer verdicts and quiet-worker progress semantics remain unchanged. Heartbeats no longer wake an armed watch.\n- A no-cursor `watch` and attach's first render begin at the checkpoint offset; without a checkpoint they begin at byte 0. An older unread planner surface still returns immediately, and watch heartbeat/ending lines count every unread surface. Explicit cursors, settlement returns and `watch --all` retain their behavior.\n- Publication fences avoid redundant writes as overlapping publications settle. A fence can continue naming settled publications until a new publication is added or the fence empties, preserving takeover timing. The takeover message now says the fence “still names” those nodes and gives its write time.\n- The lock links **onemessagebus 0.9.4**. Its derived count and cursor-offset sidecars expand public `onepipeline::channel::layout::FILES` from `[&str; 7]` to `[&str; 11]`, a breaking library change. Reading an older channel can leave the two cursor-offset sidecars; original recording files remain byte-for-byte unchanged.\n\n**Merging main at `969e8388`** (then its release commit `ba8dc5b5`). Only `docs/contract-divergences.md` conflicted: main's #1214 added entry 141 (a fast `local-direct` node held unlanded until its release), the number this branch's two entries had used. Main's entry keeps 141; this branch's become **142** (journal scaling and liveness) and **143** (the bus's derived files), and every reference moved with them (`docs/contract.md`'s two mentions of the bus entry, `tests/contract.rs`, `tests/registry.rs`, `heartbeat::tests`).\n\nWhich main changes reach the driver's journal, checkpoint, reply or channel paths:\n- **#1214** adds the `complete-but-held` status and a `node-settled` `awaiting` field, folded through `projection`/`summary`, plus a per-node `nodes` list in `status --json` (run-reading schema 3). Its `nodes` read each node's standing settlement off the view's events. On this branch `status --json` resumes from the checkpoint and holds no events, so a held node's `detail` and `awaiting` came back null, and adoption's two held-for-release journeys failed on the merged tree. The fold now keeps the newest settlement's `awaiting` beside its detail (`RunState::settled_awaiting`, added to the still-unreleased checkpoint schema 15, golden updated), and the reading takes both from state (`bd69353d`). No covered history is read.\n- **#1186** waits for the observer's teardown when a driver lets go. **#1206** changes only the loop-cost test's timing. **#1205, #1207, #1209, #1213** move linked engines. None of these touches the journal, checkpoint, reply or channel reads.\n\nThe measurements were not re-taken. The only merged change on a measured path is the fold of a `node-settled` record, which now keeps one more small map. The harness workload settles a handful of nodes, so a few map inserts are the whole added cost.\n\n<details>\n<summary>Retained performance evidence and limitations</summary>\n\nMeasurements use the `spike-driver-profile` harness on its own branch: seed 20261019, a 23-node plan, four doubled dispatches, 20 reply amends and an idle window. Generated workloads are not committed.\n\nThe following before figures are the spike report's **v0.75.0 / main at `a77106ce`** results. At 20 and 80 MB, comma-separated figures are the original campaign and its re-run. **≥ denotes a lower bound**, including the phase-limited 800 MB results. After figures were measured on **`1e1cc141`, onemessagebus 0.9.3**, campaign `t-camp`, 2026-10-24.\n\n| Figure | 1 MB | 20 MB | 80 MB | 160 MB | 800 MB |\n|---|---|---|---|---|---|\n| Journalling delay p95, before | 0.09 / 0.09 s | 499, ≥694 / 537, 496 s | ≥1,491, ≥1,487 / ≥1,505, ≥1,509 s | ≥2,754 / ≥2,727 s | ≥4,102 / ≥4,330 s |\n| After | 0.026 s | 0.026 s | 0.025 s | 0.026 s | 0.026 s |\n| Reply outcome p95, before | 0.50 / 0.43 s | 203, 146 / 226, 185 s | ≥1,495, ≥1,494 / ≥1,465, 1,194 s | ≥1,572 / 1,250 s | ≥3,985 / ≥3,435 s |\n| After | 0.343 s | 0.320 s | 0.333 s | 0.362 s | 0.659 s |\n| Longest reconcile pass, before (not p95) | 2.7 / 0.78 s | 537, ≥659 / 572, 530 s | 120, ≥1,496 / 158, 1,252 s | ≥2,745 / ≥2,745 s | ≥1,669 / ≥3,043 s |\n| Pass p95 after; flush-interval upper bound in parentheses | <1 ms (128 ms) | <1 ms (134 ms) | <1 ms (134 ms) | <1 ms (151 ms) | <1 ms (149 ms) |\n| Idle CPU, before | 1.6% / 1.6% | 3.8% / 3.9% | 17.5% / 16.0% | 69.6% / 67.0% | 101% / 106% |\n| After | 1.45% | 1.35% | 1.85% | 1.82% | 1.32% |\n| Peak RSS, before | 112 / 101 MB | 612, 610 / 612, 614 MB | 1,631, 1,584 / 1,543, 2,672 MB | 5,645 / 7,059 MB | ≥10,901 / ≥10,845 MB |\n| After | 101.8 MB | 108.7 MB | 108.0 MB | 116.5 MB | 210.0 MB |\n| Adoption to first finished pass, after | 0.90 s | 0.90 s | 0.90 s | 0.90 s | 1.20 s |\n\nAt 800 MB, journalling delay meets its 0.076 s threshold; the pass-time upper bound meets 178 ms; idle CPU meets 0.0245 cores. Reply latency **misses** 0.443 s and peak RSS **misses** 127.2 MB. These are not claims that every measured cost is flat.\n\nThe retained isolation experiment on `1e1cc141` padded only a 1 MB run's command queue to 2,125 envelopes, matching the 800 MB run. RSS rose from 102.0 to 228.5 MB and reply p95 from 0.305 to 0.965 s. This ties both misses to onemessagebus 0.9.3's whole-queue reads on claim/submit; the amended scope leaves those bars to `op-measure-combined` on the bus fix. No measurement is represented as a new measurement on 0.9.4.\n\nThe earlier 800 MB journalling-delay regression was 1.155 s on `5de9807d` versus 0.064 s on `b7c9fc90`. Back-to-back repeats, both using bus 0.9.3, measured:\n\n| Round | `b7c9fc90`: p95 / sampled host load | `5de9807d`: p95 / sampled host load |\n|---|---|---|\n| 1 | 0.076 s / 24.75 | 0.081 s / 17.07 |\n| 2 | 0.106 s / 35.31 | 0.113 s / 23.59 |\n\nAn earlier A/B with an older harness measured `5de9807d` at 0.185 and 0.159 s, and `b7c9fc90` at 0.149 and 0.399 s (load 67.95). The retained report attributes the variation to host load and fsync latency rather than a commit-specific regression; the later campaign measured 0.026 s at 800 MB.\n\n**Measurement provenance through the final head.** The retained source comparison of `1e1cc141` against rebased `8c3da5f1` found branch-owned source matched apart from heartbeat test comments, and other source differences matched main's `7d2be8f3`→`4bc8be07` changes by patch ID. Subsequent changes through `14b4b43a` were comments/indentation, `watch --all`, host-view code, a per-thread read counter and the bus 0.9.4 link. The amendment permits retaining measurements across that link. `3d5484af` changes a test; `543ab334` reduces publication-fence writes without changing journal, checkpoint, fold, relay or reply code.\n\n**Checkpoint rebuilds**, re-measured with `status --json` on **`14b4b43a`, bus 0.9.4**, three runs per case:\n\n| Journal length | Checkpoint | Peak RSS, MB | Journal bytes read / windows | Rebuilt schema |\n|---|---|---|---|---|\n| 80,865,873 B | Deleted | 165.6, 162.1, 165.3 | 80,885,092 / 5 | 15 |\n| 80,865,873 B | Schema 13 | 165.2, 165.6, 165.1 | 80,885,092 / 5 | 15 |\n| 808,807,513 B | Deleted | 176.7, 175.9, 175.2 | 809,138,577 / 49 | 15 |\n| 808,807,513 B | Schema 13 | 175.9, 194.9, 176.7 | 809,138,577 / 49 | 15 |\n\nEach rebuild reads from byte 0 once, then proceeds in 16 MiB windows. Their union equals the journal length. Only boundary-crossing records are read again: **19,219 B (0.024%)** and **331,064 B (0.041%)** overlap, within the amended streaming-read allowance.\n\nMedian RSS rose approximately 11 MB across 10× the journal, within the larger run's 19.7 MB spread but above the smaller run's 3.6 MB spread; its cause was not traced. Earlier schema-14 measurements from the `5de9807d` era were 162–165 MB and 162–168 MB respectively. Rebuild host load was 12.85 before and 12.19 after. A scratch harness copy excluded host-specific `*.offset` sidecars from its deterministic-generation comparison; the journal and all other files matched. Later commits change only a test and the publication fence, neither reached by this rebuild measurement.\n\nThe publication-fence quota experiment used bus 0.9.4. Main at `2f569b5b` measured 171 units twice; the branch before repair measured 179 and 175, with identical GitHub-token cost (54). Logged fence writes in the first rework numbered six on main versus eleven on the branch. After repair, three runs measured **157 units**, including 22 driver metadata writes, against a budget of 175.\n\n</details>\n\n<details>\n<summary>Retained regression evidence and check links</summary>\n\nThe compiled-binary journeys cover overwritten checkpoint-covered history, earlier-stamped worker events, rebuilds, legacy-run adoption, liveness readers, watch/attach cursors, and relay/reply behavior during a held reconcile pass.\n\n- The held-pass settlement journey failed against base **`4bc8be07`** with the branch's tests: the reply remained `queued` rather than becoming `applied`. It passed on **`14b4b43a`**; subsequent changes do not touch that path.\n- The publication-fence takeover journey fails with the fence change disabled (`[\"y\"]` versus `[\"x\",\"y\"]`) and passed twice with it enabled. The retained local results include all 49 continuation journeys and 13 continuation unit tests.\n- Two macOS journey failures were caused by collecting read counters after run completion, allowing `scratch::at_writer_ending`'s whole-journal read into the observation window. The tests now collect while a node is held. The old rebuild journey failed with an induced five-second delay; the fixed version passed with it and then three times without it. The old overwritten-history journey failed with an eight-second delay; its fixed version passed with and without the delay. All 15 journal-scaling journeys passed. The end-of-run read remains a follow-up.\n- Windows `rework::a_restack_starts_before_its_reworked_parent_s_checks_have_settled` failed once on **`14b4b43a`** in [job 121305841132](https://github.com/nickderobertis/onepipeline/actions/runs/40238737586/job/121305841132), then passed all three re-runs of the same build. This branch does not change that test or `tests/e2e/rework.rs`.\n- The retained completion report records every [PR #1200 check](https://github.com/nickderobertis/onepipeline/pull/1200/checks) green on **`543ab334`**, including gate, llmlint, both Windows proof shards, Mac PR proofs, install/install-documented, smoke, msrv, engines-current and deny. It also records `cargo clippy --workspace --all-targets --locked -- -D warnings` clean locally on that commit.\n- On the merged head (`bd69353d`): `cargo clippy --workspace --all-targets --locked -- -D warnings` is clean; lib unit tests (1,085) pass; `contract`, `registry` and `channel_layout` (157) pass; 653 e2e journeys pass (`journal_scaling`, `loopcost`, `checkpoint`, `journal`, `watch`, `views`, `adoption`, `dispatch`, `live_edit`, `destination`, `draft_lifecycle`, `lifecycle`, `run_ending`, `scratch`, `writeback_cost`, `linear_loopback`, `publication_boundary`, `unwatched`, `recorded_channel`, `review_reply`); and `just lint-llm-diff origin/main` reports 0 failures. In that full run `adoption::a_change_request_settled_with_no_release_baseline_is_answered_with_the_command_to_record_it` timed out once under load, then passed four times in isolation. The `publication_boundary` journeys first failed only because onetaskgraph 0.12.5 (main's #1213) was not yet installed locally, and passed once it was. The head then merges main's release commit `ba8dc5b5` (v0.94.0) as `c6e494c8`. It changes only the crate version, the lock's copy of it and `CHANGELOG.md`, none of which those checks read, so their results stand for it.\n</details>\n","created_at":"2026-10-25T12:46:36Z","updated_at":"2026-10-26T14:02:30Z","closed_at":"2026-10-26T14:02:28Z","merged_at":"2026-10-26T14:02:28Z","merge_commit_sha":"5970561d0285f995909ac8c883b27da218a810db","assignees":[],"requested_reviewers":[],"requested_teams":[],"labels":[],"milestone":null,"draft":false,"commits_url":"https://api.github.com/repos/nickderobertis/onepipeline/pulls/1200/commits","review_comments_url":"https://api.github.com/repos/nickderobertis/onepipeline/pulls/1200/comments","review_comment_url":"https://api.github.com/repos/nickderobertis/onepipeline/pulls/comments{/number}","comments_url":"https://api.github.com/repos/nickderobertis/onepipeline/issues/1200/comments","statuses_url":"https://api.github.com/repos/nickderobertis/onepipeline/statuses/3f9a85cd52a4eecb423dbdbc0d298b1414c81c74","head":{"label":"nickderobertis:nick/1044/op-journal-scaling","ref":"nick/1044/op-journal-scaling","sha":"3f9a85cd52a4eecb423dbdbc0d298b1414c81c74","user":{"login":"nickderobertis","id":19440155,"node_id":"MDQ6VXNlcjE5NDQwMTU1","avatar_url":"https://avatars.githubusercontent.com/u/19440155?v=4","gravatar_id":"","url":"https://api.github.com/users/nickderobertis","html_url":"https://github.com/nickderobertis","followers_url":"https://api.github.com/users/nickderobertis/followers","following_url":"https://api.github.com/users/nickderobertis/following{/other_user}","gists_url":"https://api.github.com/users/nickderobertis/gists{/gist_id}","starred_url":"https://api.github.com/users/nickderobertis/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nickderobertis/subscriptions","organizations_url":"https://api.github.com/users/nickderobertis/orgs","repos_url":"https://api.github.com/users/nickderobertis/repos","events_url":"https://api.github.com/users/nickderobertis/events{/privacy}","received_events_url":"https://a