":"https://api.github.com/users/nickderobertis/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nickderobertis/subscriptions","organizations_url":"https://api.github.com/users/nickderobertis/orgs","repos_url":"https://api.github.com/users/nickderobertis/repos","events_url":"https://api.github.com/users/nickderobertis/events{/privacy}","received_events_url":"https://api.github.com/users/nickderobertis/received_events","type":"User","user_view_type":"public","site_admin":false},"merge_method":"squash","commit_title":null,"commit_message":null},"assignee":null,"active_lock_reason":null},{"url":"https://api.github.com/repos/nickderobertis/onepipeline/pulls/1274","id":5055405369,"node_id":"PR_kwDOTx8aUc8AAAABLVNdOQ","html_url":"https://github.com/nickderobertis/onepipeline/pull/1274","diff_url":"https://github.com/nickderobertis/onepipeline/pull/1274.diff","patch_url":"https://github.com/nickderobertis/onepipeline/pull/1274.patch","issue_url":"https://api.github.com/repos/nickderobertis/onepipeline/issues/1274","number":1274,"state":"closed","locked":false,"title":"fix(tests): make the busy review-round journey wait for the write it judges","user":{"login":"nickderobertis","id":19440155,"node_id":"MDQ6VXNlcjE5NDQwMTU1","avatar_url":"https://avatars.githubusercontent.com/u/19440155?v=4","gravatar_id":"","url":"https://api.github.com/users/nickderobertis","html_url":"https://github.com/nickderobertis","followers_url":"https://api.github.com/users/nickderobertis/followers","following_url":"https://api.github.com/users/nickderobertis/following{/other_user}","gists_url":"https://api.github.com/users/nickderobertis/gists{/gist_id}","starred_url":"https://api.github.com/users/nickderobertis/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nickderobertis/subscriptions","organizations_url":"https://api.github.com/users/nickderobertis/orgs","repos_url":"https://api.github.com/users/nickderobertis/repos","events_url":"https://api.github.com/users/nickderobertis/events{/privacy}","received_events_url":"https://api.github.com/users/nickderobertis/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"## What\n\nMake the review-round journey wait for captured command output before advancing its clock: reaching a held store call does not guarantee the independent renderer’s output has been observed. Add a deterministic delayed-capture regression using a file spool to avoid Windows pipe hangs, while preserving the proof that a writing command survives beyond one step and exits successfully.\n\n## Why\n\nA flaky failure in the required Mac proof job costs another roughly two-hour run. Fix the journey’s observation race at its cause instead of relying on successful reruns.","created_at":"2026-10-28T18:11:05Z","updated_at":"2026-10-29T08:36:42Z","closed_at":"2026-10-29T08:36:40Z","merged_at":"2026-10-29T08:36:40Z","merge_commit_sha":"51eb9aa2765fb1ba61c99c819587a88a401a3591","assignees":[],"requested_reviewers":[],"requested_teams":[],"labels":[],"milestone":null,"draft":false,"commits_url":"https://api.github.com/repos/nickderobertis/onepipeline/pulls/1274/commits","review_comments_url":"https://api.github.com/repos/nickderobertis/onepipeline/pulls/1274/comments","review_comment_url":"https://api.github.com/repos/nickderobertis/onepipeline/pulls/comments{/number}","comments_url":"https://api.github.com/repos/nickderobertis/onepipeline/issues/1274/comments","statuses_url":"https://api.github.com/repos/nickderobertis/onepipeline/statuses/2c4ccc49db5546f8de5be42c46d2b6dff009e902","head":{"label":"nickderobertis:nick/npm-engine-install/onepipeline-review-round-mac-flake","ref":"nick/npm-engine-install/onepipeline-review-round-mac-flake","sha":"2c4ccc49db5546f8de5be42c46d2b6dff009e902","user":{"login":"nickderobertis","id":19440155,"node_id":"MDQ6VXNlcjE5NDQwMTU1","avatar_url":"https://avatars.githubusercontent.com/u/19440155?v=4","gravatar_id":"","url":"https://api.github.co