ref":"https://api.github.com/repos/nickderobertis/onepipeline/issues/1288/comments"},"review_comments":{"href":"https://api.github.com/repos/nickderobertis/onepipeline/pulls/1288/comments"},"review_comment":{"href":"https://api.github.com/repos/nickderobertis/onepipeline/pulls/comments{/number}"},"commits":{"href":"https://api.github.com/repos/nickderobertis/onepipeline/pulls/1288/commits"},"statuses":{"href":"https://api.github.com/repos/nickderobertis/onepipeline/statuses/7a0743f7b9ffd25d5781a423875820a4662acda0"}},"author_association":"OWNER","auto_merge":null,"assignee":null,"active_lock_reason":null},{"url":"https://api.github.com/repos/nickderobertis/onepipeline/pulls/1285","id":5061994278,"node_id":"PR_kwDOTx8aUc8AAAABLbfnJg","html_url":"https://github.com/nickderobertis/onepipeline/pull/1285","diff_url":"https://github.com/nickderobertis/onepipeline/pull/1285.diff","patch_url":"https://github.com/nickderobertis/onepipeline/pull/1285.patch","issue_url":"https://api.github.com/repos/nickderobertis/onepipeline/issues/1285","number":1285,"state":"closed","locked":false,"title":"fix(test): make the post-adoption driver panic journey reliable on a loaded runner","user":{"login":"nickderobertis","id":19440155,"node_id":"MDQ6VXNlcjE5NDQwMTU1","avatar_url":"https://avatars.githubusercontent.com/u/19440155?v=4","gravatar_id":"","url":"https://api.github.com/users/nickderobertis","html_url":"https://github.com/nickderobertis","followers_url":"https://api.github.com/users/nickderobertis/followers","following_url":"https://api.github.com/users/nickderobertis/following{/other_user}","gists_url":"https://api.github.com/users/nickderobertis/gists{/gist_id}","starred_url":"https://api.github.com/users/nickderobertis/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nickderobertis/subscriptions","organizations_url":"https://api.github.com/users/nickderobertis/orgs","repos_url":"https://api.github.com/users/nickderobertis/repos","events_url":"https://api.github.com/users/nickderobertis/events{/privacy}","received_events_url":"https://api.github.com/users/nickderobertis/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"## What\n\nMake the driver-panic adoption journey wait for the original and replacement workers to reach their rendezvous before proceeding, replacing fixed polling waits. Explicit journal assertions verify adoption and both nodes’ re-dispatch; the test runner’s timeout still catches missing progress.\n\n## Why\n\nThis flaky CI failure is blocking pull requests needed for the engine release. Waiting on worker progress removes the timing assumption on loaded runners and addresses the cause instead of relying on retries.","created_at":"2026-10-29T04:09:34Z","updated_at":"2026-10-29T11:10:13Z","closed_at":"2026-10-29T11:10:11Z","merged_at":"2026-10-29T11:10:11Z","merge_commit_sha":"09fa5f7845dc3910b803b6beb4e10fa451715361","assignees":[],"requested_reviewers":[],"requested_teams":[],"labels":[],"milestone":null,"draft":false,"commits_url":"https://api.github.com/repos/nickderobertis/onepipeline/pulls/1285/commits","review_comments_url":"https://api.github.com/repos/nickderobertis/onepipeline/pulls/1285/comments","review_comment_url":"https://api.github.com/repos/nickderobertis/onepipeline/pulls/comments{/number}","comments_url":"https://api.github.com/repos/nickderobertis/onepipeline/issues/1285/comments","statuses_url":"https://api.github.com/repos/nickderobertis/onepipeline/statuses/2642f60767a094ea64cc25e3913ccc6c04618c64","head":{"label":"nickderobertis:nick/npm-engine-install/onepipeline-driver-exit-adoption-flake","ref":"nick/npm-engine-install/onepipeline-driver-exit-adoption-flake","sha":"2642f60767a094ea64cc25e3913ccc6c04618c64","user":{"login":"nickderobertis","id":19440155,"node_id":"MDQ6VXNlcjE5NDQwMTU1","avatar_url":"https://avatars.githubusercontent.com/u/19440155?v=4","gravatar_id":"","url":"https://api.github.com/users/nickderobertis","html_url":"https: