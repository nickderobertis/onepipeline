b.com/repos/nickderobertis/onepipeline/pulls/1264"},"html":{"href":"https://github.com/nickderobertis/onepipeline/pull/1264"},"issue":{"href":"https://api.github.com/repos/nickderobertis/onepipeline/issues/1264"},"comments":{"href":"https://api.github.com/repos/nickderobertis/onepipeline/issues/1264/comments"},"review_comments":{"href":"https://api.github.com/repos/nickderobertis/onepipeline/pulls/1264/comments"},"review_comment":{"href":"https://api.github.com/repos/nickderobertis/onepipeline/pulls/comments{/number}"},"commits":{"href":"https://api.github.com/repos/nickderobertis/onepipeline/pulls/1264/commits"},"statuses":{"href":"https://api.github.com/repos/nickderobertis/onepipeline/statuses/dc8b53837ffd1b6307f31a942275ba0d661b6300"}},"author_association":"OWNER","auto_merge":{"enabled_by":{"login":"nickderobertis","id":19440155,"node_id":"MDQ6VXNlcjE5NDQwMTU1","avatar_url":"https://avatars.githubusercontent.com/u/19440155?v=4","gravatar_id":"","url":"https://api.github.com/users/nickderobertis","html_url":"https://github.com/nickderobertis","followers_url":"https://api.github.com/users/nickderobertis/followers","following_url":"https://api.github.com/users/nickderobertis/following{/other_user}","gists_url":"https://api.github.com/users/nickderobertis/gists{/gist_id}","starred_url":"https://api.github.com/users/nickderobertis/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nickderobertis/subscriptions","organizations_url":"https://api.github.com/users/nickderobertis/orgs","repos_url":"https://api.github.com/users/nickderobertis/repos","events_url":"https://api.github.com/users/nickderobertis/events{/privacy}","received_events_url":"https://api.github.com/users/nickderobertis/received_events","type":"User","user_view_type":"public","site_admin":false},"merge_method":"squash","commit_title":null,"commit_message":null},"assignee":null,"active_lock_reason":null},{"url":"https://api.github.com/repos/nickderobertis/onepipeline/pulls/1279","id":5057857047,"node_id":"PR_kwDOTx8aUc8AAAABLXjGFw","html_url":"https://github.com/nickderobertis/onepipeline/pull/1279","diff_url":"https://github.com/nickderobertis/onepipeline/pull/1279.diff","patch_url":"https://github.com/nickderobertis/onepipeline/pull/1279.patch","issue_url":"https://api.github.com/repos/nickderobertis/onepipeline/issues/1279","number":1279,"state":"closed","locked":false,"title":"fix(test): make the pooled-slot hand-back journey reliable on a loaded runner","user":{"login":"nickderobertis","id":19440155,"node_id":"MDQ6VXNlcjE5NDQwMTU1","avatar_url":"https://avatars.githubusercontent.com/u/19440155?v=4","gravatar_id":"","url":"https://api.github.com/users/nickderobertis","html_url":"https://github.com/nickderobertis","followers_url":"https://api.github.com/users/nickderobertis/followers","following_url":"https://api.github.com/users/nickderobertis/following{/other_user}","gists_url":"https://api.github.com/users/nickderobertis/gists{/gist_id}","starred_url":"https://api.github.com/users/nickderobertis/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nickderobertis/subscriptions","organizations_url":"https://api.github.com/users/nickderobertis/orgs","repos_url":"https://api.github.com/users/nickderobertis/repos","events_url":"https://api.github.com/users/nickderobertis/events{/privacy}","received_events_url":"https://api.github.com/users/nickderobertis/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"## What\n\nIsolate the pooled-slot journey from concurrent publication on its shared checkout and wait for recorded slot return, retaining assertions against premature admission. Give it a scoped Nx tier included in aggregate coverage, update nextest fixtures so the configuration loads with that tier, and correct the crate-split proposal’s transitive test inputs.\n\n## Why\n\nThe flaky journey blocks pull requests carrying the engine release needed by the user’s host. Fix it rather than relying on retries, and remove the configuration failure blocking this branch’s merge.\n\n## Additional info\n\nThe failure in PR #1268 came from a dirty-checkout publication refusal. onevcs checks checkout readiness before acquiring its publication turn, allowing that check to overlap another publication’s checkout update. This change isolates the journey from that race; the onevcs fix remains separate.","created_at":"2026-10-28T21:18:41Z","updated_at":"2026-10-29T05:37:00Z","closed_at":"2026-10-29T05:36:58Z","merged_at":"2026-10-29T05:36:58Z","merge_commit_sha":"258276876f60667e2980d242acf1a5f337f0c781","assignees":[],"requested_reviewers":[],"requested_teams":[],"labels":[],"milestone":null,"draft":false,"commits_url":"https://api.github.com/repos/nickderobertis/onepipeline/pulls/1279/commits","review_comments_url":"https://api.github.com/repos/nickderobertis/onepipeline/pulls/1279/comments","review_comment_url":"https://api.github.com/repos/nickderobertis/onepipeline/pulls/comments{/number}","comments_url":"https://api.github.com/repos/nickderobertis/onepipeline/issues/1279/comments","statuses_url":"https://api.github.com/repos/nickderobertis/onepipeline/statuses/4c1b8d267793aab10e98b137375dfcf91f48496a","head":{"label":"nickderobertis:nick/npm-engine-install/onepipeline-pooled-slot-flake","ref":"nick/npm-engine-install/onepipeline-pooled-slot-flake","sha":"4c1b8d267793aab10e98b137375dfcf91f48496a","user":{"login":"nickderobertis","id":19440155,"node_id":"MDQ6VXNlcjE5NDQwMTU1","avatar_url":"https://avatars.githubusercontent.com/u/19440155?v=4","gravatar_id":"","url":"https://api.github.com/users/nickderobertis","html_url":"https://github.com/nickderobertis","followers_url":"https://api.github.com/users/nickderobertis/followers","following_url":"https://api.github.com/users/nickderobertis/following{/other_user}","gists_url":"https://api.github.com/users/nickderobertis/gists{/gist_id}","starred_url":"https://api.github.com/users/nickderobertis/starred{/owner}{/rep