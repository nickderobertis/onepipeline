Dc6TGljZW5zZTEz"},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"has_pull_requests":true,"pull_request_creation_policy":"all","topics":[],"visibility":"public","forks":2,"open_issues":252,"watchers":1,"default_branch":"main"}},"_links":{"self":{"href":"https://api.github.com/repos/nickderobertis/onepipeline/pulls/1254"},"html":{"href":"https://github.com/nickderobertis/onepipeline/pull/1254"},"issue":{"href":"https://api.github.com/repos/nickderobertis/onepipeline/issues/1254"},"comments":{"href":"https://api.github.com/repos/nickderobertis/onepipeline/issues/1254/comments"},"review_comments":{"href":"https://api.github.com/repos/nickderobertis/onepipeline/pulls/1254/comments"},"review_comment":{"href":"https://api.github.com/repos/nickderobertis/onepipeline/pulls/comments{/number}"},"commits":{"href":"https://api.github.com/repos/nickderobertis/onepipeline/pulls/1254/commits"},"statuses":{"href":"https://api.github.com/repos/nickderobertis/onepipeline/statuses/95c4027cae7430b9f2fa45bc8f7042b0a5d2774f"}},"author_association":"OWNER","auto_merge":{"enabled_by":{"login":"nickderobertis","id":19440155,"node_id":"MDQ6VXNlcjE5NDQwMTU1","avatar_url":"https://avatars.githubusercontent.com/u/19440155?v=4","gravatar_id":"","url":"https://api.github.com/users/nickderobertis","html_url":"https://github.com/nickderobertis","followers_url":"https://api.github.com/users/nickderobertis/followers","following_url":"https://api.github.com/users/nickderobertis/following{/other_user}","gists_url":"https://api.github.com/users/nickderobertis/gists{/gist_id}","starred_url":"https://api.github.com/users/nickderobertis/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nickderobertis/subscriptions","organizations_url":"https://api.github.com/users/nickderobertis/orgs","repos_url":"https://api.github.com/users/nickderobertis/repos","events_url":"https://api.github.com/users/nickderobertis/events{/privacy}","received_events_url":"https://api.github.com/users/nickderobertis/received_events","type":"User","user_view_type":"public","site_admin":false},"merge_method":"squash","commit_title":null,"commit_message":null},"assignee":null,"active_lock_reason":null},{"url":"https://api.github.com/repos/nickderobertis/onepipeline/pulls/1240","id":5039590738,"node_id":"PR_kwDOTx8aUc8AAAABLGINUg","html_url":"https://github.com/nickderobertis/onepipeline/pull/1240","diff_url":"https://github.com/nickderobertis/onepipeline/pull/1240.diff","patch_url":"https://github.com/nickderobertis/onepipeline/pull/1240.patch","issue_url":"https://api.github.com/repos/nickderobertis/onepipeline/issues/1240","number":1240,"state":"closed","locked":false,"title":"fix(npm): make the npm-installed onepipeline command become the engine process instead of running it as a child","user":{"login":"nickderobertis","id":19440155,"node_id":"MDQ6VXNlcjE5NDQwMTU1","avatar_url":"https://avatars.githubusercontent.com/u/19440155?v=4","gravatar_id":"","url":"https://api.github.com/users/nickderobertis","html_url":"https://github.com/nickderobertis","followers_url":"https://api.github.com/users/nickderobertis/followers","following_url":"https://api.github.com/users/nickderobertis/following{/other_user}","gists_url":"https://api.github.com/users/nickderobertis/gists{/gist_id}","starred_url":"https://api.github.com/users/nickderobertis/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nickderobertis/subscriptions","organizations_url":"https://api.github.com/users/nickderobertis/orgs","repos_url":"https://api.github.com/users/nickderobertis/repos","events_url":"https://api.github.com/users/nickderobertis/events{/privacy}","received_events_url":"https://api.github.com/users/nickderobertis/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"## What\n\nMake the npm-installed command become the engine process on Linux and macOS, preserving the caller’s PID. On Windows, supervise the engine so console interrupts and exit status pass through and launcher termination cleans up the engine. Add installed-package regression tests and platform CI coverage, and make launcher changes count toward releases.\n\n## Why\n\nSwitching a host from PyPI to npm after PyPI’s project size limit blocked publication exposed the extra Node process: it broke a PID-based flow re-entry guard, spawned about 8,500 processes, exhausted memory, and killed a running orchestrator. This fixes the upstream behavior so the host can remove its workaround of invoking the platform binary directly.\n\n## Additional info\n\nThe npm package now requires Node.js `^22.15.0 || >=23.11.0`; Linux and macOS refuse runtimes without `process.execve`.","created_at":"2026-10-27T19:06:30Z","updated_at":"2026-10-28T03:39:04Z","closed_at":"2026-10-28T03:39:01Z","merged_at":"2026-10-28T03:39:01Z","merge_commit_sha":"41b164fe06e84ee905cd000c9b868a1f3bfba9e9","assignees":[],"requested_reviewers":[],"requested_teams":[],"labels":[],"milestone":null,"draft":false,"commits_url":"https://api.github.com/repos/nickderobertis/onepipeline/pulls/1240/commits","review_comments_url":"https://api.github.com/repos/nickderobertis/onepipeline/pulls/1240/comments","review_comment_url":"https://api.github.com/repos/nickderobertis/onepipeline/pulls/comments{/number}","comments_url":"https://api.github.com/repos/nickderobertis/onepipeline/issues/1240/comments","statuses_url":"https://api.github.com/repos/nickderobertis/onepipeline/statuses/d7056c24704139c72b9d90520e75fa587f3186a3","head":{"label":"nickderobertis:nick/npm-engine-install/onepipeline-npm-launcher-exec","ref":"nick/npm-engine-install/onepipeline-npm-launcher-exec","sha":"d7056c24704139c72b9d90520e75fa587f3186a3","user":{"login":"nickderobertis","id":19440155,"node_id":"MDQ6VXNlcjE5NDQwMTU1","avatar_url":"https://avatars.githubusercontent.com/u/19440155?v=4","gravatar_id":"","url":"https://api.github.com/users/nickderobertis","html_url":"https://github.com/nickderobertis