T09:36:05Z","git_url":"git://github.com/nickderobertis/onepipeline.git","ssh_url":"git@github.com:nickderobertis/onepipeline.git","clone_url":"https://github.com/nickderobertis/onepipeline.git","svn_url":"https://github.com/nickderobertis/onepipeline","homepage":null,"size":24249,"stargazers_count":1,"watchers_count":1,"language":"Rust","has_issues":true,"has_projects":true,"has_downloads":false,"has_wiki":true,"has_pages":true,"has_discussions":false,"forks_count":2,"mirror_url":null,"archived":false,"disabled":false,"open_issues_count":252,"license":{"key":"mit","name":"MIT License","spdx_id":"MIT","url":"https://api.github.com/licenses/mit","node_id":"MDc6TGljZW5zZTEz"},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"has_pull_requests":true,"pull_request_creation_policy":"all","topics":[],"visibility":"public","forks":2,"open_issues":252,"watchers":1,"default_branch":"main"}},"_links":{"self":{"href":"https://api.github.com/repos/nickderobertis/onepipeline/pulls/1132"},"html":{"href":"https://github.com/nickderobertis/onepipeline/pull/1132"},"issue":{"href":"https://api.github.com/repos/nickderobertis/onepipeline/issues/1132"},"comments":{"href":"https://api.github.com/repos/nickderobertis/onepipeline/issues/1132/comments"},"review_comments":{"href":"https://api.github.com/repos/nickderobertis/onepipeline/pulls/1132/comments"},"review_comment":{"href":"https://api.github.com/repos/nickderobertis/onepipeline/pulls/comments{/number}"},"commits":{"href":"https://api.github.com/repos/nickderobertis/onepipeline/pulls/1132/commits"},"statuses":{"href":"https://api.github.com/repos/nickderobertis/onepipeline/statuses/25d637374e5c3cc2627ec3d22f07d96e867a3c9e"}},"author_association":"OWNER","auto_merge":null,"assignee":null,"active_lock_reason":null},{"url":"https://api.github.com/repos/nickderobertis/onepipeline/pulls/1120","id":4980200118,"node_id":"PR_kwDOTx8aUc8AAAABKNfStg","html_url":"https://github.com/nickderobertis/onepipeline/pull/1120","diff_url":"https://github.com/nickderobertis/onepipeline/pull/1120.diff","patch_url":"https://github.com/nickderobertis/onepipeline/pull/1120.patch","issue_url":"https://api.github.com/repos/nickderobertis/onepipeline/issues/1120","number":1120,"state":"closed","locked":false,"title":"feat(deps)!: link the agent graph whose turn records point at the transcript, and onevcs's check times","user":{"login":"nickderobertis","id":19440155,"node_id":"MDQ6VXNlcjE5NDQwMTU1","avatar_url":"https://avatars.githubusercontent.com/u/19440155?v=4","gravatar_id":"","url":"https://api.github.com/users/nickderobertis","html_url":"https://github.com/nickderobertis","followers_url":"https://api.github.com/users/nickderobertis/followers","following_url":"https://api.github.com/users/nickderobertis/following{/other_user}","gists_url":"https://api.github.com/users/nickderobertis/gists{/gist_id}","starred_url":"https://api.github.com/users/nickderobertis/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nickderobertis/subscriptions","organizations_url":"https://api.github.com/users/nickderobertis/orgs","repos_url":"https://api.github.com/users/nickderobertis/repos","events_url":"https://api.github.com/users/nickderobertis/events{/privacy}","received_events_url":"https://api.github.com/users/nickderobertis/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"## What\n\nResolve turn content through the new public `views::transcript` module across monitor, watch, machine output, transcripts, status and note confirmation. Live calls show concise descriptions, text readers receive whole content, and unavailable history produces an explicit diagnostic. Preserve legacy journal rendering, referenced history files and relayed check timestamps.\n\n## Why\n\nManagers and observers need to see what a dispatch is doing while it runs. With turn records now referencing history instead of copying content, one shared resolver keeps those views informative and consistent, including confirmation of notes beyond the old truncation limit.\n\n## Additional info\n\nBreaking library change: upgrades `oneagentgraph` to 0.8.0, changing the exposed relayed turn-record types, and changes `NodeActivity::doing` from `Option<String>` to `Option<Doing>`. Adds the public `views::transcript` API. Checkpoint schema advances to version 14 so activity references survive resume; older checkpoints are rebuilt from the journal.\n\nLinks `onevcs` 0.56.9 for check timestamps and the checkout read-lease and session-read fixes. Supervisor references resolve to the supervisor’s message text and whole opening prompt. Updates the lockfile to Tokio 1.54.1.\n\nAdjusts the busy review round’s git-process bounds for the linked onevcs checkout reads and fixes the scratch journal test’s Windows append-handle contention, closing its writer before waiting for the driver.","created_at":"2026-10-23T08:45:44Z","updated_at":"2026-10-24T07:57:22Z","closed_at":"2026-10-24T07:57:20Z","merged_at":"2026-10-24T07:57:20Z","merge_commit_sha":"dc428584875c6ea42d074b4829d2e184b0896a27","assignees":[],"requested_reviewers":[],"requested_teams":[],"labels":[],"milestone":null,"draft":false,"commits_url":"https://api.github.com/repos/nickderobertis/onepipeline/pulls/1120/commits","review_comments_url":"https://api.github.com/repos/nickderobertis/onepipeline/pulls/1120/comments","review_comment_url":"https://api.github.com/repos/nickderobertis/onepipeline/pulls/comments{/number}","comments_url":"https://api.github.com/repos/nickderobertis/onepipeline/issues/1120/comments","statuses_url":"https://api.github.com/repos/nickderobertis/onepipeline/statuses/e790265a2d32603d8ab2ca08fc271ce0fd6ac1e6","head":{"label":"nickderobertis:nick/1087/engine-transcript-refs","ref":"nick/1087/engine-transcript-refs","sha":"e790265a2d32603d8ab2ca08fc271ce0fd6ac1e6","user":{"login":"nickderobertis","id":19440155,"node_id":"MDQ6VXNlcjE5NDQwMTU1","avatar_url":"https://avatars.githubuse