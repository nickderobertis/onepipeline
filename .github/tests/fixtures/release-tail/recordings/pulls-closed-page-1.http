x_id":"MIT","url":"https://api.github.com/licenses/mit","node_id":"MDc6TGljZW5zZTEz"},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"has_pull_requests":true,"pull_request_creation_policy":"all","topics":[],"visibility":"public","forks":2,"open_issues":252,"watchers":1,"default_branch":"main"}},"_links":{"self":{"href":"https://api.github.com/repos/nickderobertis/onepipeline/pulls/1219"},"html":{"href":"https://github.com/nickderobertis/onepipeline/pull/1219"},"issue":{"href":"https://api.github.com/repos/nickderobertis/onepipeline/issues/1219"},"comments":{"href":"https://api.github.com/repos/nickderobertis/onepipeline/issues/1219/comments"},"review_comments":{"href":"https://api.github.com/repos/nickderobertis/onepipeline/pulls/1219/comments"},"review_comment":{"href":"https://api.github.com/repos/nickderobertis/onepipeline/pulls/comments{/number}"},"commits":{"href":"https://api.github.com/repos/nickderobertis/onepipeline/pulls/1219/commits"},"statuses":{"href":"https://api.github.com/repos/nickderobertis/onepipeline/statuses/98fcef3b6071cad4a907d17a9c1897de5258f102"}},"author_association":"OWNER","auto_merge":{"enabled_by":{"login":"nickderobertis","id":19440155,"node_id":"MDQ6VXNlcjE5NDQwMTU1","avatar_url":"https://avatars.githubusercontent.com/u/19440155?v=4","gravatar_id":"","url":"https://api.github.com/users/nickderobertis","html_url":"https://github.com/nickderobertis","followers_url":"https://api.github.com/users/nickderobertis/followers","following_url":"https://api.github.com/users/nickderobertis/following{/other_user}","gists_url":"https://api.github.com/users/nickderobertis/gists{/gist_id}","starred_url":"https://api.github.com/users/nickderobertis/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nickderobertis/subscriptions","organizations_url":"https://api.github.com/users/nickderobertis/orgs","repos_url":"https://api.github.com/users/nickderobertis/repos","events_url":"https://api.github.com/users/nickderobertis/events{/privacy}","received_events_url":"https://api.github.com/users/nickderobertis/received_events","type":"User","user_view_type":"public","site_admin":false},"merge_method":"squash","commit_title":null,"commit_message":null},"assignee":null,"active_lock_reason":null},{"url":"https://api.github.com/repos/nickderobertis/onepipeline/pulls/1212","id":5009971765,"node_id":"PR_kwDOTx8aUc8AAAABKp4aNQ","html_url":"https://github.com/nickderobertis/onepipeline/pull/1212","diff_url":"https://github.com/nickderobertis/onepipeline/pull/1212.diff","patch_url":"https://github.com/nickderobertis/onepipeline/pull/1212.patch","issue_url":"https://api.github.com/repos/nickderobertis/onepipeline/issues/1212","number":1212,"state":"closed","locked":false,"title":"feat(deps)!: link the plan store that records what Linear stores from each write","user":{"login":"nickderobertis","id":19440155,"node_id":"MDQ6VXNlcjE5NDQwMTU1","avatar_url":"https://avatars.githubusercontent.com/u/19440155?v=4","gravatar_id":"","url":"https://api.github.com/users/nickderobertis","html_url":"https://github.com/nickderobertis","followers_url":"https://api.github.com/users/nickderobertis/followers","following_url":"https://api.github.com/users/nickderobertis/following{/other_user}","gists_url":"https://api.github.com/users/nickderobertis/gists{/gist_id}","starred_url":"https://api.github.com/users/nickderobertis/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nickderobertis/subscriptions","organizations_url":"https://api.github.com/users/nickderobertis/orgs","repos_url":"https://api.github.com/users/nickderobertis/repos","events_url":"https://api.github.com/users/nickderobertis/events{/privacy}","received_events_url":"https://api.github.com/users/nickderobertis/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"## What\n\nAdapt the Linear loopback and launch journeys to verify copied renderings against what Linear actually stores, including the Markdown rewrites measured by the producer’s spike. Settlement assertions require a read followed by a metadata write, with no read afterward; the `stored-content-diverged` failure mapping remains unchanged.\n\n## Why\n\nPlans rendered by the host’s templates must launch from their Linear copies so teams can follow runs and settlements in their own tracker. Taking stored content from each write’s response also removes an extra read from every settlement write-back on the shared key.\n\n## Additional info\n\nThe base already carries onetaskgraph 0.12.5, including the breaking removal of `stored_form` introduced in 0.12.4. This diff retains that release and makes no dependency-version changes, including to onemessagebus. The removed loopback helper is replaced by a model of Linear’s measured behavior, with rendering digests checked against stored content.","created_at":"2026-10-25T23:58:09Z","updated_at":"2026-10-26T16:28:15Z","closed_at":"2026-10-26T16:28:13Z","merged_at":"2026-10-26T16:28:13Z","merge_commit_sha":"67c8b859289debb255d65dd89b430f11f38c3579","assignees":[],"requested_reviewers":[],"requested_teams":[],"labels":[],"milestone":null,"draft":false,"commits_url":"https://api.github.com/repos/nickderobertis/onepipeline/pulls/1212/commits","review_comments_url":"https://api.github.com/repos/nickderobertis/onepipeline/pulls/1212/comments","review_comment_url":"https://api.github.com/repos/nickderobertis/onepipeline/pulls/comments{/number}","comments_url":"https://api.github.com/repos/nickderobertis/onepipeline/issues/1212/comments","statuses_url":"https://api.github.com/repos/nickderobertis/onepipeline/statuses/05e9449fb0eb8efda76ed09aaf7b751dffbc8ba6","head":{"label":"nickderobertis:nick/1154/pipeline-link-linear-stored-content","ref":"nick/1154/pipeline-link-linear-stored-content","sha":"05e9449fb0eb8efda76ed09aaf7b751dffbc8ba6","user":{"login":"nickderobertis","id":19440155,"node_id":"MDQ6VXNlcjE5NDQwMTU1","avatar_url":"https://avatars.github