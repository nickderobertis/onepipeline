https://github.com/nickderobertis/onepipeline/pull/1236))\n- *(driver)* hold the combined driver's cost flat across journal sizes ([#1230](https://github.com/nickderobertis/onepipeline/pull/1230))\n</blockquote>\n\n\n</p></details>\n\n---\nThis PR was generated with [release-plz](https://github.com/release-plz/release-plz/).","created_at":"2026-10-27T11:08:33Z","updated_at":"2026-10-27T15:16:33Z","closed_at":"2026-10-27T15:16:31Z","merged_at":"2026-10-27T15:16:31Z","merge_commit_sha":"c962121d3e8c732efd26ca141d4de50b475c0f54","assignees":[],"requested_reviewers":[],"requested_teams":[],"labels":[],"milestone":null,"draft":false,"commits_url":"https://api.github.com/repos/nickderobertis/onepipeline/pulls/1235/commits","review_comments_url":"https://api.github.com/repos/nickderobertis/onepipeline/pulls/1235/comments","review_comment_url":"https://api.github.com/repos/nickderobertis/onepipeline/pulls/comments{/number}","comments_url":"https://api.github.com/repos/nickderobertis/onepipeline/issues/1235/comments","statuses_url":"https://api.github.com/repos/nickderobertis/onepipeline/statuses/c8fa4ce01c17d43cdf80d5a5c908c6597e3645a9","head":{"label":"nickderobertis:release-plz-2026-10-27T11-08-29Z","ref":"release-plz-2026-10-27T11-08-29Z","sha":"c8fa4ce01c17d43cdf80d5a5c908c6597e3645a9","user":{"login":"nickderobertis","id":19440155,"node_id":"MDQ6VXNlcjE5NDQwMTU1","avatar_url":"https://avatars.githubusercontent.com/u/19440155?v=4","gravatar_id":"","url":"https://api.github.com/users/nickderobertis","html_url":"https://github.com/nickderobertis","followers_url":"https://api.github.com/users/nickderobertis/followers","following_url":"https://api.github.com/users/nickderobertis/following{/other_user}","gists_url":"https://api.github.com/users/nickderobertis/gists{/gist_id}","starred_url":"https://api.github.com/users/nickderobertis/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nickderobertis/subscriptions","organizations_url":"https://api.github