nickderobertis/onepipeline/issues/1231"},"comments":{"href":"https://api.github.com/repos/nickderobertis/onepipeline/issues/1231/comments"},"review_comments":{"href":"https://api.github.com/repos/nickderobertis/onepipeline/pulls/1231/comments"},"review_comment":{"href":"https://api.github.com/repos/nickderobertis/onepipeline/pulls/comments{/number}"},"commits":{"href":"https://api.github.com/repos/nickderobertis/onepipeline/pulls/1231/commits"},"statuses":{"href":"https://api.github.com/repos/nickderobertis/onepipeline/statuses/c3af35743bc5732201676219e77d695d3857c963"}},"author_association":"OWNER","auto_merge":null,"assignee":null,"active_lock_reason":null},{"url":"https://api.github.com/repos/nickderobertis/onepipeline/pulls/1228","id":5027374294,"node_id":"PR_kwDOTx8aUc8AAAABK6ek1g","html_url":"https://github.com/nickderobertis/onepipeline/pull/1228","diff_url":"https://github.com/nickderobertis/onepipeline/pull/1228.diff","patch_url":"https://github.com/nickderobertis/onepipeline/pull/1228.patch","issue_url":"https://api.github.com/repos/nickderobertis/onepipeline/issues/1228","number":1228,"state":"closed","locked":false,"title":"fix(test): stop two tests failing slow Windows runners on wall-clock bounds","user":{"login":"nickderobertis","id":19440155,"node_id":"MDQ6VXNlcjE5NDQwMTU1","avatar_url":"https://avatars.githubusercontent.com/u/19440155?v=4","gravatar_id":"","url":"https://api.github.com/users/nickderobertis","html_url":"https://github.com/nickderobertis","followers_url":"https://api.github.com/users/nickderobertis/followers","following_url":"https://api.github.com/users/nickderobertis/following{/other_user}","gists_url":"https://api.github.com/users/nickderobertis/gists{/gist_id}","starred_url":"https://api.github.com/users/nickderobertis/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nickderobertis/subscriptions","organizations_url":"https://api.github.com/users/nickderobertis/orgs","repos_url":"https://api.github.com/users/nickderobertis/repos","events_url":"https://api.github.com/users/nickderobertis/events{/privacy}","received_events_url":"https://api.github.com/users/nickderobertis/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"## What\n\nMake the orphaned-pipe relay test assert that the stream ends while the pipe remains open, removing its elapsed-time verdict. Add coverage for a delayed graph-exit answer, retaining a safeguard against indefinite hangs.\n\n## Why\n\nSlow Windows runners were blocking unrelated changes behind manual re-runs, delaying npm adoption of the engine needed to stop Codex launches consuming unnecessary network and quota ([oneharness#1442](https://github.com/nickderobertis/oneharness/issues/1442)). Touching packaged crate source also enables the release carrying the previously merged SBOM work.\n\n## Additional info\n\nThe adoption e2e failure was isolated to a suspected Windows driver stall and deferred to a separate follow-up; that test and the driver remain unchanged. The failure is recorded in the [Windows cross-proof job](https://github.com/nickderobertis/onepipeline/actions/runs/40409285974/job/121875396770).","created_at":"2026-10-27T01:53:43Z","updated_at":"2026-10-27T04:52:14Z","closed_at":"2026-10-27T04:52:12Z","merged_at":"2026-10-27T04:52:12Z","merge_commit_sha":"f458c5e8069aa61419d8ab7971dfdc9f8fddf1fd","assignees":[],"requested_reviewers":[],"requested_teams":[],"labels":[],"milestone":null,"draft":false,"commits_url":"https://api.github.com/repos/nickderobertis/onepipeline/pulls/1228/commits","review_comments_url":"https://api.github.com/repos/nickderobertis/onepipeline/pulls/1228/comments","review_comment_url":"https://api.github.com/repos/nickderobertis/onepipeline/pulls/comments{/number}","comments_url":"https://api.github.com/repos/nickderobertis/onepipeline/issues/1228/comments","statuses_url":"https://api.github.com/repos/nickderobertis/onepipeline/statuses/c2870170171e9882b3c00eccf40387e8cbc0d823","head":{"label":"nickderobertis:nick/npm-engine-install/onepipeline-windows-timing-flakes","ref":"nick/npm-engine-install/onepipeline-windows-timing-flakes","sha":"c2870170171e9882b3c00eccf40387e8cbc0d823","user":{"login":"nickderobertis","id":19440155,"node_id":"MDQ6VXNlcjE5NDQwMTU1","avatar_url":"https://avatars.githubusercontent.com/u/19440155?v=4","gravatar_id":"","url":"https://api.github.com/users/nickderobertis","html_url":"https://github.com/nickderobertis","followers_url":"https://api.github.com/users/nickderobertis/followers","following_url":"https://api.github.com/users/nickderobertis/following{/other_user}","gists_url":"https://api.github.com/users/nickderobertis/gists{/gist_id}","starred_url":"https://api.github.com/users/nickderobertis/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nickderobertis/subscriptions","organizations_url":"https://api.github.com/users/nickderobertis/orgs","repos_url":"https://api.github.com/users/nickderobertis/repos","events_url":"https://api.github.com/users/nickderobertis/events{/privacy}","received_events_url":"https://api.github.com/users/nickderobertis/received_events","type":"User","user_view_type":"public","site_admin":false},"repo":{"id":1327438417,"node_id":"R_kgDOTx8aUQ","name":"onepipeline","full_name":"nickderobertis/onepipeline","private":false,"owner":{"login":"nickderobertis","id":19440155,"node_id":"MDQ6VXNlcjE5NDQwMTU1","avatar_url":"https://avatars.githubusercontent.com/u/19440155?v=4","gravatar_id":"","url":"https://api.github.com/users/nickderobertis","html_url":"https://github.com/nickderobertis","followers_url":"https://api.github.com/users/nickderobertis/followers","following_url":"https://api.github.com/users/nickderobertis/following{/other_user}","gists_url":"https://api.github.com/users/nickderobertis/gists{/gist_id}","starred_url":"https://api.github.com/users/nickderobertis/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nickderobertis/subscrip