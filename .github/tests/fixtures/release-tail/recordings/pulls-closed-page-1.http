erobertis/onepipeline/pulls/1283"},"html":{"href":"https://github.com/nickderobertis/onepipeline/pull/1283"},"issue":{"href":"https://api.github.com/repos/nickderobertis/onepipeline/issues/1283"},"comments":{"href":"https://api.github.com/repos/nickderobertis/onepipeline/issues/1283/comments"},"review_comments":{"href":"https://api.github.com/repos/nickderobertis/onepipeline/pulls/1283/comments"},"review_comment":{"href":"https://api.github.com/repos/nickderobertis/onepipeline/pulls/comments{/number}"},"commits":{"href":"https://api.github.com/repos/nickderobertis/onepipeline/pulls/1283/commits"},"statuses":{"href":"https://api.github.com/repos/nickderobertis/onepipeline/statuses/b3def39e47a95a396e6117b00ec405e39835168d"}},"author_association":"OWNER","auto_merge":null,"assignee":null,"active_lock_reason":null},{"url":"https://api.github.com/repos/nickderobertis/onepipeline/pulls/1264","id":5050198526,"node_id":"PR_kwDOTx8aUc8AAAABLQPp_g","html_url":"https://github.com/nickderobertis/onepipeline/pull/1264","diff_url":"https://github.com/nickderobertis/onepipeline/pull/1264.diff","patch_url":"https://github.com/nickderobertis/onepipeline/pull/1264.patch","issue_url":"https://api.github.com/repos/nickderobertis/onepipeline/issues/1264","number":1264,"state":"closed","locked":false,"title":"chore: release v0.95.5","user":{"login":"nickderobertis","id":19440155,"node_id":"MDQ6VXNlcjE5NDQwMTU1","avatar_url":"https://avatars.githubusercontent.com/u/19440155?v=4","gravatar_id":"","url":"https://api.github.com/users/nickderobertis","html_url":"https://github.com/nickderobertis","followers_url":"https://api.github.com/users/nickderobertis/followers","following_url":"https://api.github.com/users/nickderobertis/following{/other_user}","gists_url":"https://api.github.com/users/nickderobertis/gists{/gist_id}","starred_url":"https://api.github.com/users/nickderobertis/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nickderobertis/subscriptions","organizations_url":"https://api.github.com/users/nickderobertis/orgs","repos_url":"https://api.github.com/users/nickderobertis/repos","events_url":"https://api.github.com/users/nickderobertis/events{/privacy}","received_events_url":"https://api.github.com/users/nickderobertis/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"\n\n\n## 🤖 New release\n\n* `onepipeline`: 0.95.4 -> 0.95.5 (✓ API compatible changes)\n\n<details><summary><i><b>Changelog</b></i></summary><p>\n\n<blockquote>\n\n## [0.95.5](https://github.com/nickderobertis/onepipeline/compare/v0.95.4...v0.95.5) - 2026-10-29\n\n### Added\n\n- *(deps)* link the plan store that routes by organization and classification together ([#1262](https://github.com/nickderobertis/onepipeline/pull/1262))\n\n### Fixed\n\n- *(test)* make the pooled-slot hand-back journey reliable on a loaded runner ([#1279](https://github.com/nickderobertis/onepipeline/pull/1279))\n- *(tests)* make the activity-rule liveness test wait for the spawned tree to exit ([#1268](https://github.com/nickderobertis/onepipeline/pull/1268))\n- *(tests)* make the live-judge note journey wait for the worker's presentation record ([#1273](https://github.com/nickderobertis/onepipeline/pull/1273))\n- *(npm)* run the npm launcher journeys on Windows ([#1259](https://github.com/nickderobertis/onepipeline/pull/1259))\n- *(deps)* link the plan store that keeps a private Linear home's public projections ([#1256](https://github.com/nickderobertis/onepipeline/pull/1256))\n</blockquote>\n\n\n</p></details>\n\n---\nThis PR was generated with [release-plz](https://github.com/release-plz/release-plz/).","created_at":"2026-10-28T12:07:45Z","updated_at":"2026-10-29T07:29:19Z","closed_at":"2026-10-29T07:29:17Z","merged_at":"2026-10-29T07:29:17Z","merge_commit_sha":"10dde3918791a7e66095ad179c4e8ca7d70f881e","assignees":[],"requested_reviewers":[],"requested_teams":[],"labels":[],"milestone":null,"draft":false,"commits_url":"https://api.github.co