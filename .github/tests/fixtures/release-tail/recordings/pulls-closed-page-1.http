/onepipeline/releases{/id}","deployments_url":"https://api.github.com/repos/nickderobertis/onepipeline/deployments","created_at":"2026-08-08T05:18:50Z","updated_at":"2026-11-01T09:13:42Z","pushed_at":"2026-11-01T09:36:05Z","git_url":"git://github.com/nickderobertis/onepipeline.git","ssh_url":"git@github.com:nickderobertis/onepipeline.git","clone_url":"https://github.com/nickderobertis/onepipeline.git","svn_url":"https://github.com/nickderobertis/onepipeline","homepage":null,"size":24249,"stargazers_count":1,"watchers_count":1,"language":"Rust","has_issues":true,"has_projects":true,"has_downloads":false,"has_wiki":true,"has_pages":true,"has_discussions":false,"forks_count":2,"mirror_url":null,"archived":false,"disabled":false,"open_issues_count":252,"license":{"key":"mit","name":"MIT License","spdx_id":"MIT","url":"https://api.github.com/licenses/mit","node_id":"MDc6TGljZW5zZTEz"},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"has_pull_requests":true,"pull_request_creation_policy":"all","topics":[],"visibility":"public","forks":2,"open_issues":252,"watchers":1,"default_branch":"main"}},"_links":{"self":{"href":"https://api.github.com/repos/nickderobertis/onepipeline/pulls/1274"},"html":{"href":"https://github.com/nickderobertis/onepipeline/pull/1274"},"issue":{"href":"https://api.github.com/repos/nickderobertis/onepipeline/issues/1274"},"comments":{"href":"https://api.github.com/repos/nickderobertis/onepipeline/issues/1274/comments"},"review_comments":{"href":"https://api.github.com/repos/nickderobertis/onepipeline/pulls/1274/comments"},"review_comment":{"href":"https://api.github.com/repos/nickderobertis/onepipeline/pulls/comments{/number}"},"commits":{"href":"https://api.github.com/repos/nickderobertis/onepipeline/pulls/1274/commits"},"statuses":{"href":"https://api.github.com/repos/nickderobertis/onepipeline/statuses/2c4ccc49db5546f8de5be42c46d2b6dff009e902"}},"author_association":"OWNER","auto_merge":null,"assignee":null,"active_lock_reason":null},{"url":"https://api.github.com/repos/nickderobertis/onepipeline/pulls/1261","id":5048234758,"node_id":"PR_kwDOTx8aUc8AAAABLOXzBg","html_url":"https://github.com/nickderobertis/onepipeline/pull/1261","diff_url":"https://github.com/nickderobertis/onepipeline/pull/1261.diff","patch_url":"https://github.com/nickderobertis/onepipeline/pull/1261.patch","issue_url":"https://api.github.com/repos/nickderobertis/onepipeline/issues/1261","number":1261,"state":"closed","locked":false,"title":"fix(test): make the restack-before-checks journey reliable on a loaded runner","user":{"login":"nickderobertis","id":19440155,"node_id":"MDQ6VXNlcjE5NDQwMTU1","avatar_url":"https://avatars.githubusercontent.com/u/19440155?v=4","gravatar_id":"","url":"https://api.github.com/users/nickderobertis","html_url":"https://github.com/nickderobertis","followers_url":"https://api.github.com/users/nickderobertis/followers","following_url":"https://api.github.com/users/nickderobertis/following{/other_user}","gists_url":"https://api.github.com/users/nickderobertis/gists{/gist_id}","starred_url":"https://api.github.com/users/nickderobertis/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nickderobertis/subscriptions","organizations_url":"https://api.github.com/users/nickderobertis/orgs","repos_url":"https://api.github.com/users/nickderobertis/repos","events_url":"https://api.github.com/users/nickderobertis/events{/privacy}","received_events_url":"https://api.github.com/users/nickderobertis/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"## What\n\nPrevent the e2e harness from rewriting a hook script while a held push is running it, avoiding a Windows race that can refuse the rework’s push and strand its retry at the restack’s hold. Add regression coverage for switching holds during an active push, preserving the journey’s event-based restack ordering assertion.\n\n## Why\n\nThis flake is blocking the engine release carrying the plan store fix the user’s host needs. Fixing the harness race addresses the failure instead of relying on retries.","created_at":"2026-10-28T09:32:18Z","updated_at":"2026-10-29T08:18:33Z","closed_at":"2026-10-29T08:18:31Z","merged_at":"2026-10-29T08:18:30Z","merge_commit_sha":"4c1f3eabf1e723e6556cfe5a033f25dfe407e6e5","assignees":[],"requested_reviewers":[],"requested_teams":[],"labels":[],"milestone":null,"draft":false,"commits_url":"https://api.github.com/repos/nickderobertis/onepipeline/pulls/1261/commits","review_comments_url":"https://api.github.com/repos/nickderobertis/onepipeline/pulls/1261/comments","review_comment_url":"https://api.github.com/repos/nickderobertis/onepipeline/pulls/comments{/number}","comments_url":"https://api.github.com/repos/nickderobertis/onepipeline/issues/1261/comments","statuses_url":"https://api.github.com/repos/nickderobertis/onepipeline/statuses/374630bbdbea318cd470601be4e6dc4b04ada9b9","head":{"label":"nickderobertis:nick/npm-engine-install/onepipeline-restack-wait-windows","ref":"nick/npm-engine-install/onepipeline-restack-wait-windows","sha":"374630bbdbea318cd470601be4e6dc4b04ada9b9","user":{"login":"nickderobertis","id":19440155,"node_id":"MDQ6VXNlcjE5NDQwMTU1","avatar_url":"https://avatars.githubusercontent.com/u/19440155?v=4","gravatar_id":"","url":"https://api.github.com/users/nickderobertis","html_url":"https://github.com/nickderobertis","followers_url":"https://api.github.com/users/nickderobertis/followers","following_url":"https://api.github.com/users/nickderobertis/following{/other_user}","gists_url":"https://api.github.com/users/nickderobertis/gists{/gist_id}","starred_url":"https://api.github.com/users/nickderobertis/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nickderobertis/subscriptions","organizations_url":"https://api.github.com/users/nickderobertis/orgs","repos_url":"https://api.github.com/users/nickderobertis/repos","events_url":"https://api.github.com/users/nickderobertis/events{/p