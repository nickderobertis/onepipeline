onepipeline/issues/1299/comments"},"review_comments":{"href":"https://api.github.com/repos/nickderobertis/onepipeline/pulls/1299/comments"},"review_comment":{"href":"https://api.github.com/repos/nickderobertis/onepipeline/pulls/comments{/number}"},"commits":{"href":"https://api.github.com/repos/nickderobertis/onepipeline/pulls/1299/commits"},"statuses":{"href":"https://api.github.com/repos/nickderobertis/onepipeline/statuses/f1670d7f93255ebf8dd0e5cec2be2e5a0ac45d1d"}},"author_association":"OWNER","auto_merge":null,"assignee":null,"active_lock_reason":null},{"url":"https://api.github.com/repos/nickderobertis/onepipeline/pulls/1297","id":5070568248,"node_id":"PR_kwDOTx8aUc8AAAABLjq7OA","html_url":"https://github.com/nickderobertis/onepipeline/pull/1297","diff_url":"https://github.com/nickderobertis/onepipeline/pull/1297.diff","patch_url":"https://github.com/nickderobertis/onepipeline/pull/1297.patch","issue_url":"https://api.github.com/repos/nickderobertis/onepipeline/issues/1297","number":1297,"state":"closed","locked":false,"title":"feat: declare additive human action item contracts","user":{"login":"nickderobertis","id":19440155,"node_id":"MDQ6VXNlcjE5NDQwMTU1","avatar_url":"https://avatars.githubusercontent.com/u/19440155?v=4","gravatar_id":"","url":"https://api.github.com/users/nickderobertis","html_url":"https://github.com/nickderobertis","followers_url":"https://api.github.com/users/nickderobertis/followers","following_url":"https://api.github.com/users/nickderobertis/following{/other_user}","gists_url":"https://api.github.com/users/nickderobertis/gists{/gist_id}","starred_url":"https://api.github.com/users/nickderobertis/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nickderobertis/subscriptions","organizations_url":"https://api.github.com/users/nickderobertis/orgs","repos_url":"https://api.github.com/users/nickderobertis/repos","events_url":"https://api.github.com/users/nickderobertis/events{/privacy}","received_events_url":"https://api.github.com/users/nickderobertis/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"## What\n\nAdd the public human-items contract, exported JSON schemas and optional human-node metadata, with conformance tests tying engine definitions to the documented contract. Add sample-backed CLI queries and actions with full item bodies, source and blocking context, and Critical/High/Medium/Low labels.\n\n## Why\n\nA single visible queue lets operators focus on the most urgent human work while unrelated development continues.\n\n## Additional info\n\nCLI adapters require explicit `--sample` mode; live commands return a typed unavailable refusal. Runtime approval integration, automatic resolution and durable delivery remain deferred. Existing run scheduling and journal writers are unchanged.\n\nUpdate the locked libz-sys dependency to 1.1.31 to address RUSTSEC-2026-0418.","created_at":"2026-10-29T15:11:08Z","updated_at":"2026-10-29T19:14:24Z","closed_at":"2026-10-29T19:14:21Z","merged_at":"2026-10-29T19:14:21Z","merge_commit_sha":"23f9e4b9ccbea278ee1b4c603c183110b48b4168","assignees":[],"requested_reviewers":[],"requested_teams":[],"labels":[],"milestone":null,"draft":false,"commits_url":"https://api.github.com/repos/nickderobertis/onepipeline/pulls/1297/commits","review_comments_url":"https://api.github.com/repos/nickderobertis/onepipeline/pulls/1297/comments","review_comment_url":"https://api.github.com/repos/nickderobertis/onepipeline/pulls/comments{/number}","comments_url":"https://api.github.com/repos/nickderobertis/onepipeline/issues/1297/comments","statuses_url":"https://api.github.com/repos/nickderobertis/onepipeline/statuses/d3ae06abb22af1a01150809607b16cc30be4dad2","head":{"label":"nickderobertis:nick/1270/item-contract","ref":"nick/1270/item-contract","sha":"d3ae06abb22af1a01150809607b16cc30be4dad2","user":{"login":"nickderobertis","id":19440155,"node_id":"MDQ6VXNlcjE5NDQwMTU1","avatar_url":"https://avatars.githubusercontent.com/