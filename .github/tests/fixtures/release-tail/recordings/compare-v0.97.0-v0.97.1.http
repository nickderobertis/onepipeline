l":"https://api.github.com/users/nickderobertis/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nickderobertis/subscriptions","organizations_url":"https://api.github.com/users/nickderobertis/orgs","repos_url":"https://api.github.com/users/nickderobertis/repos","events_url":"https://api.github.com/users/nickderobertis/events{/privacy}","received_events_url":"https://api.github.com/users/nickderobertis/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"da460300fa11006304d74ef5c6d0f5763eeb2603","url":"https://api.github.com/repos/nickderobertis/onepipeline/commits/da460300fa11006304d74ef5c6d0f5763eeb2603","html_url":"https://github.com/nickderobertis/onepipeline/commit/da460300fa11006304d74ef5c6d0f5763eeb2603"}]}],"files":[{"sha":"a7e4c89ce4051a77bc463d162b1c9d0b9b455000","filename":"CHANGELOG.md","status":"modified","additions":6,"deletions":0,"changes":6,"blob_url":"https://github.com/nickderobertis/onepipeline/blob/c3f74a07da428dcf7094d18c4c6d21d250111bc9/CHANGELOG.md","raw_url":"https://github.com/nickderobertis/onepipeline/raw/c3f74a07da428dcf7094d18c4c6d21d250111bc9/CHANGELOG.md","contents_url":"https://api.github.com/repos/nickderobertis/onepipeline/contents/CHANGELOG.md?ref=c3f74a07da428dcf7094d18c4c6d21d250111bc9","patch":"@@ -7,6 +7,12 @@ and this project adheres to [Semantic Versioning](https://semver.org/spec/v2.0.0\n \n ## [Unreleased]\n \n+## [0.97.1](https://github.com/nickderobertis/onepipeline/compare/v0.97.0...v0.97.1) - 2026-10-31\n+\n+### Performance\n+\n+- cut onepipeline's per-test cost in the e2e suite and library ([#1278](https://github.com/nickderobertis/onepipeline/pull/1278))\n+\n ## [0.97.0](https://github.com/nickderobertis/onepipeline/compare/v0.96.2...v0.97.0) - 2026-10-31\n \n ### Added"},{"sha":"9fb0090154093fd055df40481871c84c1c856907","filename":"Cargo.lock","status":"modified","additions":1,"deletions":1,"changes":2,"blob_url":"https://github.com/nickderobertis/onepipeline/blob/c3f74a07da428dcf7094d18c4c6d21d250111bc9/Cargo.lock","raw_url":"https://github.com/nickderobertis/onepipeline/raw/c3f74a07da428dcf7094d18c4c6d21d250111bc9/Cargo.lock","contents_url":"https://api.github.com/repos/nickderobertis/onepipeline/contents/Cargo.lock?ref=c3f74a07da428dcf7094d18c4c6d21d250111bc9","patch":"@@ -1579,7 +1579,7 @@ dependencies = [\n \n [[package]]\n name = \"onepipeline\"\n-version = \"0.97.0\"\n+version = \"0.97.1\"\n dependencies = [\n  \"async-trait\",\n  \"clap\","},{"sha":"c74cde2c49d1fa7799d19c76b229dd77f6880cc0","filename":"Cargo.toml","status":"modified","additions":17,"deletions":1,"changes":18,"blob_url":"https://github.com/nickderobertis/onepipeline/blob/c3f74a07da428dcf7094d18c4c6d21d250111bc9/Cargo.toml","raw_url":"https://github.com/nickderobertis/onepipeline/raw/c3f74a07da428dcf7094d18c4c6d21d250111bc9/Cargo.toml","contents_url":"https://api.github.com/repos/nickderobertis/onepipeline/contents/Cargo.toml?ref=c3f74a07da428dcf7094d18c4c6d21d250111bc9","patch":"@@ -1318,7 +1318,7 @@ windows-sys = \"0.61\"\n \n [package]\n name = \"onepipeline\"\n-version = \"0.97.0\"\n+version = \"0.97.1\"\n edition = \"2021\"\n rust-version.workspace = true\n description = \"Execute a task DAG over oneagentgraph and onevcs, merging their event streams into one.\"\n@@ -1635,6 +1635,22 @@ strip = true\n lto = \"thin\"\n codegen-units = 1\n \n+# Every debug process — each `onepipeline` an e2e test spawns — builds the event\n+# registry at start, compiling a JSON Schema validator per payload: about 140 ms\n+# unoptimized, about 30 ms with these dependencies optimized. Workspace members stay\n+# at opt-level 0, so what coverage instruments is unchanged.\n+[profile.dev.package]\n+ahash = { opt-level = 2 }\n+fancy-regex = { opt-level = 2 }\n+jsonschema = { opt-level = 2 }\n+jsonschema-regex = { opt-level = 2 }\n+jsonschema-value = { opt-level = 2 }\n+referencing = { opt-level = 2 }\n+regex = { opt-level = 2 }\n+regex-automata = { opt-level = 2 }\n+regex-syntax = { opt-level = 2 }\n+schemars = { opt-level = 2 }\n+\n # Wire-level refusal checks for the shared Codex app-server double, isolated\n # from the dispatch journeys so its backstops rerun only for their own inputs.\n [[test]]"},{"sha":"3d6e43d93d49cee5179902a17bfeb813968ae282","filename":"crates/testfakes/Cargo.toml","status":"modified","additions":7,"deletions":0,"changes":7,"blob_url":"https://github.com/nickderobertis/onepipeline/blob/c3f74a07da428dcf7094d18c4c6d21d250111bc9/crates%2Ftestfakes%2FCargo.toml","raw_url":"https://github.com/nickderobertis/onepipeline/raw/c3f74a07da428dcf7094d18c4c6d21d250111bc9/crates%2Ftestfakes%2FCargo.toml","contents_url":"https://api.github.com/repos/nickderobertis/onepipeline/contents/crates%2Ftestfakes%2FCargo.toml?ref=c3f74a07da428dcf7094d18c4c6d21d250111bc9","patch":"@@ -221,3 +221,10 @@ path = \"src/bin/review-read.rs\"\n [lib]\n name = \"onepipeline_testfakes\"\n path = \"src/lib.rs\"\n+\n+# llmlint: ignore[new_command_or_client_gets_its_own_project] a test-only Cargo\n+# recorder, owned and exercised by the e2e fixture project like the bins above;\n+# it forwards to the real compiler and is never a published command.\n+[[bin]]\n+name = \"cargo-record\"\n+path = \"src/bin/cargo-record.rs\""},{"sha":"17aa7a563dc4a2790569880aadb613b035a0d1eb","filename":"crates/testfakes/src/bin/cargo-record.rs","status":"added","additions":35,"deletions":0,"changes":35,"blob_url":"https://github.com/nickderobertis/onepipeline/blob/c3f74a07da428dcf7094d18c4c6d21d250111bc9/crates%2Ftestfakes%2Fsrc%2Fbin%2Fcargo-record.rs","raw_url":"https://github.com/nickderobertis/onepipeline/raw/c3f74a07da428dcf7094d18c4c6d21d250111bc9/crates%2Ftestfakes%2Fsrc%2Fbin%2Fcargo-record.rs","contents_url":"https://api.github.com/repos/nickderobertis/onepipeline/contents/crates%2Ftestfakes%2Fsrc%2Fbin%2Fcargo-record.rs?ref=c3f74a07da428dcf7094d18c4c6d21d250111bc9","patch":"@@ -0,0 +1,35 @@\n+//! Record Cargo starts while forwarding every argument to the real Cargo.\n+//! The e2e harness's build-cache journey uses this to observe builds without\n+//! substituting the compiler, its freshness checks, or its refusal paths.\n+\n+use std::io::Write;\n+use std::process::{Command, ExitCode};\n+\n+fn main() -> ExitCode {\n+    match run() {\n+        Ok(code) => code,\n+        Err(error) => {\n+            eprintln!(\"cargo-record: {error}\");\n+            ExitCode::FAILURE\n+        }\n+    }\n+}\n+\n+fn run() -> Result<ExitCode, Box<dyn std::error::Error>> {\n+    let real = std::env::var_os(\"ONEPIPELINE_REAL_CARGO\").ok_or(\"real Cargo is required\")?;\n+    let log = std::env::var_os(\"ONEPIPELINE_CARGO_STARTS\").ok_or(\"a starts log is required\")?;\n+    let mut log = std::fs::OpenOptions::new()\n+        .create(true)\n+        .append(true)\n+        .open(log)?;\n+    writeln!(log, \"build\")?;\n+    let status = Command::new(real)\n+        .args(std::env::args_os().skip(1))\n+        .status()?;\n+    Ok(ExitCode::from(\n+        status\n+            .code()\n+            .and_then(|code| u8::try_from(code).ok())\n+            .unwrap_or(1),\n+    ))\n+}"},{"sha":"0c75291aef87674b83838d056093e8a8b4d14eb8","filename":"justfile","status":"modified","additions":12,"deletions":2,"changes":14,"blob_url":"https://github.com/nickderobertis/onepipeline/blob/c3f74a07da428dcf7094d18c4c6d21d250111bc9/justfile","raw_url":"https://github.com/nickderobertis/onepipeline/raw/c3f74a07da428dcf7094d18c4c6d21d250111bc9/justfile","contents_url":"https://api.github.com/repos/nickderobertis/onepipeline/contents/justfile?ref=c3f74a07da428dcf7094d18c4c6d21d250111bc9","patch":"@@ -567,11 +567,21 @@ _release-compat-run *args:\n stop-verdict-journeys:\n     @node scripts/stop-guard-unpublished-invocation.mjs just _stop-verdict-run\n \n-_stop-verdict-run:\n-    @RUSTFLAGS=\"-D warnings\" cargo build --release --locked --quiet --bin onepipeline\n+_stop-verdict-run: _stop-verdict-build\n     @ONEPIPELINE_BUDGET_BINARY=\"$PWD/target/release/onepipeline\" RUSTFLAGS=\"-D warnings\" cargo nextest run --locked -E 'binary(stop_verdict)' --no-tests=fail\n     @node --test scripts/stop-guard-unpublished-budget.test.mjs\n \n+# The release binary the run above times, built alone: the\n+# `onepipeline-stop-verdict:test-build` target its `test` depends on. That `test`\n+# admits nothing beside it, because it times the binary, and building needs no\n+# such quiet, so this runs beside the rest of the gate rather than inside the\n+# window nothing else may use. Only the release build: the run's test binaries\n+# are the debug tree `just _crate-build` builds under the same flags, and\n+# building them here held that tree's lock from the gate's first minute, until\n+# the npm publish journey waiting on it ran out its 900-second setup.\n+_stop-verdict-build:\n+    @RUSTFLAGS=\"-D warnings\" cargo build --release --locked --quiet --bin onepipeline\n+\n # Outside `check` and `gate`: each runs a whole host-shaped workload journey to\n # measure it, which no per-change selection should pay for. Every project's\n # `workload` target is uncached and reached by no `check`, `test`, coverage or"},{"sha":"46d268b7d3b16d46ca57bfb0127a5ef0eadd2455","filename":"npm/project.json","status":"modified","additions":7,"deletions":0,"changes":7,"blob_url":"https://github.com/nickderobertis/onepipeline/blob/c3f74a07da428dcf7094d18c4c6d21d250111bc9/npm%2Fproject.json","raw_url":"https://github.com/nickderobertis/onepipeline/raw/c3f74a07da428dcf7094d18c4c6d21d250111bc9/npm%2Fproject.json","contents_url":"https://api.github.com/repos/nickderobertis/onepipeline/contents/npm%2Fproject.json?ref=c3f74a07da428dcf7094d18c4c6d21d250111bc9","patch":"@@ -30,6 +30,13 @@\n     },\n     \"test\": {\n       \"command\": \"node --test npm/test/*.test.mjs\",\n+      \"//\": \"The crate's debug build (`just _crate-build`) runs first, as its own task: the publish journey packs that build and workspace-nx drives the same recipe, and a suite that compiled it itself held the tree's lock past the publish journey's 900-second setup.\",\n+      \"dependsOn\": [\n+        {\n+          \"projects\": [\"onepipeline\"],\n+          \"target\": \"build\"\n+        }\n+      ],\n       \"inputs\": [\n         \"{projectRoot}/**/*\",\n         \"{workspaceRoot}/scripts/npm-build.mjs\","},{"sha":"1641b3d87047fa7d94d419a22bba722811649077","filename":"npm/test/install-support.mjs","status":"modified","additions":31,"deletions":9,"changes":40,"blob_url":"https://github.com/nickderobertis/onepipeline/blob/c3f74a07da428dcf7094d18c4c6d21d250111bc9/npm%2Ftest%2Finstall-support.mjs","raw_url":"https://github.com/nickderobertis/onepipeline/raw/c3f74a07da428dcf7094d18c4c6d21d250111bc9/npm%2Ftest%2Finstall-support.mjs","contents_url":"https://api.github.com/repos/nickderobertis/onepipeline/contents/npm%2Ftest%2Finstall-support.mjs?ref=c3f74a07da428dcf7094d18c4c6d21d250111bc9","patch":"@@ -2,10 +2,11 @@\n // stage without contending with the rest of the gate, and the pack-then-install a\n // user's `npm install` amounts to.\n \n-import { execFileSync } from \"node:child_process\";\n+import { execFile, execFileSync } from \"node:child_process\";\n import { dirname, join, resolve } from \"node:path\";\n import assert from \"node:assert/strict\";\n import { fileURLToPath } from \"node:url\";\n+import { promisify } from \"node:util\";\n import { spawnable } from \"./spawn-support.mjs\";\n \n export const REPO_ROOT = resolve(dirname(fileURLToPath(import.meta.url)), \"..\", \"..\");\n@@ -32,15 +33,36 @@ export function hostTarget() {\n // keeps them out of that lock and still reuses its build on the next run.\n export const STAGED_TARGET_DIR = join(REPO_ROOT, \"target\", \"npm-staged\");\n \n+// The debug build `publish-gate.test.mjs` packs, under the flags of every other\n+// debug build the gate makes (`just _crate-build`, the stop-verdict tier). Cargo\n+// keys a build on its flags, so an unflagged one compiled the crate and every\n+// dependency into a second tree; `workspace-nx.test.mjs` holds this one to the\n+// tree `_crate-build` leaves.\n+export const GATE_DEBUG_BUILD = {\n+  args: [\"build\", \"--locked\", \"--quiet\"],\n+  env: { RUSTFLAGS: \"-D warnings\" },\n+};\n+\n+function spawnOptions(options) {\n+  return {\n+    cwd: REPO_ROOT,\n+    encoding: \"utf8\",\n+    ...options,\n+    env: { ...process.env, CARGO_TARGET_DIR: STAGED_TARGET_DIR, ...options.env },\n+  };\n+}\n+\n export function run(command, args, options = {}) {\n-  return execFileSync(\n-    ...spawnable(command, args, {\n-      cwd: REPO_ROOT,\n-      encoding: \"utf8\",\n-      ...options,\n-      env: { ...process.env, CARGO_TARGET_DIR: STAGED_TARGET_DIR, ...options.env },\n-    }),\n-  );\n+  return execFileSync(...spawnable(command, args, spawnOptions(options)));\n+}\n+\n+const execFileAsync = promisify(execFile);\n+\n+/// `run` without blocking the event loop, for the cases a suite runs at once.\n+/// Resolves to stdout; a failed command rejects with its `code` and `stderr`.\n+export async function runAsync(command, args, options = {}) {\n+  const { stdout } = await execFileAsync(...spawnable(command, args, spawnOptions(options)));\n+  return stdout;\n }\n \n /// Pack a package directory into the tarball the registry would serve."},{"sha":"bc326951715a45417c2d9123a636977fc3d770c1","filename":"npm/test/launcher.test.mjs","status":"modified","additions":111,"deletions":98,"changes":209,"blob_url":"https://github.com/nickderobertis/onepipeline/blob/c3f74a07da428dcf7094d18c4c6d21d250111bc9/npm%2Ftest%2Flauncher.test.mjs","raw_url":"https://github.com/nickderobertis/onepipeline/raw/c3f74a07da428dcf7094d18c4c6d21d250111bc9/npm%2Ftest%2Flauncher.test.mjs","contents_url":"https://api.github.com/repos/nickderobertis/onepipeline/contents/npm%2Ftest%2Flauncher.test.mjs?ref=c3f74a07da428dcf7094d18c4c6d21d250111bc9","patch":"@@ -14,7 +14,7 @@ import { join } from \"node:path\";\n import { after, before, describe, it } from \"node:test\";\n import assert from \"node:assert/strict\";\n import { assertSbomShape } from \"./sbom-support.mjs\";\n-import { REPO_ROOT, hostTarget, installInto, pack, run } from \"./install-support.mjs\";\n+import { REPO_ROOT, hostTarget, installInto, pack, run, runAsync } from \"./install-support.mjs\";\n \n /// Invoke the installed launcher, returning its exit code, stdout, and stderr.\n function launch(project, args) {\n@@ -137,105 +137,118 @@ describe(\"the npm distribution\", () => {\n     );\n   });\n \n-  for (const [mutation, reason] of [\n-    ...Array.from({ length: 6 }, (_, i) => [`version-invalid-${i}`, \"invalid staged version\"]),\n-    [\"wheel-primary\", \"omitted the primary executable\"],\n-    [\"npm-missing\", \"omitted required members\"],\n-    [\"hash-syntax\", \"invalid payload hash\"],\n-    [\"inventory-empty\", \"invalid executable inventory\"],\n-    [\"inventory-type\", \"invalid executable inventory\"],\n-    [\"inventory-unsafe\", \"invalid executable inventory\"],\n-    [\"wheel-encrypted-flagged\", \"encrypted\"],\n-    [\"archive-truncated\", \"Compressed file ended\"],\n-    [\"wheel-duplicate\", \"unsafe wheel member: duplicate.data\"],\n-    [\"wheel-path\", \"invalid wheel executable inventory\"],\n-    [\"sbom-object\", \"invalid SBOM\"],\n-    [\"npm-object\", \"invalid npm manifest object\"],\n-    [\"npm-directory\", \"unexpected npm archive member\"],\n-    [\"npm-name\", \"npm target identity mismatch\"],\n-    [\"npm-os\", \"npm target identity mismatch\"],\n-    [\"npm-cpu\", \"npm target identity mismatch\"],\n-    [\"npm-unsafe\", \"unsafe or duplicate\"],\n-    [\"npm-duplicate\", \"unsafe or duplicate\"],\n-    [\"npm-link\", \"unexpected npm archive member\"],\n-    [\"npm-unexpected\", \"unexpected npm archive member\"],\n-    [\"npm-executable\", \"unexpected executable npm archive member\"],\n-    [\"npm-mode\", \"npm executable lacks execute permission\"],\n-    [\"archive-mode\", \"archive executable lacks execute permission\"],\n-    [\"wheel-extra-tag\", \"wheel architecture tag mismatch\"],\n-    [\"archive-doc-directory\", \"not a regular file\"],\n-    [\"archive-doc-symlink\", \"not a regular file\"],\n-    [\"archive-doc-hardlink\", \"not a regular file\"],\n-    [\"archive-directory\", \"not a regular file\"],\n-    [\"schema\", \"unsupported staged record schema\"],\n-    [\"unknown\", \"missing or unknown fields\"],\n-    [\"missing\", \"missing or unknown fields\"],\n-    [\"field-type\", \"invalid staged record field\"],\n-    [\"target\", \"unsupported target\"],\n-    [\"tag\", \"tag/version mismatch\"],\n-    [\"inventory\", \"inventory differs\"],\n-    [\"wheel-version\", \"wheel name/version mismatch\"],\n-    [\"wheel-arch\", \"wheel architecture tag mismatch\"],\n-    [\"sbom\", \"invalid SBOM\"],\n-    [\"no-sbom\", \"missing SBOM\"],\n-    [\"no-metadata\", \"wheel is missing its .dist-info/METADATA\"],\n-    [\"no-wheel-tags\", \"wheel is missing its .dist-info/WHEEL\"],\n-    [\"wheel-traversal\", \"unsafe wheel member: ../escape\"],\n-    [\"wheel-symlink\", \"wheel member is not a regular file\"],\n-    [\"wheel-dist-info\", \"exactly one .dist-info directory\"],\n-    [\"wheel-data-scheme\", \"unsafe wheel member\"],\n-    [\"wheel-filename\", \"wheel filename tags differ from its WHEEL tags\"],\n-    [\"wheel-filename-version\", \"wheel filename name/version mismatch\"],\n-    [\"wheel-repeat\", \"wheel repeats a member\"],\n-    [\"macho\", \"Mach-O architecture mismatch\"],\n-    [\"archive-layout\", \"archive layout mismatch\"],\n-    [\"archive-payload\", \"archive executable differs\"],\n-    [\"npm-payload\", \"npm executable differs\"],\n-    [\"npm-version\", \"npm version mismatch\"],\n-    [\"archive-name\", \"archive name mismatch\"],\n-    [\"checksum\", \"archive checksum mismatch\"],\n-    ...[\n-      [\"npm-no-sbom\", \"omitted sboms/onepipeline.cyclonedx.json\"],\n+  // Each case mutates its own copy of the staged bundles and verifies it, so the\n+  // cases share nothing but the build `before` made; each is a single-threaded\n+  // inflate and hash, so four, the cores of CI's Linux runner, run at once.\n+  describe(\"the staged verifier\", { concurrency: 4 }, () => {\n+    for (const [mutation, reason] of [\n+      ...Array.from({ length: 6 }, (_, i) => [`version-invalid-${i}`, \"invalid staged version\"]),\n+      [\"wheel-primary\", \"omitted the primary executable\"],\n+      [\"npm-missing\", \"omitted required members\"],\n+      [\"hash-syntax\", \"invalid payload hash\"],\n+      [\"inventory-empty\", \"invalid executable inventory\"],\n+      [\"inventory-type\", \"invalid executable inventory\"],\n+      [\"inventory-unsafe\", \"invalid executable inventory\"],\n+      [\"wheel-encrypted-flagged\", \"encrypted\"],\n+      [\"archive-truncated\", \"Compressed file ended\"],\n+      [\"wheel-duplicate\", \"unsafe wheel member: duplicate.data\"],\n+      [\"wheel-path\", \"invalid wheel executable inventory\"],\n+      [\"sbom-object\", \"invalid SBOM\"],\n+      [\"npm-object\", \"invalid npm manifest object\"],\n+      [\"npm-directory\", \"unexpected npm archive member\"],\n+      [\"npm-name\", \"npm target identity mismatch\"],\n+      [\"npm-os\", \"npm target identity mismatch\"],\n+      [\"npm-cpu\", \"npm target identity mismatch\"],\n+      [\"npm-unsafe\", \"unsafe or duplicate\"],\n+      [\"npm-duplicate\", \"unsafe or duplicate\"],\n+      [\"npm-link\", \"unexpected npm archive member\"],\n+      [\"npm-unexpected\", \"unexpected npm archive member\"],\n+      [\"npm-executable\", \"unexpected executable npm archive member\"],\n+      [\"npm-mode\", \"npm executable lacks execute permission\"],\n+      [\"archive-mode\", \"archive executable lacks execute permission\"],\n+      [\"wheel-extra-tag\", \"wheel architecture tag mismatch\"],\n+      [\"archive-doc-directory\", \"not a regular file\"],\n+      [\"archive-doc-symlink\", \"not a regular file\"],\n+      [\"archive-doc-hardlink\", \"not a regular file\"],\n+      [\"archive-directory\", \"not a regular file\"],\n+      [\"schema\", \"unsupported staged record schema\"],\n+      [\"unknown\", \"missing or unknown fields\"],\n+      [\"missing\", \"missing or unknown fields\"],\n+      [\"field-type\", \"invalid staged record field\"],\n+      [\"target\", \"unsupported target\"],\n+      [\"tag\", \"tag/version mismatch\"],\n+      [\"inventory\", \"inventory differs\"],\n+      [\"wheel-version\", \"wheel name/version mismatch\"],\n+      [\"wheel-arch\", \"wheel architecture tag mismatch\"],\n+      [\"sbom\", \"invalid SBOM\"],\n+      [\"no-sbom\", \"missing SBOM\"],\n+      [\"no-metadata\", \"wheel is missing its .dist-info/METADATA\"],\n+      [\"no-wheel-tags\", \"wheel is missing its .dist-info/WHEEL\"],\n+      [\"wheel-traversal\", \"unsafe wheel member: ../escape\"],\n+      [\"wheel-symlink\", \"wheel member is not a regular file\"],\n+      [\"wheel-dist-info\", \"exactly one .dist-info directory\"],\n+      [\"wheel-data-scheme\", \"unsafe wheel member\"],\n+      [\"wheel-filename\", \"wheel filename tags differ from its WHEEL tags\"],\n+      [\"wheel-filename-version\", \"wheel filename name/version mismatch\"],\n+      [\"wheel-repeat\", \"wheel repeats a member\"],\n+      [\"macho\", \"Mach-O architecture mismatch\"],\n+      [\"archive-layout\", \"archive layout mismatch\"],\n+      [\"archive-payload\", \"archive executable differs\"],\n+      [\"npm-payload\", \"npm executable differs\"],\n+      [\"npm-version\", \"npm version mismatch\"],\n+      [\"archive-name\", \"archive name mismatch\"],\n+      [\"checksum\", \"archive checksum mismatch\"],\n+      ...[\n+        [\"npm-no-sbom\", \"omitted sboms/onepipeline.cyclonedx.json\"],\n+        [\n+          \"npm-sbom-object\",\n+          \"carries sboms/onepipeline.cyclonedx.json that is not a CycloneDX object\",\n+        ],\n+        [\"npm-sbom\", \"carries sboms/onepipeline.cyclonedx.json that is not a CycloneDX object\"],\n+        [\n+          \"npm-sbom-json\",\n+          \"carries sboms/onepipeline.cyclonedx.json that is not a CycloneDX object\",\n+        ],\n+        [\n+          \"npm-sbom-link\",\n+          \"carries sboms/onepipeline.cyclonedx.json as something other than a file\",\n+        ],\n+      ].map(([mutation, reason]) => [\n+        mutation,\n+        `npm package onepipeline-cli-${process.platform}-${process.arch} ${reason}`,\n+      ]),\n+      [\"npm-sbom-differs\", \"npm SBOM differs from the wheel's\"],\n       [\n-        \"npm-sbom-object\",\n-        \"carries sboms/onepipeline.cyclonedx.json that is not a CycloneDX object\",\n+        \"wheel-sbom-extra\",\n+        \"wheel must carry exactly one .dist-info/sboms/onepipeline.cyclonedx.json\",\n       ],\n-      [\"npm-sbom\", \"carries sboms/onepipeline.cyclonedx.json that is not a CycloneDX object\"],\n-      [\"npm-sbom-json\", \"carries sboms/onepipeline.cyclonedx.json that is not a CycloneDX object\"],\n-      [\"npm-sbom-link\", \"carries sboms/onepipeline.cyclonedx.json as something other than a file\"],\n-    ].map(([mutation, reason]) => [\n-      mutation,\n-      `npm package onepipeline-cli-${process.platform}-${process.arch} ${reason}`,\n-    ]),\n-    [\"npm-sbom-differs\", \"npm SBOM differs from the wheel's\"],\n-    [\n-      \"wheel-sbom-extra\",\n-      \"wheel must carry exactly one .dist-info/sboms/onepipeline.cyclonedx.json\",\n-    ],\n-    [\"wheel-sbom-name\", \"wheel must carry exactly one .dist-info/sboms/onepipeline.cyclonedx.json\"],\n-    [\"npm-sbom-extra\", \"unexpected npm archive member\"],\n-  ])\n-    it(`rejects real staged artifact corruption: ${mutation}`, () => {\n-      const python = process.platform === \"win32\" ? \"python\" : \"python3\";\n-      const bad = run(python, [\n-        \"npm/test/staged-mutation.py\",\n-        join(dist, `${hostTarget()}.json`),\n-        mutation,\n-        join(work, `mutation-${mutation}`),\n-      ]).trim();\n-      assert.throws(\n-        () =>\n-          run(python, [\"scripts/build-staged-release.py\", \"--verify\", bad], {\n-            stdio: [\"ignore\", \"pipe\", \"pipe\"],\n-          }),\n-        (error) => {\n-          assert.equal(error.status, 1);\n-          assert.ok(error.stderr.includes(reason), error.stderr);\n-          assert.match(error.stderr, /next:.*regenerate/);\n-          return true;\n-        },\n-      );\n-    });\n+      [\n+        \"wheel-sbom-name\",\n+        \"wheel must carry exactly one .dist-info/sboms/onepipeline.cyclonedx.json\",\n+      ],\n+      [\"npm-sbom-extra\", \"unexpected npm archive member\"],\n+    ])\n+      it(`rejects real staged artifact corruption: ${mutation}`, async () => {\n+        const python = process.platform === \"win32\" ? \"python\" : \"python3\";\n+        const bad = (\n+          await runAsync(python, [\n+            \"npm/test/staged-mutation.py\",\n+            join(dist, `${hostTarget()}.json`),\n+            mutation,\n+            join(work, `mutation-${mutation}`),\n+          ])\n+        ).trim();\n+        await assert.rejects(\n+          runAsync(python, [\"scripts/build-staged-release.py\", \"--verify\", bad]),\n+          (error) => {\n+            assert.equal(error.code, 1);\n+            assert.ok(error.stderr.includes(reason), error.stderr);\n+            assert.match(error.stderr, /next:.*regenerate/);\n+            return true;\n+          },\n+        );\n+      });\n+  });\n \n   it(\"packs the binary's SBOM, the wheel's own, as the one file under sboms/\", () => {\n     const record = JSON.parse(readFileSync(join(dist, `${hostTarget()}.json`), \"utf8\"));"},{"sha":"d87cfee82e2a53514c6354785c2f11218879e183","filename":"npm/test/publish-gate.test.mjs","status":"modified","additions":6,"deletions":2,"changes":8,"blob_url":"https://github.com/nickderobertis/onepipeline/blob/c3f74a07da428dcf7094d18c4c6d21d250111bc9/npm%2Ftest%2Fpublish-gate.test.mjs","raw_url":"https://github.com/nickderobertis/onepipeline/raw/c3f74a07da428dcf7094d18c4c6d21d250111bc9/npm%2Ftest%2Fpublish-gate.test.mjs","contents_url":"https://api.github.com/repos/nickderobertis/onepipeline/contents/npm%2Ftest%2Fpublish-gate.test.mjs?ref=c3f74a07da428dcf7094d18c4c6d21d250111bc9","patch":"@@ -31,6 +31,7 @@ import { after, before, describe, it } from \"node:test\";\n import assert from \"node:assert/strict\";\n import { promisify } from \"node:util\";\n import { fileURLToPath } from \"node:url\";\n+import { GATE_DEBUG_BUILD } from \"./install-support.mjs\";\n import { Registry } from \"./registry-support.mjs\";\n import { spawnable } from \"./spawn-support.mjs\";\n \n@@ -159,8 +160,11 @@ describe(\"the npm publish order\", () => {\n       // The real binary the host's package carries. Debug rather than release,\n       // for the reason `launcher.test.mjs` builds debug: this proves the\n       // packaging and the publish order, and a release build would cost the gate\n-      // minutes.\n-      await run(\"cargo\", [\"build\", \"--locked\", \"--quiet\"]);\n+      // minutes. Built as `GATE_DEBUG_BUILD` says, so it is the tree the gate's\n+      // other debug builds already made rather than a second one.\n+      await run(\"cargo\", GATE_DEBUG_BUILD.args, {\n+        env: { ...process.env, ...GATE_DEBUG_BUILD.env },\n+      });\n       work = mkdtempSync(join(tmpdir(), \"onepipeline-publish-\"));\n       hostBinary = await payload(\n         join(\"target\", \"debug\", process.platform === \"win32\" ? \"onepipeline.exe\" : \"onepipeline\"),"},{"sha":"69c1e87c67803fe31a5f71cfad31014cbb524bf0","filename":"npm/test/staged-mutation.py","status":"modified","additions":10,"deletions":4,"changes":14,"blob_url":"https://github.com/nickderobertis/onepipeline/blob/c3f74a07da428dcf7094d18c4c6d21d250111bc9/npm%2Ftest%2Fstaged-mutation.py","raw_url":"https://github.com/nickderobertis/onepipeline/raw/c3f74a07da428dcf7094d18c4c6d21d250111bc9/npm%2Ftest%2Fstaged-mutation.py","contents_url":"https://api.github.com/repos/nickderobertis/onepipeline/contents/npm%2Ftest%2Fstaged-mutation.py?ref=c3f74a07da428dcf7094d18c4c6d21d250111bc9","patch":"@@ -13,6 +13,12 @@\n out = Path(destination)\n out.mkdir(parents=True, exist_ok=True)\n \n+# Every rewritten bundle recompresses the real engine binary, and at the default\n+# levels (gzip 9, deflate 6) that alone took 10-22 s a case. The verifier\n+# inflates what it reads and never sees the level, so the fastest one proves the\n+# same rejection.\n+FAST = 1\n+\n if case.startswith('version-invalid-'):\n     versions = ['01.2.3', '1.2.3-.', '1.2.3+.', '1.2.3-a..b', '1.2.3-01', '1.2.3\\n']\n     record['version'] = versions[int(case.removeprefix('version-invalid-'))]\n@@ -23,14 +29,14 @@\n         for entry in original.infolist():\n             payload = original.read(entry)\n             if entry.filename.endswith('/METADATA'): payload = payload.replace(f'Version: {previous}'.encode(), b'Version: 0.0.0')\n-            entry.filename = entry.filename.replace(previous, '0.0.0'); changed.writestr(entry, payload)\n+            entry.filename = entry.filename.replace(previous, '0.0.0'); changed.writestr(entry, payload, compresslevel=FAST)\n     record['wheel'] = str(wheel)\n     archive = out / f\"onepipeline-v0.0.0-{record['target']}.tar.gz\"\n     shutil.copyfile(record['archive'], archive); record['archive'] = str(archive)\n     import hashlib\n     (out / f\"onepipeline-v0.0.0-{record['target']}.sha256\").write_text(f'{hashlib.sha256(archive.read_bytes()).hexdigest()}  {archive.name}\\n')\n     tgz = out / Path(record['npm']).name\n-    with tarfile.open(record['npm']) as original, tarfile.open(tgz, 'w:gz') as changed:\n+    with tarfile.open(record['npm']) as original, tarfile.open(tgz, 'w:gz', compresslevel=FAST) as changed:\n         for entry in original.getmembers():\n             payload = original.extractfile(entry).read() if entry.isfile() else None\n             if entry.name == 'package/package.json':\n@@ -82,7 +88,7 @@\n                 entry.filename = entry.filename.replace('/onepipeline', '/other-helper')\n             if case == 'wheel-path' and '.data/scripts/' in entry.filename:\n                 entry.filename = entry.filename.replace('/scripts/', '/scripts/nested/')\n-            changed.writestr(entry, payload)\n+            changed.writestr(entry, payload, compresslevel=FAST)\n             if case == 'wheel-traversal' and entry.filename.endswith('.dist-info/WHEEL'):\n                 changed.writestr('../escape', b'outside the install prefix')\n             if case == 'wheel-symlink' and entry.filename.endswith('.dist-info/WHEEL'):\n@@ -110,7 +116,7 @@\n     key = 'npm' if case.startswith('npm-') else 'archive'\n     source = record[key]\n     target = out / Path(source).name\n-    with tarfile.open(source) as original, tarfile.open(target, 'w:gz') as changed:\n+    with tarfile.open(source) as original, tarfile.open(target, 'w:gz', compresslevel=FAST) as changed:\n         for entry in original.getmembers():\n             if case == 'npm-missing' and entry.name == 'package/README.md': continue\n             if case == 'npm-no-sbom' and entry.name.startswith('package/sboms'): continue"},{"sha":"0d38a3c302a395bcf74b16ad232a09c7c1178370","filename":"npm/test/workspace-nx.test.mjs","status":"modified","additions":224,"deletions":0,"changes":224,"blob_url":"https://github.com/nickderobertis/onepipeline/blob/c3f74a07da428dcf7094d18c4c6d21d250111bc9/npm%2Ftest%2Fworkspace-nx.test.mjs","raw_url":"https://github.com/nickderobertis/onepipeline/raw/c3f74a07da428dcf7094d18c4c6d21d250111bc9/npm%2Ftest%2Fworkspace-nx.test.mjs","contents_url":"https://api.github.com/repos/nickderobertis/onepipeline/contents/npm%2Ftest%2Fworkspace-nx.test.mjs?ref=c3f74a07da428dcf7094d18c4c6d21d250111bc9","patch":"@@ -37,6 +37,7 @@ import { tmpdir } from \"node:os\";\n import { basename, dirname, join } from \"node:path\";\n import { afterEach, beforeEach, describe, it } from \"node:test\";\n import { fileURLToPath } from \"node:url\";\n+import { GATE_DEBUG_BUILD } from \"./install-support.mjs\";\n import { spawnable } from \"./spawn-support.mjs\";\n \n const root = join(dirname(fileURLToPath(import.meta.url)), \"..\", \"..\");\n@@ -1018,6 +1019,199 @@ esac\n   });\n });\n \n+describe(\"the stop-verdict tier's builds\", () => {\n+  // The tier times the release binary, so its `test` admits nothing beside it;\n+  // its builds need no such quiet and run ahead of it as `test-build`. Driven\n+  // through the real Nx and the committed project graph in a scratch repository;\n+  // only `just` is a double. Each recipe it stands in for logs when it started\n+  // and ended, the build writes the binary the journeys time, and the journeys\n+  // record the binary they found, as the real producer records the one it timed.\n+  const DOUBLE = `#!/usr/bin/env bash\n+now() { node -e 'process.stdout.write(String(Date.now()))'; }\n+echo \"start $1 $(now)\" >> \"$JUST_CALLS\"\n+case \"$1\" in\n+  _stop-verdict-build)\n+    sleep 2\n+    [ -z \"\\${BREAK_BUILD:-}\" ] || { echo \"build: broken input\" >&2; exit 1; }\n+    mkdir -p target/release && echo \"binary $$ $RANDOM\" > target/release/onepipeline ;;\n+  stop-verdict-journeys)\n+    [ -f target/release/onepipeline ] || { echo \"journeys: no release binary\" >&2; exit 1; }\n+    mkdir -p target/budget-records\n+    cp target/release/onepipeline target/budget-records/stop-guard-unpublished-onepipeline\n+    echo '{}' > target/budget-records/stop-guard-unpublished.json\n+    echo '{}' > target/budget-records/stop-guard-unpublished-invocation.json\n+    sleep 1 ;;\n+  *) sleep 2 ;;\n+esac\n+echo \"end $1 $(now)\" >> \"$JUST_CALLS\"\n+`;\n+\n+  function check(repo, env = {}) {\n+    const calls = join(repo.path, \"just.calls\");\n+    writeFileSync(calls, \"\");\n+    const result = run(\n+      [\"scripts/nx.sh\", \"run\", \"onepipeline-stop-verdict:check\"],\n+      { PATH: `${join(repo.path, \"bin\")}:${process.env.PATH}`, JUST_CALLS: calls, ...env },\n+      repo.path,\n+    );\n+    const spans = {};\n+    for (const line of readFileSync(calls, \"utf8\").split(\"\\n\").filter(Boolean)) {\n+      const [edge, recipe, at] = line.split(\" \");\n+      spans[recipe] = { ...spans[recipe], [edge]: Number(at) };\n+    }\n+    return { result, spans };\n+  }\n+\n+  const overlap = (a, b) => a.start < b.end && b.start < a.end;\n+\n+  function scratch(t) {\n+    const repo = scratchRepository(t);\n+    mkdirSync(join(repo.path, \"bin\"));\n+    writeFileSync(join(repo.path, \"bin\", \"just\"), DOUBLE, { mode: 0o755 });\n+    return repo;\n+  }\n+\n+  it(\"builds beside the rest of the gate, then times what it built alone\", (t) => {\n+    const repo = scratch(t);\n+    const { result, spans } = check(repo);\n+    assert.equal(result.status, 0, result.stderr);\n+    const build = spans[\"_stop-verdict-build\"];\n+    const journeys = spans[\"stop-verdict-journeys\"];\n+    assert.ok(build?.end && journeys?.end, JSON.stringify(spans));\n+    assert.ok(build.end <= journeys.start, \"the journeys started before their build ended\");\n+    const debug = spans[\"_crate-build\"];\n+    assert.ok(\n+      debug?.end,\n+      `the debug test binaries were left to the timed run: ${JSON.stringify(spans)}`,\n+    );\n+    assert.ok(debug.end <= journeys.start, \"the journeys started before the debug build ended\");\n+    const others = Object.entries(spans).filter(\n+      ([recipe]) => ![\"_stop-verdict-build\", \"stop-verdict-journeys\"].includes(recipe),\n+    );\n+    assert.ok(others.length > 0, JSON.stringify(spans));\n+    assert.ok(\n+      others.some(([, span]) => overlap(span, build)),\n+      `the build ran alone rather than beside the tier's lint and format check: ${JSON.stringify(spans)}`,\n+    );\n+    for (const [recipe, span] of others) {\n+      assert.ok(!overlap(span, journeys), `${recipe} ran beside the timed journeys`);\n+    }\n+    assert.equal(\n+      readFileSync(\n+        join(repo.path, \"target\", \"budget-records\", \"stop-guard-unpublished-onepipeline\"),\n+        \"utf8\",\n+      ),\n+      readFileSync(join(repo.path, \"target\", \"release\", \"onepipeline\"), \"utf8\"),\n+      \"the journeys timed a binary other than the one the build made\",\n+    );\n+\n+    // Unchanged, both replay together: a warm cache builds nothing.\n+    const warm = check(repo);\n+    assert.equal(warm.result.status, 0, warm.result.stderr);\n+    assert.deepEqual(Object.keys(warm.spans), [], JSON.stringify(warm.spans));\n+  });\n+\n+  it(\"keys the build on exactly the timed run's inputs, so the two replay or run together\", () => {\n+    // `test`'s inputs are held to the record fingerprint elsewhere; these are\n+    // held to `test`'s, so a cached build can never stand beside a run that\n+    // misses, nor a stale one beside a run that replays.\n+    const tier = project(\"onepipeline-stop-verdict\");\n+    assert.equal(tier.targets[\"test-build\"].cache, true);\n+    assert.deepEqual(tier.targets[\"test-build\"].inputs, tier.targets.test.inputs);\n+  });\n+\n+  it(\"builds only the release tree, leaving the debug tree's lock to the rest of the gate\", () => {\n+    // It starts in the gate's first minute. A debug build there held\n+    // `target/debug`'s lock until the npm publish journey, waiting on it, ran out\n+    // its 900-second setup; the run's debug test binaries are the tree\n+    // `just _crate-build` builds under the same flags.\n+    const dry = spawnSync(\"just\", [\"--dry-run\", \"_stop-verdict-build\"], {\n+      cwd: root,\n+      encoding: \"utf8\",\n+    });\n+    assert.equal(dry.status, 0, dry.stderr);\n+    const builds = dry.stderr.split(\"\\n\").filter((line) => /\\bcargo\\b/.test(line));\n+    assert.ok(builds.length > 0, dry.stderr);\n+    for (const line of builds) assert.match(line, /\\bcargo build --release\\b/, line);\n+  });\n+\n+  it(\"fails the gate, timing nothing, when the build does\", (t) => {\n+    const repo = scratch(t);\n+    const { result, spans } = check(repo, { BREAK_BUILD: \"1\" });\n+    assert.equal(result.status, 1, result.stdout);\n+    assert.match(result.stderr, /build: broken input/);\n+    assert.ok(spans[\"_stop-verdict-build\"]?.start, JSON.stringify(spans));\n+    assert.equal(\n+      spans[\"stop-verdict-journeys\"],\n+      undefined,\n+      \"the journeys ran after a failed build\",\n+    );\n+    assert.equal(\n+      existsSync(join(repo.path, \"target\", \"budget-records\", \"stop-guard-unpublished.json\")),\n+      false,\n+    );\n+  });\n+});\n+\n+describe(\"the npm suite's debug build\", () => {\n+  // The publish journey packs the crate's debug build and workspace-nx drives\n+  // `just _crate-build`; built inside the suite, that held the tree's lock past\n+  // the publish journey's 900-second setup. So `onepipeline:build` runs first, as\n+  // its own task. Asked of the real Nx and the committed graph in a scratch\n+  // repository, where `just` is a double that can refuse the build.\n+  const DOUBLE = `#!/usr/bin/env bash\n+echo \"$1\" >> \"$JUST_CALLS\"\n+[ \"$1\" != _crate-build ] || [ -z \"\\${BREAK_BUILD:-}\" ] || { echo \"build: broken input\" >&2; exit 1; }\n+`;\n+\n+  it(\"builds the crate's debug tree as a task ahead of the suite\", (t) => {\n+    const repo = scratchRepository(t);\n+    const graphPath = join(repo.path, \"task-graph.json\");\n+    const graph = spawnSync(\n+      ...spawnable(\n+        join(repo.path, \"node_modules\", \".bin\", \"nx\"),\n+        [\"run\", \"onepipeline-npm:test\", `--graph=${graphPath}`],\n+        {\n+          cwd: repo.path,\n+          env: { ...process.env, NX_DAEMON: \"false\", NX_CACHE_PROJECT_GRAPH: \"false\" },\n+          encoding: \"utf8\",\n+        },\n+      ),\n+    );\n+    assert.equal(graph.status, 0, `${graph.stdout}\\n${graph.stderr}`);\n+    const { dependencies } = JSON.parse(readFileSync(graphPath, \"utf8\")).tasks;\n+    assert.ok(\n+      dependencies[\"onepipeline-npm:test\"].includes(\"onepipeline:build\"),\n+      JSON.stringify(dependencies[\"onepipeline-npm:test\"]),\n+    );\n+  });\n+\n+  it(\"fails the gate before the suite starts when that build does\", (t) => {\n+    const repo = scratchRepository(t);\n+    mkdirSync(join(repo.path, \"bin\"));\n+    writeFileSync(join(repo.path, \"bin\", \"just\"), DOUBLE, { mode: 0o755 });\n+    const calls = join(repo.path, \"just.calls\");\n+    writeFileSync(calls, \"\");\n+    const result = run(\n+      [\"scripts/nx.sh\", \"run\", \"onepipeline-npm:test\"],\n+      {\n+        PATH: `${join(repo.path, \"bin\")}:${process.env.PATH}`,\n+        JUST_CALLS: calls,\n+        BREAK_BUILD: \"1\",\n+      },\n+      repo.path,\n+    );\n+    assert.equal(result.status, 1, result.stdout);\n+    assert.match(result.stderr, /build: broken input/);\n+    assert.deepEqual(readFileSync(calls, \"utf8\").split(\"\\n\").filter(Boolean), [\"_crate-build\"]);\n+    assert.doesNotMatch(\n+      result.stderr,\n+      /node --test npm\\/test/,\n+      \"the suite ran after a failed build\",\n+    );\n+  });\n+});\n+\n describe(\"the build targets\", () => {\n   it(\"compiles the crate's binary, library, and tests with warnings denied\", () => {\n     // The crate's own build command, run the way its Nx target runs it. A\n@@ -1031,6 +1225,36 @@ describe(\"the build targets\", () => {\n     );\n   });\n \n+  it(\"leaves nothing to compile for the debug build the npm publish journey packs\", () => {\n+    // After the build above, which is the tree every debug build in the gate\n+    // shares. A publish build under other flags would compile a second tree,\n+    // from every dependency up, and say so here as `Compiling`.\n+    const result = spawnSync(\n+      \"cargo\",\n+      [...GATE_DEBUG_BUILD.args.filter((arg) => arg !== \"--quiet\"), \"--verbose\"],\n+      {\n+        cwd: root,\n+        encoding: \"utf8\",\n+        // CI sets `CARGO_TERM_COLOR=always`, which wraps each status word in\n+        // escape codes the line matches below would never see past — the\n+        // `Compiling` check would pass on anything. Colour does not enter\n+        // cargo's fingerprint, so this reads the same tree.\n+        env: {\n+          ...process.env,\n+          ...GATE_DEBUG_BUILD.env,\n+          CARGO_TERM_QUIET: \"false\",\n+          CARGO_TERM_COLOR: \"never\",\n+        },\n+      },\n+    );\n+    assert.equal(result.status, 0, result.stderr);\n+    const compiled = result.stderr\n+      .split(\"\\n\")\n+      .filter((line) => /^\\s+(Compiling|Dirty) /.test(line));\n+    assert.deepEqual(compiled, [], \"the publish build compiled what `_crate-build` had built\");\n+    assert.match(result.stderr, /^\\s+Fresh onepipeline /m);\n+  });\n+\n   it(\"declares the command each project's build target actually runs\", () => {\n     const crate = project(\"onepipeline\");\n     const packaging = project(\"onepipeline-npm\");"},{"sha":"c6ff44e53ebdb796883b31488e49c15a2926d13a","filename":"scripts/host-view-measure.mjs","status":"modified","additions":13,"deletions":1,"changes":14,"blob_url":"https://github.com/nickderobertis/onepipeline/blob/c3f74a07da428dcf7094d18c4c6d21d250111bc9/scripts%2Fhost-view-measure.mjs","raw_url":"https://github.com/nickderobertis/onepipeline/raw/c3f74a07da428dcf7094d18c4c6d21d250111bc9/scripts%2Fhost-view-measure.mjs","contents_url":"https://api.github.com/repos/nickderobertis/onepipeline/contents/scripts%2Fhost-view-measure.mjs?ref=c3f74a07da428dcf7094d18c4c6d21d250111bc9","patch":"@@ -35,6 +35,7 @@ import { tmpdir } from \"node:os\";\n import { dirname, join } from \"node:path\";\n import { fileURLToPath } from \"node:url\";\n import {\n+  cloneFixture,\n   cold,\n   generate,\n   grow,\n@@ -68,6 +69,8 @@ const NEXT =\n   \"pass an installed release build of this tree's onepipeline (`cargo install --path .`), on Linux, with `npm ci` done; a read that answered wrongly is a defect of the view, which `just test-e2e 'test(/^host_view::/)'` reproduces against this tree's own build\";\n const TRACER_NEXT =\n   \"install `strace` on PATH and let this user trace its own children (`kernel.yama.ptrace_scope` 0 or 1), then measure again\";\n+const TEMPLATE_NEXT =\n+  \"unset ONEPIPELINE_TEST_HOST_FIXTURE to generate the fixture afresh, or point it at a template the host-view journeys wrote (a directory holding `manifest.json` and `runs/`), then measure again\";\n /** An error carrying the next step its own failure needs, in place of {@link NEXT}. */\n const failed = (message, next) => Object.assign(new Error(message), { next });\n const recordRefused = (error) =>\n@@ -306,7 +309,16 @@ try {\n     entries: [[sleeper(), sleeper()], [sleeper(), sleeper()], [sleeper()]],\n   };\n   const generating = process.hrtime.bigint();\n-  const manifest = generate(runs, processes);\n+  const template = process.env.ONEPIPELINE_TEST_HOST_FIXTURE;\n+  let manifest;\n+  if (template === undefined) manifest = generate(runs, processes);\n+  else {\n+    try {\n+      manifest = cloneFixture(runs, processes, template);\n+    } catch (error) {\n+      throw failed(`the host fixture template ${template}: ${error.message}`, TEMPLATE_NEXT);\n+    }\n+  }\n   const generatedMs = Number(process.hrtime.bigint() - generating) / 1e6;\n \n   cold(runs, manifest);"},{"sha":"f0bfcfafa71bfaf77045756b57b62c26e93bb3d0","filename":"src/driver.rs","status":"modified","additions":5,"deletions":2,"changes":7,"blob_url":"https://github.com/nickderobertis/onepipeline/blob/c3f74a07da428dcf7094d18c4c6d21d250111bc9/src%2Fdriver.rs","raw_url":"https://github.com/nickderobertis/onepipeline/raw/c3f74a07da428dcf7094d18c4c6d21d250111bc9/src%2Fdriver.rs","contents_url":"https://api.github.com/repos/nickderobertis/onepipeline/contents/src%2Fdriver.rs?ref=c3f74a07da428dcf7094d18c4c6d21d250111bc9","patch":"@@ -3025,8 +3025,11 @@ fn attach(\n     // with. It is released the moment nothing will start another, so the drain\n     // below still ends on the relay closing rather than on its whole grace.\n     let mut relay = Some(tx.clone());\n-    if let Some(run) = watched.as_deref_mut() {\n-        relay_observer(paths, run, tx)?;\n+    match watched.as_deref_mut() {\n+        Some(run) => relay_observer(paths, run, tx)?,\n+        // No observer to hand it to, so it goes now: held here, it would be a\n+        // writing handle the drain waits its whole grace for.\n+        None => drop(tx),\n     }\n     // The run's fold, kept current from what its journal appends, and the byte the\n     // stream has printed up to: each record is read once, as it arrives, and the"},{"sha":"c78f7d85427061c39a4fb70dae4ad98022db6278","filename":"src/engine.rs","status":"modified","additions":11,"deletions":1,"changes":12,"blob_url":"https://github.com/nickderobertis/onepipeline/blob/c3f74a07da428dcf7094d18c4c6d21d250111bc9/src%2Fengine.rs","raw_url":"https://github.com/nickderobertis/onepipeline/raw/c3f74a07da428dcf7094d18c4c6d21d250111bc9/src%2Fengine.rs","contents_url":"https://api.github.com/repos/nickderobertis/onepipeline/contents/src%2Fengine.rs?ref=c3f74a07da428dcf7094d18c4c6d21d250111bc9","patch":"@@ -1598,6 +1598,10 @@ fn converge(\n     let channel = ChannelState::of_run(paths, launch);\n     let rules = executor_rules()?;\n     let (to_loop, rx): (Sender<Message>, Receiver<Message>) = mpsc::channel();\n+    // Sweep reports are control messages, not agent envelopes. Send them\n+    // directly: close-out joins their producer before draining this receiver,\n+    // which must not race a relay that has yet to forward its last reports.\n+    let maintenance_tx = to_loop.clone();\n     // Every dispatch, delivery and probe sends through the relay, which journals a\n     // dispatch's envelopes as they arrive rather than when this loop next waits.\n     // A driver taking the run over has ended every dispatch the one before it\n@@ -2268,7 +2272,7 @@ fn converge(\n             && !readied\n             && in_flight.len() < state.graph.concurrency as usize\n             && crate::maintenance::host_has_room();\n-        maintenance.consider(idle, paths, &tx);\n+        maintenance.consider(idle, paths, &maintenance_tx);\n \n         // Nothing more to do until something happens — unless this pass is what\n         // happened, in which case the next one is due now. The longest this loop\n@@ -3332,9 +3336,15 @@ fn journalling_relay(paths: &RunPaths, to_loop: Sender<Message>) -> Result<Sende\n                     },\n                     other => other,\n                 };\n+                let settlement = matches!(message, Message::Settled(_));\n                 if to_loop.send(message).is_err() {\n                     break;\n                 }\n+                if settlement {\n+                    if let Err(error) = crate::ordering::settlement_relayed() {\n+                        eprintln!(\"{error}\");\n+                    }\n+                }\n             }\n         })\n         .map_err(|e| Error::Invalid(format!(\"cannot start the journal relay: {e}\")))?;"},{"sha":"3966cdaa7d3107e02827b6d7f29b1c94a400a795","filename":"src/ordering.rs","status":"modified","additions":7,"deletions":0,"changes":7,"blob_url":"https://github.com/nickderobertis/onepipeline/blob/c3f74a07da428dcf7094d18c4c6d21d250111bc9/src%2Fordering.rs","raw_url":"https://github.com/nickderobertis/onepipeline/raw/c3f74a07da428dcf7094d18c4c6d21d250111bc9/src%2Fordering.rs","contents_url":"https://api.github.com/repos/nickderobertis/onepipeline/contents/src%2Fordering.rs?ref=c3f74a07da428dcf7094d18c4c6d21d250111bc9","patch":"@@ -97,6 +97,13 @@ pub(crate) fn settlement_before_queue(node: &str) -> Result<()> {\n     Ok(())\n }\n \n+/// Hold the relay after the loop has received a settlement, so a journey can\n+/// let the driver close while the relay cannot forward another message.\n+pub(crate) fn settlement_relayed() -> Result<()> {\n+    meet(\"ONEPIPELINE_TEST_SETTLEMENT_RELAYED_GATE\")?;\n+    Ok(())\n+}\n+\n pub(crate) fn settlement_queued(node: &str) -> Result<()> {\n     if settlement_target(node) {\n         meet(\"ONEPIPELINE_TEST_SETTLEMENT_QUEUED_GATE\")?;"},{"sha":"89fb2bf192105ec9cebc03f7e42fe16ee3e803c8","filename":"src/unwatched.rs","status":"modified","additions":64,"deletions":11,"changes":75,"blob_url":"https://github.com/nickderobertis/onepipeline/blob/c3f74a07da428dcf7094d18c4c6d21d250111bc9/src%2Funwatched.rs","raw_url":"https://github.com/nickderobertis/onepipeline/raw/c3f74a07da428dcf7094d18c4c6d21d250111bc9/src%2Funwatched.rs","contents_url":"https://api.github.com/repos/nickderobertis/onepipeline/contents/src%2Funwatched.rs?ref=c3f74a07da428dcf7094d18c4c6d21d250111bc9","patch":"@@ -746,6 +746,7 @@ fn discover_owned_runs(root: &Path, session: &str) -> Result<Discovered> {\n         }\n     };\n     let mut owned = Discovered::default();\n+    let mut candidates = Vec::new();\n     for entry in entries {\n         // llmlint: ignore-block[changed_behavior_has_e2e] an entry the filesystem lists and\n         // then refuses to describe is a host condition no portable journey can set —\n@@ -783,21 +784,73 @@ fn discover_owned_runs(root: &Path, session: &str) -> Result<Discovered> {\n             continue;\n         }\n         let paths = RunPaths::under(root, &name);\n-        // The launch record and nothing else. Read leniently, exactly as every\n-        // other reader of it: a record this build cannot parse names no session,\n-        // and a run belonging to nobody is passed over.\n-        let Some(launch) = ledger::read_json_opt::<LaunchRecord>(&paths.launch()) else {\n-            continue;\n-        };\n-        if launch.owned_by(session) {\n-            owned\n-                .runs\n-                .push((paths, crate::flow::FlowId::parse(&launch.flow)));\n-        }\n+        candidates.push((candidates.len(), paths));\n     }\n+    let readers = std::thread::available_parallelism()\n+        .map_or(1, std::num::NonZeroUsize::get)\n+        .min(4);\n+    // Discovery reads every launch, even when the session owns only a handful.\n+    // Bound the I/O concurrency to the same small number of cores as a hosted\n+    // runner, while keeping small roots on the calling thread.\n+    let mut runs = if candidates.len() < 32 || readers == 1 {\n+        owned_launches(&candidates, session)\n+    } else {\n+        std::thread::scope(|scope| {\n+            let mut pending = Vec::new();\n+            let mut found = Vec::new();\n+            for chunk in candidates.chunks(candidates.len().div_ceil(readers)) {\n+                match std::thread::Builder::new()\n+                    .name(\"unwatched-discovery\".to_owned())\n+                    .spawn_scoped(scope, || owned_launches(chunk, session))\n+                {\n+                    Ok(reader) => pending.push(reader),\n+                    // A host that cannot start another thread still gets the\n+                    // same complete discovery through the sequential reader.\n+                    Err(_) => found.extend(owned_launches(chunk, session)),\n+                }\n+            }\n+            for reader in pending {\n+                match reader.join() {\n+                    Ok(runs) => found.extend(runs),\n+                    // Preserve a reader's programming failure as the sequential\n+                    // call would; filesystem and decoding failures are Options.\n+                    Err(panic) => std::panic::resume_unwind(panic),\n+                }\n+            }\n+            found\n+        })\n+    };\n+    // Joining chunks and a sequential fallback can complete out of order. Keep\n+    // discovery's original directory order for every downstream decision.\n+    runs.sort_unstable_by_key(|(index, _)| *index);\n+    owned.runs = runs.into_iter().map(|(_, run)| run).collect();\n     Ok(owned)\n }\n \n+/// Which of `candidates` the session owns, each kept with its discovery index.\n+///\n+/// The launch record and nothing else, read whole before deciding ownership by\n+/// both discovery paths. Read leniently, exactly as every other reader of it: a\n+/// record this build cannot parse names no session, and a run belonging to nobody\n+/// is passed over.\n+fn owned_launches(\n+    candidates: &[(usize, RunPaths)],\n+    session: &str,\n+) -> Vec<(usize, (RunPaths, Option<crate::flow::FlowId>))> {\n+    candidates\n+        .iter()\n+        .filter_map(|(index, paths)| {\n+            let launch = ledger::read_json_opt::<LaunchRecord>(&paths.launch())?;\n+            launch.owned_by(session).then(|| {\n+                (\n+                    *index,\n+                    (paths.clone(), crate::flow::FlowId::parse(&launch.flow)),\n+                )\n+            })\n+        })\n+        .collect()\n+}\n+\n /// What discovery found: the runs the session owns, and what it could not resolve.\n ///\n /// The second half is why this is a value rather than a list. Discovery is a walk"},{"sha":"97a07d74c1c1bddbe0111a3f0c8344a55cb46473","filename":"tests/e2e/channel.rs","status":"modified","additions":18,"deletions":2,"changes":20,"blob_url":"https://github.com/nickderobertis/onepipeline/blob/c3f74a07da428dcf7094d18c4c6d21d250111bc9/tests%2Fe2e%2Fchannel.rs","raw_url":"https://github.com/nickderobertis/onepipeline/raw/c3f74a07da428dcf7094d18c4c6d21d250111bc9/tests%2Fe2e%2Fchannel.rs","contents_url":"https://api.github.com/repos/nickderobertis/onepipeline/contents/tests%2Fe2e%2Fchannel.rs?ref=c3f74a07da428dcf7094d18c4c6d21d250111bc9","patch":"@@ -2749,11 +2749,11 @@ fn a_listener_of_another_asker_leaves_an_ended_askers_question_alone() {\n     world.script(\"build.wait\", \"hold\");\n     let run = running(&world, \"otherasker\", vec![agent(\"build\", &[])]);\n \n-    let serving = |asker: &str, frame: &str| {\n+    let serving = |asker: &str, frame: &str, timeout: &str| {\n         let mut serving = world\n             .host_channel(&run)\n             .env(onepipeline::channel::ASKER_ENV, asker)\n-            .env(\"ONEPIPELINE_REPLY_TIMEOUT_SECONDS\", \"1\")\n+            .env(\"ONEPIPELINE_REPLY_TIMEOUT_SECONDS\", timeout)\n             .stdin(std::process::Stdio::piped())\n             .stdout(std::process::Stdio::piped())\n             .stderr(std::process::Stdio::piped())\n@@ -2771,6 +2771,7 @@ fn a_listener_of_another_asker_leaves_an_ended_askers_question_alone() {\n     let asked = serving(\n         \"the-asker-that-ended\",\n         r#\"{\"kind\":\"blocker\",\"message\":\"who owns this decision?\",\"node\":\"build\"}\"#,\n+        \"1\",\n     );\n     world.until(\"the question to reach the planner\", |world| {\n         !world.queued_surfaces(&run).is_empty()\n@@ -2798,6 +2799,7 @@ fn a_listener_of_another_asker_leaves_an_ended_askers_question_alone() {\n     let stranger = serving(\n         \"some-other-dispatch\",\n         r#\"{\"kind\":\"monitor\",\"message\":\"unrelated work is green\",\"blocking\":false}\"#,\n+        \"1\",\n     );\n     world.until(\"the stranger's report to reach the planner\", |world| {\n         world.queued_surfaces(&run).len() == 2\n@@ -2818,6 +2820,7 @@ fn a_listener_of_another_asker_leaves_an_ended_askers_question_alone() {\n     let pressing = serving(\n         \"some-other-dispatch\",\n         r#\"{\"kind\":\"blocker\",\"message\":\"whose call is the base?\",\"node\":\"build\"}\"#,\n+        \"120\",\n     );\n     world.until(\"the stranger's question to reach the planner\", |world| {\n         world.queued_surfaces(&run).len() == 3\n@@ -2846,6 +2849,19 @@ fn a_listener_of_another_asker_leaves_an_ended_askers_question_alone() {\n         \"who owns this decision?\"\n     );\n     assert_eq!(displaced.json()[\"surface\"][\"abandoned\"], json!(true));\n+    // Its live state is what the assertions need, not a one-second window in\n+    // which the host must execute them. End it with the ruling it waited for.\n+    world\n+        .run_with_stdin(\n+            &[\"reply\", &run],\n+            &json!({\n+                \"completion\": false, \"reason\": \"the scoped channel assertions are complete\",\n+                \"version\": 2, \"commands\": []\n+            })\n+            .to_string(),\n+        )\n+        .exited(0)\n+        .out_has(\"\\\"delivered\\\"\");\n     ended(pressing);\n     world.release(\"build.go\");\n }"},{"sha":"0d814f16157ec8be9078086e1d3d9a9e08dd7920","filename":"tests/e2e/driver_exit.rs","status":"modified","additions":41,"deletions":0,"changes":41,"blob_url":"https://github.com/nickderobertis/onepipeline/blob/c3f74a07da428dcf7094d18c4c6d21d250111bc9/tests%2Fe2e%2Fdriver_exit.rs","raw_url":"https://github.com/nickderobertis/onepipeline/raw/c3f74a07da428dcf7094d18c4c6d21d250111bc9/tests%2Fe2e%2Fdriver_exit.rs","contents_url":"https://api.github.com/repos/nickderobertis/onepipeline/contents/tests%2Fe2e%2Fdriver_exit.rs?ref=c3f74a07da428dcf7094d18c4c6d21d250111bc9","patch":"@@ -250,6 +250,47 @@ fn a_driver_that_completes_its_run_records_its_exit_before_the_run_is_free() {\n     assert_eq!(world.run_json(run, \"result.json\")[\"state\"], \"complete\");\n }\n \n+/// **An attached launch with no observer leaves once its driver has.** Nothing\n+/// relays an observer's last envelopes, so the launch has nothing to drain once its\n+/// loop has finished: it prints its settlement and exits without waiting out the two\n+/// seconds it gives an observer's stream to close.\n+#[test]\n+fn an_attached_launch_with_no_observer_exits_once_its_driver_has_exited() {\n+    let world = World::new(\"exit-no-observer\");\n+    let run = \"unobserved\";\n+    let path = world.plan(run, &plan_of(run, vec![agent(\"build\", &[])]));\n+    let launched = world\n+        .cmd(&[\"start\", &path, \"--attach\"])\n+        .current_dir(&world.project)\n+        .output()\n+        .expect(\"the binary runs\");\n+    let left = crate::harness::now_millis();\n+    assert_eq!(\n+        launched.status.code(),\n+        Some(0),\n+        \"{}\",\n+        String::from_utf8_lossy(&launched.stderr)\n+    );\n+    assert!(String::from_utf8_lossy(&launched.stdout).contains(\"\\\"settlement\\\":\\\"complete\\\"\"));\n+    let launch = world.run_json(run, \"launch.json\");\n+    assert!(\n+        launch[\"graph\"].as_str().unwrap_or_default().is_empty(),\n+        \"the launch named an observer graph: {launch}\"\n+    );\n+\n+    let exited = crate::harness::epoch_millis(\n+        the_exit(&world, run)[\"ts\"]\n+            .as_str()\n+            .expect(\"the record is stamped\"),\n+    );\n+    let after = left.saturating_sub(exited);\n+    assert!(\n+        after < 2_000,\n+        \"the launch exited {after} ms after its driver recorded its exit — it waited out \\\n+         the drain an observer's stream is given, with no observer to drain\"\n+    );\n+}\n+\n /// **A run paused on a person.** The record says `awaiting-planner` — the word\n /// the attached launch printed — answers no command, and comes before the hook\n /// the pause withheld."},{"sha":"fc68439923ab054acfa6e048b84aba040e5ba0b0","filename":"tests/e2e/harness.rs","status":"modified","additions":495,"deletions":82,"changes":577,"blob_url":"https://github.com/nickderobertis/onepipeline/blob/c3f74a07da428dcf7094d18c4c6d21d250111bc9/tests%2Fe2e%2Fharness.rs","raw_url":"https://github.com/nickderobertis/onepipeline/raw/c3f74a07da428dcf7094d18c4c6d21d250111bc9/tests%2Fe2e%2Fharness.rs","contents_url":"https://api.github.com/repos/nickderobertis/onepipeline/contents/tests%2Fe2e%2Fharness.rs?ref=c3f74a07da428dcf7094d18c4c6d21d250111bc9","patch":"@@ -973,6 +973,10 @@ impl World {\n     /// reads as one statement of what this world is.\n     #[must_use]\n     pub fn with_env(mut self, key: &str, value: &str) -> Self {\n+        assert!(\n+            !key.is_empty() && !key.contains(['=', '\\0']) && !value.contains('\\0'),\n+            \"a fixture environment assignment must be valid for a child process\"\n+        );\n         self.environment.push((key.to_owned(), value.to_owned()));\n         self\n     }\n@@ -1721,21 +1725,7 @@ impl World {\n         for dir in [&origin, &home] {\n             profile::fs::create_dir_all(dir).expect(\"a scratch directory\");\n         }\n-        git(self, &origin, &[\"init\", \"--bare\", \"--initial-branch=main\"]);\n-        git(\n-            self,\n-            &self.root,\n-            &[\"clone\", &origin.to_string_lossy(), \"service\"],\n-        );\n-        profile::fs::write(checkout.join(\"README.md\"), \"the repository under test\\n\")\n-            .expect(\"the seed file is written\");\n-        git(self, &checkout, &[\"add\", \"-A\"]);\n-        git(\n-            self,\n-            &checkout,\n-            &[\"commit\", \"-m\", \"chore: seed the repository\"],\n-        );\n-        git(self, &checkout, &[\"push\", \"-u\", \"origin\", \"main\"]);\n+        seed_repository(self, &origin, &checkout, \"the repository under test\\n\");\n \n         // Version 4: no `gate:` in it at all — what verifies a change is the\n         // repository's own merge path, so the rules file says how the change is\n@@ -1787,25 +1777,12 @@ impl World {\n         let _fixture = profile::span(profile::Category::Fixture);\n         let origin = self.root.join(format!(\"{alias}.git\"));\n         let checkout = self.root.join(alias);\n-        profile::fs::create_dir_all(&origin).expect(\"a scratch directory\");\n-        git(self, &origin, &[\"init\", \"--bare\", \"--initial-branch=main\"]);\n-        git(\n-            self,\n-            &self.root,\n-            &[\"clone\", &origin.to_string_lossy(), alias],\n-        );\n-        profile::fs::write(\n-            checkout.join(\"README.md\"),\n-            format!(\"the {alias} repository\\n\"),\n-        )\n-        .expect(\"the seed file is written\");\n-        git(self, &checkout, &[\"add\", \"-A\"]);\n-        git(\n+        seed_repository(\n             self,\n+            &origin,\n             &checkout,\n-            &[\"commit\", \"-m\", \"chore: seed the repository\"],\n+            &format!(\"the {alias} repository\\n\"),\n         );\n-        git(self, &checkout, &[\"push\", \"-u\", \"origin\", \"main\"]);\n         self.register(\n             &checkout,\n             Some(&format!(\"https://github.com/owner/{alias}.git\")),\n@@ -1958,7 +1935,6 @@ impl World {\n     /// launch then met as `\"engine\" is not a registered repository`, naming the\n     /// repository whichever thread had lost the race.\n     fn pointed_at_this_world(&self) -> std::sync::MutexGuard<'static, ()> {\n-        static POINTING: std::sync::Mutex<()> = std::sync::Mutex::new(());\n         let held = POINTING.lock().unwrap_or_else(|held| held.into_inner());\n         std::env::set_var(\"ONEVCS_HOME\", self.onevcs_home());\n         std::env::set_var(\"GIT_CONFIG_GLOBAL\", self.gitconfig());\n@@ -4647,6 +4623,49 @@ fn a_move_nothing_ever_lets_go_of_fails_under_the_caller_s_own_words() {\n /// [`as_session`](World::as_session) makes a real case.\n static LIVE: std::sync::atomic::AtomicUsize = std::sync::atomic::AtomicUsize::new(0);\n \n+// The same environment lock covers repository registration and native cleanup.\n+static POINTING: std::sync::Mutex<()> = std::sync::Mutex::new(());\n+\n+/// Apply a world's command environment to one synchronous library call, then\n+/// restore every value, including removed variables, even while unwinding.\n+struct WorldEnvironment {\n+    _held: std::sync::MutexGuard<'static, ()>,\n+    saved: Vec<(std::ffi::OsString, Option<std::ffi::OsString>)>,\n+}\n+\n+impl WorldEnvironment {\n+    fn enter(command: &Command) -> Self {\n+        let held = POINTING.lock().unwrap_or_else(|held| held.into_inner());\n+        let changes: Vec<_> = command\n+            .get_envs()\n+            .map(|(key, value)| (key.to_owned(), value.map(std::ffi::OsStr::to_owned)))\n+            .collect();\n+        let saved = changes\n+            .iter()\n+            .map(|(key, _)| (key.clone(), std::env::var_os(key)))\n+            .collect();\n+        let environment = Self { _held: held, saved };\n+        for (key, value) in changes {\n+            match value {\n+                Some(value) => std::env::set_var(key, value),\n+                None => std::env::remove_var(key),\n+            }\n+        }\n+        environment\n+    }\n+}\n+\n+impl Drop for WorldEnvironment {\n+    fn drop(&mut self) {\n+        for (key, value) in &self.saved {\n+            match value {\n+                Some(value) => std::env::set_var(key, value),\n+                None => std::env::remove_var(key),\n+            }\n+        }\n+    }\n+}\n+\n impl World {\n     /// Stop the runs this world started that can be stopped, before it goes.\n     ///\n@@ -4658,11 +4677,10 @@ impl World {\n     /// the pipe `cargo nextest` reads this test's output from: the test exits,\n     /// the pipe never reaches EOF, and the test is reported `LEAK`.\n     ///\n-    /// Through the binary's own `stop`, which on either platform walks the run's\n-    /// descendants and waits until they are gone, rather than a second teardown\n-    /// here that would walk the tree differently. `--force` because a world seen\n-    /// through [`as_session`](World::as_session) is ending a run another\n-    /// session's label owns.\n+    /// Through the approved `verbs::stop` API, whose body the CLI calls too.\n+    /// Cleanup has no stdout or exit-code assertion; explicit stop journeys\n+    /// still drive the compiled binary. `force` stops a run another session's\n+    /// label owns, as a world seen through [`as_session`](World::as_session) may.\n     ///\n     /// What it cannot stop it leaves, which is why it promises only the runs it\n     /// can: `stop` refuses a run whose dispatch registry it cannot read, and\n@@ -4672,18 +4690,25 @@ impl World {\n         let Ok(entries) = profile::fs::read_dir(&self.runs) else {\n             return;\n         };\n-        for entry in entries.flatten() {\n-            // A directory with no launch record is not a run anything is\n-            // driving — a plan that was refused before it started, or a run\n-            // whose record a journey removed to see what the views make of it.\n-            if !entry.path().join(\"launch.json\").is_file() {\n-                continue;\n-            }\n-            let run = entry.file_name();\n-            let Some(run) = run.to_str() else {\n-                continue;\n-            };\n-            let _ = self.cmd(&[\"stop\", run, \"--force\"]).output();\n+        let runs: Vec<_> = entries\n+            .flatten()\n+            .filter(|entry| entry.path().join(\"launch.json\").is_file())\n+            .filter_map(|entry| entry.file_name().into_string().ok())\n+            .collect();\n+        if runs.is_empty() {\n+            return;\n+        }\n+        let command = self.cmd(&[]);\n+        let _environment = WorldEnvironment::enter(&command);\n+        for run in runs {\n+            let paths = onepipeline::views::RunPaths::under(&self.runs, &run);\n+            let _ = onepipeline::verbs::stop(\n+                &paths,\n+                onepipeline::verbs::StopRequest {\n+                    session: &self.session,\n+                    force: true,\n+                },\n+            );\n         }\n     }\n }\n@@ -4768,6 +4793,167 @@ fn a_worlds_teardown_ends_a_run_that_is_still_working() {\n     );\n } // llmlint: ignore-end[tests_mirror_real_usage]\n \n+/// Keep another world alive so containment cannot hide a missed stop. Both\n+/// drivers must be gone after Drop, before the final world reaps descendants.\n+#[test]\n+fn teardown_stops_every_driver_without_spawning_the_cli() {\n+    let world = World::new(\"teardown-library\");\n+    let mut drivers = Vec::new();\n+    for run in [\"first\", \"second\"] {\n+        let node = format!(\"{run}-work\");\n+        world.script(&format!(\"{node}.wait\"), \"hold\");\n+        let project = world.plan(run, &plan_of(run, vec![agent(&node, &[])]));\n+        world.run(&[\"start\", &project, \"--detach\"]).exited(0);\n+        world.until(\"the driver to dispatch its held worker\", |world| {\n+            !world.events_of(run, \"node-dispatched\").is_empty()\n+        });\n+        let pid =\n+            u32::try_from(world.run_json(run, \"launch.json\")[\"pid\"].as_u64().unwrap()).unwrap();\n+        assert!(\n+            !process_ended(pid),\n+            \"the driver must be alive before cleanup\"\n+        );\n+        drivers.push(pid);\n+    }\n+    let holder = world.as_session(\"keep-containment-owned\");\n+    let environment = std::env::vars_os().collect::<std::collections::BTreeMap<_, _>>();\n+    let starts = || {\n+        profile::snapshot()\n+            .programs\n+            .get(\"onepipeline\")\n+            .map_or(0, |entry| entry.0)\n+    };\n+    let before = starts();\n+    let began = std::time::Instant::now();\n+    drop(world);\n+    println!(\n+        \"teardown of two live runs: {:.6}s; CLI starts: {}\",\n+        began.elapsed().as_secs_f64(),\n+        starts() - before\n+    );\n+    for pid in drivers {\n+        assert!(\n+            process_ended(pid),\n+            \"cleanup left driver {pid} alive before containment\"\n+        );\n+    }\n+    assert_eq!(\n+        starts(),\n+        before,\n+        \"fixture cleanup does not need another CLI process\"\n+    );\n+    assert!(\n+        std::env::vars_os().collect::<std::collections::BTreeMap<_, _>>() == environment,\n+        \"cleanup restores the caller's environment\"\n+    );\n+    drop(holder);\n+}\n+\n+/// Reject invalid child settings before they enter a world. Unwinding that\n+/// constructor still stops its live driver and restores the caller's environment.\n+#[test]\n+fn teardown_with_invalid_child_settings_restores_the_environment() {\n+    let world = World::new(\"teardown-invalid-environment\");\n+    world.script(\"work.wait\", \"hold\");\n+    let project = world.plan(\"invalid\", &plan_of(\"invalid\", vec![agent(\"work\", &[])]));\n+    world.run(&[\"start\", &project, \"--detach\"]).exited(0);\n+    world.until(\"the run to dispatch\", |world| {\n+        !world.events_of(\"invalid\", \"node-dispatched\").is_empty()\n+    });\n+    let pid = u32::try_from(\n+        world.run_json(\"invalid\", \"launch.json\")[\"pid\"]\n+            .as_u64()\n+            .unwrap(),\n+    )\n+    .unwrap();\n+    let holder = world.as_session(\"keep-the-cleanup-owner\");\n+    let before = std::env::vars_os().collect::<std::collections::BTreeMap<_, _>>();\n+    let refused = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| {\n+        world.with_env(\"ONEPIPELINE_TEST_INVALID_ENV\", \"bad\\0value\")\n+    }));\n+    if let Ok(mut world) = refused {\n+        // A broken validator must fail this test without leaking its driver.\n+        world\n+            .environment\n+            .retain(|(key, _)| key != \"ONEPIPELINE_TEST_INVALID_ENV\");\n+        drop(world);\n+        panic!(\"an invalid child setting must be rejected\");\n+    }\n+    assert!(\n+        std::env::vars_os().collect::<std::collections::BTreeMap<_, _>>() == before,\n+        \"the caller's environment was not restored\"\n+    );\n+    assert!(\n+        process_ended(pid),\n+        \"invalid configuration left driver {pid} alive before containment\"\n+    );\n+    drop(holder);\n+}\n+\n+/// A native caller inherits the world's removals as well as its assignments;\n+/// unwinding after the real stop restores both for the next caller.\n+#[test]\n+fn a_native_stop_restores_removed_settings_when_its_caller_unwinds() {\n+    let world = World::new(\"teardown-unwind\");\n+    world.script(\"work.wait\", \"hold\");\n+    let project = world.plan(\"unwind\", &plan_of(\"unwind\", vec![agent(\"work\", &[])]));\n+    world.run(&[\"start\", &project, \"--detach\"]).exited(0);\n+    world.until(\"the driver to dispatch\", |world| {\n+        !world.events_of(\"unwind\", \"node-dispatched\").is_empty()\n+    });\n+    let pid = u32::try_from(\n+        world.run_json(\"unwind\", \"launch.json\")[\"pid\"]\n+            .as_u64()\n+            .unwrap(),\n+    )\n+    .unwrap();\n+    let holder = world.as_session(\"keep-the-unwind-owner\");\n+    let key = onepipeline::cli::FLOW_ENV;\n+    let previous = std::env::var_os(key);\n+    std::env::set_var(key, \"the parent owns this setting\");\n+    let before = std::env::vars_os().collect::<std::collections::BTreeMap<_, _>>();\n+    let command = world.cmd(&[]);\n+    let unwound = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| {\n+        let _environment = WorldEnvironment::enter(&command);\n+        let probe = Command::new(\"node\")\n+            .args([\"-e\", \"process.stdout.write(JSON.stringify({flow:process.env.ONEPIPELINE_FLOW??null,runs:process.env.ONEPIPELINE_RUNS_DIR}))\"])\n+            .output().expect(\"a real child inherits the native caller's environment\");\n+        assert!(probe.status.success());\n+        assert_eq!(\n+            serde_json::from_slice::<serde_json::Value>(&probe.stdout).unwrap(),\n+            serde_json::json!({\"flow\": null, \"runs\": world.runs})\n+        );\n+        onepipeline::verbs::stop(\n+            &onepipeline::views::RunPaths::under(&world.runs, \"unwind\"),\n+            onepipeline::verbs::StopRequest {\n+                session: &world.session,\n+                force: true,\n+            },\n+        )\n+        .expect(\"the public API stops the real run\");\n+        panic!(\"the native caller unwinds after stopping its run\");\n+    }));\n+    let panic = unwound.expect_err(\"the native caller deliberately unwinds\");\n+    assert_eq!(\n+        panic.downcast_ref::<&str>(),\n+        Some(&\"the native caller unwinds after stopping its run\")\n+    );\n+    assert!(\n+        std::env::vars_os().collect::<std::collections::BTreeMap<_, _>>() == before,\n+        \"the caller's environment was not restored\"\n+    );\n+    assert!(\n+        process_ended(pid),\n+        \"the native stop left its driver alive before containment\"\n+    );\n+    match previous {\n+        Some(value) => std::env::set_var(key, value),\n+        None => std::env::remove_var(key),\n+    }\n+    drop(world);\n+    drop(holder);\n+}\n+\n /// A dump carries what the run directory holds, including a file nothing in\n /// this suite names.\n ///\n@@ -5463,6 +5649,123 @@ impl Repository {\n     }\n }\n \n+/// Seed the bare origin in one plumbing transaction before cloning it. Clone\n+/// then establishes the worktree, remote tracking ref and upstream together;\n+/// there is no empty checkout to add, commit and push separately.\n+fn seed_repository(world: &World, origin: &Path, checkout: &Path, readme: &str) {\n+    profile::fs::create_dir_all(origin).expect(\"a scratch origin\");\n+    git(world, origin, &[\"init\", \"--bare\", \"--initial-branch=main\"]);\n+    let message = \"chore: seed the repository\";\n+    let timestamp = std::time::SystemTime::now()\n+        .duration_since(std::time::UNIX_EPOCH)\n+        .expect(\"the clock is after the epoch\")\n+        .as_secs();\n+    let stream = format!(\n+        \"blob\\nmark :1\\ndata {}\\n{readme}\\ncommit refs/heads/main\\n\\\n+         committer {GIT_WHO} <{GIT_EMAIL}> {timestamp} +0000\\ndata {}\\n{message}\\n\\\n+         M 100644 :1 README.md\\n\\ndone\\n\",\n+        readme.len(),\n+        message.len(),\n+    );\n+    let mut import = Command::new(\"git\")\n+        .args([\"fast-import\", \"--quiet\", \"--done\"])\n+        .current_dir(origin)\n+        .env(\"GIT_CONFIG_GLOBAL\", world.gitconfig())\n+        .stdin(Stdio::piped())\n+        .stdout(Stdio::piped())\n+        .stderr(Stdio::piped())\n+        .spawn()\n+        .expect(\"git imports the seed commit\");\n+    std::io::Write::write_all(\n+        &mut import.stdin.take().expect(\"the import stream\"),\n+        stream.as_bytes(),\n+    )\n+    .expect(\"the seed stream is written\");\n+    let imported = import.wait_with_output().expect(\"git finishes importing\");\n+    assert!(\n+        imported.status.success(),\n+        \"{}\",\n+        String::from_utf8_lossy(&imported.stderr)\n+    );\n+    git(\n+        world,\n+        &world.root,\n+        &[\n+            \"clone\",\n+            &origin.to_string_lossy(),\n+            &checkout.to_string_lossy(),\n+        ],\n+    );\n+}\n+\n+#[test]\n+fn seeded_repositories_track_their_own_origin_and_keep_hooks() {\n+    let world = World::new(\"seed-repositories\");\n+    let starts = || {\n+        profile::snapshot()\n+            .programs\n+            .get(\"git\")\n+            .map_or(0, |entry| entry.0)\n+    };\n+    let before = starts();\n+    let first = world.repository(\"local-direct\", &[\"exit 1\"]);\n+    let second = world.extra_repository(\"dependency\");\n+    assert_eq!(\n+        starts() - before,\n+        9,\n+        \"two seeds use three git starts each, plus a hook configuration and two remote lookups\"\n+    );\n+    for (repository, readme) in [\n+        (&first, \"the repository under test\\n\"),\n+        (&second, \"the dependency repository\\n\"),\n+    ] {\n+        assert_eq!(\n+            git(&world, &repository.checkout, &[\"show\", \"HEAD:README.md\"]),\n+            readme\n+        );\n+        assert_eq!(\n+            git(&world, &repository.checkout, &[\"log\", \"-1\", \"--format=%s\"]).trim(),\n+            \"chore: seed the repository\"\n+        );\n+        assert_eq!(\n+            git(&world, &repository.checkout, &[\"status\", \"--porcelain\"]),\n+            \"\"\n+        );\n+        assert_eq!(\n+            git(&world, &repository.checkout, &[\"rev-parse\", \"HEAD\"]),\n+            git(&world, &repository.origin, &[\"rev-parse\", \"main\"])\n+        );\n+        assert_eq!(\n+            git(\n+                &world,\n+                &repository.checkout,\n+                &[\"rev-parse\", \"--abbrev-ref\", \"@{upstream}\"]\n+            )\n+            .trim(),\n+            \"origin/main\"\n+        );\n+    }\n+    git(\n+        &world,\n+        &first.checkout,\n+        &[\"commit\", \"--allow-empty\", \"-m\", \"fix: exercise the hook\"],\n+    );\n+    let pushed = Command::new(\"git\")\n+        .arg(\"push\")\n+        .current_dir(&first.checkout)\n+        .env(\"GIT_CONFIG_GLOBAL\", world.gitconfig())\n+        .output()\n+        .unwrap();\n+    assert!(\n+        !pushed.status.success(),\n+        \"the installed pre-push hook must still refuse\"\n+    );\n+    assert_ne!(\n+        git(&world, &first.checkout, &[\"rev-parse\", \"HEAD\"]),\n+        git(&world, &first.origin, &[\"rev-parse\", \"main\"])\n+    );\n+}\n+\n /// Run git in a repository, refusing to continue on anything it rejects.\n ///\n /// Through the world's own git config, like every git `onevcs` runs from here:\n@@ -5634,26 +5937,11 @@ pub fn rows(stdout: &str) -> Vec<&str> {\n \n /// One of the sibling doubles, pinned to a name only this process holds.\n ///\n-/// The doubles live in a separate workspace member so they can never ship, and a\n-/// package-scoped build — `cargo llvm-cov` runs one — does not build another\n-/// member's binaries. So the fixture builds itself.\n-///\n-/// Cargo is the freshness check, not the file's existence: a double whose source\n-/// changed has to be rebuilt, and a harness that stopped at \"the binary is\n-/// there\" would silently run last week's fixture against this week's test. The\n-/// build happens once per process; `.config/nextest.toml` bounds how many run at\n-/// a time, and cargo's own lock serialises those.\n-///\n-/// The path handed back is **never** the one cargo publishes. Every test runs in\n-/// its own process and each builds the doubles, so several cargo invocations\n-/// uplift the same `target/debug/<name>` — and an uplift is a remove followed by\n-/// a replacement, so that name is briefly absent. A test that had already looked\n-/// would then spawn a binary that vanished under it: on macOS that surfaced both\n-/// as a missing double and, worse, as a whole run stuck at `run-started` because\n-/// the launcher could not start its driver. Giving each process its own name for\n-/// the binary closes the window, because a later uplift replaces the *name* it\n-/// published and never touches this one. See [`held_alias`] for why that name is\n-/// a link rather than a copy wherever the filesystem allows one.\n+/// The doubles live in a separate workspace member so they can never ship. The\n+/// first test needing a package builds it; the rest of that nextest run reuse\n+/// that freshness check. Direct test-binary runs still ask cargo each time.\n+/// Each process holds its own alias, so another build's uplift cannot remove a\n+/// binary from underneath a running journey (see [`held_alias`]).\n pub fn double(name: &str) -> PathBuf {\n     static BUILT: std::sync::OnceLock<PathBuf> = std::sync::OnceLock::new();\n     let held = BUILT.get_or_init(|| build(&[\"--package\", \"onepipeline-testfakes\"]));\n@@ -6385,17 +6673,145 @@ fn held_dir() -> PathBuf {\n /// Build one package's binaries into the target directory this test's own binary\n /// came out of, and return the per-process directory they are held in.\n ///\n-/// The one wait in this harness that is deliberately left unbounded. Every test\n-/// process needing a double runs this, so several of them queue on cargo's lock\n-/// over the shared target directory and cargo says so — `Blocking waiting for\n-/// file lock on build directory` — and then waits as long as it takes. A\n-/// deadline here would end whichever process drew the short straw, on a host\n-/// that was working the whole time, and it would do it more often the more\n-/// parallel the runner is. What bounds it instead is the runner: `slow-timeout`\n-/// in `.config/nextest.toml` names the test that is waiting and then ends it, so\n-/// a lock nothing is going to release reads as one named test rather than as a\n-/// suite that stopped.\n+/// Cargo and the per-run file lock may wait for another builder. The runner's\n+/// slow-timeout bounds that wait, as it bounds the subprocess journeys.\n fn build(selection: &[&str]) -> PathBuf {\n+    if let Ok(run) = std::env::var(\"NEXTEST_RUN_ID\") {\n+        assert!(\n+            !run.is_empty()\n+                && run\n+                    .bytes()\n+                    .all(|byte| byte.is_ascii_hexdigit() || byte == b'-'),\n+            \"nextest's run id must be a safe path component\"\n+        );\n+        let key = selection.join(\"_\").replace('-', \"\");\n+        let cache = binary()\n+            .parent()\n+            .expect(\"the binary's directory\")\n+            .join(\"double-builds\")\n+            .join(run)\n+            .join(key);\n+        build_once(&cache, || build_package(selection));\n+    } else {\n+        build_package(selection);\n+    }\n+    let held = held_dir();\n+    profile::fs::create_dir_all(&held).expect(\"a directory for this process's doubles\");\n+    held\n+}\n+\n+/// A failed or interrupted builder leaves no success marker; dropping its OS\n+/// lock lets the next process retry. Only small markers are shared, never a\n+/// mutable executable or a process's aliases.\n+pub(crate) fn build_once(cache: &Path, build: impl FnOnce()) {\n+    let ready = cache.join(\"ready\");\n+    if ready.is_file() {\n+        return;\n+    }\n+    profile::fs::create_dir_all(cache).expect(\"a directory for the run's build marker\");\n+    let lock = profile::fs::OpenOptions::new()\n+        .create(true)\n+        .truncate(false)\n+        .write(true)\n+        .open(cache.join(\"lock\"))\n+        .expect(\"a build lock\");\n+    {\n+        let _wait = profile::span(profile::Category::Wait);\n+        fs4::fs_std::FileExt::lock_exclusive(&lock).expect(\"the run's build lock\");\n+    }\n+    if !ready.is_file() {\n+        build();\n+        profile::fs::write(ready, b\"\").expect(\"the completed build marker\");\n+    }\n+}\n+\n+/// Ask for real doubles from independent test processes. A recording forwarder\n+/// observes Cargo starts; a missing compiler exercises Cargo's actual refusal.\n+#[test]\n+fn concurrent_builders_share_success_and_retry_failure() {\n+    const CHILD: &str = \"ONEPIPELINE_BUILD_CACHE_CHILD\";\n+    if let Some(scripts) = std::env::var_os(CHILD) {\n+        let _world = World::new(\"build-cache-child\");\n+        let output = Command::new(double(\"reviewer-bar\"))\n+            .env(SCRIPT_DIR_ENV, scripts)\n+            .output()\n+            .expect(\"the built double runs\");\n+        assert!(output.status.success(), \"{output:?}\");\n+        assert_eq!(output.stdout, b\"fixture built\\n\");\n+        return;\n+    }\n+    let world = World::new(\"build-cache\");\n+    world.script(\"reviewer-bar.fingerprint\", \"fixture built\");\n+    let recorder = double(\"cargo-record\");\n+    let log = world.root.join(\"cargo-starts\");\n+    let stamp = std::time::SystemTime::now()\n+        .duration_since(std::time::UNIX_EPOCH)\n+        .unwrap()\n+        .as_nanos();\n+    let run = |nth: u32| {\n+        let hex = format!(\"{:032x}\", stamp + u128::from(nth));\n+        format!(\n+            \"{}-{}-{}-{}-{}\",\n+            &hex[..8],\n+            &hex[8..12],\n+            &hex[12..16],\n+            &hex[16..20],\n+            &hex[20..]\n+        )\n+    };\n+    let child = |run: &str| {\n+        let mut command = Command::new(std::env::current_exe().expect(\"the test executable\"));\n+        command\n+            .args([\n+                \"--exact\",\n+                \"harness::concurrent_builders_share_success_and_retry_failure\",\n+            ])\n+            .env(CHILD, &world.fakes)\n+            .env(\"NEXTEST_RUN_ID\", run)\n+            .env(\"CARGO\", &recorder)\n+            .env(\n+                \"ONEPIPELINE_REAL_CARGO\",\n+                std::env::var_os(\"CARGO\").unwrap_or_else(|| \"cargo\".into()),\n+            )\n+            .env(\"ONEPIPELINE_CARGO_STARTS\", &log);\n+        command\n+    };\n+    let failed = child(&run(0))\n+        .env(\"RUSTC\", world.root.join(\"missing-rustc\"))\n+        .output()\n+        .expect(\"a builder starts\");\n+    assert!(\n+        !failed.status.success(),\n+        \"the missing compiler must refuse the build\"\n+    );\n+    let refusal = format!(\n+        \"{}{}\",\n+        String::from_utf8_lossy(&failed.stdout),\n+        String::from_utf8_lossy(&failed.stderr)\n+    );\n+    assert!(refusal.contains(\"missing-rustc\"), \"{refusal}\");\n+    let starts = || profile::fs::read_to_string(&log).unwrap().lines().count();\n+    assert_eq!(starts(), 1, \"Cargo was asked and refused\");\n+    let children: Vec<_> = (0..4)\n+        .map(|_| child(&run(0)).spawn().expect(\"a waiting builder starts\"))\n+        .collect();\n+    for mut child in children {\n+        assert!(child.wait().expect(\"a builder exits\").success());\n+    }\n+    assert_eq!(\n+        starts(),\n+        2,\n+        \"one successful build after the refusal, reused by every waiter\"\n+    );\n+    assert!(child(&run(1)).status().unwrap().success());\n+    assert_eq!(\n+        starts(),\n+        3,\n+        \"a new run must ask Cargo about freshness again\"\n+    );\n+}\n+\n+fn build_package(selection: &[&str]) {\n     let debug = binary()\n         .parent()\n         .expect(\"the binary is in a directory\")\n@@ -6445,9 +6861,6 @@ fn build(selection: &[&str]) -> PathBuf {\n         \"{selection:?} did not build: {}\",\n         String::from_utf8_lossy(&built.stderr)\n     );\n-    let held = held_dir();\n-    profile::fs::create_dir_all(&held).expect(\"a directory for this process's doubles\");\n-    held\n }\n \n /// This process's own name for a built binary, made once and kept."},{"sha":"a7c6107aaf2c2790c6e9dda68c5989c2169000ec","filename":"tests/e2e/host_view.rs","status":"modified","additions":449,"deletions":4,"changes":453,"blob_url":"https://github.com/nickderobertis/onepipeline/blob/c3f74a07da428dcf7094d18c4c6d21d250111bc9/tests%2Fe2e%2Fhost_view.rs","raw_url":"https://github.com/nickderobertis/onepipeline/raw/c3f74a07da428dcf7094d18c4c6d21d250111bc9/tests%2Fe2e%2Fhost_view.rs","contents_url":"https://api.github.com/repos/nickderobertis/onepipeline/contents/tests%2Fe2e%2Fhost_view.rs?ref=c3f74a07da428dcf7094d18c4c6d21d250111bc9","patch":"@@ -150,6 +150,404 @@ fn generator(world: &World, args: &[&str]) -> String {\n     String::from_utf8(output.stdout).expect(\"UTF-8\")\n }\n \n+/// Dead fixture entries share one reaped process; live entries still name the\n+/// caller's real processes. Observe execve so this holds the generator's cost,\n+/// and exercise a missing executable followed by recovery in the same process.\n+#[test]\n+fn the_generator_reaps_once_and_does_not_cache_a_failed_spawn() {\n+    let world = World::new(\"fixture-reaped-pid\");\n+    let module = crate::harness::repo_file(GENERATOR);\n+    let script = r#\"\n+        import {pathToFileURL} from 'node:url';\n+        const {reapedPid} = await import(pathToFileURL(process.argv[2]));\n+        console.log(JSON.stringify({node: process.execPath, pids: [reapedPid(), reapedPid(), reapedPid()]}));\n+    \"#;\n+    let trace = world.root.join(\"generator.strace\");\n+    let output = Command::new(\"strace\")\n+        .args([\"-f\", \"-e\", \"trace=execve\", \"-o\"])\n+        .arg(&trace)\n+        .args([\"node\", \"--input-type=module\", \"-e\", script])\n+        .arg(\"fixture-probe\")\n+        .arg(&module)\n+        .output()\n+        .expect(\"the generator runs under strace\");\n+    assert!(\n+        output.status.success(),\n+        \"{}\",\n+        String::from_utf8_lossy(&output.stderr)\n+    );\n+    let held: Value = serde_json::from_slice(&output.stdout).expect(\"the reaped pids\");\n+    let pids = held[\"pids\"].as_array().expect(\"three pids\");\n+    assert!(pids[0].as_u64().is_some_and(|pid| pid > 0));\n+    assert!(pids.iter().all(|pid| pid == &pids[0]), \"{held}\");\n+    let trace = std::fs::read_to_string(trace).expect(\"the exec trace\");\n+    assert_eq!(\n+        trace\n+            .lines()\n+            .filter(|line| line.contains(\"/true\\\",\") && line.ends_with(\"= 0\"))\n+            .count(),\n+        1,\n+        \"{trace}\"\n+    );\n+\n+    let recovery = r#\"\n+        import {pathToFileURL} from 'node:url';\n+        import assert from 'node:assert/strict';\n+        const {reapedPid} = await import(pathToFileURL(process.argv[2]));\n+        const path = process.env.PATH;\n+        process.env.PATH = '';\n+        assert.throws(() => reapedPid(), /could not reap/);\n+        process.env.PATH = path;\n+        assert.ok(reapedPid() > 0);\n+    \"#;\n+    let recovered = Command::new(held[\"node\"].as_str().expect(\"node's executable\"))\n+        .args([\"--input-type=module\", \"-e\", recovery])\n+        .arg(\"fixture-probe\")\n+        .arg(module)\n+        .output()\n+        .expect(\"the generator retries after PATH is restored\");\n+    assert!(\n+        recovered.status.success(),\n+        \"{}\",\n+        String::from_utf8_lossy(&recovered.stderr)\n+    );\n+}\n+\n+/// Copies retain the CLI's records, but their live entries belong to the new\n+/// caller and their journals can be changed without touching the shared source.\n+#[test]\n+fn shared_fixtures_rebind_live_processes_and_keep_independent_journals() {\n+    let world = World::new(\"host-fixture-copies\");\n+    let mut fixture = Fixture::empty(&world);\n+    let (old_pid, old_token) = fixture.sleeper();\n+    let (new_pid, new_token) = fixture.sleeper();\n+    let started = now_millis();\n+    for (run, nodes) in [\n+        (\"live-0\", vec![\"plan\", \"build\"]),\n+        (\"live-1\", vec![\"plan\", \"review\"]),\n+        (\"live-2\", vec![\"plan\"]),\n+    ] {\n+        let mut spec = json!({\n+            \"run\": run, \"started_ms\": started, \"nodes\": &nodes[1..],\n+            \"registry\": nodes.iter().map(|node| json!({\"node\": node, \"pid\": old_pid, \"token\": old_token, \"recorded_ms\": started})).collect::<Vec<_>>()\n+        });\n+        if run != \"live-2\" {\n+            spec[\"driver\"] = json!({\"pid\": old_pid, \"token\": old_token});\n+        }\n+        fixture.run(&world, &spec);\n+    }\n+    fixture.run(\n+        &world,\n+        &json!({\"run\": \"sparse\", \"started_ms\": started, \"settled\": true, \"registry\": []}),\n+    );\n+    let sparse = fixture.runs.join(\"sparse/events.jsonl\");\n+    let prefix = std::fs::metadata(&sparse).unwrap().len();\n+    std::fs::OpenOptions::new()\n+        .write(true)\n+        .open(&sparse)\n+        .unwrap()\n+        .set_len(8 * 1024 * 1024)\n+        .unwrap();\n+    let cache = world.root.join(\"template\");\n+    std::fs::create_dir(&cache).unwrap();\n+    std::fs::rename(&fixture.runs, cache.join(\"runs\")).unwrap();\n+    write(\n+        &cache.join(\"manifest.json\"),\n+        &json!({\n+            \"expected\": {\"held\": [], \"unproven\": [], \"stale\": [], \"stopped\": [], \"skipped\": []},\n+            \"live_runs\": [\"live-0\", \"live-1\", \"live-2\"], \"ended\": [\"sparse\"], \"settled\": [\"sparse\"],\n+            \"sparse_run\": \"sparse\", \"sparse_record_bytes\": prefix\n+        }),\n+    );\n+    let process = json!({\"pid\": new_pid, \"token\": new_token});\n+    let processes = world.root.join(\"processes.json\");\n+    write(\n+        &processes,\n+        &json!({\"drivers\": [process, process], \"entries\": [[process, process], [process, process], [process]]}),\n+    );\n+    let copied = world.root.join(\"copy\");\n+    generator(\n+        &world,\n+        &[\"clone\", path(&copied), path(&processes), path(&cache)],\n+    );\n+    for run in [\"live-0\", \"live-1\", \"live-2\"] {\n+        let source = cache.join(\"runs\").join(run);\n+        let target = copied.join(run);\n+        if run != \"live-2\" {\n+            assert_eq!(read_json(&source.join(\"launch.json\"))[\"pid\"], old_pid);\n+            assert_eq!(read_json(&target.join(\"launch.json\"))[\"pid\"], new_pid);\n+        } else {\n+            assert_eq!(\n+                read_json(&source.join(\"launch.json\")),\n+                read_json(&target.join(\"launch.json\"))\n+            );\n+        }\n+        let entries: Vec<_> = std::fs::read_dir(target.join(\"dispatches\"))\n+            .unwrap()\n+            .collect();\n+        assert_eq!(entries.len(), if run == \"live-2\" { 1 } else { 2 });\n+        for entry in entries {\n+            let entry = read_json(&entry.unwrap().path());\n+            assert_eq!(entry[\"pid\"], new_pid);\n+            assert_eq!(entry[\"started\"], new_token);\n+        }\n+        assert_eq!(\n+            std::fs::read(source.join(\"events.jsonl\")).unwrap(),\n+            std::fs::read(target.join(\"events.jsonl\")).unwrap()\n+        );\n+    }\n+    assert_eq!(\n+        std::fs::metadata(copied.join(\"sparse/events.jsonl\"))\n+            .unwrap()\n+            .len(),\n+        8 * 1024 * 1024\n+    );\n+    let source = cache.join(\"runs/live-0/events.jsonl\");\n+    let bytes = std::fs::read(&source).unwrap();\n+    std::fs::write(copied.join(\"live-0/events.jsonl\"), \"the copy changes\").unwrap();\n+    assert_eq!(\n+        std::fs::read(&source).unwrap(),\n+        bytes,\n+        \"a clone cannot mutate its template\"\n+    );\n+\n+    let refused_clone = |name: &str| {\n+        Command::new(\"node\")\n+            .arg(crate::harness::repo_file(GENERATOR))\n+            .arg(\"clone\")\n+            .arg(world.root.join(name))\n+            .arg(&processes)\n+            .arg(&cache)\n+            .output()\n+            .unwrap()\n+    };\n+    let launch = cache.join(\"runs/live-0/launch.json\");\n+    let original = read_json(&launch);\n+    let dead_launch = cache.join(\"runs/live-2/launch.json\");\n+    let original_dead_launch = read_json(&dead_launch);\n+    let plan = cache.join(\"runs/live-2/plan.json\");\n+    let original_plan = read_json(&plan);\n+    let dispatch = cache\n+        .join(\"runs/live-0/dispatches\")\n+        .join(format!(\"{old_pid}-0.json\"));\n+    let original_dispatch = read_json(&dispatch);\n+    let mut unknown = original.clone();\n+    unknown[\"typo\"] = json!(true);\n+    let mut unknown_dead = original_dead_launch.clone();\n+    unknown_dead[\"typo\"] = json!(true);\n+    let mut unknown_plan = original_plan.clone();\n+    unknown_plan[\"typo\"] = json!(true);\n+    let mut wrong_type = original_dispatch.clone();\n+    wrong_type[\"pid\"] = json!([]);\n+    let mut wrong_time = original_dispatch.clone();\n+    wrong_time[\"dispatched_at\"] = json!(\"yesterday\");\n+    for (nth, (file, bad, message)) in [\n+        (&launch, unknown, \"cached launch has unknown field typo\"),\n+        (\n+            &dead_launch,\n+            unknown_dead,\n+            \"cached launch has unknown field typo\",\n+        ),\n+        (&plan, unknown_plan, \"cached plan has unknown field typo\"),\n+        (\n+            &dispatch,\n+            wrong_type,\n+            \"cached dispatch.pid has the wrong type\",\n+        ),\n+        (\n+            &dispatch,\n+            wrong_time,\n+            \"cached dispatch.dispatched_at must be a timestamp\",\n+        ),\n+    ]\n+    .into_iter()\n+    .enumerate()\n+    {\n+        write(file, &bad);\n+        let refused = refused_clone(&format!(\"bad-{nth}\"));\n+        assert_eq!(refused.status.code(), Some(1));\n+        assert!(\n+            String::from_utf8_lossy(&refused.stderr).contains(message),\n+            \"{}\",\n+            String::from_utf8_lossy(&refused.stderr)\n+        );\n+        write(&launch, &original);\n+        write(&dead_launch, &original_dead_launch);\n+        write(&plan, &original_plan);\n+        write(&dispatch, &original_dispatch);\n+    }\n+    let manifest = cache.join(\"manifest.json\");\n+    let original_manifest = read_json(&manifest);\n+    let mut fixed = original.clone();\n+    fixed[\"host\"] = json!(\"another host\");\n+    let mut invalid_pid = original.clone();\n+    invalid_pid[\"pid\"] = json!(-1);\n+    let mut fractional_pid = original.clone();\n+    fractional_pid[\"pid\"] = json!(1.5);\n+    let mut empty_plan = original_plan.clone();\n+    empty_plan[\"tasks\"] = json!([]);\n+    let mut non_array_plan = original_plan.clone();\n+    non_array_plan[\"tasks\"] = json!(null);\n+    let mut invalid_task = read_json(&cache.join(\"runs/live-0/plan.json\"));\n+    invalid_task[\"tasks\"][1][\"id\"] = json!(\"../outside\");\n+    let mut wrong_shape = original_manifest.clone();\n+    wrong_shape[\"live_runs\"] = json!([\"live-0\", \"live-1\"]);\n+    let mut repeated_live = original_manifest.clone();\n+    let first_live = repeated_live[\"live_runs\"][0].clone();\n+    repeated_live[\"live_runs\"][1] = first_live;\n+    let extra_plan = cache.join(\"runs/live-0/plan.json\");\n+    for (nth, (file, bad, message)) in [\n+        (&launch, json!(null), \"cached launch must be an object\"),\n+        (&launch, json!([]), \"cached launch must be an object\"),\n+        (&launch, json!({}), \"cached launch is missing\"),\n+        (&launch, fixed, \"cached launch.host differs\"),\n+        (&launch, invalid_pid, \"cached launch must be {pid, token}\"),\n+        (\n+            &launch,\n+            fractional_pid,\n+            \"cached launch must be {pid, token}\",\n+        ),\n+        (\n+            &plan,\n+            empty_plan,\n+            \"cached plan.tasks must be a nonempty array\",\n+        ),\n+        (\n+            &plan,\n+            non_array_plan,\n+            \"cached plan.tasks must be a nonempty array\",\n+        ),\n+        (\n+            &extra_plan,\n+            invalid_task,\n+            \"cached plan task.id must be a run name\",\n+        ),\n+        (\n+            &manifest,\n+            wrong_shape,\n+            \"the template's live runs differ from the process shape\",\n+        ),\n+        (\n+            &manifest,\n+            repeated_live,\n+            \"live_runs must not name a run twice\",\n+        ),\n+    ]\n+    .into_iter()\n+    .enumerate()\n+    {\n+        let valid = read_json(file);\n+        write(file, &bad);\n+        let refused = refused_clone(&format!(\"invalid-metadata-{nth}\"));\n+        assert_eq!(refused.status.code(), Some(1));\n+        assert!(\n+            String::from_utf8_lossy(&refused.stderr).contains(message),\n+            \"{}\",\n+            String::from_utf8_lossy(&refused.stderr)\n+        );\n+        write(file, &valid);\n+    }\n+    let registry = cache.join(\"runs/live-0/dispatches\");\n+    for (nth, replacement) in [\n+        None,\n+        Some(\"duplicate-1.json\"),\n+        Some(\"gap-9.json\"),\n+        Some(\"malformed.json\"),\n+    ]\n+    .into_iter()\n+    .enumerate()\n+    {\n+        let moved = registry.join(format!(\"{old_pid}-0.json\"));\n+        // Remove an index, duplicate the remaining index, leave a gap, or\n+        // replace its spelling: all must fail before a registry is rebound.\n+        let saved = std::fs::read(&moved).unwrap();\n+        std::fs::remove_file(&moved).unwrap();\n+        if let Some(name) = replacement {\n+            std::fs::write(registry.join(name), &saved).unwrap();\n+        }\n+        let refused = refused_clone(&format!(\"invalid-registry-{nth}\"));\n+        assert_eq!(refused.status.code(), Some(1));\n+        assert!(\n+            String::from_utf8_lossy(&refused.stderr)\n+                .contains(\"the template's registry for live-0 differs from the process shape\"),\n+            \"{}\",\n+            String::from_utf8_lossy(&refused.stderr)\n+        );\n+        if let Some(name) = replacement {\n+            std::fs::remove_file(registry.join(name)).unwrap();\n+        }\n+        std::fs::write(moved, saved).unwrap();\n+    }\n+    std::fs::write(cache.join(\"runs/sparse/events.jsonl\"), \"\").unwrap();\n+    let refused = refused_clone(\"refused\");\n+    assert_eq!(refused.status.code(), Some(1));\n+    assert!(String::from_utf8_lossy(&refused.stderr)\n+        .contains(\"the sparse fixture's recorded prefix is truncated\"));\n+}\n+\n+fn fixture_cache(world: &World) -> PathBuf {\n+    match std::env::var(\"NEXTEST_RUN_ID\") {\n+        Ok(run) => {\n+            assert!(\n+                !run.is_empty()\n+                    && run\n+                        .bytes()\n+                        .all(|byte| byte.is_ascii_hexdigit() || byte == b'-')\n+            );\n+            crate::harness::binary()\n+                .parent()\n+                .unwrap()\n+                .join(\"host-fixtures\")\n+                .join(run)\n+        }\n+        Err(_) => world.root.join(\"host-fixture-template\"),\n+    }\n+}\n+\n+/// Compare the raw CLI fixture with its first copy, including sparse prefixes\n+/// and file lengths. No host read has yet written summaries or checkpoints.\n+fn same_fixture(template: &Path, copied: &Path, sparse: &Path, sparse_prefix: u64) {\n+    use std::io::Read;\n+    let names = |root| {\n+        std::fs::read_dir(root)\n+            .unwrap()\n+            .map(|entry| entry.unwrap().file_name())\n+            .collect::<BTreeSet<_>>()\n+    };\n+    let entries = names(template);\n+    assert_eq!(entries, names(copied), \"{}\", template.display());\n+    for name in entries {\n+        let source = template.join(&name);\n+        let destination = copied.join(&name);\n+        if source.is_dir() {\n+            same_fixture(&source, &destination, sparse, sparse_prefix);\n+        } else {\n+            let length = std::fs::metadata(&source).unwrap().len();\n+            assert_eq!(\n+                length,\n+                std::fs::metadata(&destination).unwrap().len(),\n+                \"{}\",\n+                source.display()\n+            );\n+            let prefix = if destination == sparse {\n+                sparse_prefix\n+            } else {\n+                length\n+            };\n+            let bytes = |path| {\n+                let mut bytes = Vec::new();\n+                std::fs::File::open(path)\n+                    .unwrap()\n+                    .take(prefix)\n+                    .read_to_end(&mut bytes)\n+                    .unwrap();\n+                bytes\n+            };\n+            assert_eq!(bytes(&source), bytes(&destination), \"{}\", source.display());\n+        }\n+    }\n+}\n+\n fn pairs(value: &Value) -> BTreeSet<(String, String)> {\n     value\n         .as_array()\n@@ -203,7 +601,34 @@ impl Fixture {\n         });\n         let file = world.root.join(\"processes.json\");\n         write(&file, &processes);\n-        let manifest = generator(world, &[\"generate\", path(&fixture.runs), path(&file)]);\n+        let cache = fixture_cache(world);\n+        let mut generated = false;\n+        crate::harness::build_once(&cache, || {\n+            let template = cache.join(\"runs\");\n+            let _ = std::fs::remove_dir_all(&template);\n+            let manifest = generator(world, &[\"generate\", path(&template), path(&file)]);\n+            std::fs::write(cache.join(\"manifest.json\"), manifest)\n+                .expect(\"the raw fixture's manifest\");\n+            generated = true;\n+        });\n+        let manifest = generator(\n+            world,\n+            &[\"clone\", path(&fixture.runs), path(&file), path(&cache)],\n+        );\n+        if generated {\n+            // The first copy uses the very processes the CLI-generated template\n+            // names, so every byte must agree before later copies rebind them.\n+            let parsed: Value = serde_json::from_str(&manifest).unwrap();\n+            same_fixture(\n+                &cache.join(\"runs\"),\n+                &fixture.runs,\n+                &fixture\n+                    .runs\n+                    .join(parsed[\"sparse_run\"].as_str().unwrap())\n+                    .join(\"events.jsonl\"),\n+                parsed[\"sparse_record_bytes\"].as_u64().unwrap(),\n+            );\n+        }\n         fixture.adopt(&manifest);\n         fixture\n     }\n@@ -1979,6 +2404,8 @@ fn a_live_dispatch_recorded_with_a_legacy_ps_start_token_is_held() {\n #[test]\n fn the_budget_measurement_records_what_each_scaling_read_opened() {\n     let world = World::new(\"host-view-measure\");\n+    let _fixture = Fixture::generate(&world);\n+    let cache = fixture_cache(&world);\n     let real = std::env::split_paths(&std::env::var_os(\"PATH\").unwrap_or_default())\n         .map(|dir| dir.join(\"strace\"))\n         .find(|strace| strace.is_file())\n@@ -2014,7 +2441,7 @@ fn the_budget_measurement_records_what_each_scaling_read_opened() {\n         .status()\n         .expect(\"binutils' strip runs\");\n     assert!(strip.success(), \"strip refused the suite's build\");\n-    let measure = |record: &Path, refuse: Option<&str>| {\n+    let measure = |record: &Path, refuse: Option<&str>, template: &Path| {\n         let mut command = Command::new(\"node\");\n         command\n             .arg(crate::harness::repo_file(\"scripts/host-view-measure.mjs\"))\n@@ -2025,6 +2452,7 @@ fn the_budget_measurement_records_what_each_scaling_read_opened() {\n                 \"tests/e2e/host_view.rs: a stripped copy of the suite's build\",\n             )\n             .env(\"PATH\", &path)\n+            .env(\"ONEPIPELINE_TEST_HOST_FIXTURE\", template)\n             .stdin(Stdio::null());\n         if let Some(refuse) = refuse {\n             command.env(\"REFUSE_TRACE\", refuse);\n@@ -2041,7 +2469,7 @@ fn the_budget_measurement_records_what_each_scaling_read_opened() {\n     };\n \n     let record = world.root.join(\"host-view.json\");\n-    let measured = measure(&record, None);\n+    let measured = measure(&record, None, &cache);\n     assert!(\n         measured.status.success(),\n         \"{}\",\n@@ -2083,7 +2511,7 @@ fn the_budget_measurement_records_what_each_scaling_read_opened() {\n \n     std::fs::remove_file(&asked).expect(\"the noted traces\");\n     let refused_record = world.root.join(\"refused.json\");\n-    let refused = measure(&refused_record, Some(\"scaling-400\"));\n+    let refused = measure(&refused_record, Some(\"scaling-400\"), &cache);\n     let stderr = String::from_utf8_lossy(&refused.stderr);\n     assert_eq!(refused.status.code(), Some(1), \"{stderr}\");\n     assert!(\n@@ -2104,4 +2532,21 @@ fn the_budget_measurement_records_what_each_scaling_read_opened() {\n         !refused_record.exists(),\n         \"a measurement whose read went unobserved recorded it\"\n     );\n+\n+    // A template the suite never wrote is refused before anything is measured, with the\n+    // step that repairs the override or drops it rather than the measurement's own.\n+    let missing_record = world.root.join(\"missing-template.json\");\n+    let missing = world.root.join(\"no-such-template\");\n+    let refused = measure(&missing_record, None, &missing);\n+    let stderr = String::from_utf8_lossy(&refused.stderr);\n+    assert_eq!(refused.status.code(), Some(1), \"{stderr}\");\n+    assert!(\n+        stderr.contains(&format!(\"the host fixture template {}\", missing.display()))\n+            && stderr.contains(\"next: unset ONEPIPELINE_TEST_HOST_FIXTURE\"),\n+        \"{stderr}\"\n+    );\n+    assert!(\n+        !missing_record.exists(),\n+        \"a measurement over a template it could not copy recorded it\"\n+    );\n }"},{"sha":"4deb48a0d7640a4512062fb8e13f7ba594d11da4","filename":"tests/e2e/host_view_fixture.mjs","status":"modified","additions":140,"deletions":11,"changes":151,"blob_url":"https://github.com/nickderobertis/onepipeline/blob/c3f74a07da428dcf7094d18c4c6d21d250111bc9/tests%2Fe2e%2Fhost_view_fixture.mjs","raw_url":"https://github.com/nickderobertis/onepipeline/raw/c3f74a07da428dcf7094d18c4c6d21d250111bc9/tests%2Fe2e%2Fhost_view_fixture.mjs","contents_url":"https://api.github.com/repos/nickderobertis/onepipeline/contents/tests%2Fe2e%2Fhost_view_fixture.mjs?ref=c3f74a07da428dcf7094d18c4c6d21d250111bc9","patch":"@@ -26,6 +26,7 @@\n //\n // As a command:\n //   host_view_fixture.mjs generate RUNS PROCESSES.json   writes the 100-run root, prints its manifest\n+//   host_view_fixture.mjs clone RUNS PROCESSES.json CACHE  copies a raw fixture and rebinds its live processes\n //   host_view_fixture.mjs grow RUNS MANIFEST.json TOTAL    grows it with ended history, prints the manifest\n //   host_view_fixture.mjs cold RUNS MANIFEST.json          forgets every ended run's derived documents\n //   host_view_fixture.mjs stamp-sparse RUNS MANIFEST.json BINARY   the sparse run's summary, as its writer keeps it\n@@ -35,17 +36,22 @@\n import { spawnSync } from \"node:child_process\";\n import {\n   appendFileSync,\n+  closeSync,\n+  constants,\n+  copyFileSync,\n   chmodSync,\n   linkSync,\n   mkdirSync,\n+  openSync,\n   readdirSync,\n   readFileSync,\n+  readSync,\n   rmSync,\n   statSync,\n   truncateSync,\n   writeFileSync,\n } from \"node:fs\";\n-import { dirname, join } from \"node:path\";\n+import { basename, dirname, join } from \"node:path\";\n import { fileURLToPath } from \"node:url\";\n \n const REPO = join(dirname(fileURLToPath(import.meta.url)), \"..\", \"..\");\n@@ -240,9 +246,19 @@ export function dispatched(run, node, at) {\n   return [\"node-ready\", \"node-dispatched\"].map((kind) => pipeline(run, kind, node, at));\n }\n \n-/** A pid this host has just reaped, so a probe of it answers gone. */\n+// Every dead entry also carries an impossible start token, so even PID reuse\n+// cannot turn it into a live dispatch. Reaping once keeps a 100-run fixture from\n+// spawning a process for each dead driver and registry entry.\n+let reaped;\n+/** A pid this generator reaped, so a probe cannot prove the fixture's dead token. */\n export function reapedPid() {\n-  return spawnSync(\"true\").pid;\n+  if (reaped !== undefined) return reaped;\n+  const child = spawnSync(\"true\");\n+  if (child.status !== 0 || !Number.isSafeInteger(child.pid) || child.pid <= 0) {\n+    throw new Error(`could not reap a fixture process: ${child.error?.message ?? child.stderr}`);\n+  }\n+  reaped = child.pid;\n+  return reaped;\n }\n \n /** The procfs start token of a live process, as the engine records one. */\n@@ -259,20 +275,43 @@ const readJson = (path) => JSON.parse(readFileSync(path, \"utf8\"));\n export function writeRun(runs, seed, { run, journal: text, registry = null, driver = GONE, nodes = [] }) {\n   const dir = join(runs, run);\n   mkdirSync(dir, { recursive: true });\n-  writeJson(join(dir, \"launch.json\"), {\n+  writeJson(join(dir, \"launch.json\"), launchOf(seed, run, driver));\n+  writeJson(join(dir, \"plan.json\"), planWith(seed, nodes));\n+  writeFileSync(join(dir, \"events.jsonl\"), text);\n+  if (registry !== null) {\n+    mkdirSync(join(dir, \"dispatches\"));\n+    registry.forEach((entry, n) => writeJson(join(dir, \"dispatches\", `${entry.pid}-${n}.json`), entry));\n+  }\n+}\n+\n+function launchOf(seed, run, driver) {\n+  return {\n     ...seed.launch,\n     run_id: run,\n     project: `authoring:${run}`,\n     host: HOST,\n     pid: driver.pid || reapedPid(),\n     started: driver.token,\n-  });\n-  writeJson(join(dir, \"plan.json\"), planWith(seed, nodes));\n-  writeFileSync(join(dir, \"events.jsonl\"), text);\n-  if (registry !== null) {\n-    mkdirSync(join(dir, \"dispatches\"));\n-    registry.forEach((entry, n) => writeJson(join(dir, \"dispatches\", `${entry.pid}-${n}.json`), entry));\n+  };\n+}\n+\n+// Cache records must be exactly the shape this generator writes. Derive keys\n+// and fixed fields from its writers, rather than copying the engine's schema.\n+function fixtureRecord(value, expected, varying, label) {\n+  if (typeof value !== \"object\" || value === null || Array.isArray(value)) refuse(`${label} must be an object`);\n+  for (const key of Object.keys(value)) {\n+    if (!Object.hasOwn(expected, key)) refuse(`${label} has unknown field ${key}`);\n   }\n+  for (const key of Object.keys(expected)) {\n+    if (!Object.hasOwn(value, key)) refuse(`${label} is missing ${key}`);\n+    if (varying.includes(key)) {\n+      if (typeof value[key] !== typeof expected[key]) refuse(`${label}.${key} has the wrong type`);\n+    } else if (JSON.stringify(value[key]) !== JSON.stringify(expected[key])) {\n+      refuse(`${label}.${key} differs from the generated fixture`);\n+    }\n+  }\n+  if (Object.hasOwn(expected, \"pid\")) processOf({pid: value.pid, token: value.started}, label);\n+  return value;\n }\n \n /** A registry entry, stamped just after the run recorded the dispatch it names. */\n@@ -382,6 +421,92 @@ export function generate(runs, processes, now = Date.now()) {\n   return manifest;\n }\n \n+/** Copy a raw CLI-generated fixture, rebinding its live processes to this caller.\n+ * Journals are independent copies: cold reads chmod and truncate them, so links\n+ * would let one journey change the template another journey reads.\n+ */\n+export function cloneFixture(runs, live, cache) {\n+  root(runs);\n+  root(cache);\n+  processes(live);\n+  const manifest = manifestOf(readJson(join(cache, \"manifest.json\")));\n+  const template = join(cache, \"runs\");\n+  const seed = readSeed();\n+  const cachedDispatch = (file) => {\n+    const value = fixtureRecord(readJson(file), entry(\"plan\", GONE, 0), [\"node\", \"pid\", \"started\", \"dispatched_at\"], \"cached dispatch\");\n+    runName(value.node, \"cached dispatch.node\");\n+    const time = Date.parse(value.dispatched_at);\n+    if (!Number.isFinite(time) || stamp(time) !== value.dispatched_at) refuse(\"cached dispatch.dispatched_at must be a timestamp\");\n+    return value;\n+  };\n+  const validateMetadata = (file) => {\n+    const run = basename(dirname(file));\n+    if (basename(file) === \"launch.json\") {\n+      fixtureRecord(readJson(file), launchOf(seed, run, GONE), [\"pid\", \"started\"], \"cached launch\");\n+    } else if (basename(file) === \"plan.json\") {\n+      const value = readJson(file);\n+      if (!Array.isArray(value?.tasks) || value.tasks.length === 0) refuse(\"cached plan.tasks must be a nonempty array\");\n+      const nodes = value.tasks.slice(1).map((task) => {\n+        runName(task?.id, \"cached plan task.id\");\n+        return task.id;\n+      });\n+      fixtureRecord(value, planWith(seed, nodes), [], \"cached plan\");\n+    } else if (basename(dirname(file)) === \"dispatches\") cachedDispatch(file);\n+  };\n+  const copy = (from, to) => {\n+    mkdirSync(to, { recursive: true });\n+    for (const item of readdirSync(from, { withFileTypes: true })) {\n+      const source = join(from, item.name);\n+      const destination = join(to, item.name);\n+      if (item.isDirectory()) copy(source, destination);\n+      else if (source === join(template, manifest.sparse_run, \"events.jsonl\")) {\n+        // Copy only the sparse file's real prefix, never materialize its holes.\n+        const file = openSync(source, \"r\");\n+        try {\n+          const bytes = Buffer.alloc(manifest.sparse_record_bytes);\n+          let read = 0;\n+          while (read < bytes.length) {\n+            const got = readSync(file, bytes, read, bytes.length - read, read);\n+            if (got === 0) throw new Error(\"the sparse fixture's recorded prefix is truncated\");\n+            read += got;\n+          }\n+          writeFileSync(destination, bytes);\n+          truncateSync(destination, statSync(source).size);\n+        } finally {\n+          closeSync(file);\n+        }\n+      } else {\n+        validateMetadata(source);\n+        copyFileSync(source, destination, constants.COPYFILE_FICLONE);\n+      }\n+    }\n+  };\n+  if (manifest.live_runs.length !== live.entries.length) throw new Error(\"the template's live runs differ from the process shape\");\n+  copy(template, runs);\n+  manifest.live_runs.forEach((run, i) => {\n+    const directory = join(runs, run);\n+    const launch = fixtureRecord(readJson(join(directory, \"launch.json\")), launchOf(seed, run, GONE), [\"pid\", \"started\"], \"cached launch\");\n+    if (live.drivers[i]) {\n+      writeJson(join(directory, \"launch.json\"), { ...launch, pid: live.drivers[i].pid, started: live.drivers[i].token });\n+    }\n+    const registry = join(directory, \"dispatches\");\n+    const entries = readdirSync(registry).map((file) => ({\n+      index: Number(file.match(/-(\\d+)\\.json$/)?.[1]),\n+      value: cachedDispatch(join(registry, file)),\n+    })).sort((a, b) => a.index - b.index);\n+    if (entries.length !== live.entries[i].length || entries.some((entry, n) => entry.index !== n)) {\n+      throw new Error(`the template's registry for ${run} differs from the process shape`);\n+    }\n+    rmSync(registry, { recursive: true });\n+    mkdirSync(registry);\n+    entries.forEach(({ value }, n) => {\n+      const process = live.entries[i][n];\n+      writeJson(join(registry, `${process.pid}-${n}.json`), { ...value, pid: process.pid, started: process.token });\n+    });\n+  });\n+  return manifest;\n+}\n+\n /**\n  * Grow the root with ended, settled runs — and launch-less roots, at 9% — to\n  * `total` run roots. Each added run is one of the 100-run fixture's own settled\n@@ -563,6 +688,8 @@ function manifestOf(value) {\n     });\n   }\n   for (const key of [\"live_runs\", \"ended\", \"settled\"]) names(value[key], key);\n+  // Each live run is rebound to its own processes; a repeat would rebind one twice.\n+  if (new Set(value.live_runs).size !== value.live_runs.length) refuse(\"live_runs must not name a run twice\");\n   names(value.expected.skipped, \"expected.skipped\");\n   runName(value.sparse_run, \"sparse_run\");\n   count(value.sparse_record_bytes, \"sparse_record_bytes\");\n@@ -620,6 +747,8 @@ function command(argv) {\n   switch (verb) {\n     case \"generate\":\n       return out(generate(root(args[0]), processes(readJson(args[1]))));\n+    case \"clone\":\n+      return out(cloneFixture(root(args[0]), processes(readJson(args[1])), root(args[2])));\n     case \"grow\": {\n       const total = Number(args[2]);\n       if (!Number.isSafeInteger(total) || total < 100) refuse(`grow wants a total of at least 100 run roots, not ${args[2]}`);\n@@ -639,7 +768,7 @@ function command(argv) {\n       return append(root(args[0]), spec);\n     }\n     default:\n-      throw new Error(`unknown verb ${verb}: generate, grow, cold, stamp-sparse, run or append`);\n+      throw new Error(`unknown verb ${verb}: generate, clone, grow, cold, stamp-sparse, run or append`);\n   }\n }\n "},{"sha":"b468b8c1a872e9295ee1a47a41e6a3ab2a1b07e5","filename":"tests/e2e/maintenance.rs","status":"modified","additions":11,"deletions":1,"changes":12,"blob_url":"https://github.com/nickderobertis/onepipeline/blob/c3f74a07da428dcf7094d18c4c6d21d250111bc9/tests%2Fe2e%2Fmaintenance.rs","raw_url":"https://github.com/nickderobertis/onepipeline/raw/c3f74a07da428dcf7094d18c4c6d21d250111bc9/tests%2Fe2e%2Fmaintenance.rs","contents_url":"https://api.github.com/repos/nickderobertis/onepipeline/contents/tests%2Fe2e%2Fmaintenance.rs?ref=c3f74a07da428dcf7094d18c4c6d21d250111bc9","patch":"@@ -2255,9 +2255,14 @@ fn a_closing_driver_journals_the_cut_of_a_sweep_over_identities_that_declare_not\n     // the real linked sibling, and every outcome is asserted on the binary's own records.\n     let inside = crate::harness::Rendezvous::failpoint();\n     let stopping = crate::harness::Rendezvous::failpoint();\n+    let relayed = crate::harness::Rendezvous::failpoint();\n     let world = pooled_world(\"maintenance-undeclared-cut\", Some(FAST_PACE))\n         .with_env(IDENTITY_GATE, &inside.address())\n-        .with_env(STOP_GATE, &stopping.address());\n+        .with_env(STOP_GATE, &stopping.address())\n+        .with_env(\n+            \"ONEPIPELINE_TEST_SETTLEMENT_RELAYED_GATE\",\n+            &relayed.address(),\n+        );\n     // llmlint: ignore-end[tests_mirror_real_usage]\n     let service = world.repository(\"local-direct\", &[]);\n     let other = world.extra_repository(\"other\");\n@@ -2270,12 +2275,17 @@ fn a_closing_driver_journals_the_cut_of_a_sweep_over_identities_that_declare_not\n     let held = inside.arrived();\n     assert!(sweeping(&world, \"cut\"), \"{}\", world.dump());\n     world.release(\"cut-build.go\");\n+    // The loop has its settlement, but the relay cannot forward the sweep's\n+    // reports. Joining the sweep must suffice to put those reports on the\n+    // loop's receiver before close-out drains it.\n+    let relay_held = relayed.arrived();\n     stopping.arrived().release();\n     held.release();\n     world.until(\"the cut run's result\", |world| {\n         world.run_file(\"cut\", \"result.json\").is_file()\n     });\n \n+    relay_held.release();\n     let recorded = records(&world, \"cut\");\n     assert_eq!(recorded.len(), 1, \"{}\", world.dump());\n     let payload = &recorded[0][\"payload\"];"},{"sha":"3c2be724b97b7f9af418772b8ae81d4631743096","filename":"tests/e2e/profiling.rs","status":"modified","additions":17,"deletions":8,"changes":25,"blob_url":"https://github.com/nickderobertis/onepipeline/blob/c3f74a07da428dcf7094d18c4c6d21d250111bc9/tests%2Fe2e%2Fprofiling.rs","raw_url":"https://github.com/nickderobertis/onepipeline/raw/c3f74a07da428dcf7094d18c4c6d21d250111bc9/tests%2Fe2e%2Fprofiling.rs","contents_url":"https://api.github.com/repos/nickderobertis/onepipeline/contents/tests%2Fe2e%2Fprofiling.rs?ref=c3f74a07da428dcf7094d18c4c6d21d250111bc9","patch":"@@ -145,15 +145,24 @@ fn a_profiled_journey_that_fails() {\n /// Run this suite's own binary the way nextest runs one test — alone, in a\n /// process of its own — with its record redirected into `records`.\n fn run_alone(args: &[&str], records: &std::path::Path) -> std::process::Output {\n-    Command::new(std::env::current_exe().expect(\"this suite's own binary\"))\n+    let mut command = Command::new(std::env::current_exe().expect(\"this suite's own binary\"));\n+    command\n         .args(args)\n         .arg(\"--nocapture\")\n         .env(profile::DIR_ENV, records)\n         // The name nextest gave *this* test, which the child would otherwise read\n         // as its own: what it runs is what `args` names.\n-        .env_remove(\"NEXTEST_TEST_NAME\")\n-        .output()\n-        .expect(\"the suite runs\")\n+        .env_remove(\"NEXTEST_TEST_NAME\");\n+    if args.contains(&BUSY) {\n+        // This probe must observe Cargo even when the enclosing run already\n+        // built the doubles. Its independent run still uses the real builder.\n+        let run = std::time::SystemTime::now()\n+            .duration_since(std::time::UNIX_EPOCH)\n+            .unwrap()\n+            .as_nanos();\n+        command.env(\"NEXTEST_RUN_ID\", format!(\"{run:x}\"));\n+    }\n+    command.output().expect(\"the suite runs\")\n }\n \n fn passed(test: &str, ran: &std::process::Output) {\n@@ -444,9 +453,9 @@ fn a_fixtures_nested_git_and_file_work_is_its_own_and_not_the_fixtures() {\n         whole,\n         \"the fixture's time and its nested work: {after:?}\"\n     );\n-    // `init`, `clone`, `add`, `commit` and `push`; the registration through the\n-    // linked `onevcs`; and the `remote get-url` that registration runs.\n-    assert_eq!(delta(Category::Git).0, 7, \"git operations: {after:?}\");\n+    // `init`, `fast-import` and `clone`; the registration through the linked\n+    // `onevcs`; and the `remote get-url` that registration runs.\n+    assert_eq!(delta(Category::Git).0, 5, \"git operations: {after:?}\");\n }\n \n /// A poll inside a poll is one polling wait, and every sleep in either counts.\n@@ -681,7 +690,7 @@ fn nested_work_on_a_thread_the_test_started_is_counted_once() {\n     assert!(fixture_time > std::time::Duration::ZERO, \"{after:?}\");\n     let (gits, git_time) = delta(Category::Git);\n     assert_eq!(\n-        gits, 7,\n+        gits, 5,\n         \"the same git operations as on the test thread: {after:?}\"\n     );\n     assert_eq!("},{"sha":"f6d3e6896f22f3422bc0d81cab2a6934a3388076","filename":"tests/e2e/retirement.rs","status":"modified","additions":7,"deletions":3,"changes":10,"blob_url":"https://github.com/nickderobertis/onepipeline/blob/c3f74a07da428dcf7094d18c4c6d21d250111bc9/tests%2Fe2e%2Fretirement.rs","raw_url":"https://github.com/nickderobertis/onepipeline/raw/c3f74a07da428dcf7094d18c4c6d21d250111bc9/tests%2Fe2e%2Fretirement.rs","contents_url":"https://api.github.com/repos/nickderobertis/onepipeline/contents/tests%2Fe2e%2Fretirement.rs?ref=c3f74a07da428dcf7094d18c4c6d21d250111bc9","patch":"@@ -2705,9 +2705,13 @@ fn a_sweep_records_its_maintenance_before_its_retirement_pass_ends() {\n     world.until(\"the sweeper to settle\", |world| {\n         world.run_file(\"sweeper\", \"result.json\").is_file()\n     });\n-    assert!(retired(&world, \"sweeper\")\n-        .iter()\n-        .any(|entry| entry[\"branch\"] == \"done/published\"));\n+    assert!(\n+        retired(&world, \"sweeper\")\n+            .iter()\n+            .any(|entry| entry[\"branch\"] == \"done/published\"),\n+        \"{}\",\n+        world.dump()\n+    );\n     assert!(!holds(&world, &repo.origin, \"done/published\"));\n     let kinds: Vec<Value> = world\n         .journal(\"sweeper\")"},{"sha":"72db54f293ed7b25d471ab4faff53ef953f81e07","filename":"tests/e2e/unwatched.rs","status":"modified","additions":57,"deletions":0,"changes":57,"blob_url":"https://github.com/nickderobertis/onepipeline/blob/c3f74a07da428dcf7094d18c4c6d21d250111bc9/tests%2Fe2e%2Funwatched.rs","raw_url":"https://github.com/nickderobertis/onepipeline/raw/c3f74a07da428dcf7094d18c4c6d21d250111bc9/tests%2Fe2e%2Funwatched.rs","contents_url":"https://api.github.com/repos/nickderobertis/onepipeline/contents/tests%2Fe2e%2Funwatched.rs?ref=c3f74a07da428dcf7094d18c4c6d21d250111bc9","patch":"@@ -1548,6 +1548,63 @@ fn assembled_run(template: &RunPaths, root: &std::path::Path, id: &str, session:\n \n // llmlint: ignore-end[tests_mirror_real_usage]\n \n+#[test]\n+fn a_large_root_validates_owned_foreign_and_malformed_launches_before_reporting() {\n+    let world = World::new(\"unwatched-discovery\");\n+    world.script(\"build.wait\", \"hold\");\n+    let template = paths_of(&world, &held(&world, \"discovery-template\"));\n+    let mut launches = Vec::new();\n+    for index in 0..40 {\n+        let owner = if index < 3 {\n+            world.session.as_str()\n+        } else {\n+            \"another-planner\"\n+        };\n+        launches.push(assembled_run(\n+            &template,\n+            &world.runs,\n+            &format!(\"discovery-{index:02}\"),\n+            owner,\n+        ));\n+    }\n+    world.run(&[\"stop\", &template.run, \"--force\"]).exited(0);\n+    world.release(\"build.go\");\n+    // llmlint: ignore-block[tests_mirror_real_usage] no verb writes a launch record whose pid\n+    // is not a process id, and none could: the state is left by a damaged write or a build\n+    // whose schema this one does not read. The record edited is this build's own, changed only\n+    // in the field under test, and every claim afterwards is read off the compiled binary.\n+    let original = std::fs::read(launches[1].launch()).expect(\"the real launch record\");\n+    let mut malformed: Value = serde_json::from_slice(&original).expect(\"the real schema\");\n+    malformed[\"pid\"] = json!(\"not a process id\");\n+    std::fs::write(launches[1].launch(), malformed.to_string()).expect(\"the incomplete launch\");\n+    // llmlint: ignore-end[tests_mirror_real_usage]\n+    let (code, rows) = asked(&world, &[\"unwatched\"]);\n+    assert_eq!(code, RUNS_UNWATCHED, \"{rows}\");\n+    assert_eq!(rows.lines().count(), 2, \"{rows}\");\n+    assert!(\n+        rows.contains(\"discovery-00\") && rows.contains(\"discovery-02\"),\n+        \"{rows}\"\n+    );\n+    assert!(\n+        !rows.contains(\"discovery-01\") && !rows.contains(\"discovery-03\"),\n+        \"{rows}\"\n+    );\n+    // llmlint: ignore-block[tests_mirror_real_usage] the repair is putting back the record\n+    // this build's own writer wrote, byte for byte, which is what restoring a damaged run root\n+    // does; no verb rewrites another run's launch record.\n+    std::fs::write(launches[1].launch(), original).expect(\"the recovered launch\");\n+    // llmlint: ignore-end[tests_mirror_real_usage]\n+    let (code, recovered) = asked(&world, &[\"unwatched\"]);\n+    assert_eq!(code, RUNS_UNWATCHED, \"{recovered}\");\n+    assert_eq!(recovered.lines().count(), 3, \"{recovered}\");\n+    for index in 0..3 {\n+        assert!(\n+            recovered.contains(&format!(\"discovery-{index:02}\")),\n+            \"{recovered}\"\n+        );\n+    }\n+}\n+\n /// Windows may refuse an atomic replacement or an open while another handle\n /// is closing. Wait for that filesystem state, under the harness's existing\n /// deadline; unrelated errors still fail at their first attempt."},{"sha":"1fb11ce3dc48b4cc3086aaf1b276bbca1fd5cc9c","filename":"tests/stop_verdict/project.json","status":"modified","additions":24,"deletions":0,"changes":24,"blob_url":"https://github.com/nickderobertis/onepipeline/blob/c3f74a07da428dcf7094d18c4c6d21d250111bc9/tests%2Fstop_verdict%2Fproject.json","raw_url":"https://github.com/nickderobertis/onepipeline/raw/c3f74a07da428dcf7094d18c4c6d21d250111bc9/tests%2Fstop_verdict%2Fproject.json","contents_url":"https://api.github.com/repos/nickderobertis/onepipeline/contents/tests%2Fstop_verdict%2Fproject.json?ref=c3f74a07da428dcf7094d18c4c6d21d250111bc9","patch":"@@ -48,6 +48,21 @@\n         \"{workspaceRoot}/rustfmt.toml\"\n       ]\n     },\n+    \"test-build\": {\n+      \"command\": \"just _stop-verdict-build\",\n+      \"//\": \"The release binary `test` times, built ahead of it and beside the rest of the gate: `test` admits nothing beside it because it times that binary, and compiling it needs no such quiet. Keyed on exactly `test`'s inputs, so the two replay or run together: a warm cache builds nothing, and a `test` that runs finds the binary fresh. The debug test binaries `test` runs come from `onepipeline:build`, the other edge `test` declares.\",\n+      \"cache\": true,\n+      \"inputs\": [\n+        \"rustBuild\",\n+        \"{workspaceRoot}/tests/stop_verdict/**/*\",\n+        \"{workspaceRoot}/tests/golden/**/*\",\n+        \"{workspaceRoot}/tests/recorded/registry/**/*\",\n+        \"{workspaceRoot}/tests/recorded/run-root/onemessagebus-repair-2/**/*\",\n+        \"{workspaceRoot}/scripts/stop-guard-unpublished-*\",\n+        \"{workspaceRoot}/clippy.toml\",\n+        \"{workspaceRoot}/rustfmt.toml\"\n+      ]\n+    },\n     \"test\": {\n       \"command\": \"just stop-verdict-journeys\",\n       \"//\": \"llmlint: ignore-block[expensive_tests_stay_behind_their_own_edge] this tier times the release binary, so its inputs are what that binary is built from and nothing narrower: the budget reader refuses a record whose build fingerprint (scripts/stop-guard-unpublished-build-inputs.json, the same set) differs from the tree, so an input left out here would replay a record the reader then refuses as stale, and a module left out of both would let a changed binary be judged by an old one's timings.\",\n@@ -67,6 +82,15 @@\n         \"{workspaceRoot}/target/budget-records/stop-guard-unpublished-invocation.json\",\n         \"{workspaceRoot}/target/budget-records/stop-guard-unpublished-onepipeline\"\n       ],\n+      \"dependsOn\": [\n+        \"test-build\",\n+        {\n+          \"projects\": [\n+            \"onepipeline\"\n+          ],\n+          \"target\": \"build\"\n+        }\n+      ],\n       \"parallelism\": false\n     },\n     \"check\": {"}]}